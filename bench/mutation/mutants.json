 {
  "id": "refund_without_tax",
  "what": "the refund is computed from the net total (gross minus tax)",
  "qal": [
   {
    "def": "take_back",
    "old": "let refund = o.total * qty / o.qty in",
    "new": "let refund = (o.total - o.tax) * qty / o.qty in"
   }
  ],
  "rust": [
   {
    "old": "let refund = order.total * u128::from(qty) / order_qty;",
    "new": "let refund = (order.total - order.tax) * u128::from(qty) / order_qty;"
   }
  ]
