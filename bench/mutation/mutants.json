    "old": "        let percent = (quantity_percent + tier.percent() + product.promo).min(50);",
    "new": "        let quantity_percent = if line.qty >= 10 { 5 } else { 0 };\n        let percent = (quantity_percent + tier.percent() + product.promo).min(50);"
   }
  ]
 },
