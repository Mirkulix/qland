    "old": "fold(st.pending, Step",
    "new": "fold(reverse(st.pending), Step"
   }
  ],
  "rust": [
   {
    "old": "        for oid in queue {\n",
    "new": "        for oid in queue.into_iter().rev() {\n"
   },
