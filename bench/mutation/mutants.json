 {
  "id": "top_ties_reversed",
  "what": "ties in `top` go by id in reverse byte order",
  "qal": [
   {
    "def": "better_prod",
    "old": "a.sold == b.sold && a.id < b.id",
    "new": "a.sold == b.sold && a.id > b.id"
   }
  ],
  "rust": [
   {
    "old": "ranked.sort_by(|a, b| b.1.cmp(&a.1));",
    "new": "ranked.sort_by(|a, b| b.1.cmp(&a.1).then(b.0.cmp(a.0)));"
   }
  ]
 },
