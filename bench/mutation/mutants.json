[
 {
  "id": "cancel_pending_deletes",
  "what": "cancelling a pending order deletes it, so its id is free again and a second cancel says unknown_order (the bug of pressure run 5)",
  "qal": [
   {
    "def": "cancel",
    "old": "Step { st: St { products: st.products, customers: st.customers, used: st.used, orders: st.orders, bad: st.bad, tax: st.tax, pending: drop_pending(st.pending, oid), promo: st.promo }, out: [\"CANCELLED \" ++ oid ++ \" 0\"] }",
    "new": "Step { st: St { products: st.products, customers: st.customers, used: map_del(st.used, oid), orders: map_del(st.orders, oid), bad: st.bad, tax: st.tax, pending: drop_pending(st.pending, oid), promo: st.promo }, out: [\"CANCELLED \" ++ oid ++ \" 0\"] }"
   }
  ],
  "rust": [
   {
    "old": "        if order.status == Status::Pending {\n            order.status = Status::Cancelled;\n            self.pending.retain",
    "new": "        if order.status == Status::Pending {\n            self.orders.remove(oid);\n            self.pending.retain"
   }
  ]
 },
