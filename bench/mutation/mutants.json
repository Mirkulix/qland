 {
  "id": "fits_per_line",
  "what": "the stock check looks at each line alone, not at the sum of the lines of one product",
  "qal": [
   {
    "def": "fits",
    "old": "acc && demand(lines, l.pid) <= stock_of(st, l.pid)",
    "new": "acc && l.qty <= stock_of(st, l.pid)"
   }
  ],
  "rust": [
   {
    "old": "        let mut need: BTreeMap<&str, u64> = BTreeMap::new();\n        for line in lines {\n            *need.entry(line.pid.as_str()).or_insert(0) += line.qty;\n        }\n        need.iter()\n            .all(|(pid, &qty)| self.products.get(*pid).is_some_and(|p| qty <= p.stock))",
    "new": "        lines.iter().all(|l| self.products.get(&l.pid).is_some_and(|p| l.qty <= p.stock))"
   }
  ]
 },
 {
