# Binary search tree: read ints from stdin, insert in order (duplicates ignored),
# then report size, height and the inorder/preorder/postorder traversals.

type Tree = Leaf | Node(Tree, Int, Tree)

type Lex = { toks: List[Str], cur: Str }

fn is_space_char(c: Str) -> Bool =
  c == " " || c == "\n" || c == "\t" || c == "\r"

fn flush(acc: Lex) -> Lex =
  if len(acc.cur) == 0 then acc
  else Lex { toks: push(acc.toks, acc.cur), cur: "" }

fn push_char(acc: Lex, c: Str) -> Lex =
  Lex { toks: acc.toks, cur: acc.cur ++ c }

fn lex_step(acc: Lex, c: Str) -> Lex =
  if is_space_char(c) then flush(acc) else push_char(acc, c)

fn tokenize(s: Str) -> List[Str] =
  let acc = fold(chars(s), Lex { toks: [], cur: "" }, lex_step) in
  flush(acc).toks

fn keep_int(acc: List[Int], s: Str) -> List[Int] =
  match to_int(s) {
    Some(n) => push(acc, n),
    None => acc
  }

fn parse_ints(toks: List[Str]) -> List[Int] =
  let empty: List[Int] = [] in
  fold(toks, empty, keep_int)

fn insert(t: Tree, v: Int) -> Tree =
  match t {
    Leaf => Node(Leaf, v, Leaf),
    Node(l, x, r) =>
      if v < x then Node(insert(l, v), x, r)
      else if v > x then Node(l, x, insert(r, v))
      else t
  }

fn build(xs: List[Int]) -> Tree =
  fold(xs, Leaf, insert)

fn tree_size(t: Tree) -> Int =
  match t {
    Leaf => 0,
    Node(l, _, r) => 1 + tree_size(l) + tree_size(r)
  }

fn max_int(a: Int, b: Int) -> Int =
  if a > b then a else b

fn tree_height(t: Tree) -> Int =
  match t {
    Leaf => 0,
    Node(l, _, r) => 1 + max_int(tree_height(l), tree_height(r))
  }

fn inorder(t: Tree) -> List[Int] =
  match t {
    Leaf => [],
    Node(l, v, r) => concat(inorder(l), concat([v], inorder(r)))
  }

fn preorder(t: Tree) -> List[Int] =
  match t {
    Leaf => [],
    Node(l, v, r) => concat([v], concat(preorder(l), preorder(r)))
  }

fn postorder(t: Tree) -> List[Int] =
  match t {
    Leaf => [],
    Node(l, v, r) => concat(postorder(l), concat(postorder(r), [v]))
  }

fn render_line(label: Str, vals: List[Int]) -> Str =
  let body = join(map(vals, fn(x) => from_int(x)), " ") in
  if len(body) == 0 then label else label ++ " " ++ body

fn render(t: Tree) -> Str =
  "size " ++ from_int(tree_size(t)) ++ "\n" ++
  "height " ++ from_int(tree_height(t)) ++ "\n" ++
  render_line("inorder", inorder(t)) ++ "\n" ++
  render_line("preorder", preorder(t)) ++ "\n" ++
  render_line("postorder", postorder(t))

# Pure pipeline shared by main and the tests.
fn solve(input: Str) -> Str =
  render(build(parse_ints(tokenize(input))))

fn main(args: List[Str]) -> Int !io =
  let input = read_all() in
  let out = solve(input) in
  {
    print(out);
    0
  }

# --- tests ---

test example =
  solve("5 3 8 1 4\n9 3\n") ==
  "size 6\nheight 3\ninorder 1 3 4 5 8 9\npreorder 5 3 1 4 8 9\npostorder 1 4 3 9 8 5"

test empty =
  solve("") ==
  "size 0\nheight 0\ninorder\npreorder\npostorder"

test whitespace_only =
  solve(" \t\n\r\n  ") ==
  "size 0\nheight 0\ninorder\npreorder\npostorder"

test single =
  solve("42") ==
  "size 1\nheight 1\ninorder 42\npreorder 42\npostorder 42"

test duplicates_ignored =
  solve("2 2 2 2") ==
  "size 1\nheight 1\ninorder 2\npreorder 2\npostorder 2"

test mixed_whitespace =
  solve("  1\t2\n\n 3  ") ==
  "size 3\nheight 3\ninorder 1 2 3\npreorder 1 2 3\npostorder 3 2 1"

test negatives =
  solve("-5 5 -3") ==
  "size 3\nheight 3\ninorder -5 -3 5\npreorder -5 5 -3\npostorder -3 5 -5"

test balanced_height =
  solve("4 2 6 1 3 5 7") ==
  "size 7\nheight 3\ninorder 1 2 3 4 5 6 7\npreorder 4 2 1 3 6 5 7\npostorder 1 3 2 5 7 6 4"

test duplicates_deep =
  solve("5 3 8 1 4 9 3 5 8") ==
  "size 6\nheight 3\ninorder 1 3 4 5 8 9\npreorder 5 3 1 4 8 9\npostorder 1 4 3 9 8 5"
