# Base conversion: <from> <to> <number> with single spaces, bases 2..36.
# Prints the number re-rendered in base `to`, or "error" for malformed input.

# Value of a single digit character (0..35), or -1 when it is not a digit.
fn digit_value(c: Str) -> Int =
  if len(c) != 1 then -1
  else if char_code(to_lower(c)) >= 48 && char_code(to_lower(c)) <= 57 then char_code(to_lower(c)) - 48
  else if char_code(to_lower(c)) >= 97 && char_code(to_lower(c)) <= 122 then char_code(to_lower(c)) - 87
  else -1

# Lowercase digit character for a value 0..35.
fn digit_char(v: Int) -> Str =
  if v >= 0 && v < 10 then from_char_code(48 + v)
  else if v >= 10 && v <= 35 then from_char_code(87 + v)
  else "0"

# True when every character of s is a decimal digit (also true for "").
fn is_digits(s: Str) -> Bool =
  fold(chars(s), true, fn(acc: Bool, c: Str) => acc && char_code(c) >= 48 && char_code(c) <= 57)

# Parse a base written in plain decimal digits, in range 2..36.
fn base_of(s: Str) -> Option[Int] =
  if !is_digits(s) then None
  else match to_int(s) {
    None => None,
    Some(n) => if n >= 2 && n <= 36 then Some(n) else None
  }

# One parsing step: acc * base + digit, rejecting bad digits and keeping
# the magnitude bounded by 10^15 (the task limit) so nothing overflows.
fn combine(acc: Int, c: Str, base: Int) -> Option[Int] req acc >= 0 && acc <= 1000000000000000 && base >= 2 && base <= 36 =
  if digit_value(c) < 0 || digit_value(c) >= base then None
  else if acc > (1000000000000000 - digit_value(c)) / base then None
  else Some(acc * base + digit_value(c))

# Parse a non-empty digit string (no sign) in the given base.
fn parse_chars(cs: List[Str], base: Int) -> Option[Int] req base >= 2 && base <= 36 =
  fold(cs, Some(0), fn(acc: Option[Int], c: Str) => match acc {
    None => None,
    Some(v) => combine(v, c, base)
  })

# Parse an optionally negative number written in the given base.
fn parse_num(s: Str, base: Int) -> Option[Int] req base >= 2 && base <= 36 =
  if len(s) == 0 then None
  else if slice(s, 0, 1) == "-" then
    if len(s) == 1 then None
    else match parse_chars(chars(slice(s, 1, len(s))), base) {
      None => None,
      Some(v) => Some(-v)
    }
  else parse_chars(chars(s), base)

# Render the positive magnitude n in the given base into acc.
fn render(n: Int, base: Int, acc: Accum[Str]) -> Str =
  if base < 2 || n <= 0 then join(reverse(acc_list(acc)), "")
  else render(n / base, base, AccPush(acc, digit_char(n % base)))

# Render a value in the given base with a leading minus for negatives.
fn format_num(v: Int, to: Int) -> Str =
  if v == 0 then "0"
  else if v < 0 then "-" ++ render(-v, to, AccEnd)
  else render(v, to, AccEnd)

# Convert one complete request line.
fn convert(fs: Str, ts: Str, ns: Str) -> Str =
  match base_of(fs) {
    None => "error",
    Some(b1) => match base_of(ts) {
      None => "error",
      Some(b2) => match parse_num(ns, b1) {
        None => "error",
        Some(v) => format_num(v, b2)
      }
    }
  }

# Split a line into its three single-space separated fields and convert it.
fn convert_line(line: Str) -> Str =
  let p = split(line, " ") in
  if len(p) != 3 then "error"
  else match get(p, 0) {
    None => "error",
    Some(fs) => match get(p, 1) {
      None => "error",
      Some(ts) => match get(p, 2) {
        None => "error",
        Some(ns) => convert(fs, ts, ns)
      }
    }
  }

# Read and answer every input line until end of input.
fn process_lines() -> Unit !io =
  match read_line() {
    None => (),
    Some(line) => { print(convert_line(line)); process_lines() }
  }

fn main(args: List[Str]) -> Int !io = { process_lines(); 0 }

test example_line_1 = convert_line("10 2 10") == "1010"
test example_line_2 = convert_line("16 10 ff") == "255"
test example_line_3 = convert_line("2 16 -1010") == "-a"
test example_line_4 = convert_line("10 37 5") == "error"
test zero = convert_line("10 2 0") == "0"
test negative_zero = convert_line("10 2 -0") == "0"
test uppercase_digits = convert_line("16 10 FF") == "255"
test uppercase_target = convert_line("10 16 255") == "ff"
test digit_out_of_range = convert_line("2 10 102") == "error"
test letter_out_of_range = convert_line("16 10 g") == "error"
test no_digits = convert_line("10 2 -") == "error"
test base_too_small = convert_line("1 10 5") == "error"
test base_too_big = convert_line("10 36 1295") == "zz"
test base_36 = convert_line("36 10 zz") == "1295"
test double_space = convert_line("10  2 10") == "error"
test trailing_space = convert_line("10 2 10 ") == "error"
test too_few_fields = convert_line("10 2") == "error"
test extra_field = convert_line("10 2 10 x") == "error"
test empty_line = convert_line("") == "error"
test plus_sign = convert_line("10 2 +10") == "error"
test leading_zeros = convert_line("10 2 0010") == "1010"
test big_binary = convert_line("10 2 1000000000000000") == "11100011010111111010100100110001101000000000000000"
test big_hex = convert_line("10 16 1000000000000000") == "38d7ea4c68000"
test big_base36 = convert_line("10 36 1000000000000000") == "9ugxnorjls"
test roundtrip_negative = convert_line("16 2 -38d7ea4c68000") == "-11100011010111111010100100110001101000000000000000"
