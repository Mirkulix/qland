{
  "name": "p04_insufficient_stock_rollback",
  "description": "Order requiring more stock than available fails with 409 and rolls back completely",
  "steps": [
    {
      "name": "create p1",
      "request": {"method": "POST", "path": "/products", "json": {"sku": "LIMIT-1", "name": "Laptop", "price_cents": 100000, "stock": 2}},
      "expect": {"status": 201},
      "capture": {"p1": "/id"}
    },
    {
      "name": "try order exceeding stock",
      "request": {
        "method": "POST",
        "path": "/orders",
        "json": {
          "lines": [
            {"product_id": "{{p1}}", "qty": 5}
          ]
        }
      },
      "expect": {
        "status": 409,
        "json": {
          "error": {
            "code": "insufficient_stock",
            "message": {"$type": "str"}
          }
        }
      }
    },
    {
      "name": "verify stock untouched",
      "request": {"method": "GET", "path": "/products/{{p1}}"},
      "expect": {
        "status": 200,
        "json": {"id": {"$var": "p1"}, "sku": "LIMIT-1", "name": "Laptop", "price_cents": 100000, "stock": 2}
      }
    }
  ]
}
