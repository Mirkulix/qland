{
  "name": "p03_orders_flow",
  "description": "Order creation, stock reduction, order inspection, cancellation and stock restoration",
  "steps": [
    {
      "name": "create p1",
      "request": {"method": "POST", "path": "/products", "json": {"sku": "P1", "name": "Phone", "price_cents": 50000, "stock": 10}},
      "expect": {"status": 201},
      "capture": {"p1": "/id"}
    },
    {
      "name": "create p2",
      "request": {"method": "POST", "path": "/products", "json": {"sku": "P2", "name": "Case", "price_cents": 2000, "stock": 20}},
      "expect": {"status": 201},
      "capture": {"p2": "/id"}
    },
    {
      "name": "create order",
      "request": {
        "method": "POST",
        "path": "/orders",
        "json": {
          "lines": [
            {"product_id": "{{p1}}", "qty": 1},
            {"product_id": "{{p2}}", "qty": 2}
          ]
        }
      },
      "expect": {
        "status": 201,
        "headers": {"location": "/orders/{{o}}", "content-type": "application/json"},
        "json": {
          "id": {"$var": "o"},
          "status": "confirmed",
          "created_at": {"$type": "int"},
          "total_cents": 54000,
          "lines": [
            {"id": {"$type": "int"}, "product_id": {"$var": "p1"}, "qty": 1, "unit_price_cents": 50000},
            {"id": {"$type": "int"}, "product_id": {"$var": "p2"}, "qty": 2, "unit_price_cents": 2000}
          ]
        }
      },
      "capture": {"o": "/id"}
    },
    {
      "name": "verify stock decreased p1",
      "request": {"method": "GET", "path": "/products/{{p1}}"},
      "expect": {"status": 200, "json": {"id": {"$var": "p1"}, "sku": "P1", "name": "Phone", "price_cents": 50000, "stock": 9}}
    },
    {
      "name": "verify stock decreased p2",
      "request": {"method": "GET", "path": "/products/{{p2}}"},
      "expect": {"status": 200, "json": {"id": {"$var": "p2"}, "sku": "P2", "name": "Case", "price_cents": 2000, "stock": 18}}
    },
    {
      "name": "get order",
      "request": {"method": "GET", "path": "/orders/{{o}}"},
      "expect": {
        "status": 200,
        "json": {
          "id": {"$var": "o"},
          "status": "confirmed",
          "created_at": {"$type": "int"},
          "total_cents": 54000,
          "lines": [
            {"id": {"$type": "int"}, "product_id": {"$var": "p1"}, "qty": 1, "unit_price_cents": 50000},
            {"id": {"$type": "int"}, "product_id": {"$var": "p2"}, "qty": 2, "unit_price_cents": 2000}
          ]
        }
      }
    },
    {
      "name": "cancel order",
      "request": {"method": "POST", "path": "/orders/{{o}}/cancel"},
      "expect": {
        "status": 200,
        "json": {"id": {"$var": "o"}, "status": "cancelled"}
      }
    },
    {
      "name": "verify stock restored p1",
      "request": {"method": "GET", "path": "/products/{{p1}}"},
      "expect": {"status": 200, "json": {"id": {"$var": "p1"}, "sku": "P1", "name": "Phone", "price_cents": 50000, "stock": 10}}
    },
    {
      "name": "verify stock restored p2",
      "request": {"method": "GET", "path": "/products/{{p2}}"},
      "expect": {"status": 200, "json": {"id": {"$var": "p2"}, "sku": "P2", "name": "Case", "price_cents": 2000, "stock": 20}}
    }
  ]
}
