{
 "name": "h06_list_order_by_id",
 "description": "order by id, not title",
 "steps": [
  {
   "name": "create a",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "zebra"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "zebra",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{a}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "a": "/id"
   }
  },
  {
   "name": "create b",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "apple"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "b"
     },
     "title": "apple",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{b}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "b": "/id"
   }
  },
  {
   "name": "create c",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "mango"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "c"
     },
     "title": "mango",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{c}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "c": "/id"
   }
  },
  {
   "name": "list",
   "request": {
    "method": "GET",
    "path": "/todos"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "a"
      },
      "title": "zebra",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     },
     {
      "id": {
       "$var": "b"
      },
      "title": "apple",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     },
     {
      "id": {
       "$var": "c"
      },
      "title": "mango",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ]
}
