{
 "name": "h08_filter_invalid_values",
 "description": "other done values are 400",
 "steps": [
  {
   "name": "create a",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "x"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "x",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{a}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "a": "/id"
   }
  },
  {
   "name": "done='done=yes'",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done=yes"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_query",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "done='done=1'",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done=1"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_query",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "done='done=0'",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done=0"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_query",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "done='done='",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done="
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_query",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "done='done=TRUE'",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done=TRUE"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_query",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "done='done=False'",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done=False"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_query",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "done='done=true%20'",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done=true%20"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_query",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "done='done'",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_query",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "still listed",
   "request": {
    "method": "GET",
    "path": "/todos"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "a"
      },
      "title": "x",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ]
}
