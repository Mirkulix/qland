{
 "name": "h09_other_query_ignored",
 "description": "unknown query parameters are ignored",
 "steps": [
  {
   "name": "create a",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "x"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "x",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{a}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "a": "/id"
   }
  },
  {
   "name": "create b",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "y",
     "done": true
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "b"
     },
     "title": "y",
     "done": true,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{b}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "b": "/id"
   }
  },
  {
   "name": "list",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "sort=title"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "a"
      },
      "title": "x",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     },
     {
      "id": {
       "$var": "b"
      },
      "title": "y",
      "done": true,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "list",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "page=2&done=true"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "b"
      },
      "title": "y",
      "done": true,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "first done wins",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done=false&done=true"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "a"
      },
      "title": "x",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "query is percent-decoded",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "d%6Fne=tru%65"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "b"
      },
      "title": "y",
      "done": true,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ]
}
