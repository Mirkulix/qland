{
 "name": "h23_created_at_int_and_stable",
 "description": "created_at is an Int and never changes",
 "steps": [
  {
   "name": "create a",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "x"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "x",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{a}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "a": "/id",
    "ca": "/created_at"
   }
  },
  {
   "name": "rename",
   "request": {
    "method": "PATCH",
    "path": "/todos/{{a}}",
    "json": {
     "title": "y"
    }
   },
   "expect": {
    "status": 200,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "y",
     "done": false,
     "created_at": {
      "$var": "ca"
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "done",
   "request": {
    "method": "PATCH",
    "path": "/todos/{{a}}",
    "json": {
     "done": true
    }
   },
   "expect": {
    "status": 200,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "y",
     "done": true,
     "created_at": {
      "$var": "ca"
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "get a",
   "request": {
    "method": "GET",
    "path": "/todos/{{a}}"
   },
   "expect": {
    "status": 200,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "y",
     "done": true,
     "created_at": {
      "$var": "ca"
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "list",
   "request": {
    "method": "GET",
    "path": "/todos"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "a"
      },
      "title": "y",
      "done": true,
      "created_at": {
       "$var": "ca"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ]
}
