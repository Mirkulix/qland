{
 "name": "h24_invalid_ids_get",
 "description": "non-positive / non-numeric ids on GET",
 "steps": [
  {
   "name": "create a",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "x"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "x",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{a}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "a": "/id"
   }
  },
  {
   "name": "GET /todos/abc",
   "request": {
    "method": "GET",
    "path": "/todos/abc"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "GET /todos/0",
   "request": {
    "method": "GET",
    "path": "/todos/0"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "GET /todos/-1",
   "request": {
    "method": "GET",
    "path": "/todos/-1"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "GET /todos/1.5",
   "request": {
    "method": "GET",
    "path": "/todos/1.5"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "GET /todos/+5",
   "request": {
    "method": "GET",
    "path": "/todos/+5"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "GET /todos/1e3",
   "request": {
    "method": "GET",
    "path": "/todos/1e3"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "GET /todos/99999999999999999999",
   "request": {
    "method": "GET",
    "path": "/todos/99999999999999999999"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "GET /todos/%20",
   "request": {
    "method": "GET",
    "path": "/todos/%20"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "GET /todos/1%2F2",
   "request": {
    "method": "GET",
    "path": "/todos/1%2F2"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "GET /todos/%2531",
   "request": {
    "method": "GET",
    "path": "/todos/%2531"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "trailing slash is an empty id",
   "request": {
    "method": "GET",
    "path": "/todos/"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_id",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ]
}
