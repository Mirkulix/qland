{
 "name": "h29_unknown_paths",
 "description": "unknown paths are 404 for every method",
 "steps": [
  {
   "name": "root",
   "request": {
    "method": "GET",
    "path": "/"
   },
   "expect": {
    "status": 404,
    "json": {
     "error": {
      "code": "not_found",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "singular",
   "request": {
    "method": "GET",
