{
 "name": "h34_patch_both",
 "description": "PATCH both fields",
 "steps": [
  {
   "name": "create a",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "x"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "x",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{a}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "a": "/id"
   }
  },
  {
   "name": "create b",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "other"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "b"
     },
     "title": "other",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{b}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "b": "/id"
   }
  },
  {
   "name": "both",
   "request": {
    "method": "PATCH",
    "path": "/todos/{{a}}",
    "json": {
     "done": true,
     "title": "  new  "
    }
   },
   "expect": {
    "status": 200,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "new",
     "done": true,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "only a changed",
   "request": {
    "method": "GET",
    "path": "/todos"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "a"
      },
      "title": "new",
      "done": true,
      "created_at": {
       "$type": "int"
      }
     },
     {
      "id": {
       "$var": "b"
      },
      "title": "other",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ]
}
