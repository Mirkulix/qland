{
 "name": "h38_patch_wrong_types",
 "description": "wrong types in PATCH",
 "steps": [
  {
   "name": "create a",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "orig"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "orig",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{a}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "a": "/id"
   }
  },
  {
   "name": "title int",
   "request": {
    "method": "PATCH",
    "path": "/todos/{{a}}",
    "json": {
     "title": 1
    }
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_type",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "title null",
   "request": {
    "method": "PATCH",
    "path": "/todos/{{a}}",
    "json": {
     "title": null
    }
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_type",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "done null",
   "request": {
    "method": "PATCH",
    "path": "/todos/{{a}}",
    "json": {
     "done": null
    }
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_type",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "done string",
   "request": {
    "method": "PATCH",
    "path": "/todos/{{a}}",
    "json": {
     "done": "false"
    }
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_type",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "get a",
   "request": {
    "method": "GET",
    "path": "/todos/{{a}}"
   },
   "expect": {
    "status": 200,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "orig",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ]
}
