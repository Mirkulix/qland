{
 "name": "h41_delete_middle",
 "description": "delete keeps the others in order",
 "steps": [
  {
   "name": "create a",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "one"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "one",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{a}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "a": "/id"
   }
  },
  {
   "name": "create b",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "two"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "b"
     },
     "title": "two",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{b}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "b": "/id"
   }
  },
  {
   "name": "create c",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "three"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "c"
     },
     "title": "three",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{c}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "c": "/id"
   }
  },
  {
   "name": "delete b",
   "request": {
    "method": "DELETE",
    "path": "/todos/{{b}}"
   },
   "expect": {
    "status": 204,
    "body": ""
   }
  },
  {
   "name": "list",
   "request": {
    "method": "GET",
    "path": "/todos"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "a"
      },
      "title": "one",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     },
     {
      "id": {
       "$var": "c"
      },
      "title": "three",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "get b",
   "request": {
    "method": "GET",
    "path": "/todos/{{b}}"
   },
   "expect": {
    "status": 404,
    "json": {
     "error": {
      "code": "not_found",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "patch b",
   "request": {
    "method": "PATCH",
    "path": "/todos/{{b}}",
    "json": {
     "done": true
    }
   },
   "expect": {
    "status": 404,
    "json": {
     "error": {
      "code": "not_found",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "delete b again",
   "request": {
    "method": "DELETE",
    "path": "/todos/{{b}}"
   },
   "expect": {
    "status": 404,
    "json": {
     "error": {
      "code": "not_found",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "delete with a body is fine",
   "request": {
    "method": "DELETE",
    "path": "/todos/{{a}}",
    "body": "ignored"
   },
   "expect": {
    "status": 204,
    "body": ""
   }
  },
  {
   "name": "only c left",
   "request": {
    "method": "GET",
    "path": "/todos"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "c"
      },
      "title": "three",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ]
}
