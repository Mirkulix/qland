{
 "name": "p03_list_and_filter",
 "description": "list in id order and ?done filter",
 "steps": [
  {
   "name": "create a",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "one"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "one",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{a}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "a": "/id"
   }
  },
  {
   "name": "create b",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "two",
     "done": true
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "b"
     },
     "title": "two",
     "done": true,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{b}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "b": "/id"
   }
  },
  {
   "name": "create c",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "three"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "c"
     },
     "title": "three",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{c}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "c": "/id"
   }
  },
  {
   "name": "list",
   "request": {
    "method": "GET",
    "path": "/todos"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "a"
      },
      "title": "one",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     },
     {
      "id": {
       "$var": "b"
      },
      "title": "two",
      "done": true,
      "created_at": {
       "$type": "int"
      }
     },
     {
      "id": {
       "$var": "c"
      },
      "title": "three",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "only done",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done=true"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "b"
      },
      "title": "two",
      "done": true,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "only open",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done=false"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "id": {
       "$var": "a"
      },
      "title": "one",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     },
     {
      "id": {
       "$var": "c"
      },
      "title": "three",
      "done": false,
      "created_at": {
       "$type": "int"
      }
     }
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "bad filter",
   "request": {
    "method": "GET",
    "path": "/todos",
    "query": "done=maybe"
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_query",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ]
}
