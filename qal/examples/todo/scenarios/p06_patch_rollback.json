{
 "name": "p06_patch_rollback",
 "description": "an invalid PATCH changes nothing",
 "steps": [
  {
   "name": "create a",
   "request": {
    "method": "POST",
    "path": "/todos",
    "json": {
     "title": "keep me"
    }
   },
   "expect": {
    "status": 201,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "keep me",
     "done": false,
     "created_at": {
      "$type": "int"
     }
    },
    "headers": {
     "location": "/todos/{{a}}",
     "content-type": "application/json"
    }
   },
   "capture": {
    "a": "/id",
    "ca": "/created_at"
   }
  },
  {
   "name": "valid title, bad done",
   "request": {
    "method": "PATCH",
    "path": "/todos/{{a}}",
    "json": {
     "title": "changed",
     "done": "yes"
    }
   },
   "expect": {
    "status": 400,
    "json": {
     "error": {
      "code": "invalid_type",
      "message": {
       "$type": "str"
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "unchanged",
   "request": {
    "method": "GET",
    "path": "/todos/{{a}}"
   },
   "expect": {
    "status": 200,
    "json": {
     "id": {
      "$var": "a"
     },
     "title": "keep me",
     "done": false,
     "created_at": {
      "$var": "ca"
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ]
}
