type Endpoint = Health | ListTodos | CreateTodo | GetTodo | PatchTodo | DeleteTodo

type TodoIn = { title: Option[Str], done: Option[Bool] }

fn bad(code: Str, msg: Str) -> HttpResponse
= std.http.error(400, code, msg)

fn bad_len(t: Option[Str]) -> Bool
= match t { None => false, Some(s) => len(s) < 1 || len(s) > 200 }

fn bool_param(o: Option[Bool]) -> SqlValue
= match o { Some(b) => SqlInt(if b then 1 else 0), None => SqlNull }

fn db_fail() -> HttpResponse
= std.http.error(500, "db_error", "database error")

fn done_of(j: Option[std.json.Json]) -> Option[Bool]
= match j { None => None, Some(v) => std.json.as_bool(v) }

fn is_digit(c: Str) -> Bool
= len(c) == 1 && char_code(c) >= 48 && char_code(c) <= 57

fn is_none_bool(t: Option[Bool]) -> Bool
= match t { None => true, Some(_) => false }

fn is_none_str(t: Option[Str]) -> Bool
= match t { None => true, Some(_) => false }

fn is_unknown(f: std.json.Field) -> Bool
= f.key != "title" && f.key != "done"

fn opt_bool(o: Option[Bool]) -> Bool
= match o { Some(b) => b, None => false }

fn opt_int(o: Option[Int]) -> Int
= match o { Some(n) => n, None => 0 }

fn opt_str(o: Option[Str]) -> Str
= match o { Some(s) => s, None => "" }

fn setup() -> Result[Unit, Str] !db
= match db_exec("CREATE TABLE IF NOT EXISTS todos (id INTEGER PRIMARY KEY, title TEXT NOT NULL, done INTEGER NOT NULL DEFAULT 0 CHECK (done IN (0,1)), created_at INTEGER NOT NULL)", []) { Ok(_) => Ok(()), Err(_) => Err("cannot create schema") }

fn text_param(o: Option[Str]) -> SqlValue
= match o { Some(s) => SqlText(s), None => SqlNull }

fn title_of(j: Option[std.json.Json]) -> Option[Str]
= match j { None => None, Some(v) => match std.json.as_str(v) { None => None, Some(s) => Some(trim(s)) } }

fn wrong_bool(j: Option[std.json.Json]) -> Bool
= match j { None => false, Some(v) => match std.json.as_bool(v) { None => true, Some(_) => false } }

fn wrong_str(j: Option[std.json.Json]) -> Bool
= match j { None => false, Some(v) => match std.json.as_str(v) { None => true, Some(_) => false } }

fn check_body(j: std.json.Json, need_title: Bool) -> Result[TodoIn, HttpResponse]
= match std.json.as_obj(j) { None => Err(bad("invalid_type", "body must be a JSON object")), Some(fs) => if len(filter(fs, fn(f) => is_unknown(f))) > 0 then Err(bad("unknown_field", "unknown field")) else let tj = std.json.get(j, "title") in let dj = std.json.get(j, "done") in if wrong_str(tj) || wrong_bool(dj) then Err(bad("invalid_type", "wrong field type")) else let t = title_of(tj) in let d = done_of(dj) in if bad_len(t) then Err(bad("invalid_value", "title must have 1 to 200 characters")) else if need_title && is_none_str(t) || is_none_str(t) && is_none_bool(d) then Err(bad("missing_field", "missing field")) else Ok(TodoIn { title: t, done: d }) }

fn delete_todo(id: Int) -> HttpResponse !db
= match db_exec("DELETE FROM todos WHERE id = ?", [SqlInt(id)]) { Err(_) => db_fail(), Ok(n) => if n == 0 then std.http.not_found() else HttpResponse { status: 204, headers: [], body: "" } }

fn invalid_id() -> HttpResponse
= bad("invalid_id", "invalid id")

fn parse_id(s: Str) -> Option[Int]
= if len(s) == 0 then None else if len(filter(chars(s), fn(c) => !is_digit(c))) > 0 then None else match to_int(s) { Some(n) => if n >= 1 then Some(n) else None, None => None }

fn routes() -> List[std.route.Route[Endpoint]]
= [std.route.Route { method: "GET", pattern: "/health", tag: Health }, std.route.Route { method: "GET", pattern: "/todos", tag: ListTodos }, std.route.Route { method: "POST", pattern: "/todos", tag: CreateTodo }, std.route.Route { method: "GET", pattern: "/todos/:id", tag: GetTodo }, std.route.Route { method: "PATCH", pattern: "/todos/:id", tag: PatchTodo }, std.route.Route { method: "DELETE", pattern: "/todos/:id", tag: DeleteTodo }]

fn todo_json(row: List[SqlValue]) -> std.json.Json
= std.json.obj([std.json.field("id", std.json.int(opt_int(std.db.int(row, 0)))), std.json.field("title", std.json.str(opt_str(std.db.text(row, 1)))), std.json.field("done", std.json.bool(opt_bool(std.db.bool(row, 2)))), std.json.field("created_at", std.json.int(opt_int(std.db.int(row, 3))))])

fn first_row_resp(rows: DbRows, status: Int) -> HttpResponse
= match std.db.first(rows) { Some(r) => std.http.json(status, todo_json(r)), None => std.http.not_found() }

fn id_of(ps: List[std.url.Param]) -> Option[Int]
= parse_id(opt_str(std.route.param(ps, "id")))

fn read_body(rq: HttpRequest, need_title: Bool) -> Result[TodoIn, HttpResponse]
= match std.http.json_body(rq) { Err(resp) => Err(resp), Ok(j) => check_body(j, need_title) }

fn rows_json(rows: DbRows) -> std.json.Json
= std.json.arr(map(rows.rows, fn(r) => todo_json(r)))

test t_body_201 = match std.json.parse("{\"title\":\"" ++ join(map(range(0, 201), fn(i) => "x"), "") ++ "\"}") { Ok(j) => match check_body(j, true) { Err(r) => contains(r.body, "invalid_value"), Ok(_) => false }, Err(_) => false }

test t_body_missing = match check_body(std.json.Obj([]), false) { Err(r) => contains(r.body, "missing_field"), Ok(_) => false }

test t_body_missing_post = match check_body(std.json.Obj([std.json.field("done", std.json.bool(true))]), true) { Err(r) => contains(r.body, "missing_field"), Ok(_) => false }

test t_body_notobj = match check_body(std.json.Arr([]), true) { Err(r) => contains(r.body, "invalid_type"), Ok(_) => false }

test t_body_ok = match check_body(std.json.Obj([std.json.field("title", std.json.str("  hi  "))]), true) { Ok(i) => i.title == Some("hi") && i.done == None, Err(_) => false }

test t_body_type = match check_body(std.json.Obj([std.json.field("done", std.json.Null)]), false) { Err(r) => contains(r.body, "invalid_type"), Ok(_) => false }

test t_body_unknown = match check_body(std.json.Obj([std.json.field("title", std.json.int(1)), std.json.field("id", std.json.int(1))]), true) { Err(r) => r.status == 400 && contains(r.body, "unknown_field"), Ok(_) => false }

test t_body_value = match check_body(std.json.Obj([std.json.field("title", std.json.str("   "))]), true) { Err(r) => contains(r.body, "invalid_value"), Ok(_) => false }

test t_id_bad = parse_id("") == None && parse_id("0") == None && parse_id("-1") == None && parse_id("+5") == None && parse_id("1.5") == None && parse_id("99999999999999999999") == None && parse_id(" ") == None && parse_id("abc") == None

test t_id_ok = parse_id("001") == Some(1) && parse_id("%31") == None && parse_id("42") == Some(42)

test t_json_order = std.json.print(todo_json([SqlInt(3), SqlText("a"), SqlInt(1), SqlInt(77)])) == "{\"id\":3,\"title\":\"a\",\"done\":true,\"created_at\":77}"

test t_route_404 = match std.route.route(routes(), "GET", "/todos/1/") { std.route.NotFound => true, _ => false }

test t_route_405 = match std.route.route(routes(), "PUT", "/todos") { std.route.MethodNotAllowed(ms) => ms == ["GET", "HEAD", "POST"], _ => false }

test t_route_empty_id = match std.route.route(routes(), "GET", "/todos/") { std.route.Matched(GetTodo, ps) => std.route.param(ps, "id") == Some(""), _ => false }

test t_route_health = match std.route.route(routes(), "GET", "/health") { std.route.Matched(Health, _) => true, _ => false }

fn create_todo(rq: HttpRequest) -> HttpResponse !db !time
= match read_body(rq, true) { Err(resp) => resp, Ok(inp) => match db_query("INSERT INTO todos (title, done, created_at) VALUES (?, ?, ?) RETURNING id, title, done, created_at", [SqlText(opt_str(inp.title)), SqlInt(if opt_bool(inp.done) then 1 else 0), SqlInt(now_ms())]) { Err(_) => db_fail(), Ok(rows) => match std.db.first(rows) { None => db_fail(), Some(r) => std.http.with_header(std.http.json(201, todo_json(r)), "location", "/todos/" ++ from_int(opt_int(std.db.int(r, 0)))) } } }

fn get_todo(id: Int) -> HttpResponse !db
= match db_query("SELECT id, title, done, created_at FROM todos WHERE id = ?", [SqlInt(id)]) { Err(_) => db_fail(), Ok(rows) => first_row_resp(rows, 200) }

fn list_todos(rq: HttpRequest) -> HttpResponse !db
= match std.url.param(std.http.query(rq), "done") { None => match db_query("SELECT id, title, done, created_at FROM todos ORDER BY id", []) { Ok(rows) => std.http.json(200, rows_json(rows)), Err(_) => db_fail() }, Some("true") => match db_query("SELECT id, title, done, created_at FROM todos WHERE done = ? ORDER BY id", [SqlInt(1)]) { Ok(rows) => std.http.json(200, rows_json(rows)), Err(_) => db_fail() }, Some("false") => match db_query("SELECT id, title, done, created_at FROM todos WHERE done = ? ORDER BY id", [SqlInt(0)]) { Ok(rows) => std.http.json(200, rows_json(rows)), Err(_) => db_fail() }, Some(_) => bad("invalid_query", "done must be true or false") }

fn patch_todo(id: Int, rq: HttpRequest) -> HttpResponse !db
= match read_body(rq, false) { Err(resp) => resp, Ok(inp) => match db_query("UPDATE todos SET title = COALESCE(?, title), done = COALESCE(?, done) WHERE id = ? RETURNING id, title, done, created_at", [text_param(inp.title), bool_param(inp.done), SqlInt(id)]) { Err(_) => db_fail(), Ok(rows) => first_row_resp(rows, 200) } }

fn dispatch(tag: Endpoint, ps: List[std.url.Param], rq: HttpRequest) -> HttpResponse !db !time
= match tag { Health => std.http.json(200, std.json.obj([std.json.field("ok", std.json.bool(true))])), ListTodos => list_todos(rq), CreateTodo => create_todo(rq), GetTodo => match id_of(ps) { None => invalid_id(), Some(id) => get_todo(id) }, PatchTodo => match id_of(ps) { None => invalid_id(), Some(id) => patch_todo(id, rq) }, DeleteTodo => match id_of(ps) { None => invalid_id(), Some(id) => delete_todo(id) } }

fn handle(rq: HttpRequest) -> HttpResponse !db !time
= match std.route.route(routes(), rq.method, rq.path) { std.route.Matched(tag, ps) => dispatch(tag, ps, rq), std.route.NotFound => std.http.not_found(), std.route.MethodNotAllowed(ms) => std.http.method_not_allowed(ms) }
