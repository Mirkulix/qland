# qal-pkg 1
# package qal_sim_cluster 446b92bfbb9fa877b4785ce9418de13ffb0557d1db2467894ec382cee1f80ba5
# def Ballot 6b63095041055248f130e9396d3644d461b8527dbbe934bdb8cccb532b28bbcb cli
# def ClusterState 75516e3a7f148422bba0f53e14dc24bdc946448facced85992a229afb7957c7e cli
# def Heartbeat 0f543b33e3692fb2d3347b3d11df2bad57f993dfb56c4d1a1ad3875bf521202c cli
# def NodeState 2e880b475c42310282ed27ac8f1bac53a30d737356b3b25ecff976aa60d92ef3 cli
# def expired ee7ac8a2d50f6ccf85dd892fff2eac80c2430d5ad6dc9c48057feb1d03ecf4b1 cli
# def has_vote 6c6d26706d73a33c0ca81688c535a82fafac43a2790eacbfc6ea545b990874ac cli
# def heartbeat_keeps_follower be0ff66007eb3ff14ba70ff41dcb023da32f0183ff6c97ba2cff225419b121bc cli
# def leader d8a07743d9693fee434ce8e313be7ca4f60011e02fb5b6e0ce43d9970c2776b8 cli
# def on_heartbeat 20dae5a18f91e2765addaa1dca899e8399947f8bfb6320bbfa989fc05bab35f2 cli
# def on_timeout e2e1b9eeec66aa1d6c9f2d157e407117319d859571e54623683572f8d0566d64 cli
# def tick 47aeef2ce1cddb4136aa7d283fa1660c14a7315a29ef85ac6bd02f3b073c36ee cli
# def timeout_elects_single_node f992688e9135498a1e5f6fc3dc3425ba3018951fa4f5e388ad34539f4f905a37 cli
# def vote 7bacc8dd0887684d0b65fa8337b3ff7715cf6636bd795e9f8743d8415925fa03 cli
# def won c5209a8ae98697ddb9a1de2af65434ce23732f9ae9b72c0c44a6ef3504585547 cli

type Ballot = { term: Int, candidate: Int, votes: List[Int], cluster: Int }

type Heartbeat = { leader: Int, term: Int, at: Int }

type NodeState = { id: Int, role: Str, term: Int, last_heartbeat: Int, leader: Int }

fn has_vote(votes: List[Int], node: Int) -> Bool
= len(filter(votes, fn(v) => v == node)) > 0

type ClusterState = { node: NodeState, ballot: Ballot }

fn expired(s: NodeState, now: Int, timeout: Int) -> Bool
  req now >= 0 && now <= 1000000000 && timeout > 0
= now - s.last_heartbeat >= timeout

fn on_heartbeat(s: NodeState, h: Heartbeat) -> NodeState
  req h.term >= 0
= if h.term < s.term then s else NodeState { id: s.id, role: "follower", term: h.term, last_heartbeat: h.at, leader: h.leader }

fn vote(b: Ballot, node: Int) -> Ballot
= if has_vote(b.votes, node) then b else Ballot { term: b.term, candidate: b.candidate, votes: push(b.votes, node), cluster: b.cluster }

fn won(b: Ballot) -> Bool
= len(b.votes) * 2 > b.cluster

fn leader(b: Ballot) -> Option[Int]
= if won(b) then Some(b.candidate) else None

fn on_timeout(s: NodeState, now: Int, timeout: Int) -> NodeState
  req now >= 0 && now <= 1000000000 && timeout > 0
= if expired(s, now, timeout) then NodeState { id: s.id, role: "candidate", term: s.term + 1, last_heartbeat: s.last_heartbeat, leader: -1 } else s

fn tick(c: ClusterState, hb: Heartbeat, now: Int, timeout: Int) -> ClusterState
  req now >= 0 && now <= 1000000000 && timeout > 0 && hb.term >= 0
= let s = on_timeout(on_heartbeat(c.node, hb), now, timeout) in if s.role == "candidate" then let b = vote(Ballot { term: s.term, candidate: s.id, votes: [], cluster: 1 }, s.id) in ClusterState { node: s, ballot: b } else ClusterState { node: s, ballot: c.ballot }

test heartbeat_keeps_follower = tick(ClusterState { node: NodeState { id: 0, role: "follower", term: 1, last_heartbeat: 0, leader: 1 }, ballot: Ballot { term: 1, candidate: 1, votes: [], cluster: 1 } }, Heartbeat { leader: 1, term: 1, at: 20 }, 20, 50).node.role == "follower"

test timeout_elects_single_node = match leader(tick(ClusterState { node: NodeState { id: 0, role: "follower", term: 1, last_heartbeat: 0, leader: 1 }, ballot: Ballot { term: 1, candidate: 1, votes: [], cluster: 1 } }, Heartbeat { leader: 1, term: 1, at: 0 }, 100, 50).ballot) { Some(0) => true, _ => false }
