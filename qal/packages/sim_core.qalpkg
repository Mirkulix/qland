# def Agent 9158543700f0201c37dd1e1e1bdf48a08796e644a52a4c71c6c6df429e7027c5 cli
# def Sim 1f9ee963b95b240936870d6c309da70aa550e6f8981e7dfc483a83277c98206c cli
# def add_agent 1bc02f942d5876cfbb64841151bb282975c455066b2c102d562cfaddc123c4f9 cli
# def add_cash 31c6855750e0302ea61b04a324c078672672a44fb0f1f5074fc0b85d0192f9af cli
# def init 83116c416a12272d456c565b04bc4df932c13a54459de5293b163058599190e7 cli
# def self_transfer_is_noop 28ba4dc8c0f325fbed66a0794ff491cef2c784790c442bb5df4d31c2875c201b cli
# def step 3211607556aab9adb98dcdf9051f875f0defc8065ea1a97a52333cab5c1ae586 cli
# def total 6139c8e991584e7f7955a8b93c7829b4ad101f1b40cc040b9cf4cb53136f8362 cli
# def transfer 01cc95d5a5083c9ff96eacc7a746243dd95e842b10a53d00d8b19e6fc5cb1724 cli
# def transfer_conserves 21487af27616262c119447930b3203fdb8457129d30210eb9316f683e6d0fc47 cli

type Agent = { cash: Int }

type Sim = { agents: Map[Int, Agent], tick: Int }

fn add_agent(m: Map[Int, Agent], i: Int) -> Map[Int, Agent]
= map_put(m, i, Agent { cash: 1000 })

fn add_cash(acc: Int, a: Agent) -> Int
= acc + a.cash

fn init(n: Int) -> Sim
  req n >= 0 && n <= 1000000
= Sim { agents: fold(range(0, n), map_new(), add_agent), tick: 0 }

fn total(sim: Sim) -> Int
= fold(map_values(sim.agents), 0, add_cash)

fn transfer(sim: Sim, from: Int, to: Int, amount: Int) -> Sim
  req amount >= 0
  ens total(r) == total(sim)
= if from == to then sim else match map_get(sim.agents, from) { None => sim, Some(src) => if src.cash < amount then sim else match map_get(sim.agents, to) { None => sim, Some(dst) => Sim { agents: map_put(map_put(sim.agents, from, Agent { cash: src.cash - amount }), to, Agent { cash: dst.cash + amount }), tick: sim.tick + 1 } } }

test self_transfer_is_noop = total(transfer(init(1), 0, 0, 100)) == 1000

fn step(sim: Sim) -> Sim !rand
= let n = map_size(sim.agents) in if n < 2 then sim else transfer(sim, rand_int(0, n - 1), rand_int(0, n - 1), rand_int(0, 50))

test transfer_conserves = total(transfer(init(2), 0, 1, 100)) == 2000
