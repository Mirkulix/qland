# qal-pkg 1
# package qal_sim_dashboard e3294431c71e359666484b478fe208fde1ebc4de805047f58b8734522a0f940e
# std 157299b76ea5a1e74bcc3a0bb266d916f478495c0eec487c6481c604da08b62e
# def fetch_node 22e4948e0d1990d3b7f1d9ec30424e80650559e08b7d506543de305b92e413c4 cli
# def handle b19b10152391eff623d7d3926aa7e7bf3eb3ea37a7dc8818763985c9ad907527 cli
# def metrics_json cbf5e0231c27256a616e2fbb0ae7217183758c0d737e3625ce11e089258400ed cli
# def page 50e8e5dae4bc205050a94f555a12683d29629f79c1569e4e16b3959fdc69ff53 cli

fn fetch_node(url: Str) -> Str !net
= match http(HttpCall { method: "GET", url: url, headers: [], body: "" }) { Err(_) => "{}", Ok(r) => r.body }

fn page() -> Str
= "<!doctype html><html><body><h1>QAL cluster</h1><pre id='m'>loading</pre>" ++ "<script>fetch('/api/metrics').then(r=>r.json()).then(j=>{document.getElementById('m').textContent=JSON.stringify(j,null,2)})</script>" ++ "</body></html>"

fn metrics_json() -> HttpResponse !net
= std.http.json(200, std.json.obj([std.json.field("n0", std.json.str(fetch_node("http://127.0.0.1:8990/api/metrics"))), std.json.field("n1", std.json.str(fetch_node("http://127.0.0.1:8991/api/metrics"))), std.json.field("n2", std.json.str(fetch_node("http://127.0.0.1:8992/api/metrics")))]))

fn handle(rq: HttpRequest) -> HttpResponse !net
= if rq.path == "/api/metrics" then metrics_json() else std.http.response(200, "text/html; charset=utf-8", page())
