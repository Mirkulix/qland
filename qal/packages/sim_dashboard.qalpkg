# qal-pkg 1
# package qal_sim_dashboard afaf030a7c2aeb2f1c1659164d7cdf9cbc1bec8f25c5ed381526152bd78f48f2
# std 157299b76ea5a1e74bcc3a0bb266d916f478495c0eec487c6481c604da08b62e
# def fetch_node 22e4948e0d1990d3b7f1d9ec30424e80650559e08b7d506543de305b92e413c4 cli
# def handle 8de0fd314b0dab226756062ce5f1ca8aa23ab30096ee7616d511eb16de2f08c1 cli
# def health_json 4aebb60dc9e35fd4eb03c3910eff61cfc500018543d0d4f61ebf886c99a1d97d cli
# def metrics_json cbf5e0231c27256a616e2fbb0ae7217183758c0d737e3625ce11e089258400ed cli
# def page 15af8fd7d5bb482e94bc43ced8a57972536739f29137d5fc957e5a8f66543308 cli
# def up 74030a1a84ae448688d0809f1dedef29db2f23dc1730e86651ca6b67bd9d8bb6 cli

fn fetch_node(url: Str) -> Str !net
= match http(HttpCall { method: "GET", url: url, headers: [], body: "" }) { Err(_) => "{}", Ok(r) => r.body }

fn page() -> Str
= "<!doctype html><html><body><h1>QAL cluster</h1><pre id='m'>loading</pre>" ++ "<script>fetch('/api/metrics').then(r=>r.json()).then(j=>{document.getElementById('m').textContent=JSON.stringify(j,null,2)})</script>" ++ "<script>fetch('/api/health').then(r=>r.json()).then(j=>{document.getElementById('m').textContent+='\nhealth '+JSON.stringify(j)})</script>" ++ "</body></html>"

fn up(s: Str) -> Bool
= len(s) > 2

fn health_json() -> HttpResponse !net
= let m0 = fetch_node("http://127.0.0.1:8990/api/metrics") in let m1 = fetch_node("http://127.0.0.1:8991/api/metrics") in let m2 = fetch_node("http://127.0.0.1:8992/api/metrics") in let n = (if up(m0) then 1 else 0) + (if up(m1) then 1 else 0) + (if up(m2) then 1 else 0) in std.http.json(200, std.json.obj([std.json.field("up", std.json.int(n)), std.json.field("total", std.json.int(3))]))

fn metrics_json() -> HttpResponse !net
= std.http.json(200, std.json.obj([std.json.field("n0", std.json.str(fetch_node("http://127.0.0.1:8990/api/metrics"))), std.json.field("n1", std.json.str(fetch_node("http://127.0.0.1:8991/api/metrics"))), std.json.field("n2", std.json.str(fetch_node("http://127.0.0.1:8992/api/metrics")))]))

fn handle(rq: HttpRequest) -> HttpResponse !net
= if rq.path == "/api/metrics" then metrics_json() else if rq.path == "/api/health" then health_json() else std.http.response(200, "text/html; charset=utf-8", page())
