type Tree[T] = Leaf | Node(Tree[T], T, Tree[T])
fn size[T](t: Tree[T]) -> Int ens r >= 0 = match t { Leaf => 0, Node(l, _, r) => size(l) + 1 + size(r) }
type IntTree = Nil | Branch(IntTree, Int, IntTree)
fn total(t: IntTree) -> Int ens r >= 0 = match t { Nil => 0, Branch(l, v, r) => if v < 0 then total(l) + total(r) else total(l) + v + total(r) }
fn wrong(t: IntTree) -> Int ens r > 0 = match t { Nil => 0, Branch(l, _, _) => wrong(l) }
