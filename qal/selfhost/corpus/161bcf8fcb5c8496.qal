type Sink[T] = { put: fn(T) -> Unit }
fn run(cb: fn() -> Unit) -> Unit = cb()
fn pure_sink() -> Sink[fn() -> Unit] = Sink { put: run }
fn feed[!e](s: Sink[fn() -> Unit !e], cb: fn() -> Unit !e) -> Unit = let p = s.put in p(cb)
fn main(args: List[Str]) -> Int !io = { feed(pure_sink(), fn() => print("x")); 0 }
