fn clamp(x: Int) -> Int ens r >= 0 && r <= 10 = if x < 0 then 0 else if x > 10 then 10 else x
fn inv(x: Int) -> Int req x != 0 ens r == 100 / x = 100 / x
fn sq(x: Int) -> Int ens r >= 0 = x * x
fn bound(x: Int) -> Int req x == 123456 ens r == x = x
fn rare(x: Int, y: Int) -> Int req y > 1000 && x == y * 7 + 123456 ens r == x = x
