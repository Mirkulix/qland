test conv = bytes_len(to_bytes("hé")) == 3 && bytes_to_list(to_bytes("hé")) == [104, 195, 169] && bytes_to_str(to_bytes("hé")) == Some("hé")
test invalid_utf8 = bytes_to_str(bytes_from([255, 0])) == None && bytes_to_str(bytes_from([])) == Some("")
test get_slice_concat = let b = bytes_from([1, 2, 3]) in bytes_get(b, 0) == Some(1) && bytes_get(b, 3) == None && bytes_get(b, -1) == None && bytes_to_list(bytes_slice(b, 1, 3) ++ b) == [2, 3, 1, 2, 3]
test equality = bytes_from([104, 105]) == to_bytes("hi") && bytes_from([1]) != bytes_from([1, 0])
