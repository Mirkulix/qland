fn up(n: Int) -> Map[Int, Int] = fold(range(0, n), map_new(), fn(m, i) => map_put(m, i, i * 2))
fn down(m: Map[Int, Int], n: Int) -> Map[Int, Int] = fold(range(0, n), m, fn(acc, i) => map_del(acc, i * 2))
fn check(n: Int) -> Bool = let m = up(n) in let d = down(m, n / 2) in map_size(m) == n && map_get(m, n - 1) == Some(2 * n - 2) && map_size(d) == n / 2 && map_keys(d) == filter(range(0, n), fn(k) => k % 2 == 1)
