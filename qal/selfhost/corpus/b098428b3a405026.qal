fn count(words: List[Str]) -> Map[Str, Int] = fold(words, map_new(), fn(m, w) => map_put(m, w, match map_get(m, w) { Some(n) => n + 1, None => 1 }))
test t = map_size(count(["a", "b", "a"])) == 2 && map_keys(count(["b", "a"])) == ["a", "b"]
test b = bytes_len(to_bytes("hé")) == 3 && bytes_get(bytes_from([1, 2]), 1) == Some(2) && bytes_to_str(to_bytes("x") ++ to_bytes("y")) == Some("xy")
test c = bytes_to_list(bytes_slice(to_bytes("abc"), 1, 3)) == [98, 99] && map_has(map_del(map_put(map_new(), 1, true), 1), 1) == false && map_values(map_put(map_new(), 1, 2)) == [2]
