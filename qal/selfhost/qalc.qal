      let a1 = qc_asm_all(li.a, [
        QcILocalGet(0), QcII32Eqz, QcIIf(QcBtEmpty), QcILocalGet(2), QcIReturn, QcIEnd,
        QcILocalGet(0), QcII32Load(24), QcILocalGet(1), QcILocalGet(2), QcICall(fill), QcILocalSet(i),
        QcILocalGet(1), QcILocalGet(i), QcII32Const(4), QcII32Shl, QcII32Add, QcILocalGet(0), QcII64Load(8), QcII64Store(8),
        QcILocalGet(1), QcILocalGet(i), QcII32Const(4), QcII32Shl, QcII32Add, QcILocalGet(0), QcII64Load(16), QcII64Store(16),
        QcILocalGet(0), QcII32Load(28), QcILocalGet(1), QcILocalGet(i), QcII32Const(1), QcII32Add, QcICall(fill)
