      let r_ln = qc_mb_rt(m, QcRtListNew) in
      let a2 = qc_asm_all(a1, [QcILocalGet(n), QcICall(r_ln.idx), QcILocalSet(xs), QcILocalGet(n), QcILocalSet(k)]) in
