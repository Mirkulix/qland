      let a1 = qc_asm_all(lp.a, [
        QcII64Const(16), QcICall(ar.idx), QcILocalTee(p), QcILocalGet(0), QcII32Store(0),
        QcILocalGet(p), QcILocalGet(1), QcII64Store(8), QcILocalGet(p)
