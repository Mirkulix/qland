      let a1 = qc_asm_all(a0, [
        QcILocalGet(0), QcII32Const(0), QcII32LtS, QcIIf(QcBtResult(QcVI32)), QcII32Const(qc_tag_addr(0)), QcIElse,
        QcII32Const(1), QcILocalGet(0), QcII64ExtendI32U, QcICall(vr.idx), QcIEnd
      ]) in
      QcMbAsm { m: vr.m, a: a1 },
