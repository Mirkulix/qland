      let a2 = qc_rt_slot_addr(qc_rt_loop_until(a1, k, n), xs, k) in
      let a3 = qc_asm_all(a2, [QcILocalGet(0), QcILocalGet(k), QcII32Add, QcII32Load8U(4), QcII64ExtendI32U, QcII64Store(8)]) in
      let a4 = qc_rt_loop_next(a3, k) in
