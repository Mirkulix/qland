# AST types and basic helpers for QAL self-hosting compiler (spec §7: qc_ast)

type QcType =
  | QcTInt
  | QcTFloat
  | QcTBool
  | QcTUnit
  | QcTStr
  | QcTBytes
  | QcTNamed(Str)
  | QcTParam(Str)
  | QcTList(QcType)
  | QcTOption(QcType)
  | QcTResult(QcType, QcType)
  | QcTMap(QcType, QcType)
  | QcTApp(Str, List[QcType])
  | QcTFn(List[QcType], QcType, List[Str])
  | QcTVar(Int)

type QcBinOp =
  | QcOpAdd
  | QcOpSub
  | QcOpMul
  | QcOpDiv
  | QcOpRem
  | QcOpConcat
  | QcOpEq
  | QcOpNe
  | QcOpLt
  | QcOpLe
  | QcOpGt
  | QcOpGe
  | QcOpAnd
  | QcOpOr

type QcUnOp =
  | QcUnNeg
  | QcUnNot

type QcFieldPat = {
  name: Str,
  pat: QcPat
}

type QcPat =
  | QcPWild
  | QcPBind(Str)
  | QcPInt(Int)
  | QcPStr(Str)
  | QcPBool(Bool)
  | QcPUnit
  | QcPVariant(Str, List[QcPat])
  | QcPRecord(Str, List[QcFieldPat])

type QcFieldExpr = {
  name: Str,
  expr: QcExpr
}

type QcLambdaParam = {
  name: Str,
  ty: Option[QcType]
}

type QcArm = {
  pat: QcPat,
  guard: Option[QcExpr],
  body: QcExpr
}

type QcExpr =
  | QcEInt(Int)
  | QcEFloat(Float)
  | QcEBool(Bool)
  | QcEStr(Str)
  | QcEUnit
  | QcEVar(Str)
  | QcEBin(QcBinOp, QcExpr, QcExpr)
  | QcEUn(QcUnOp, QcExpr)
  | QcEIf(QcExpr, QcExpr, QcExpr)
  | QcELet(Str, Option[QcType], QcExpr, QcExpr)
  | QcECall(Str, List[QcExpr])
  | QcEList(List[QcExpr])
  | QcERecord(Str, List[QcFieldExpr])
  | QcEField(QcExpr, Str)
  | QcEMatch(QcExpr, List[QcArm])
  | QcESeq(List[QcExpr])
  | QcELambda(List[QcLambdaParam], QcExpr)

type QcFnDef = {
  name: Str,
  tparams: List[Str],
  eparams: List[Str],
  params: List[QcFieldType],
  ret: QcType,
  effects: List[Str],
  reqs: List[QcExpr],
  enss: List[QcExpr],
  body: QcExpr
}

type QcTestDef = {
  name: Str,
  body: QcExpr
}

type QcVariant = {
  name: Str,
  fields: List[QcType]
}

type QcFieldType = {
  name: Str,
  ty: QcType
}

type QcTypeBody =
  | QcBodyRecord(List[QcFieldType])
  | QcBodyEnum(List[QcVariant])

type QcTypeDef = {
  name: Str,
  params: List[Str],
  body: QcTypeBody
}

type QcDef =
  | QcDefType(QcTypeDef)
  | QcDefFn(QcFnDef)
  | QcDefTest(QcTestDef)

type QcProgram = {
  defs: List[QcDef]
}

type QcTok =
  | QcTokIdent(Str)
  | QcTokInt(Int)
  | QcTokFloat(Float)
  | QcTokStr(Str)
  | QcTokSym(Str)
  | QcTokEof

type QcToken = {
  tok: QcTok,
  line: Int,
  col: Int
}

type QcDiag = {
  code: Str,
  kind: Str,
  def: Str,
  path: Str,
  message: Str,
  expected: Option[Str],
  found: Option[Str],
  hints: List[Str],
  dependents: List[Str],
  counterexample: Option[Str]
}

fn qc_binop_symbol(op: QcBinOp) -> Str =
  match op {
    QcOpAdd => "+",
    QcOpSub => "-",
    QcOpMul => "*",
    QcOpDiv => "/",
    QcOpRem => "%",
    QcOpConcat => "++",
    QcOpEq => "==",
    QcOpNe => "!=",
    QcOpLt => "<",
    QcOpLe => "<=",
    QcOpGt => ">",
    QcOpGe => ">=",
    QcOpAnd => "&&",
    QcOpOr => "||"
  }

fn qc_binop_prec(op: QcBinOp) -> Int =
  match op {
    QcOpOr => 1,
    QcOpAnd => 2,
    QcOpEq => 3,
    QcOpNe => 3,
    QcOpLt => 3,
    QcOpLe => 3,
    QcOpGt => 3,
    QcOpGe => 3,
    QcOpAdd => 4,
    QcOpSub => 4,
    QcOpConcat => 4,
    QcOpMul => 5,
    QcOpDiv => 5,
    QcOpRem => 5
  }

fn qc_binop_is_comparison(op: QcBinOp) -> Bool =
  match op {
    QcOpEq => true,
    QcOpNe => true,
    QcOpLt => true,
    QcOpLe => true,
    QcOpGt => true,
    QcOpGe => true,
    _ => false
  }

fn qc_unop_symbol(op: QcUnOp) -> Str =
  match op {
    QcUnNeg => "-",
    QcUnNot => "!"
  }

fn qc_is_upper_char(c: Int) -> Bool = c >= 65 && c <= 90

fn qc_last_segment_rec(b: Bytes, i: Int, n: Int, last_dot: Int) -> Str =
  if i >= n then
    (if last_dot < 0 then match bytes_to_str(b) { Some(s) => s, None => "" }
     else match bytes_to_str(bytes_slice(b, last_dot + 1, n)) { Some(s) => s, None => "" })
  else if bytes_at(b, i) == 46 then qc_last_segment_rec(b, i + 1, n, i)
  else qc_last_segment_rec(b, i + 1, n, last_dot)

fn qc_last_segment(s: Str) -> Str =
  let b = to_bytes(s) in
  qc_last_segment_rec(b, 0, bytes_len(b), -1)

fn qc_is_upper(name: Str) -> Bool =
  let seg = qc_last_segment(name) in
  if len(seg) == 0 then false
  else qc_is_upper_char(bytes_at(to_bytes(seg), 0))

fn qc_def_name(d: QcDef) -> Str =
  match d {
    QcDefType(t) => t.name,
    QcDefFn(f) => f.name,
    QcDefTest(t) => t.name
  }

fn qc_list_find_idx_str_loop(xs: List[Str], s: Str, cur: Int) -> Option[Int] =
  if cur >= len(xs) then None
  else if list_at(xs, cur) == s then Some(cur)
  else qc_list_find_idx_str_loop(xs, s, cur + 1)

fn qc_list_find_idx_str(xs: List[Str], s: Str) -> Option[Int] =
  qc_list_find_idx_str_loop(xs, s, 0)

# Effect parameters (spec 2026-10-22): the effect lists inside a type (Type::map_effects and
# Type::mentions_effect in ast.rs). `from[i]` becomes `to[i]`.
fn qc_rename_effects(effs: List[Str], from: List[Str], to: List[Str]) -> List[Str] =
  map(effs, fn(e: Str) =>
    match qc_list_find_idx_str(from, e) {
      Some(i) => if i < len(to) then list_at(to, i) else e,
      None => e
    })

fn qc_type_map_effects(t: QcType, from: List[Str], to: List[Str]) -> QcType =
  match t {
    QcTList(x) => QcTList(qc_type_map_effects(x, from, to)),
    QcTOption(x) => QcTOption(qc_type_map_effects(x, from, to)),
    QcTResult(a, b) => QcTResult(qc_type_map_effects(a, from, to), qc_type_map_effects(b, from, to)),
    QcTMap(a, b) => QcTMap(qc_type_map_effects(a, from, to), qc_type_map_effects(b, from, to)),
    QcTApp(n, args) => QcTApp(n, map(args, fn(a: QcType) => qc_type_map_effects(a, from, to))),
    QcTFn(ps, r, effs) =>
      QcTFn(map(ps, fn(p: QcType) => qc_type_map_effects(p, from, to)), qc_type_map_effects(r, from, to), qc_rename_effects(effs, from, to)),
    _ => t
  }

fn qc_type_mentions_effect(t: QcType, e: Str) -> Bool =
  match t {
    QcTList(x) => qc_type_mentions_effect(x, e),
    QcTOption(x) => qc_type_mentions_effect(x, e),
    QcTResult(a, b) => qc_type_mentions_effect(a, e) || qc_type_mentions_effect(b, e),
    QcTMap(a, b) => qc_type_mentions_effect(a, e) || qc_type_mentions_effect(b, e),
    QcTApp(_, args) => fold(args, false, fn(acc: Bool, a: QcType) => acc || qc_type_mentions_effect(a, e)),
    QcTFn(ps, r, effs) =>
      fold(effs, false, fn(acc: Bool, x: Str) => acc || x == e)
        || fold(ps, false, fn(acc: Bool, p: QcType) => acc || qc_type_mentions_effect(p, e))
        || qc_type_mentions_effect(r, e),
    _ => false
  }

test qc_ast_test =
  qc_binop_symbol(QcOpAdd) == "+" &&
  qc_binop_prec(QcOpMul) == 5 &&
  qc_binop_is_comparison(QcOpEq) == true &&
  qc_is_upper("Dot") == true &&
  qc_is_upper("std.json.Str") == true &&
  qc_is_upper("area") == false
# Lexer for QAL self-hosting compiler (spec §7: qc_lex, port of qal-text/src/lexer.rs)

fn qc_diag_parse(line: Int, col: Int, msg: Str) -> QcDiag =
  QcDiag {
    code: "E0100",
    kind: "parse",
    def: "",
    path: from_int(line) ++ ":" ++ from_int(col),
    message: msg,
    expected: None,
    found: None,
    hints: [],
    dependents: [],
    counterexample: None
  }

fn qc_diag_parse_hint(line: Int, col: Int, msg: Str, hint: Str) -> QcDiag =
  QcDiag {
    code: "E0100",
    kind: "parse",
    def: "",
    path: from_int(line) ++ ":" ++ from_int(col),
    message: msg,
    expected: None,
    found: None,
    hints: [hint],
    dependents: [],
    counterexample: None
  }

fn qc_is_digit(c: Int) -> Bool = c >= 48 && c <= 57

fn qc_is_lower(c: Int) -> Bool = c >= 97 && c <= 122

fn qc_is_alpha(c: Int) -> Bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90)

fn qc_is_ident_start(c: Int) -> Bool = qc_is_alpha(c) || c == 95

fn qc_is_ident_char(c: Int) -> Bool = qc_is_alpha(c) || qc_is_digit(c) || c == 95

fn qc_is_hexdigit(c: Int) -> Bool = qc_is_digit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)

fn qc_hex_val(c: Int) -> Int =
  if qc_is_digit(c) then c - 48
  else if c >= 97 && c <= 102 then c - 97 + 10
  else c - 65 + 10

fn qc_is_keyword(s: Str) -> Bool =
  s == "fn" || s == "type" || s == "test" || s == "let" || s == "in" ||
  s == "if" || s == "then" || s == "else" || s == "match" || s == "req" ||
  s == "ens" || s == "true" || s == "false" || s == "std"

fn qc_scan_digits(b: Bytes, i: Int, n: Int) -> Int =
  if i < n && qc_is_digit(bytes_at(b, i)) then qc_scan_digits(b, i + 1, n)
  else i

fn qc_scan_ident(b: Bytes, i: Int, n: Int) -> Int =
  if i < n && qc_is_ident_char(bytes_at(b, i)) then qc_scan_ident(b, i + 1, n)
  else i

fn qc_skip_comment(b: Bytes, i: Int, n: Int) -> Int =
  if i < n && bytes_at(b, i) != 10 then qc_skip_comment(b, i + 1, n)
  else i

type QcStrRes = {
  res: Result[Str, QcDiag],
  next_i: Int,
  next_line: Int,
  next_col: Int
}

fn qc_lex_escape(b: Bytes, i: Int, n: Int, line: Int, col: Int, acc: Accum[Int]) -> QcStrRes =
  if i >= n then
    QcStrRes { res: Err(qc_diag_parse(line, col, "unterminated string literal")), next_i: n, next_line: line, next_col: col }
  else
    let e = bytes_at(b, i) in
    if e == 110 then qc_lex_str_body(b, i + 1, n, line, col + 1, AccPush(acc, 10))
    else if e == 116 then qc_lex_str_body(b, i + 1, n, line, col + 1, AccPush(acc, 9))
    else if e == 114 then qc_lex_str_body(b, i + 1, n, line, col + 1, AccPush(acc, 13))
    else if e == 48 then qc_lex_str_body(b, i + 1, n, line, col + 1, AccPush(acc, 0))
    else if e == 92 then qc_lex_str_body(b, i + 1, n, line, col + 1, AccPush(acc, 92))
    else if e == 34 then qc_lex_str_body(b, i + 1, n, line, col + 1, AccPush(acc, 34))
    else if e == 117 then qc_lex_unicode(b, i + 1, n, line, col + 1, acc)
    else
      let ch = match bytes_to_str(bytes_slice(b, i, i + 1)) { Some(s) => s, None => "?" } in
      let bad = "\\" ++ ch in
      QcStrRes { res: Err(qc_diag_parse(line, col - 1, "invalid escape `" ++ bad ++ "` in string literal")), next_i: i + 1, next_line: line, next_col: col + 1 }

fn qc_scan_hex(b: Bytes, i: Int, n: Int, count: Int, acc: Int) -> Int =
  if count < 6 && i < n && qc_is_hexdigit(bytes_at(b, i)) then
    qc_scan_hex(b, i + 1, n, count + 1, bit_or(shl(acc, 4), qc_hex_val(bytes_at(b, i))))
  else acc

fn qc_count_hex(b: Bytes, i: Int, n: Int, count: Int) -> Int =
  if count < 6 && i < n && qc_is_hexdigit(bytes_at(b, i)) then
    qc_count_hex(b, i + 1, n, count + 1)
  else count

fn qc_utf8_encode(cp: Int, acc: Accum[Int]) -> Accum[Int] =
  if cp < 128 then AccPush(acc, cp)
  else if cp < 2048 then
    AccPush(AccPush(acc, bit_or(192, shr(cp, 6))), bit_or(128, bit_and(cp, 63)))
  else if cp < 65536 then
    AccPush(AccPush(AccPush(acc, bit_or(224, shr(cp, 12))), bit_or(128, bit_and(shr(cp, 6), 63))), bit_or(128, bit_and(cp, 63)))
  else
    AccPush(AccPush(AccPush(AccPush(acc, bit_or(240, shr(cp, 18))), bit_or(128, bit_and(shr(cp, 12), 63))), bit_or(128, bit_and(shr(cp, 6), 63))), bit_or(128, bit_and(cp, 63)))

fn qc_lex_unicode(b: Bytes, i: Int, n: Int, line: Int, col: Int, acc: Accum[Int]) -> QcStrRes =
  if i >= n || bytes_at(b, i) != 123 then
    QcStrRes { res: Err(qc_diag_parse(line, col - 2, "invalid escape `\\u` in string literal")), next_i: i, next_line: line, next_col: col }
  else
    let start = i + 1 in
    let cnt = qc_count_hex(b, start, n, 0) in
    let end_pos = start + cnt in
    if cnt == 0 || end_pos >= n || bytes_at(b, end_pos) != 125 then
      let hex_str = match bytes_to_str(bytes_slice(b, start, end_pos)) { Some(s) => s, None => "" } in
      QcStrRes { res: Err(qc_diag_parse(line, col - 2, "invalid escape `\\u{" ++ hex_str ++ "` in string literal")), next_i: end_pos + 1, next_line: line, next_col: col + cnt + 2 }
    else
      let cp = qc_scan_hex(b, start, n, 0, 0) in
      if cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343) then
        let hex_str = match bytes_to_str(bytes_slice(b, start, end_pos)) { Some(s) => s, None => "" } in
        QcStrRes { res: Err(qc_diag_parse(line, col - 2, "invalid escape `\\u{" ++ hex_str ++ "}` in string literal")), next_i: end_pos + 1, next_line: line, next_col: col + cnt + 2 }
      else
        let acc2 = qc_utf8_encode(cp, acc) in
        qc_lex_str_body(b, end_pos + 1, n, line, col + cnt + 2, acc2)

fn qc_lex_str_body(b: Bytes, i: Int, n: Int, line: Int, col: Int, acc: Accum[Int]) -> QcStrRes =
  if i >= n then
    QcStrRes { res: Err(qc_diag_parse(line, col, "unterminated string literal")), next_i: n, next_line: line, next_col: col }
  else
    let c = bytes_at(b, i) in
    if c == 34 then
      let out_str = match bytes_to_str(bytes_from(acc_list(acc))) { Some(s) => s, None => "" } in
      QcStrRes { res: Ok(out_str), next_i: i + 1, next_line: line, next_col: col + 1 }
    else if c == 10 then
      qc_lex_str_body(b, i + 1, n, line + 1, 1, AccPush(acc, 10))
    else if c == 92 then
      qc_lex_escape(b, i + 1, n, line, col + 1, acc)
    else
      qc_lex_str_body(b, i + 1, n, line, col + 1, AccPush(acc, c))

type QcQualRes = {
  res: Result[Str, QcDiag],
  next_i: Int
}

fn qc_is_std_name_parts(mod_str: Str, last_str: Str, full_len: Int) -> Bool =
  full_len <= 128 &&
  len(mod_str) > 0 &&
  qc_is_lower(bytes_at(to_bytes(mod_str), 0)) &&
  !qc_is_keyword(mod_str) &&
  len(last_str) > 0 &&
  qc_is_ident_start(bytes_at(to_bytes(last_str), 0)) &&
  last_str != "_" &&
  !qc_is_keyword(last_str)

fn qc_lex_qualified(b: Bytes, i: Int, n: Int, line: Int, col: Int) -> QcQualRes =
  let p1 = i + 1 in
  let end1 = qc_scan_ident(b, p1, n) in
  if end1 == p1 then
    QcQualRes { res: Err(qc_diag_parse_hint(line, col, "`std` is not a standard library name", "standard library names have the form `std.<module>.<name>`: a lowercase module (e.g. `std.json.parse`, `std.json.Json`, `std.json.Str(\"a\")`)")), next_i: p1 }
  else if end1 >= n || bytes_at(b, end1) != 46 then
    let mod_s = match bytes_to_str(bytes_slice(b, p1, end1)) { Some(s) => s, None => "" } in
    QcQualRes { res: Err(qc_diag_parse_hint(line, col, "`std." ++ mod_s ++ "` is not a standard library name", "standard library names have the form `std.<module>.<name>`: a lowercase module (e.g. `std.json.parse`, `std.json.Json`, `std.json.Str(\"a\")`)")), next_i: end1 }
  else
    let p2 = end1 + 1 in
    let end2 = qc_scan_ident(b, p2, n) in
    let mod_s = match bytes_to_str(bytes_slice(b, p1, end1)) { Some(s) => s, None => "" } in
    let last_s = match bytes_to_str(bytes_slice(b, p2, end2)) { Some(s) => s, None => "" } in
    let full = "std." ++ mod_s ++ "." ++ last_s in
    if end2 - (i - 3) > 128 then
      QcQualRes { res: Err(qc_diag_parse(line, col, "identifier longer than 128 characters")), next_i: end2 }
    else if !qc_is_std_name_parts(mod_s, last_s, len(full)) then
      QcQualRes { res: Err(qc_diag_parse_hint(line, col, "`" ++ full ++ "` is not a standard library name", "standard library names have the form `std.<module>.<name>`: a lowercase module (e.g. `std.json.parse`, `std.json.Json`, `std.json.Str(\"a\")`)")), next_i: end2 }
    else
      QcQualRes { res: Ok(full), next_i: end2 }

fn qc_match_2sym(c1: Int, c2: Int) -> Option[Str] =
  if c1 == 45 && c2 == 62 then Some("->")
  else if c1 == 61 && c2 == 62 then Some("=>")
  else if c1 == 61 && c2 == 61 then Some("==")
  else if c1 == 33 && c2 == 61 then Some("!=")
  else if c1 == 60 && c2 == 61 then Some("<=")
  else if c1 == 62 && c2 == 61 then Some(">=")
  else if c1 == 38 && c2 == 38 then Some("&&")
  else if c1 == 124 && c2 == 124 then Some("||")
  else if c1 == 43 && c2 == 43 then Some("++")
  else None

fn qc_match_1sym(c: Int) -> Option[Str] =
  if c == 40 then Some("(")
  else if c == 41 then Some(")")
  else if c == 91 then Some("[")
  else if c == 93 then Some("]")
  else if c == 123 then Some("{")
  else if c == 125 then Some("}")
  else if c == 44 then Some(",")
  else if c == 59 then Some(";")
  else if c == 58 then Some(":")
  else if c == 46 then Some(".")
  else if c == 124 then Some("|")
  else if c == 61 then Some("=")
  else if c == 60 then Some("<")
  else if c == 62 then Some(">")
  else if c == 43 then Some("+")
  else if c == 45 then Some("-")
  else if c == 42 then Some("*")
  else if c == 47 then Some("/")
  else if c == 37 then Some("%")
  else if c == 33 then Some("!")
  else None

type QcLexRes = {
  tokens: List[QcToken],
  diag: Option[QcDiag]
}

fn qc_lex_loop(b: Bytes, i: Int, n: Int, line: Int, col: Int, prev_dot: Bool, acc: Accum[QcToken]) -> QcLexRes =
  if i >= n then
    let eof_tok = QcToken { tok: QcTokEof, line: line, col: col } in
    QcLexRes { tokens: acc_list(AccPush(acc, eof_tok)), diag: None }
  else
    let c = bytes_at(b, i) in
    if c == 10 then
      qc_lex_loop(b, i + 1, n, line + 1, 1, false, acc)
    else if c == 32 || c == 9 || c == 13 then
      qc_lex_loop(b, i + 1, n, line, col + 1, false, acc)
    else if c == 35 then
      let j = qc_skip_comment(b, i + 1, n) in
      qc_lex_loop(b, j, n, line, col + (j - i), false, acc)
    else if qc_is_digit(c) then
      qc_lex_number(b, i, n, line, col, acc)
    else if qc_is_ident_start(c) then
      qc_lex_identifier(b, i, n, line, col, prev_dot, acc)
    else if c == 34 then
      let sr = qc_lex_str_body(b, i + 1, n, line, col + 1, AccEnd) in
      match sr.res {
        Err(d) => QcLexRes { tokens: [], diag: Some(d) },
        Ok(s) =>
          let t = QcToken { tok: QcTokStr(s), line: line, col: col } in
          qc_lex_loop(b, sr.next_i, n, sr.next_line, sr.next_col, false, AccPush(acc, t))
      }
    else
      let sym2 = if i + 1 < n then qc_match_2sym(c, bytes_at(b, i + 1)) else None in
      match sym2 {
        Some(s) =>
          let t = QcToken { tok: QcTokSym(s), line: line, col: col } in
          qc_lex_loop(b, i + 2, n, line, col + 2, false, AccPush(acc, t)),
        None =>
          match qc_match_1sym(c) {
            Some(s) =>
              let is_dot = c == 46 in
              let t = QcToken { tok: QcTokSym(s), line: line, col: col } in
              qc_lex_loop(b, i + 1, n, line, col + 1, is_dot, AccPush(acc, t)),
            None =>
              let bad_ch = match bytes_to_str(bytes_slice(b, i, i + 1)) { Some(s) => s, None => "?" } in
              QcLexRes { tokens: [], diag: Some(qc_diag_parse(line, col, "unexpected character `" ++ bad_ch ++ "`")) }
          }
      }

fn qc_skip_leading_zeros(b: Bytes, i: Int, n: Int) -> Int =
  if i + 1 < n && bytes_at(b, i) == 48 then qc_skip_leading_zeros(b, i + 1, n)
  else i

fn qc_is_i64_min_mag(s: Str) -> Bool =
  let b = to_bytes(s) in
  let start = qc_skip_leading_zeros(b, 0, bytes_len(b)) in
  match bytes_to_str(bytes_slice(b, start, bytes_len(b))) {
    Some(trimmed) => trimmed == "9223372036854775808",
    None => false
  }

fn qc_lex_number(b: Bytes, i: Int, n: Int, line: Int, col: Int, acc: Accum[QcToken]) -> QcLexRes =
  let int_end = qc_scan_digits(b, i, n) in
  let has_dot = int_end + 1 < n && bytes_at(b, int_end) == 46 && qc_is_digit(bytes_at(b, int_end + 1)) in
  let frac_end = if has_dot then qc_scan_digits(b, int_end + 2, n) else int_end in
  let has_exp = frac_end < n && (bytes_at(b, frac_end) == 101 || bytes_at(b, frac_end) == 69) in
  let exp_sign = if has_exp && frac_end + 1 < n && (bytes_at(b, frac_end + 1) == 43 || bytes_at(b, frac_end + 1) == 45) then 1 else 0 in
  let has_exp_digits = has_exp && frac_end + 1 + exp_sign < n && qc_is_digit(bytes_at(b, frac_end + 1 + exp_sign)) in
  let num_end = if has_exp_digits then qc_scan_digits(b, frac_end + 1 + exp_sign, n) else frac_end in
  let is_float = has_dot || has_exp_digits in
  if num_end < n && (qc_is_ident_char(bytes_at(b, num_end))) then
    let bad_end = qc_scan_ident(b, num_end, n) in
    let bad_text = match bytes_to_str(bytes_slice(b, i, bad_end)) { Some(s) => s, None => "" } in
    QcLexRes { tokens: [], diag: Some(qc_diag_parse(line, col, "invalid number literal `" ++ bad_text ++ "`")) }
  else
    let num_str = match bytes_to_str(bytes_slice(b, i, num_end)) { Some(s) => s, None => "" } in
    let len_num = num_end - i in
    if is_float then
      match to_float(num_str) {
        Some(f) =>
          let t = QcToken { tok: QcTokFloat(f), line: line, col: col } in
          qc_lex_loop(b, num_end, n, line, col + len_num, false, AccPush(acc, t)),
        None =>
          QcLexRes { tokens: [], diag: Some(qc_diag_parse(line, col, "float literal `" ++ num_str ++ "` is out of range")) }
      }
    else
      match to_int(num_str) {
        Some(v) =>
          let t = QcToken { tok: QcTokInt(v), line: line, col: col } in
          qc_lex_loop(b, num_end, n, line, col + len_num, false, AccPush(acc, t)),
        None =>
          if qc_is_i64_min_mag(num_str) then
            let t = QcToken { tok: QcTokInt(shl(1, 63)), line: line, col: col } in
            qc_lex_loop(b, num_end, n, line, col + len_num, false, AccPush(acc, t))
          else
            QcLexRes { tokens: [], diag: Some(qc_diag_parse(line, col, "integer literal `" ++ num_str ++ "` does not fit in Int (64-bit)")) }
      }

fn qc_lex_identifier(b: Bytes, i: Int, n: Int, line: Int, col: Int, prev_dot: Bool, acc: Accum[QcToken]) -> QcLexRes =
  let end_pos = qc_scan_ident(b, i, n) in
  let id_len = end_pos - i in
  if id_len > 128 then
    QcLexRes { tokens: [], diag: Some(qc_diag_parse(line, col, "identifier longer than 128 characters")) }
  else
    let text = match bytes_to_str(bytes_slice(b, i, end_pos)) { Some(s) => s, None => "" } in
    if text == "std" && !prev_dot && end_pos < n && bytes_at(b, end_pos) == 46 then
      let qr = qc_lex_qualified(b, end_pos, n, line, col) in
      match qr.res {
        Err(d) => QcLexRes { tokens: [], diag: Some(d) },
        Ok(qname) =>
          let t = QcToken { tok: QcTokIdent(qname), line: line, col: col } in
          qc_lex_loop(b, qr.next_i, n, line, col + (qr.next_i - i), false, AccPush(acc, t))
      }
    else
      let t = QcToken { tok: QcTokIdent(text), line: line, col: col } in
      qc_lex_loop(b, end_pos, n, line, col + id_len, false, AccPush(acc, t))

fn qc_lex(src: Str) -> Result[List[QcToken], QcDiag] =
  let b = to_bytes(src) in
  let r = qc_lex_loop(b, 0, bytes_len(b), 1, 1, false, AccEnd) in
  match r.diag {
    Some(d) => Err(d),
    None => Ok(r.tokens)
  }

test qc_lex_test =
  match qc_lex("fn f(x: Int) -> Int = x + 1\ntest t = f(1) == 2") {
    Ok(toks) => len(toks) == 23,
    Err(_) => false
  }
# Recursive-descent parser for QAL self-hosting compiler (spec §7: qc_parse, port of qal-text/src/parser.rs)

type QcPState = {
  toks: List[QcToken],
  pos: Int,
  depth: Int,
  no_struct: Bool
}

type QcPRes[T] = {
  val: Option[T],
  err: Option[QcDiag],
  state: QcPState
}

fn qc_pres_ok[T](v: T, s: QcPState) -> QcPRes[T] =
  QcPRes { val: Some(v), err: None, state: s }

fn qc_pres_err[T](d: QcDiag, s: QcPState) -> QcPRes[T] =
  QcPRes { val: None, err: Some(d), state: s }

fn qc_peek(s: QcPState) -> QcTok =
  if s.pos < len(s.toks) then (list_at(s.toks, s.pos)).tok else QcTokEof

fn qc_peek_tok(s: QcPState) -> QcToken =
  if s.pos < len(s.toks) then list_at(s.toks, s.pos)
  else QcToken { tok: QcTokEof, line: 1, col: 1 }

fn qc_peek_at(s: QcPState, offset: Int) -> QcTok =
  let idx = s.pos + offset in
  if idx < len(s.toks) then (list_at(s.toks, idx)).tok else QcTokEof

fn qc_next(s: QcPState) -> QcPState =
  if s.pos < len(s.toks) then
    QcPState { toks: s.toks, pos: s.pos + 1, depth: s.depth, no_struct: s.no_struct }
  else s

fn qc_err_here[T](s: QcPState, msg: Str) -> QcPRes[T] =
  let t = qc_peek_tok(s) in
  qc_pres_err(qc_diag_parse(t.line, t.col, msg), s)

fn qc_err_here_hint[T](s: QcPState, msg: Str, hint: Str) -> QcPRes[T] =
  let t = qc_peek_tok(s) in
  qc_pres_err(qc_diag_parse_hint(t.line, t.col, msg, hint), s)

fn qc_check_sym(s: QcPState, sym: Str) -> Bool =
  match qc_peek(s) {
    QcTokSym(op) => op == sym,
    _ => false
  }

fn qc_check_ident(s: QcPState, id: Str) -> Bool =
  match qc_peek(s) {
    QcTokIdent(name) => name == id,
    _ => false
  }

fn qc_tok_describe(tok: QcTok) -> Str =
  match tok {
    QcTokIdent(s) => "`" ++ s ++ "`",
    QcTokInt(n) => if n < 0 then "`9223372036854775808`" else "`" ++ from_int(n) ++ "`",
    QcTokFloat(f) => "`" ++ from_float(f) ++ "`",
    QcTokStr(s) => "\"" ++ s ++ "\"",
    QcTokSym(s) => "`" ++ s ++ "`",
    QcTokEof => "end of input"
  }

fn qc_expect_kw(s: QcPState, kw: Str) -> Result[QcPState, QcDiag] =
  match qc_peek(s) {
    QcTokIdent(name) =>
      if name == kw then Ok(qc_next(s))
      else
        let t = qc_peek_tok(s) in
        Err(qc_diag_parse(t.line, t.col, "expected `" ++ kw ++ "`, found " ++ qc_tok_describe(t.tok))),
    _ =>
      let t = qc_peek_tok(s) in
      Err(qc_diag_parse(t.line, t.col, "expected `" ++ kw ++ "`, found " ++ qc_tok_describe(t.tok)))
  }

fn qc_expect_sym(s: QcPState, sym: Str) -> Result[QcPState, QcDiag] =
  match qc_peek(s) {
    QcTokSym(op) =>
      if op == sym then Ok(qc_next(s))
      else
        let t = qc_peek_tok(s) in
        Err(qc_diag_parse(t.line, t.col, "expected `" ++ sym ++ "`, found " ++ qc_tok_describe(t.tok))),
    _ =>
      let t = qc_peek_tok(s) in
      Err(qc_diag_parse(t.line, t.col, "expected `" ++ sym ++ "`, found " ++ qc_tok_describe(t.tok)))
  }

fn qc_expect_ident(s: QcPState) -> QcPRes[Str] =
  match qc_peek(s) {
    QcTokIdent(id) =>
      if qc_is_keyword(id) then
        let t = qc_peek_tok(s) in
        if id == "std" then
          qc_pres_err(qc_diag_parse_hint(t.line, t.col, "expected a name, found `std`", "`std` is a keyword since Phase 3b (standard library names are `std.<module>.<name>`); rename the parameter, local or field, e.g. to `std_`"), s)
        else
          qc_pres_err(qc_diag_parse(t.line, t.col, "expected a name, found `" ++ id ++ "`"), s)
      else qc_pres_ok(id, qc_next(s)),
    _ =>
      let t = qc_peek_tok(s) in
      qc_pres_err(qc_diag_parse(t.line, t.col, "expected a name, found " ++ qc_tok_describe(t.tok)), s)
  }

fn qc_is_qual_std(id: Str) -> Bool =
  len(id) > 4 && slice(id, 0, 4) == "std."

fn qc_expect_lower_what(s: QcPState, what: Str) -> QcPRes[Str] =
  match qc_peek(s) {
    QcTokIdent(id) =>
      if qc_is_upper(id) then
        let t = qc_peek_tok(s) in
        qc_pres_err(qc_diag_parse(t.line, t.col, what ++ " names start with a lowercase letter, found `" ++ id ++ "`"), s)
      else qc_expect_ident(s),
    _ => qc_expect_ident(s)
  }

fn qc_expect_local(s: QcPState, what: Str) -> QcPRes[Str] =
  match qc_peek(s) {
    QcTokIdent(id) =>
      if qc_is_qual_std(id) then
        let t = qc_peek_tok(s) in
        qc_pres_err(qc_diag_parse_hint(t.line, t.col, what ++ " names cannot be qualified, found `" ++ id ++ "`", "only definitions (functions, tests, types and variants) have `std.<module>.<name>` names"), s)
      else qc_expect_lower_what(s, what),
    _ => qc_expect_lower_what(s, what)
  }

fn qc_expect_upper_what(s: QcPState, what: Str, allow_qual: Bool) -> QcPRes[Str] =
  match qc_peek(s) {
    QcTokIdent(id) =>
      if !allow_qual && qc_is_qual_std(id) then
        let t = qc_peek_tok(s) in
        qc_pres_err(qc_diag_parse_hint(t.line, t.col, what ++ " names cannot be qualified, found `" ++ id ++ "`", "only definitions (functions, tests, types and variants) have `std.<module>.<name>` names"), s)
      else if !qc_is_upper(id) then
        let t = qc_peek_tok(s) in
        qc_pres_err(qc_diag_parse(t.line, t.col, what ++ " names start with an uppercase letter, found `" ++ id ++ "`"), s)
      else qc_expect_ident(s),
    _ => qc_expect_ident(s)
  }

fn qc_enter(s: QcPState) -> Result[QcPState, QcDiag] =
  if s.depth >= 256 then
    let t = qc_peek_tok(s) in
    Err(qc_diag_parse(t.line, t.col, "expression nested too deeply (max 256 levels)"))
  else
    Ok(QcPState { toks: s.toks, pos: s.pos, depth: s.depth + 1, no_struct: s.no_struct })

fn qc_leave(s: QcPState) -> QcPState =
  QcPState { toks: s.toks, pos: s.pos, depth: s.depth - 1, no_struct: s.no_struct }

# -----------------------------------------------------------------------------
# Type parsing

fn qc_parse_type(s: QcPState) -> QcPRes[QcType] =
  match qc_enter(s) {
    Err(d) => qc_pres_err(d, s),
    Ok(s1) =>
      let r = qc_parse_type_inner(s1) in
      QcPRes { val: r.val, err: r.err, state: qc_leave(r.state) }
  }

fn qc_parse_type_inner(s: QcPState) -> QcPRes[QcType] =
  match qc_peek(s) {
    QcTokSym("(") =>
      let s1 = qc_next(s) in
      let r = qc_parse_type(s1) in
      match r.err {
        Some(d) => qc_pres_err(d, r.state),
        None =>
          match qc_expect_sym(r.state, ")") {
            Err(d) => qc_pres_err(d, r.state),
            Ok(s2) => qc_pres_ok(match r.val { Some(t) => t, None => QcTUnit }, s2)
          }
      },
    QcTokIdent("Int") => qc_pres_ok(QcTInt, qc_next(s)),
    QcTokIdent("Float") => qc_pres_ok(QcTFloat, qc_next(s)),
    QcTokIdent("Bool") => qc_pres_ok(QcTBool, qc_next(s)),
    QcTokIdent("Unit") => qc_pres_ok(QcTUnit, qc_next(s)),
    QcTokIdent("Str") => qc_pres_ok(QcTStr, qc_next(s)),
    QcTokIdent("Bytes") => qc_pres_ok(QcTBytes, qc_next(s)),
    QcTokIdent("List") =>
      let s1 = qc_next(s) in
      match qc_expect_sym(s1, "[") {
        Err(d) => qc_pres_err(d, s1),
        Ok(s2) =>
          let elem_r = qc_parse_type(s2) in
          match elem_r.err {
            Some(d) => qc_pres_err(d, elem_r.state),
            None =>
              match qc_expect_sym(elem_r.state, "]") {
                Err(d) => qc_pres_err(d, elem_r.state),
                Ok(s3) => qc_pres_ok(QcTList(match elem_r.val { Some(t) => t, None => QcTUnit }), s3)
              }
          }
      },
    QcTokIdent("Option") =>
      let s1 = qc_next(s) in
      match qc_expect_sym(s1, "[") {
        Err(d) => qc_pres_err(d, s1),
        Ok(s2) =>
          let elem_r = qc_parse_type(s2) in
          match elem_r.err {
            Some(d) => qc_pres_err(d, elem_r.state),
            None =>
              match qc_expect_sym(elem_r.state, "]") {
                Err(d) => qc_pres_err(d, elem_r.state),
                Ok(s3) => qc_pres_ok(QcTOption(match elem_r.val { Some(t) => t, None => QcTUnit }), s3)
              }
          }
      },
    QcTokIdent("Result") =>
      let s1 = qc_next(s) in
      match qc_expect_sym(s1, "[") {
        Err(d) => qc_pres_err(d, s1),
        Ok(s2) =>
          let ok_r = qc_parse_type(s2) in
          match ok_r.err {
            Some(d) => qc_pres_err(d, ok_r.state),
            None =>
              match qc_expect_sym(ok_r.state, ",") {
                Err(d) => qc_pres_err(d, ok_r.state),
                Ok(s3) =>
                  let err_r = qc_parse_type(s3) in
                  match err_r.err {
                    Some(d) => qc_pres_err(d, err_r.state),
                    None =>
                      match qc_expect_sym(err_r.state, "]") {
                        Err(d) => qc_pres_err(d, err_r.state),
                        Ok(s4) =>
                          qc_pres_ok(QcTResult(match ok_r.val { Some(t) => t, None => QcTUnit },
                                              match err_r.val { Some(t) => t, None => QcTUnit }), s4)
                      }
                  }
              }
          }
      },
    QcTokIdent("Map") =>
      let s1 = qc_next(s) in
      match qc_expect_sym(s1, "[") {
        Err(d) => qc_pres_err(d, s1),
        Ok(s2) =>
          let k_r = qc_parse_type(s2) in
          match k_r.err {
            Some(d) => qc_pres_err(d, k_r.state),
            None =>
              match qc_expect_sym(k_r.state, ",") {
                Err(d) => qc_pres_err(d, k_r.state),
                Ok(s3) =>
                  let v_r = qc_parse_type(s3) in
                  match v_r.err {
                    Some(d) => qc_pres_err(d, v_r.state),
                    None =>
                      match qc_expect_sym(v_r.state, "]") {
                        Err(d) => qc_pres_err(d, v_r.state),
                        Ok(s4) =>
                          qc_pres_ok(QcTMap(match k_r.val { Some(t) => t, None => QcTUnit },
                                           match v_r.val { Some(t) => t, None => QcTUnit }), s4)
                      }
                  }
              }
          }
      },
    QcTokIdent("fn") =>
      qc_parse_fn_type(qc_next(s)),
    QcTokIdent(name) =>
      if !qc_is_upper(name) then
        qc_err_here(s, "expected a type (e.g. Int, Str, List[Int]), found `" ++ name ++ "`")
      else
        let s1 = qc_next(s) in
        if qc_check_sym(s1, "[") then
          let s2 = qc_next(s1) in
          if qc_check_sym(s2, "]") then
            qc_err_here(s2, "`" ++ name ++ "[]` needs at least one type argument")
          else
            let args_r = qc_parse_type_args(s2, AccEnd) in
            match args_r.err {
              Some(d) => qc_pres_err(d, args_r.state),
              None => qc_pres_ok(QcTApp(name, match args_r.val { Some(l) => l, None => [] }), args_r.state)
            }
        else
          qc_pres_ok(QcTNamed(name), s1),
    _ => qc_err_here(s, "expected a type")
  }

fn qc_parse_type_args(s: QcPState, acc: Accum[QcType]) -> QcPRes[List[QcType]] =
  if qc_check_sym(s, "]") then
    qc_pres_ok(acc_list(acc), qc_next(s))
  else
    let r = qc_parse_type(s) in
    match r.err {
      Some(d) => qc_pres_err(d, r.state),
      None =>
        let t = match r.val { Some(x) => x, None => QcTUnit } in
        let s2 = r.state in
        if qc_check_sym(s2, ",") then
          let s3 = qc_next(s2) in
          if qc_check_sym(s3, "]") then qc_pres_ok(acc_list(AccPush(acc, t)), qc_next(s3))
          else qc_parse_type_args(s3, AccPush(acc, t))
        else if qc_check_sym(s2, "]") then
          qc_pres_ok(acc_list(AccPush(acc, t)), qc_next(s2))
        else
          qc_err_here(s2, "expected `,` or `]`")
    }

fn qc_parse_fn_type(s: QcPState) -> QcPRes[QcType] =
  match qc_expect_sym(s, "(") {
    Err(d) => qc_pres_err(d, s),
    Ok(s1) =>
      let params_r = qc_parse_fn_type_params(s1, AccEnd) in
      match params_r.err {
        Some(d) => qc_pres_err(d, params_r.state),
        None =>
          match qc_expect_sym(params_r.state, "->") {
            Err(d) => qc_pres_err(d, params_r.state),
            Ok(s2) =>
              let ret_r = qc_parse_type(s2) in
              match ret_r.err {
                Some(d) => qc_pres_err(d, ret_r.state),
                None =>
                  let eff_r = qc_parse_effects(ret_r.state, AccEnd) in
                  qc_pres_ok(QcTFn(match params_r.val { Some(p) => p, None => [] },
                                  match ret_r.val { Some(r) => r, None => QcTUnit },
                                  match eff_r.val { Some(e) => e, None => [] }), eff_r.state)
              }
          }
      }
  }

fn qc_parse_fn_type_params(s: QcPState, acc: Accum[QcType]) -> QcPRes[List[QcType]] =
  if qc_check_sym(s, ")") then
    qc_pres_ok(acc_list(acc), qc_next(s))
  else
    let r = qc_parse_type(s) in
    match r.err {
      Some(d) => qc_pres_err(d, r.state),
      None =>
        let t = match r.val { Some(x) => x, None => QcTUnit } in
        let s2 = r.state in
        if qc_check_sym(s2, ",") then
          let s3 = qc_next(s2) in
          if qc_check_sym(s3, ")") then qc_pres_ok(acc_list(AccPush(acc, t)), qc_next(s3))
          else qc_parse_fn_type_params(s3, AccPush(acc, t))
        else if qc_check_sym(s2, ")") then
          qc_pres_ok(acc_list(AccPush(acc, t)), qc_next(s2))
        else
          qc_err_here(s2, "expected `,` or `)`")
    }

fn qc_insert_sorted_str_rec(xs: List[Str], s: Str, idx: Int, acc: Accum[Str]) -> List[Str] =
  if idx >= len(xs) then acc_list(AccPush(acc, s))
  else
    let cur = list_at(xs, idx) in
    if s == cur then xs
    else if s < cur then
      qc_append_rest_str(xs, idx, AccPush(acc, s))
    else
      qc_insert_sorted_str_rec(xs, s, idx + 1, AccPush(acc, cur))

fn qc_append_rest_str(xs: List[Str], idx: Int, acc: Accum[Str]) -> List[Str] =
  if idx >= len(xs) then acc_list(acc)
  else qc_append_rest_str(xs, idx + 1, AccPush(acc, list_at(xs, idx)))

fn qc_insert_sorted_str(xs: List[Str], s: Str) -> List[Str] =
  qc_insert_sorted_str_rec(xs, s, 0, AccEnd)

fn qc_sort_dedup_strs(xs: List[Str]) -> List[Str] =
  fold(xs, [], qc_insert_sorted_str)

fn qc_parse_effects(s: QcPState, acc: Accum[Str]) -> QcPRes[List[Str]] =
  if qc_check_sym(s, "!") then
    let s1 = qc_next(s) in
    let id_r = qc_expect_local(s1, "effect") in
    match id_r.err {
      Some(d) => qc_pres_err(d, id_r.state),
      None => qc_parse_effects(id_r.state, AccPush(acc, match id_r.val { Some(id) => id, None => "" }))
    }
  else
    qc_pres_ok(qc_sort_dedup_strs(acc_list(acc)), s)

# -----------------------------------------------------------------------------
# Expressions

fn qc_parse_expr(s: QcPState) -> QcPRes[QcExpr] =
  match qc_enter(s) {
    Err(d) => qc_pres_err(d, s),
    Ok(s1) =>
      let r = qc_parse_expr_inner(s1) in
      QcPRes { val: r.val, err: r.err, state: qc_leave(r.state) }
  }

fn qc_parse_expr_inner(s: QcPState) -> QcPRes[QcExpr] =
  match qc_peek(s) {
    QcTokIdent("let") => qc_parse_let(qc_next(s)),
    QcTokIdent("if") => qc_parse_if(qc_next(s)),
    QcTokIdent("match") => qc_parse_match(qc_next(s)),
    _ => qc_parse_binary(s, 1)
  }

fn qc_parse_let(s: QcPState) -> QcPRes[QcExpr] =
  let name_r = qc_expect_local(s, "variable") in
  match name_r.err {
    Some(d) => qc_pres_err(d, name_r.state),
    None =>
      let name = match name_r.val { Some(n) => n, None => "" } in
      let s1 = name_r.state in
      let ty_r =
        if qc_check_sym(s1, ":") then
          let tr = qc_parse_type(qc_next(s1)) in
          match tr.err {
            Some(d) => QcPRes { val: None, err: Some(d), state: tr.state },
            None => QcPRes { val: Some(tr.val), err: None, state: tr.state }
          }
        else
          QcPRes { val: Some(None), err: None, state: s1 } in
      match ty_r.err {
        Some(d) => qc_pres_err(d, ty_r.state),
        None =>
          let ann = match ty_r.val { Some(opt) => opt, None => None } in
          match qc_expect_sym(ty_r.state, "=") {
            Err(d) => qc_pres_err(d, ty_r.state),
            Ok(s2) =>
              let val_r = qc_parse_expr(s2) in
              match val_r.err {
                Some(d) => qc_pres_err(d, val_r.state),
                None =>
                  match qc_expect_kw(val_r.state, "in") {
                    Err(d) => qc_pres_err(d, val_r.state),
                    Ok(s3) =>
                      let body_r = qc_parse_expr(s3) in
                      match body_r.err {
                        Some(d) => qc_pres_err(d, body_r.state),
                        None =>
                          qc_pres_ok(QcELet(name, ann,
                                           match val_r.val { Some(v) => v, None => QcEUnit },
                                           match body_r.val { Some(b) => b, None => QcEUnit }), body_r.state)
                      }
                  }
              }
          }
      }
  }

fn qc_parse_if(s: QcPState) -> QcPRes[QcExpr] =
  let c_r = qc_parse_expr(s) in
  match c_r.err {
    Some(d) => qc_pres_err(d, c_r.state),
    None =>
      match qc_expect_kw(c_r.state, "then") {
        Err(d) => qc_pres_err(d, c_r.state),
        Ok(s1) =>
          let t_r = qc_parse_expr(s1) in
          match t_r.err {
            Some(d) => qc_pres_err(d, t_r.state),
            None =>
              match qc_expect_kw(t_r.state, "else") {
                Err(d) => qc_pres_err(d, t_r.state),
                Ok(s2) =>
                  let e_r = qc_parse_expr(s2) in
                  match e_r.err {
                    Some(d) => qc_pres_err(d, e_r.state),
                    None =>
                      qc_pres_ok(QcEIf(match c_r.val { Some(c) => c, None => QcEUnit },
                                      match t_r.val { Some(t) => t, None => QcEUnit },
                                      match e_r.val { Some(e) => e, None => QcEUnit }), e_r.state)
                  }
              }
          }
      }
  }

fn qc_parse_match(s: QcPState) -> QcPRes[QcExpr] =
  let s_scrut = QcPState { toks: s.toks, pos: s.pos, depth: s.depth, no_struct: true } in
  let scrut_r = qc_parse_expr(s_scrut) in
  match scrut_r.err {
    Some(d) => qc_pres_err(d, scrut_r.state),
    None =>
      let s1 = QcPState { toks: scrut_r.state.toks, pos: scrut_r.state.pos, depth: scrut_r.state.depth, no_struct: s.no_struct } in
      match qc_expect_sym(s1, "{") {
        Err(d) => qc_pres_err(d, s1),
        Ok(s2) =>
          let arms_r = qc_parse_arms(s2, AccEnd) in
          match arms_r.err {
            Some(d) => qc_pres_err(d, arms_r.state),
            None =>
              qc_pres_ok(QcEMatch(match scrut_r.val { Some(sc) => sc, None => QcEUnit },
                                 match arms_r.val { Some(ar) => ar, None => [] }), arms_r.state)
          }
      }
  }

fn qc_parse_arms(s: QcPState, acc: Accum[QcArm]) -> QcPRes[List[QcArm]] =
  if qc_check_sym(s, "}") then
    qc_pres_ok(acc_list(acc), qc_next(s))
  else
    let pat_r = qc_parse_pat(s) in
    match pat_r.err {
      Some(d) => qc_pres_err(d, pat_r.state),
      None =>
        let pat = match pat_r.val { Some(p) => p, None => QcPWild } in
        let s1 = pat_r.state in
        let guard_r =
          if qc_check_ident(s1, "if") then
            let gr = qc_parse_expr(qc_next(s1)) in
            match gr.err {
              Some(d) => QcPRes { val: None, err: Some(d), state: gr.state },
              None => QcPRes { val: Some(gr.val), err: None, state: gr.state }
            }
          else QcPRes { val: Some(None), err: None, state: s1 } in
        match guard_r.err {
          Some(d) => qc_pres_err(d, guard_r.state),
          None =>
            let guard = match guard_r.val { Some(g) => g, None => None } in
            match qc_expect_sym(guard_r.state, "=>") {
              Err(d) => qc_pres_err(d, guard_r.state),
              Ok(s2) =>
                let body_r = qc_parse_expr(s2) in
                match body_r.err {
                  Some(d) => qc_pres_err(d, body_r.state),
                  None =>
                    let body = match body_r.val { Some(b) => b, None => QcEUnit } in
                    let arm = QcArm { pat: pat, guard: guard, body: body } in
                    let s3 = body_r.state in
                    if qc_check_sym(s3, ",") then
                      let s4 = qc_next(s3) in
                      if qc_check_sym(s4, "}") then qc_pres_ok(acc_list(AccPush(acc, arm)), qc_next(s4))
                      else qc_parse_arms(s4, AccPush(acc, arm))
                    else if qc_check_sym(s3, "}") then
                      qc_pres_ok(acc_list(AccPush(acc, arm)), qc_next(s3))
                    else
                      qc_err_here(s3, "expected `,` or `}`")
                }
            }
        }
    }

fn qc_parse_closure(s: QcPState) -> QcPRes[QcExpr] =
  match qc_expect_sym(s, "(") {
    Err(d) => qc_pres_err(d, s),
    Ok(s1) =>
      let ps_r = qc_parse_closure_params(s1, AccEnd) in
      match ps_r.err {
        Some(d) => qc_pres_err(d, ps_r.state),
        None =>
          match qc_expect_sym(ps_r.state, "=>") {
            Err(d) => qc_pres_err(d, ps_r.state),
            Ok(s2) =>
              let body_r = qc_parse_expr(s2) in
              match body_r.err {
                Some(d) => qc_pres_err(d, body_r.state),
                None =>
                  qc_pres_ok(QcELambda(match ps_r.val { Some(p) => p, None => [] },
                                      match body_r.val { Some(b) => b, None => QcEUnit }), body_r.state)
              }
          }
      }
  }

fn qc_parse_closure_params(s: QcPState, acc: Accum[QcLambdaParam]) -> QcPRes[List[QcLambdaParam]] =
  if qc_check_sym(s, ")") then
    qc_pres_ok(acc_list(acc), qc_next(s))
  else
    let id_r = qc_expect_local(s, "parameter") in
    match id_r.err {
      Some(d) => qc_pres_err(d, id_r.state),
      None =>
        let name = match id_r.val { Some(n) => n, None => "" } in
        let s1 = id_r.state in
        let ty_r =
          if qc_check_sym(s1, ":") then
            let tr = qc_parse_type(qc_next(s1)) in
            match tr.err {
              Some(d) => QcPRes { val: None, err: Some(d), state: tr.state },
              None => QcPRes { val: Some(tr.val), err: None, state: tr.state }
            }
          else QcPRes { val: Some(None), err: None, state: s1 } in
        match ty_r.err {
          Some(d) => qc_pres_err(d, ty_r.state),
          None =>
            let p = QcLambdaParam { name: name, ty: match ty_r.val { Some(opt) => opt, None => None } } in
            let s2 = ty_r.state in
            if qc_check_sym(s2, ",") then
              let s3 = qc_next(s2) in
              if qc_check_sym(s3, ")") then qc_pres_ok(acc_list(AccPush(acc, p)), qc_next(s3))
              else qc_parse_closure_params(s3, AccPush(acc, p))
            else if qc_check_sym(s2, ")") then
              qc_pres_ok(acc_list(AccPush(acc, p)), qc_next(s2))
            else
              qc_err_here(s2, "expected `,` or `)`")
        }
    }

fn qc_parse_binary(s: QcPState, min_prec: Int) -> QcPRes[QcExpr] =
  let left_r = qc_parse_unary(s) in
  match left_r.err {
    Some(d) => qc_pres_err(d, left_r.state),
    None => qc_climb_precedence(left_r.state, match left_r.val { Some(l) => l, None => QcEUnit }, min_prec)
  }

fn qc_peek_binop(s: QcPState) -> Option[QcBinOp] =
  match qc_peek(s) {
    QcTokSym("+") => Some(QcOpAdd),
    QcTokSym("-") => Some(QcOpSub),
    QcTokSym("*") => Some(QcOpMul),
    QcTokSym("/") => Some(QcOpDiv),
    QcTokSym("%") => Some(QcOpRem),
    QcTokSym("++") => Some(QcOpConcat),
    QcTokSym("==") => Some(QcOpEq),
    QcTokSym("!=") => Some(QcOpNe),
    QcTokSym("<") => Some(QcOpLt),
    QcTokSym("<=") => Some(QcOpLe),
    QcTokSym(">") => Some(QcOpGt),
    QcTokSym(">=") => Some(QcOpGe),
    QcTokSym("&&") => Some(QcOpAnd),
    QcTokSym("||") => Some(QcOpOr),
    _ => None
  }

fn qc_climb_precedence(s: QcPState, left: QcExpr, min_prec: Int) -> QcPRes[QcExpr] =
  match qc_peek_binop(s) {
    None => qc_pres_ok(left, s),
    Some(op) =>
      let prec = qc_binop_prec(op) in
      if prec < min_prec then qc_pres_ok(left, s)
      else
        let s1 = qc_next(s) in
        let next_min = prec + 1 in
        let right_r = qc_parse_binary(s1, next_min) in
        match right_r.err {
          Some(d) => qc_pres_err(d, right_r.state),
          None =>
            let right = match right_r.val { Some(r) => r, None => QcEUnit } in
            let new_left = QcEBin(op, left, right) in
            let s2 = right_r.state in
            if qc_binop_is_comparison(op) && (match qc_peek_binop(s2) { Some(next_op) => qc_binop_is_comparison(next_op), None => false }) then
              qc_err_here(s2, "comparisons cannot be chained; use `&&`")
            else
              qc_climb_precedence(s2, new_left, min_prec)
        }
  }

fn qc_parse_unary(s: QcPState) -> QcPRes[QcExpr] =
  match qc_peek(s) {
    QcTokSym("-") =>
      let s1 = qc_next(s) in
      match qc_enter(s1) {
        Err(d) => qc_pres_err(d, s1),
        Ok(s2) =>
          let r = qc_parse_unary(s2) in
          let s_out = qc_leave(r.state) in
          match r.err {
            Some(d) => qc_pres_err(d, s_out),
            None => qc_pres_ok(QcEUn(QcUnNeg, match r.val { Some(e) => e, None => QcEUnit }), s_out)
          }
      },
    QcTokSym("!") =>
      let s1 = qc_next(s) in
      match qc_enter(s1) {
        Err(d) => qc_pres_err(d, s1),
        Ok(s2) =>
          let r = qc_parse_unary(s2) in
          let s_out = qc_leave(r.state) in
          match r.err {
            Some(d) => qc_pres_err(d, s_out),
            None => qc_pres_ok(QcEUn(QcUnNot, match r.val { Some(e) => e, None => QcEUnit }), s_out)
          }
      },
    _ => qc_parse_postfix(s)
  }

fn qc_parse_postfix(s: QcPState) -> QcPRes[QcExpr] =
  let atom_r = qc_parse_atom(s) in
  match atom_r.err {
    Some(d) => qc_pres_err(d, atom_r.state),
    None => qc_postfix_fields(atom_r.state, match atom_r.val { Some(e) => e, None => QcEUnit })
  }

fn qc_postfix_fields(s: QcPState, target: QcExpr) -> QcPRes[QcExpr] =
  if qc_check_sym(s, ".") then
    let s1 = qc_next(s) in
    let id_r = qc_expect_local(s1, "field") in
    match id_r.err {
      Some(d) => qc_pres_err(d, id_r.state),
      None =>
        let f = match id_r.val { Some(n) => n, None => "" } in
        qc_postfix_fields(id_r.state, QcEField(target, f))
    }
  else
    qc_pres_ok(target, s)

fn qc_parse_atom(s: QcPState) -> QcPRes[QcExpr] =
  match qc_peek(s) {
    QcTokInt(n) =>
      if n >= 0 then qc_pres_ok(QcEInt(n), qc_next(s))
      else qc_err_here(s, "integer literal `9223372036854775808` does not fit in Int (64-bit); write `-9223372036854775807 - 1` for the minimum"),
    QcTokFloat(f) => qc_pres_ok(QcEFloat(f), qc_next(s)),
    QcTokStr(str_val) => qc_pres_ok(QcEStr(str_val), qc_next(s)),
    QcTokIdent("true") => qc_pres_ok(QcEBool(true), qc_next(s)),
    QcTokIdent("false") => qc_pres_ok(QcEBool(false), qc_next(s)),
    QcTokSym("(") =>
      let s1 = QcPState { toks: s.toks, pos: s.pos + 1, depth: s.depth, no_struct: false } in
      if qc_check_sym(s1, ")") then qc_pres_ok(QcEUnit, QcPState { toks: s1.toks, pos: s1.pos + 1, depth: s1.depth, no_struct: s.no_struct })
      else
        let r = qc_parse_expr(s1) in
        match r.err {
          Some(d) => qc_pres_err(d, r.state),
          None =>
            match qc_expect_sym(r.state, ")") {
              Err(d) => qc_pres_err(d, r.state),
              Ok(s2) => qc_pres_ok(match r.val { Some(e) => e, None => QcEUnit }, QcPState { toks: s2.toks, pos: s2.pos, depth: s2.depth, no_struct: s.no_struct })
            }
        },
    QcTokSym("[") =>
      let s1 = QcPState { toks: s.toks, pos: s.pos + 1, depth: s.depth, no_struct: false } in
      if qc_check_sym(s1, "]") then qc_pres_ok(QcEList([]), QcPState { toks: s1.toks, pos: s1.pos + 1, depth: s1.depth, no_struct: s.no_struct })
      else
        let items_r = qc_parse_expr_list(s1, AccEnd) in
        match items_r.err {
          Some(d) => qc_pres_err(d, items_r.state),
          None => qc_pres_ok(QcEList(match items_r.val { Some(l) => l, None => [] }), QcPState { toks: items_r.state.toks, pos: items_r.state.pos, depth: items_r.state.depth, no_struct: s.no_struct })
        },
    QcTokSym("{") =>
      let s1 = QcPState { toks: s.toks, pos: s.pos + 1, depth: s.depth, no_struct: false } in
      let seq_r = qc_parse_seq_exprs(s1, AccEnd) in
      match seq_r.err {
        Some(d) => qc_pres_err(d, seq_r.state),
        None => qc_pres_ok(QcESeq(match seq_r.val { Some(l) => l, None => [] }), QcPState { toks: seq_r.state.toks, pos: seq_r.state.pos, depth: seq_r.state.depth, no_struct: s.no_struct })
      },
    QcTokIdent(id) =>
      if id == "fn" && qc_check_sym(qc_next(s), "(") then
        let s1 = QcPState { toks: s.toks, pos: s.pos + 1, depth: s.depth, no_struct: false } in
        let r = qc_parse_closure(s1) in
        match r.err {
          Some(d) => qc_pres_err(d, r.state),
          None => qc_pres_ok(match r.val { Some(v) => v, None => QcEUnit }, QcPState { toks: r.state.toks, pos: r.state.pos, depth: r.state.depth, no_struct: s.no_struct })
        }
      else if qc_is_keyword(id) then
        let t = qc_peek_tok(s) in
        let extra = if id == "if" || id == "let" || id == "match" then " (wrap the `" ++ id ++ "` expression in parentheses here)" else "" in
        qc_pres_err(qc_diag_parse(t.line, t.col, "expected an expression, found `" ++ id ++ "`" ++ extra), s)
      else if qc_is_upper(id) && !s.no_struct && qc_check_sym(qc_next(s), "{") then
        let s2 = QcPState { toks: s.toks, pos: s.pos + 2, depth: s.depth, no_struct: false } in
        let r = qc_parse_record_literal(s2, id, AccEnd) in
        match r.err {
          Some(d) => qc_pres_err(d, r.state),
          None => qc_pres_ok(match r.val { Some(v) => v, None => QcEUnit }, QcPState { toks: r.state.toks, pos: r.state.pos, depth: r.state.depth, no_struct: s.no_struct })
        }
      else
        let s1 = qc_next(s) in
        if qc_check_sym(s1, "(") then
          let s2 = QcPState { toks: s1.toks, pos: s1.pos + 1, depth: s1.depth, no_struct: false } in
          if qc_check_sym(s2, ")") then qc_pres_ok(QcECall(id, []), QcPState { toks: s2.toks, pos: s2.pos + 1, depth: s2.depth, no_struct: s.no_struct })
          else
            let args_r = qc_parse_call_args(s2, AccEnd) in
            match args_r.err {
              Some(d) => qc_pres_err(d, args_r.state),
              None => qc_pres_ok(QcECall(id, match args_r.val { Some(a) => a, None => [] }), QcPState { toks: args_r.state.toks, pos: args_r.state.pos, depth: args_r.state.depth, no_struct: s.no_struct })
            }
        else
          qc_pres_ok(QcEVar(id), s1),
    _ => qc_err_here(s, "expected an expression, found " ++ qc_tok_describe(qc_peek(s)))
  }

fn qc_parse_record_literal(s: QcPState, name: Str, acc: Accum[QcFieldExpr]) -> QcPRes[QcExpr] =
  if qc_check_sym(s, "}") then
    qc_pres_ok(QcERecord(name, acc_list(acc)), qc_next(s))
  else
    let fn_r = qc_expect_local(s, "field") in
    match fn_r.err {
      Some(d) => qc_pres_err(d, fn_r.state),
      None =>
        let fname = match fn_r.val { Some(n) => n, None => "" } in
        match qc_expect_sym(fn_r.state, ":") {
          Err(d) => qc_pres_err(d, fn_r.state),
          Ok(s1) =>
            let val_r = qc_parse_expr(s1) in
            match val_r.err {
              Some(d) => qc_pres_err(d, val_r.state),
              None =>
                let fe = QcFieldExpr { name: fname, expr: match val_r.val { Some(e) => e, None => QcEUnit } } in
                let s2 = val_r.state in
                if qc_check_sym(s2, ",") then
                  let s3 = qc_next(s2) in
                  if qc_check_sym(s3, "}") then qc_pres_ok(QcERecord(name, acc_list(AccPush(acc, fe))), qc_next(s3))
                  else qc_parse_record_literal(s3, name, AccPush(acc, fe))
                else if qc_check_sym(s2, "}") then
                  qc_pres_ok(QcERecord(name, acc_list(AccPush(acc, fe))), qc_next(s2))
                else
                  qc_err_here(s2, "expected `,` or `}`")
            }
        }
    }

fn qc_parse_call_args(s: QcPState, acc: Accum[QcExpr]) -> QcPRes[List[QcExpr]] =
  if qc_check_sym(s, ")") then
    qc_pres_ok(acc_list(acc), qc_next(s))
  else
    let r = qc_parse_expr(s) in
    match r.err {
      Some(d) => qc_pres_err(d, r.state),
      None =>
        let e = match r.val { Some(x) => x, None => QcEUnit } in
        let s1 = r.state in
        if qc_check_sym(s1, ",") then
          let s2 = qc_next(s1) in
          if qc_check_sym(s2, ")") then qc_pres_ok(acc_list(AccPush(acc, e)), qc_next(s2))
          else qc_parse_call_args(s2, AccPush(acc, e))
        else if qc_check_sym(s1, ")") then
          qc_pres_ok(acc_list(AccPush(acc, e)), qc_next(s1))
        else
          qc_err_here(s1, "expected `,` or `)`")
    }

fn qc_parse_expr_list(s: QcPState, acc: Accum[QcExpr]) -> QcPRes[List[QcExpr]] =
  if qc_check_sym(s, "]") then
    qc_pres_ok(acc_list(acc), qc_next(s))
  else
    let r = qc_parse_expr(s) in
    match r.err {
      Some(d) => qc_pres_err(d, r.state),
      None =>
        let e = match r.val { Some(x) => x, None => QcEUnit } in
        let s1 = r.state in
        if qc_check_sym(s1, ",") then
          let s2 = qc_next(s1) in
          if qc_check_sym(s2, "]") then qc_pres_ok(acc_list(AccPush(acc, e)), qc_next(s2))
          else qc_parse_expr_list(s2, AccPush(acc, e))
        else if qc_check_sym(s1, "]") then
          qc_pres_ok(acc_list(AccPush(acc, e)), qc_next(s1))
        else
          qc_err_here(s1, "expected `,` or `]`")
    }

fn qc_parse_seq_exprs(s: QcPState, acc: Accum[QcExpr]) -> QcPRes[List[QcExpr]] =
  let r = qc_parse_expr(s) in
  match r.err {
    Some(d) => qc_pres_err(d, r.state),
    None =>
      let e = match r.val { Some(x) => x, None => QcEUnit } in
      let s1 = r.state in
      if qc_check_sym(s1, ";") then
        let s2 = qc_next(s1) in
        qc_parse_seq_exprs(s2, AccPush(acc, e))
      else if qc_check_sym(s1, "}") then
        qc_pres_ok(acc_list(AccPush(acc, e)), qc_next(s1))
      else
        qc_err_here(s1, "expected `;` or `}`")
  }

# -----------------------------------------------------------------------------
# Patterns

fn qc_parse_pat(s: QcPState) -> QcPRes[QcPat] =
  match qc_enter(s) {
    Err(d) => qc_pres_err(d, s),
    Ok(s1) =>
      let r = qc_parse_pat_inner(s1) in
      QcPRes { val: r.val, err: r.err, state: qc_leave(r.state) }
  }

fn qc_parse_pat_inner(s: QcPState) -> QcPRes[QcPat] =
  match qc_peek(s) {
    QcTokIdent("_") => qc_pres_ok(QcPWild, qc_next(s)),
    QcTokSym("_") => qc_pres_ok(QcPWild, qc_next(s)),
    QcTokInt(n) =>
      if n >= 0 then qc_pres_ok(QcPInt(n), qc_next(s))
      else qc_err_here(s, "integer literal `9223372036854775808` does not fit in Int (64-bit); write `-9223372036854775807 - 1` for the minimum"),
    QcTokStr(str_val) => qc_pres_ok(QcPStr(str_val), qc_next(s)),
    QcTokIdent("true") => qc_pres_ok(QcPBool(true), qc_next(s)),
    QcTokIdent("false") => qc_pres_ok(QcPBool(false), qc_next(s)),
    QcTokSym("(") =>
      if qc_check_sym(qc_next(s), ")") then
        qc_pres_ok(QcPUnit, qc_next(qc_next(s)))
      else
        qc_err_here(s, "expected a pattern"),
    QcTokSym("-") =>
      let s1 = qc_next(s) in
      match qc_peek(s1) {
        QcTokInt(n) =>
          let neg_n = if n < 0 then n else -n in
          qc_pres_ok(QcPInt(neg_n), qc_next(s1)),
        _ => qc_err_here(s, "expected a pattern")
      },
    QcTokIdent(id) =>
      if qc_is_upper(id) then
        let s1 = qc_next(s) in
        if qc_check_sym(s1, "(") then
          let s2 = qc_next(s1) in
          if qc_check_sym(s2, ")") then qc_pres_ok(QcPVariant(id, []), qc_next(s2))
          else
            let sub_r = qc_parse_pat_list(s2, AccEnd) in
            match sub_r.err {
              Some(d) => qc_pres_err(d, sub_r.state),
              None => qc_pres_ok(QcPVariant(id, match sub_r.val { Some(l) => l, None => [] }), sub_r.state)
            }
        else if qc_check_sym(s1, "{") then
          qc_parse_pat_record_fields(qc_next(s1), id, AccEnd)
        else
          qc_pres_ok(QcPVariant(id, []), s1)
      else
        let vr = qc_expect_local(s, "variable") in
        match vr.err {
          Some(d) => qc_pres_err(d, vr.state),
          None => qc_pres_ok(QcPBind(match vr.val { Some(v) => v, None => "" }), vr.state)
        },
    _ => qc_err_here(s, "expected a pattern")
  }

fn qc_parse_pat_list(s: QcPState, acc: Accum[QcPat]) -> QcPRes[List[QcPat]] =
  if qc_check_sym(s, ")") then
    qc_pres_ok(acc_list(acc), qc_next(s))
  else
    let r = qc_parse_pat(s) in
    match r.err {
      Some(d) => qc_pres_err(d, r.state),
      None =>
        let p = match r.val { Some(x) => x, None => QcPWild } in
        let s1 = r.state in
        if qc_check_sym(s1, ",") then
          let s2 = qc_next(s1) in
          if qc_check_sym(s2, ")") then qc_pres_ok(acc_list(AccPush(acc, p)), qc_next(s2))
          else qc_parse_pat_list(s2, AccPush(acc, p))
        else if qc_check_sym(s1, ")") then
          qc_pres_ok(acc_list(AccPush(acc, p)), qc_next(s1))
        else
          qc_err_here(s1, "expected `,` or `)`")
    }

fn qc_parse_pat_record_fields(s: QcPState, name: Str, acc: Accum[QcFieldPat]) -> QcPRes[QcPat] =
  if qc_check_sym(s, "}") then
    qc_pres_ok(QcPRecord(name, acc_list(acc)), qc_next(s))
  else
    let id_r = qc_expect_local(s, "field") in
    match id_r.err {
      Some(d) => qc_pres_err(d, id_r.state),
      None =>
        let fname = match id_r.val { Some(n) => n, None => "" } in
        let s1 = id_r.state in
        let pat_r =
          if qc_check_sym(s1, ":") then
            qc_parse_pat(qc_next(s1))
          else
            QcPRes { val: Some(QcPBind(fname)), err: None, state: s1 } in
        match pat_r.err {
          Some(d) => qc_pres_err(d, pat_r.state),
          None =>
            let fp = QcFieldPat { name: fname, pat: match pat_r.val { Some(p) => p, None => QcPWild } } in
            let s2 = pat_r.state in
            if qc_check_sym(s2, ",") then
              let s3 = qc_next(s2) in
              if qc_check_sym(s3, "}") then qc_pres_ok(QcPRecord(name, acc_list(AccPush(acc, fp))), qc_next(s3))
              else qc_parse_pat_record_fields(s3, name, AccPush(acc, fp))
            else if qc_check_sym(s2, "}") then
              qc_pres_ok(QcPRecord(name, acc_list(AccPush(acc, fp))), qc_next(s2))
            else
              qc_err_here(s2, "expected `,` or `}`")
        }
    }

# -----------------------------------------------------------------------------
# Definitions and Program

# `[A, B]` after a type name (none: empty).
fn qc_parse_tparams(s: QcPState) -> QcPRes[List[Str]] =
  let r = qc_parse_params_lists(s, false) in
  QcPRes { val: match r.val { Some(h) => Some(h.tps), None => None }, err: r.err, state: r.state }

# `[A, B, !e]` after a definition name: type parameters and effect parameters. Effect parameters
# (`!name`) are accepted only when `effects` is set (functions, not types).
type QcParamsLists = {
  tps: List[Str],
  eps: List[Str]
}

type QcParamItem = {
  is_effect: Bool,
  name: Str
}

fn qc_parse_params_lists(s: QcPState, effects: Bool) -> QcPRes[QcParamsLists] =
  if qc_check_sym(s, "[") then
    let s1 = qc_next(s) in
    if qc_check_sym(s1, "]") then
      qc_err_here(s1, "`[]` needs at least one type parameter")
    else
      qc_parse_params_lists_loop(s1, effects, AccEnd, AccEnd)
  else
    qc_pres_ok(QcParamsLists { tps: [], eps: [] }, s)

fn qc_parse_params_item(s: QcPState, effects: Bool) -> QcPRes[QcParamItem] =
  if qc_check_sym(s, "!") then
    if !effects then
      qc_err_here(s, "a type has no effect parameters; `!e` belongs to a function: `fn f[T, !e](...)`")
    else
      let id_r = qc_expect_local(qc_next(s), "effect parameter") in
      match id_r.err {
        Some(d) => qc_pres_err(d, id_r.state),
        None => qc_pres_ok(QcParamItem { is_effect: true, name: match id_r.val { Some(x) => x, None => "" } }, id_r.state)
      }
  else
    let id_r = qc_expect_upper_what(s, "type parameter", false) in
    match id_r.err {
      Some(d) => qc_pres_err(d, id_r.state),
      None => qc_pres_ok(QcParamItem { is_effect: false, name: match id_r.val { Some(x) => x, None => "" } }, id_r.state)
    }

fn qc_parse_params_lists_loop(s: QcPState, effects: Bool, tps: Accum[Str], eps: Accum[Str]) -> QcPRes[QcParamsLists] =
  if qc_check_sym(s, "]") then
    qc_pres_ok(QcParamsLists { tps: acc_list(tps), eps: acc_list(eps) }, qc_next(s))
  else
    let item_r = qc_parse_params_item(s, effects) in
    match item_r.err {
      Some(d) => qc_pres_err(d, item_r.state),
      None =>
        let item = match item_r.val { Some(x) => x, None => QcParamItem { is_effect: false, name: "" } } in
        let next_tps = if item.is_effect then tps else AccPush(tps, item.name) in
        let next_eps = if item.is_effect then AccPush(eps, item.name) else eps in
        let s1 = item_r.state in
        if qc_check_sym(s1, ",") then
          let s2 = qc_next(s1) in
          if qc_check_sym(s2, "]") then qc_pres_ok(QcParamsLists { tps: acc_list(next_tps), eps: acc_list(next_eps) }, qc_next(s2))
          else qc_parse_params_lists_loop(s2, effects, next_tps, next_eps)
        else if qc_check_sym(s1, "]") then
          qc_pres_ok(QcParamsLists { tps: acc_list(next_tps), eps: acc_list(next_eps) }, qc_next(s1))
        else
          qc_err_here(s1, "expected `,` or `]`")
    }

fn qc_parse_fn_def(s: QcPState) -> QcPRes[QcDef] =
  let name_r = qc_expect_lower_what(s, "function") in
  match name_r.err {
    Some(d) => qc_pres_err(d, name_r.state),
    None =>
      let name = match name_r.val { Some(n) => n, None => "" } in
      let tp_r = qc_parse_params_lists(name_r.state, true) in
      match tp_r.err {
        Some(d) => qc_pres_err(d, tp_r.state),
        None =>
          let heads = match tp_r.val { Some(l) => l, None => QcParamsLists { tps: [], eps: [] } } in
          match qc_expect_sym(tp_r.state, "(") {
            Err(d) => qc_pres_err(d, tp_r.state),
            Ok(s1) =>
              let params_r = qc_parse_fn_params(s1, AccEnd) in
              match params_r.err {
                Some(d) => qc_pres_err(d, params_r.state),
                None =>
                  match qc_expect_sym(params_r.state, "->") {
                    Err(d) => qc_pres_err(d, params_r.state),
                    Ok(s2) =>
                      let ret_r = qc_parse_type(s2) in
                      match ret_r.err {
                        Some(d) => qc_pres_err(d, ret_r.state),
                        None =>
                          let eff_r = qc_parse_effects(ret_r.state, AccEnd) in
                          match eff_r.err {
                            Some(d) => qc_pres_err(d, eff_r.state),
                            None =>
                              let contracts_r = qc_parse_contracts(eff_r.state, AccEnd, AccEnd) in
                              match contracts_r.err {
                                Some(d) => qc_pres_err(d, contracts_r.state),
                                None =>
                                  match qc_expect_sym(contracts_r.state, "=") {
                                    Err(d) => qc_pres_err(d, contracts_r.state),
                                    Ok(s3) =>
                                      let body_r = qc_parse_expr(s3) in
                                      match body_r.err {
                                        Some(d) => qc_pres_err(d, body_r.state),
                                        None =>
                                          let fn_def = QcFnDef {
                                            name: name,
                                            tparams: heads.tps,
                                            eparams: heads.eps,
                                            params: match params_r.val { Some(p) => p, None => [] },
                                            ret: match ret_r.val { Some(r) => r, None => QcTUnit },
                                            effects: match eff_r.val { Some(e) => e, None => [] },
                                            reqs: contracts_r.reqs,
                                            enss: contracts_r.enss,
                                            body: match body_r.val { Some(b) => b, None => QcEUnit }
                                          } in
                                          qc_pres_ok(QcDefFn(fn_def), body_r.state)
                                      }
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }

fn qc_parse_fn_params(s: QcPState, acc: Accum[QcFieldType]) -> QcPRes[List[QcFieldType]] =
  if qc_check_sym(s, ")") then
    qc_pres_ok(acc_list(acc), qc_next(s))
  else
    let id_r = qc_expect_local(s, "parameter") in
    match id_r.err {
      Some(d) => qc_pres_err(d, id_r.state),
      None =>
        let name = match id_r.val { Some(n) => n, None => "" } in
        match qc_expect_sym(id_r.state, ":") {
          Err(d) => qc_pres_err(d, id_r.state),
          Ok(s1) =>
            let ty_r = qc_parse_type(s1) in
            match ty_r.err {
              Some(d) => qc_pres_err(d, ty_r.state),
              None =>
                let param = QcFieldType { name: name, ty: match ty_r.val { Some(t) => t, None => QcTUnit } } in
                let s2 = ty_r.state in
                if qc_check_sym(s2, ",") then
                  let s3 = qc_next(s2) in
                  if qc_check_sym(s3, ")") then qc_pres_ok(acc_list(AccPush(acc, param)), qc_next(s3))
                  else qc_parse_fn_params(s3, AccPush(acc, param))
                else if qc_check_sym(s2, ")") then
                  qc_pres_ok(acc_list(AccPush(acc, param)), qc_next(s2))
                else
                  qc_err_here(s2, "expected `,` or `)`")
            }
        }
    }

type QcContractsRes = {
  reqs: List[QcExpr],
  enss: List[QcExpr],
  err: Option[QcDiag],
  state: QcPState
}

fn qc_parse_contracts(s: QcPState, req_acc: Accum[QcExpr], ens_acc: Accum[QcExpr]) -> QcContractsRes =
  if qc_check_ident(s, "req") then
    let r = qc_parse_expr(qc_next(s)) in
    match r.err {
      Some(d) => QcContractsRes { reqs: [], enss: [], err: Some(d), state: r.state },
      None =>
        let expr = match r.val { Some(e) => e, None => QcEUnit } in
        qc_parse_contracts(r.state, AccPush(req_acc, expr), ens_acc)
    }
  else if qc_check_ident(s, "ens") then
    let r = qc_parse_expr(qc_next(s)) in
    match r.err {
      Some(d) => QcContractsRes { reqs: [], enss: [], err: Some(d), state: r.state },
      None =>
        let expr = match r.val { Some(e) => e, None => QcEUnit } in
        qc_parse_contracts(r.state, req_acc, AccPush(ens_acc, expr))
    }
  else
    QcContractsRes { reqs: acc_list(req_acc), enss: acc_list(ens_acc), err: None, state: s }

fn qc_parse_test_def(s: QcPState) -> QcPRes[QcDef] =
  let name_r = qc_expect_lower_what(s, "test") in
  match name_r.err {
    Some(d) => qc_pres_err(d, name_r.state),
    None =>
      let name = match name_r.val { Some(n) => n, None => "" } in
      match qc_expect_sym(name_r.state, "=") {
        Err(d) => qc_pres_err(d, name_r.state),
        Ok(s1) =>
          let body_r = qc_parse_expr(s1) in
          match body_r.err {
            Some(d) => qc_pres_err(d, body_r.state),
            None =>
              let tdef = QcTestDef { name: name, body: match body_r.val { Some(b) => b, None => QcEUnit } } in
              qc_pres_ok(QcDefTest(tdef), body_r.state)
          }
      }
  }

fn qc_parse_type_def(s: QcPState) -> QcPRes[QcDef] =
  let name_r = qc_expect_upper_what(s, "type", true) in
  match name_r.err {
    Some(d) => qc_pres_err(d, name_r.state),
    None =>
      let name = match name_r.val { Some(n) => n, None => "" } in
      let tp_r = qc_parse_tparams(name_r.state) in
      match tp_r.err {
        Some(d) => qc_pres_err(d, tp_r.state),
        None =>
          let params = match tp_r.val { Some(l) => l, None => [] } in
          match qc_expect_sym(tp_r.state, "=") {
            Err(d) => qc_pres_err(d, tp_r.state),
            Ok(s1) =>
              let body_r = qc_parse_type_def_body(s1) in
              match body_r.err {
                Some(d) => qc_pres_err(d, body_r.state),
                None =>
                  let body = match body_r.val { Some(b) => b, None => QcBodyEnum([]) } in
                  let tdef = QcTypeDef { name: name, params: params, body: body } in
                  qc_pres_ok(QcDefType(tdef), body_r.state)
              }
          }
      }
  }

fn qc_wrap_enum(r: QcPRes[List[QcVariant]]) -> QcPRes[QcTypeBody] =
  match r.err {
    Some(d) => qc_pres_err(d, r.state),
    None => qc_pres_ok(QcBodyEnum(match r.val { Some(v) => v, None => [] }), r.state)
  }

fn qc_parse_type_def_body(s: QcPState) -> QcPRes[QcTypeBody] =
  if qc_check_sym(s, "{") then
    let fields_r = qc_parse_record_type_fields(qc_next(s), AccEnd) in
    match fields_r.err {
      Some(d) => qc_pres_err(d, fields_r.state),
      None => qc_pres_ok(QcBodyRecord(match fields_r.val { Some(f) => f, None => [] }), fields_r.state)
    }
  else if qc_check_sym(s, "|") then
    let s1 = qc_next(s) in
    # A lone `|` is an empty enum
    match qc_peek(s1) {
      QcTokIdent("fn") => qc_pres_ok(QcBodyEnum([]), s1),
      QcTokIdent("type") => qc_pres_ok(QcBodyEnum([]), s1),
      QcTokIdent("test") => qc_pres_ok(QcBodyEnum([]), s1),
      QcTokEof => qc_pres_ok(QcBodyEnum([]), s1),
      _ => qc_wrap_enum(qc_parse_enum_variants(s1, AccEnd))
    }
  else
    qc_wrap_enum(qc_parse_enum_variants(s, AccEnd))

fn qc_parse_record_type_fields(s: QcPState, acc: Accum[QcFieldType]) -> QcPRes[List[QcFieldType]] =
  if qc_check_sym(s, "}") then
    qc_pres_ok(acc_list(acc), qc_next(s))
  else
    let id_r = qc_expect_local(s, "field") in
    match id_r.err {
      Some(d) => qc_pres_err(d, id_r.state),
      None =>
        let fname = match id_r.val { Some(n) => n, None => "" } in
        match qc_expect_sym(id_r.state, ":") {
          Err(d) => qc_pres_err(d, id_r.state),
          Ok(s1) =>
            let ty_r = qc_parse_type(s1) in
            match ty_r.err {
              Some(d) => qc_pres_err(d, ty_r.state),
              None =>
                let ft = QcFieldType { name: fname, ty: match ty_r.val { Some(t) => t, None => QcTUnit } } in
                let s2 = ty_r.state in
                if qc_check_sym(s2, ",") then
                  let s3 = qc_next(s2) in
                  if qc_check_sym(s3, "}") then qc_pres_ok(acc_list(AccPush(acc, ft)), qc_next(s3))
                  else qc_parse_record_type_fields(s3, AccPush(acc, ft))
                else if qc_check_sym(s2, "}") then
                  qc_pres_ok(acc_list(AccPush(acc, ft)), qc_next(s2))
                else
                  qc_err_here(s2, "expected `,` or `}`")
            }
        }
    }

fn qc_parse_enum_variants(s: QcPState, acc: Accum[QcVariant]) -> QcPRes[List[QcVariant]] =
  let vname_r = qc_expect_upper_what(s, "variant", true) in
  match vname_r.err {
    Some(d) => qc_pres_err(d, vname_r.state),
    None =>
      let vname = match vname_r.val { Some(n) => n, None => "" } in
      let s1 = vname_r.state in
      let fields_r =
        if qc_check_sym(s1, "(") then
          let pfr = qc_parse_variant_fields(qc_next(s1), AccEnd) in
          match pfr.err {
            Some(d) => QcPRes { val: None, err: Some(d), state: pfr.state },
            None => QcPRes { val: Some(match pfr.val { Some(l) => l, None => [] }), err: None, state: pfr.state }
          }
        else
          QcPRes { val: Some([]), err: None, state: s1 } in
      match fields_r.err {
        Some(d) => qc_pres_err(d, fields_r.state),
        None =>
          let fields = match fields_r.val { Some(f) => f, None => [] } in
          let v = QcVariant { name: vname, fields: fields } in
          let s2 = fields_r.state in
          if qc_check_sym(s2, "|") then
            qc_parse_enum_variants(qc_next(s2), AccPush(acc, v))
          else
            qc_pres_ok(acc_list(AccPush(acc, v)), s2)
      }
  }

fn qc_parse_variant_fields(s: QcPState, acc: Accum[QcType]) -> QcPRes[List[QcType]] =
  if qc_check_sym(s, ")") then
    qc_pres_ok(acc_list(acc), qc_next(s))
  else
    let r = qc_parse_type(s) in
    match r.err {
      Some(d) => qc_pres_err(d, r.state),
      None =>
        let t = match r.val { Some(x) => x, None => QcTUnit } in
        let s1 = r.state in
        if qc_check_sym(s1, ",") then
          let s2 = qc_next(s1) in
          if qc_check_sym(s2, ")") then qc_pres_ok(acc_list(AccPush(acc, t)), qc_next(s2))
          else qc_parse_variant_fields(s2, AccPush(acc, t))
        else if qc_check_sym(s1, ")") then
          qc_pres_ok(acc_list(AccPush(acc, t)), qc_next(s1))
        else
          qc_err_here(s1, "expected `,` or `)`")
    }

fn qc_parse_def(s: QcPState) -> QcPRes[QcDef] =
  match qc_peek(s) {
    QcTokIdent("fn") => qc_parse_fn_def(qc_next(s)),
    QcTokIdent("type") => qc_parse_type_def(qc_next(s)),
    QcTokIdent("test") => qc_parse_test_def(qc_next(s)),
    _ => qc_err_here(s, "expected `fn`, `type` or `test`")
  }

fn qc_parse_defs(s: QcPState, acc: Accum[QcDef]) -> Result[List[QcDef], QcDiag] =
  match qc_peek(s) {
    QcTokEof => Ok(acc_list(acc)),
    _ =>
      let r = qc_parse_def(s) in
      match r.err {
        Some(d) => Err(d),
        None =>
          let d = match r.val { Some(x) => x, None => QcDefTest(QcTestDef { name: "", body: QcEUnit }) } in
          qc_parse_defs(r.state, AccPush(acc, d))
      }
  }

fn qc_parse_tokens(toks: List[QcToken]) -> Result[QcProgram, QcDiag] =
  let state = QcPState { toks: toks, pos: 0, depth: 0, no_struct: false } in
  match qc_parse_defs(state, AccEnd) {
    Err(d) => Err(d),
    Ok(defs) => Ok(QcProgram { defs: defs })
  }

fn qc_parse(src: Str) -> Result[QcProgram, QcDiag] =
  match qc_lex(src) {
    Err(d) => Err(d),
    Ok(toks) => qc_parse_tokens(toks)
  }

test qc_parse_test =
  match qc_parse("type Pair[A, B] = { fst: A, snd: B }\nfn add(x: Int, y: Int) -> Int = x + y\ntest t = add(2, 3) == 5") {
    Ok(p) => len(p.defs) == 3,
    Err(_) => false
  }
# Canonical printer for QAL self-hosting compiler (spec §7: qc_print, port of qal-text/src/printer.rs)

fn qc_hex_digit(d: Int) -> Str =
  if d < 10 then from_char_code(48 + d)
  else from_char_code(97 + (d - 10))

fn qc_to_hex_loop(n: Int, acc: Str) -> Str =
  if n == 0 then (if acc == "" then "0" else acc)
  else
    let d = bit_and(n, 15) in
    qc_to_hex_loop(shr(n, 4), qc_hex_digit(d) ++ acc)

fn qc_to_hex(n: Int) -> Str =
  if n == 0 then "0" else qc_to_hex_loop(n, "")

fn qc_escape_char(ch: Str) -> Str =
  if ch == "\"" then "\\\""
  else if ch == "\\" then "\\\\"
  else if ch == "\n" then "\\n"
  else if ch == "\t" then "\\t"
  else if ch == "\r" then "\\r"
  else if ch == "\0" then "\\0"
  else
    let c = char_code(ch) in
    if c <= 31 || (c >= 127 && c <= 159) then
      "\\u{" ++ qc_to_hex(c) ++ "}"
    else ch

fn qc_print_str(s: Str) -> Str =
  "\"" ++ join(map(chars(s), qc_escape_char), "") ++ "\""

fn qc_print_int(n: Int) -> Str =
  if n < -9223372036854775807 then "(-9223372036854775807 - 1)"
  else if n < 0 then "(-" ++ from_int(-n) ++ ")"
  else from_int(n)

fn qc_print_float(x: Float) -> Str =
  let bits = float_bits(x) in
  let is_neg = bit_and(ushr(bits, 63), 1) == 1 in
  let exp = bit_and(ushr(bits, 52), 2047) in
  let mant = bit_and(bits, 4503599627370495) in
  if exp == 2047 then
    if mant != 0 then "(0.0 / 0.0)"
    else if is_neg then "(-1.0 / 0.0)"
    else "(1.0 / 0.0)"
  else if is_neg then "(-" ++ from_float(-x) ++ ")"
  else from_float(x)

fn qc_print_type(t: QcType) -> Str =
  match t {
    QcTInt => "Int",
    QcTFloat => "Float",
    QcTBool => "Bool",
    QcTUnit => "Unit",
    QcTStr => "Str",
    QcTBytes => "Bytes",
    QcTNamed(n) => n,
    QcTParam(n) => n,
    QcTList(elem) => "List[" ++ qc_print_type(elem) ++ "]",
    QcTOption(elem) => "Option[" ++ qc_print_type(elem) ++ "]",
    QcTResult(ok, err) => "Result[" ++ qc_print_type(ok) ++ ", " ++ qc_print_type(err) ++ "]",
    QcTMap(k, v) => "Map[" ++ qc_print_type(k) ++ ", " ++ qc_print_type(v) ++ "]",
    QcTApp(n, args) => n ++ "[" ++ join(map(args, qc_print_type), ", ") ++ "]",
    QcTVar(_) => "_",
    QcTFn(ps, ret, effs) =>
      let ps_s = join(map(ps, qc_print_type), ", ") in
      let ret_s = qc_print_type(ret) in
      let base = match ret {
        QcTFn(_, _, _) => "fn(" ++ ps_s ++ ") -> (" ++ ret_s ++ ")",
        _ => "fn(" ++ ps_s ++ ") -> " ++ ret_s
      } in
      if len(effs) == 0 then base
      else base ++ " !" ++ join(effs, " !")
  }

fn qc_braces(items: List[Str]) -> Str =
  if len(items) == 0 then "{}"
  else "{ " ++ join(items, ", ") ++ " }"

fn qc_tparams(ps: List[Str]) -> Str =
  if len(ps) == 0 then ""
  else "[" ++ join(ps, ", ") ++ "]"

fn qc_print_pat(p: QcPat) -> Str =
  match p {
    QcPWild => "_",
    QcPBind(n) => n,
    QcPInt(n) => from_int(n),
    QcPStr(s) => qc_print_str(s),
    QcPBool(b) => if b then "true" else "false",
    QcPUnit => "()",
    QcPVariant(n, ps) =>
      if len(ps) == 0 then n
      else n ++ "(" ++ join(map(ps, qc_print_pat), ", ") ++ ")",
    QcPRecord(n, fs) =>
      let fs_s = map(fs, fn(f: QcFieldPat) =>
        match f.pat {
          QcPBind(b) if b == f.name => f.name,
          _ => f.name ++ ": " ++ qc_print_pat(f.pat)
        }
      ) in
      n ++ " " ++ qc_braces(fs_s)
  }

fn qc_binop_sym(op: QcBinOp) -> Str =
  match op {
    QcOpAdd => "+",
    QcOpSub => "-",
    QcOpMul => "*",
    QcOpDiv => "/",
    QcOpRem => "%",
    QcOpConcat => "++",
    QcOpEq => "==",
    QcOpNe => "!=",
    QcOpLt => "<",
    QcOpLe => "<=",
    QcOpGt => ">",
    QcOpGe => ">=",
    QcOpAnd => "&&",
    QcOpOr => "||"
  }

fn qc_prec(e: QcExpr) -> Int =
  match e {
    QcELet(_, _, _, _) => 0,
    QcEIf(_, _, _) => 0,
    QcEMatch(_, _) => 0,
    QcELambda(_, _) => 0,
    QcEBin(op, _, _) => qc_binop_prec(op),
    QcEUn(_, _) => 6,
    QcEField(_, _) => 8,
    _ => 9
  }

fn qc_wrap(e: QcExpr, needs_parens: Bool) -> Str =
  let s = qc_print_expr(e) in
  if needs_parens then "(" ++ s ++ ")" else s

fn qc_has_bare_record_arms_loop(arms: List[QcArm], idx: Int) -> Bool =
  if idx >= len(arms) then false
  else
    let a = list_at(arms, idx) in
    let g_has = match a.guard {
      Some(g) => qc_has_bare_record(g),
      None => false
    } in
    if g_has || qc_has_bare_record(a.body) then true
    else qc_has_bare_record_arms_loop(arms, idx + 1)

fn qc_has_bare_record_arms(arms: List[QcArm]) -> Bool =
  qc_has_bare_record_arms_loop(arms, 0)

fn qc_has_bare_record(e: QcExpr) -> Bool =
  match e {
    QcERecord(_, _) => true,
    QcEBin(_, l, r) => qc_has_bare_record(l) || qc_has_bare_record(r),
    QcEUn(_, x) => qc_has_bare_record(x),
    QcEField(x, _) => qc_has_bare_record(x),
    QcEIf(c, t, f) => qc_has_bare_record(c) || qc_has_bare_record(t) || qc_has_bare_record(f),
    QcELet(_, _, v, b) => qc_has_bare_record(v) || qc_has_bare_record(b),
    QcELambda(_, b) => qc_has_bare_record(b),
    QcEMatch(s, arms) => qc_has_bare_record(s) || qc_has_bare_record_arms(arms),
    _ => false
  }

fn qc_print_expr(e: QcExpr) -> Str =
  match e {
    QcEInt(n) => qc_print_int(n),
    QcEFloat(x) => qc_print_float(x),
    QcEBool(b) => if b then "true" else "false",
    QcEStr(s) => qc_print_str(s),
    QcEUnit => "()",
    QcEVar(v) => v,
    QcECall(f, args) => f ++ "(" ++ join(map(args, qc_print_expr), ", ") ++ ")",
    QcEList(items) => "[" ++ join(map(items, qc_print_expr), ", ") ++ "]",
    QcESeq(items) =>
      if len(items) == 0 then "()"
      else "{ " ++ join(map(items, qc_print_expr), "; ") ++ " }",
    QcERecord(n, fs) =>
      let fs_s = map(fs, fn(f: QcFieldExpr) => f.name ++ ": " ++ qc_print_expr(f.expr)) in
      n ++ " " ++ qc_braces(fs_s),
    QcEField(t, f) =>
      qc_wrap(t, qc_prec(t) < 8) ++ "." ++ f,
    QcEUn(op, x) =>
      let sym = match op {
        QcUnNeg => "-",
        QcUnNot => "!"
      } in
      sym ++ qc_wrap(x, qc_prec(x) < 6),
    QcEBin(op, l, r) =>
      let p = qc_binop_prec(op) in
      let lp = qc_prec(l) in
      let rp = qc_prec(r) in
      let left_parens = lp < p || (qc_binop_is_comparison(op) && lp == p) in
      let right_parens = rp <= p in
      qc_wrap(l, left_parens) ++ " " ++ qc_binop_sym(op) ++ " " ++ qc_wrap(r, right_parens),
    QcEIf(c, t, f) =>
      "if " ++ qc_print_expr(c) ++ " then " ++ qc_print_expr(t) ++ " else " ++ qc_print_expr(f),
    QcELet(n, ann, v, b) =>
      let val_s = qc_print_expr(v) in
      let body_s = qc_print_expr(b) in
      match ann {
        Some(t) => "let " ++ n ++ ": " ++ qc_print_type(t) ++ " = " ++ val_s ++ " in " ++ body_s,
        None => "let " ++ n ++ " = " ++ val_s ++ " in " ++ body_s
      },
    QcEMatch(s, arms) =>
      let arms_s = map(arms, fn(a: QcArm) =>
        let pat_s = qc_print_pat(a.pat) in
        let body_s = qc_print_expr(a.body) in
        match a.guard {
          Some(g) => pat_s ++ " if " ++ qc_print_expr(g) ++ " => " ++ body_s,
          None => pat_s ++ " => " ++ body_s
        }
      ) in
      "match " ++ qc_wrap(s, qc_has_bare_record(s)) ++ " " ++ qc_braces(arms_s),
    QcELambda(params, body) =>
      let ps_s = map(params, fn(p: QcLambdaParam) =>
        match p.ty {
          Some(t) => p.name ++ ": " ++ qc_print_type(t),
          None => p.name
        }
      ) in
      "fn(" ++ join(ps_s, ", ") ++ ") => " ++ qc_print_expr(body)
  }

fn qc_print_type_def(t: QcTypeDef) -> Str =
  let head = "type " ++ t.name ++ qc_tparams(t.params) in
  match t.body {
    QcBodyRecord(fields) =>
      let fs = map(fields, fn(f: QcFieldType) => f.name ++ ": " ++ qc_print_type(f.ty)) in
      head ++ " = " ++ qc_braces(fs),
    QcBodyEnum(variants) =>
      if len(variants) == 0 then head ++ " = |"
      else
        let vs = map(variants, fn(v: QcVariant) =>
          if len(v.fields) == 0 then v.name
          else v.name ++ "(" ++ join(map(v.fields, qc_print_type), ", ") ++ ")"
        ) in
        head ++ " = " ++ join(vs, " | ")
  }

fn qc_join_clauses(prefix: Str, exprs: List[QcExpr]) -> Str =
  let lines = map(exprs, fn(c: QcExpr) => "\n  " ++ prefix ++ " " ++ qc_print_expr(c)) in
  join(lines, "")

fn qc_print_fn_def(f: QcFnDef) -> Str =
  let params_s = join(map(f.params, fn(p: QcFieldType) => p.name ++ ": " ++ qc_print_type(p.ty)), ", ") in
  let name_s = f.name ++ qc_tparams(f.tparams ++ map(f.eparams, fn(e: Str) => "!" ++ e)) in
  let ret_s = qc_print_type(f.ret) in
  let mut_s = match f.ret {
    QcTFn(_, _, _) => "fn " ++ name_s ++ "(" ++ params_s ++ ") -> (" ++ ret_s ++ ")",
    _ => "fn " ++ name_s ++ "(" ++ params_s ++ ") -> " ++ ret_s
  } in
  let with_effs =
    if len(f.effects) == 0 then mut_s
    else mut_s ++ " !" ++ join(f.effects, " !") in
  let with_reqs = with_effs ++ qc_join_clauses("req", f.reqs) in
  let with_enss = with_reqs ++ qc_join_clauses("ens", f.enss) in
  with_enss ++ "\n= " ++ qc_print_expr(f.body)

fn qc_print_test_def(t: QcTestDef) -> Str =
  "test " ++ t.name ++ " = " ++ qc_print_expr(t.body)

fn qc_print_def(d: QcDef) -> Str =
  match d {
    QcDefFn(f) => qc_print_fn_def(f),
    QcDefType(t) => qc_print_type_def(t),
    QcDefTest(t) => qc_print_test_def(t)
  }

fn qc_print_program(p: QcProgram) -> Str =
  let parts = map(p.defs, qc_print_def) in
  let out = join(parts, "\n\n") in
  if out != "" then out ++ "\n" else ""

test qc_print_test =
  let src = "fn add(a: Int, b: Int) -> Int !io\n  req a >= 0\n= a + b * 2\n" in
  match qc_parse(src) {
    Ok(p) => qc_print_program(p) == src,
    Err(_) => false
  }
# Canonical form, content hashing, and decoding for QAL self-hosting compiler (spec §7: qc_canon)

type QcHash = Bytes

fn qc_varint_acc(n: Int, acc: Accum[Int]) -> Accum[Int] =
  let b = bit_and(n, 127) in
  let rest = ushr(n, 7) in
  if rest == 0 then AccPush(acc, b)
  else qc_varint_acc(rest, AccPush(acc, bit_or(b, 128)))

fn qc_i64_acc(n: Int, acc: Accum[Int]) -> Accum[Int] =
  let a0 = AccPush(acc, bit_and(n, 255)) in
  let a1 = AccPush(a0, bit_and(ushr(n, 8), 255)) in
  let a2 = AccPush(a1, bit_and(ushr(n, 16), 255)) in
  let a3 = AccPush(a2, bit_and(ushr(n, 24), 255)) in
  let a4 = AccPush(a3, bit_and(ushr(n, 32), 255)) in
  let a5 = AccPush(a4, bit_and(ushr(n, 40), 255)) in
  let a6 = AccPush(a5, bit_and(ushr(n, 48), 255)) in
  AccPush(a6, bit_and(ushr(n, 56), 255))

fn qc_float_acc(x: Float, acc: Accum[Int]) -> Accum[Int] =
  qc_i64_acc(float_bits(x), acc)

fn qc_bytes_slice_acc(b: Bytes, pos: Int, count: Int, acc: Accum[Int]) -> Accum[Int] =
  if count <= 0 then acc
  else qc_bytes_slice_acc(b, pos + 1, count - 1, AccPush(acc, bytes_at(b, pos)))

fn qc_str_acc(s: Str, acc: Accum[Int]) -> Accum[Int] =
  let b = to_bytes(s) in
  let blen = bytes_len(b) in
  let acc2 = qc_varint_acc(blen, acc) in
  qc_bytes_slice_acc(b, 0, blen, acc2)

fn qc_raw_bytes_acc(b: Bytes, acc: Accum[Int]) -> Accum[Int] =
  qc_bytes_slice_acc(b, 0, bytes_len(b), acc)

fn qc_hash_to_hex_loop(h: Bytes, idx: Int, acc: Str) -> Str =
  if idx >= bytes_len(h) then acc
  else
    let b = bytes_at(h, idx) in
    let hi = qc_hex_digit(ushr(b, 4)) in
    let lo = qc_hex_digit(bit_and(b, 15)) in
    qc_hash_to_hex_loop(h, idx + 1, acc ++ hi ++ lo)

fn qc_hash_to_hex(h: Bytes) -> Str =
  qc_hash_to_hex_loop(h, 0, "")

fn qc_hash_short(h: Bytes) -> Str =
  slice(qc_hash_to_hex(h), 0, 12)

fn qc_is_prelude_type(name: Str) -> Bool =
  name == "HttpHeader" || name == "HttpRequest" || name == "HttpResponse" ||
  name == "HttpCall" || name == "NetError" || name == "SqlValue" ||
  name == "DbRows" || name == "DbError" || name == "ModelResponse" || name == "ModelError" || name == "Accum"

fn qc_prelude_variant_owner(name: Str) -> Option[Str] =
  if name == "NetDenied" || name == "NetInvalid" || name == "NetConnect" || name == "NetTimeout" || name == "NetTooLarge" then Some("NetError")
  else if name == "SqlNull" || name == "SqlInt" || name == "SqlFloat" || name == "SqlText" then Some("SqlValue")
  else if name == "DbConstraint" || name == "DbSql" || name == "DbBusy" || name == "DbFull" || name == "DbTooLarge" then Some("DbError")
  else if name == "ModelDenied" || name == "ModelBudgetExceeded" || name == "ModelFailed" || name == "ModelInvalid" || name == "ModelTimeout" then Some("ModelError")
  else if name == "AccEnd" || name == "AccPush" then Some("Accum")
  else None

fn qc_is_builtin_name(name: Str) -> Bool =
  name == "len" ||
  name == "slice" || name == "split" || name == "join" || name == "trim" ||
  name == "contains" || name == "starts_with" || name == "to_int" || name == "to_float" ||
  name == "from_int" || name == "from_float" || name == "chars" || name == "get" ||
  name == "push" || name == "concat" || name == "map" || name == "filter" ||
  name == "fold" || name == "range" || name == "reverse" || name == "sort_int" ||
  name == "int_to_float" || name == "float_to_int" || name == "print" || name == "read_line" ||
  name == "read_file" || name == "write_file" || name == "now_ms" || name == "rand_int" ||
  name == "read_all" || name == "sort_str" || name == "char_code" || name == "from_char_code" ||
  name == "to_upper" || name == "to_lower" || name == "replace" || name == "index_of" ||
  name == "map_new" || name == "map_get" || name == "map_put" || name == "map_del" ||
  name == "map_has" || name == "map_size" || name == "map_keys" || name == "map_values" ||
  name == "to_bytes" || name == "bytes_len" || name == "bytes_get" || name == "bytes_slice" ||
  name == "bytes_from" || name == "bytes_to_list" || name == "bytes_to_str" || name == "compare" ||
  name == "http" || name == "db_exec" || name == "db_query" ||
  name == "bit_and" || name == "bit_or" || name == "bit_xor" || name == "bit_not" ||
  name == "shl" || name == "shr" || name == "ushr" || name == "float_bits" ||
  name == "float_of_bits" || name == "list_at" || name == "bytes_at" || name == "acc_list" ||
  name == "bytes_join" || name == "sha256" || name == "todo" || name == "model_ask" || name == "tensor_matmul"

type QcCanonEnv = {
  fns: Map[Str, Bool],
  types: Map[Str, Bool],
  variants: Map[Str, Str]
}

fn qc_canon_env_of(p: QcProgram) -> QcCanonEnv =
  fold(p.defs, QcCanonEnv { fns: map_new(), types: map_new(), variants: map_new() },
       fn(env: QcCanonEnv, d: QcDef) =>
         match d {
           QcDefFn(f) =>
             QcCanonEnv { fns: map_put(env.fns, f.name, true), types: env.types, variants: env.variants },
           QcDefType(t) =>
             let types2 = map_put(env.types, t.name, true) in
             let vars2 = match t.body {
               QcBodyEnum(vs) => fold(vs, env.variants, fn(acc: Map[Str, Str], v: QcVariant) => map_put(acc, v.name, t.name)),
               _ => env.variants
             } in
             QcCanonEnv { fns: env.fns, types: types2, variants: vars2 },
           QcDefTest(_) => env
         }
  )

type QcCanon = {
  name: Str,
  kind: Int, # 0 type, 1 fn, 2 test
  hash: Bytes,
  canonical: Bytes,
  signature: Str,
  effects: List[Str],
  local_names: List[Str],
  refs: List[Str],
  deps: List[Bytes],
  group: Option[Bytes]
}

type QcGroup = {
  hash: Bytes,
  form: Bytes
}

type QcHashed = {
  canons: List[QcCanon],
  groups: List[QcGroup]
}

fn qc_str_list_contains(xs: List[Str], target: Str) -> Bool =
  fold(xs, false, fn(found: Bool, x: Str) => if found then true else x == target)

fn qc_walk_tparams_ty(t: QcType, tps: List[Str], out: List[Str]) -> List[Str] =
  match t {
    QcTNamed(n) =>
      if qc_str_list_contains(tps, n) && !qc_str_list_contains(out, n) then out ++ [n] else out,
    QcTParam(n) =>
      if qc_str_list_contains(tps, n) && !qc_str_list_contains(out, n) then out ++ [n] else out,
    QcTList(x) => qc_walk_tparams_ty(x, tps, out),
    QcTOption(x) => qc_walk_tparams_ty(x, tps, out),
    QcTResult(a, b) => qc_walk_tparams_ty(b, tps, qc_walk_tparams_ty(a, tps, out)),
    QcTMap(a, b) => qc_walk_tparams_ty(b, tps, qc_walk_tparams_ty(a, tps, out)),
    QcTApp(_, args) => fold(args, out, fn(acc: List[Str], a: QcType) => qc_walk_tparams_ty(a, tps, acc)),
    QcTFn(ps, r, _) =>
      let acc1 = fold(ps, out, fn(acc: List[Str], p: QcType) => qc_walk_tparams_ty(p, tps, acc)) in
      qc_walk_tparams_ty(r, tps, acc1),
    _ => out
  }

fn qc_fn_tparams(f: QcFnDef) -> List[Str] =
  let out1 = fold(f.params, [], fn(acc: List[Str], p: QcFieldType) => qc_walk_tparams_ty(p.ty, f.tparams, acc)) in
  let out2 = qc_walk_tparams_ty(f.ret, f.tparams, out1) in
  fold(f.tparams, out2, fn(acc: List[Str], tp: Str) =>
    if qc_str_list_contains(acc, tp) then acc else acc ++ [tp]
  )

fn qc_map_type_named(t: QcType, tps: List[Str], refs_map: Map[Str, Bytes]) -> QcType =
  let map_n = fn(n: Str) =>
    if qc_str_list_contains(tps, n) then n
    else
      match map_get(refs_map, n) {
        Some(h) => "#" ++ qc_hash_to_hex(h),
        None => n
      } in
  match t {
    QcTNamed(n) => QcTNamed(map_n(n)),
    QcTApp(n, args) => QcTApp(map_n(n), map(args, fn(a: QcType) => qc_map_type_named(a, tps, refs_map))),
    QcTMap(k, v) => QcTMap(qc_map_type_named(k, tps, refs_map), qc_map_type_named(v, tps, refs_map)),
    QcTList(x) => QcTList(qc_map_type_named(x, tps, refs_map)),
    QcTOption(x) => QcTOption(qc_map_type_named(x, tps, refs_map)),
    QcTResult(a, b) => QcTResult(qc_map_type_named(a, tps, refs_map), qc_map_type_named(b, tps, refs_map)),
    QcTFn(ps, r, effs) => QcTFn(map(ps, fn(p: QcType) => qc_map_type_named(p, tps, refs_map)), qc_map_type_named(r, tps, refs_map), qc_sort_dedup_strs(effs)),
    _ => t
  }

fn qc_signature_text_mapped(d: QcDef, refs_map: Map[Str, Bytes]) -> Str =
  match d {
    QcDefTest(_) => "Bool",
    QcDefType(t) =>
      let head = if len(t.params) == 0 then "" else "[" ++ join(t.params, ", ") ++ "] " in
      match t.body {
        QcBodyRecord(fields) =>
          let fs = map(fields, fn(f: QcFieldType) => f.name ++ ": " ++ qc_print_type(qc_map_type_named(f.ty, t.params, refs_map))) in
          head ++ "{ " ++ join(fs, ", ") ++ " }",
        QcBodyEnum(variants) =>
          if len(variants) == 0 then head ++ "|"
          else
            let vs = map(variants, fn(v: QcVariant) =>
              if len(v.fields) == 0 then v.name
              else v.name ++ "(" ++ join(map(v.fields, fn(fty: QcType) => qc_print_type(qc_map_type_named(fty, t.params, refs_map))), ", ") ++ ")"
            ) in
            head ++ join(vs, " | ")
      },
    QcDefFn(f) =>
      let fn_ty = QcTFn(map(f.params, fn(p: QcFieldType) => p.ty), f.ret, f.effects) in
      let mapped_ty = qc_map_type_named(fn_ty, f.tparams, refs_map) in
      let base = qc_print_type(mapped_ty) in
      let heads = qc_fn_tparams(f) ++ map(f.eparams, fn(e: Str) => "!" ++ e) in
      if len(heads) == 0 then base
      else "fn[" ++ join(heads, ", ") ++ "]" ++ slice(base, 2, len(base))
  }

fn qc_signature_text(d: QcDef) -> Str =
  qc_signature_text_mapped(d, map_new())

fn qc_is_prelude_type_in_env(env: QcCanonEnv, name: Str) -> Bool =
  qc_is_prelude_type(name) && !map_has(env.types, name)

fn qc_is_type_in_env(env: QcCanonEnv, name: Str) -> Bool =
  map_has(env.types, name) || qc_is_prelude_type(name)

# Encoder state
type QcEncState = {
  env: QcCanonEnv,
  scope: List[Str],
  locals: Accum[Str],
  tparams: List[Str],
  eparams: List[Str],
  refs_map: Map[Str, Bytes],
  group_map: Map[Str, Int],
  ref_names: Accum[Str],
  resolve_refs: Bool,
  v2: Bool,
  err: Option[Str],
  bytes: Accum[Int]
}

fn qc_enc_fail(s: QcEncState, msg: Str) -> QcEncState =
  match s.err {
    Some(_) => s,
    None =>
      QcEncState {
        env: s.env,
        scope: s.scope,
        locals: s.locals,
        tparams: s.tparams,
        eparams: s.eparams,
        refs_map: s.refs_map,
        group_map: s.group_map,
        ref_names: s.ref_names,
        resolve_refs: s.resolve_refs,
        v2: s.v2,
        err: Some(msg),
        bytes: s.bytes
      }
  }

fn qc_enc_set_v2(s: QcEncState) -> QcEncState =
  QcEncState {
    env: s.env,
    scope: s.scope,
    locals: s.locals,
    tparams: s.tparams,
    eparams: s.eparams,
    refs_map: s.refs_map,
    group_map: s.group_map,
    ref_names: s.ref_names,
    resolve_refs: s.resolve_refs,
    v2: true,
    err: s.err,
    bytes: s.bytes
  }

fn qc_enc_set_scope(s: QcEncState, scope: List[Str]) -> QcEncState =
  QcEncState {
    env: s.env,
    scope: scope,
    locals: s.locals,
    tparams: s.tparams,
    eparams: s.eparams,
    refs_map: s.refs_map,
    group_map: s.group_map,
    ref_names: s.ref_names,
    resolve_refs: s.resolve_refs,
    v2: s.v2,
    err: s.err,
    bytes: s.bytes
  }

fn qc_enc_set_tparams(s: QcEncState, tps: List[Str]) -> QcEncState =
  let next_locals = fold(tps, s.locals, fn(acc: Accum[Str], tp: Str) => AccPush(acc, tp)) in
  QcEncState {
    env: s.env,
    scope: s.scope,
    locals: next_locals,
    tparams: tps,
    eparams: [],
    refs_map: s.refs_map,
    group_map: s.group_map,
    ref_names: s.ref_names,
    resolve_refs: s.resolve_refs,
    v2: s.v2,
    err: s.err,
    bytes: s.bytes
  }

fn qc_enc_byte(s: QcEncState, b: Int) -> QcEncState =
  QcEncState {
    env: s.env,
    scope: s.scope,
    locals: s.locals,
    tparams: s.tparams,
    eparams: s.eparams,
    refs_map: s.refs_map,
    group_map: s.group_map,
    ref_names: s.ref_names,
    resolve_refs: s.resolve_refs,
    v2: s.v2,
    err: s.err,
    bytes: AccPush(s.bytes, b)
  }

fn qc_enc_varint(s: QcEncState, n: Int) -> QcEncState =
  QcEncState {
    env: s.env,
    scope: s.scope,
    locals: s.locals,
    tparams: s.tparams,
    eparams: s.eparams,
    refs_map: s.refs_map,
    group_map: s.group_map,
    ref_names: s.ref_names,
    resolve_refs: s.resolve_refs,
    v2: s.v2,
    err: s.err,
    bytes: qc_varint_acc(n, s.bytes)
  }

fn qc_enc_i64(s: QcEncState, n: Int) -> QcEncState =
  QcEncState {
    env: s.env,
    scope: s.scope,
    locals: s.locals,
    tparams: s.tparams,
    eparams: s.eparams,
    refs_map: s.refs_map,
    group_map: s.group_map,
    ref_names: s.ref_names,
    resolve_refs: s.resolve_refs,
    v2: s.v2,
    err: s.err,
    bytes: qc_i64_acc(n, s.bytes)
  }

fn qc_enc_float(s: QcEncState, x: Float) -> QcEncState =
  QcEncState {
    env: s.env,
    scope: s.scope,
    locals: s.locals,
    tparams: s.tparams,
    eparams: s.eparams,
    refs_map: s.refs_map,
    group_map: s.group_map,
    ref_names: s.ref_names,
    resolve_refs: s.resolve_refs,
    v2: s.v2,
    err: s.err,
    bytes: qc_float_acc(x, s.bytes)
  }

fn qc_enc_str(s: QcEncState, str_val: Str) -> QcEncState =
  QcEncState {
    env: s.env,
    scope: s.scope,
    locals: s.locals,
    tparams: s.tparams,
    eparams: s.eparams,
    refs_map: s.refs_map,
    group_map: s.group_map,
    ref_names: s.ref_names,
    resolve_refs: s.resolve_refs,
    v2: s.v2,
    err: s.err,
    bytes: qc_str_acc(str_val, s.bytes)
  }

# An effect parameter is written `#<index>` (only `#0`: one per function), so the hash does not
# depend on its name; `#` is not a letter, so it never clashes with an effect.
fn qc_enc_map_eparams(s: QcEncState, effs: List[Str]) -> List[Str] =
  map(effs, fn(e: Str) =>
    match qc_list_find_idx_str(s.eparams, e) {
      Some(i) => "#" ++ from_int(i),
      None => e
    })

# The effect parameter's name is a local name (after the type parameters, before the parameters);
# the decoder reads it when it meets `#0` in the types.
fn qc_enc_set_eparams(s: QcEncState, f: QcFnDef) -> QcEncState =
  let s1 = if len(f.eparams) > 1 then qc_enc_fail(s, "a function has at most one effect parameter") else s in
  let s2 = if len(f.eparams) == 0 then s1
  else
    let e = list_at(f.eparams, 0) in
    let s_checked = if fold(f.params, false, fn(acc: Bool, p: QcFieldType) => acc || qc_type_mentions_effect(p.ty, e)) then s1
      else qc_enc_fail(s1, "the effect parameter `" ++ e ++ "` occurs in no parameter type (not canonical)") in
    QcEncState {
      env: s_checked.env,
      scope: s_checked.scope,
      locals: AccPush(s_checked.locals, e),
      tparams: s_checked.tparams,
      eparams: s_checked.eparams,
      refs_map: s_checked.refs_map,
      group_map: s_checked.group_map,
      ref_names: s_checked.ref_names,
      resolve_refs: s_checked.resolve_refs,
      v2: true,
      err: s_checked.err,
      bytes: s_checked.bytes
    } in
  QcEncState {
    env: s2.env,
    scope: s2.scope,
    locals: s2.locals,
    tparams: s2.tparams,
    eparams: f.eparams,
    refs_map: s2.refs_map,
    group_map: s2.group_map,
    ref_names: s2.ref_names,
    resolve_refs: s2.resolve_refs,
    v2: s2.v2,
    err: s2.err,
    bytes: s2.bytes
  }

fn qc_enc_bind(s: QcEncState, name: Str) -> QcEncState =
  QcEncState {
    env: s.env,
    scope: [name] ++ s.scope,
    locals: AccPush(s.locals, name),
    tparams: s.tparams,
    eparams: s.eparams,
    refs_map: s.refs_map,
    group_map: s.group_map,
    ref_names: s.ref_names,
    resolve_refs: s.resolve_refs,
    v2: s.v2,
    err: s.err,
    bytes: s.bytes
  }

fn qc_lookup_scope_loop(scope: List[Str], name: Str, idx: Int) -> Option[Int] =
  if idx >= len(scope) then None
  else if list_at(scope, idx) == name then Some(idx)
  else qc_lookup_scope_loop(scope, name, idx + 1)

fn qc_lookup_scope(s: QcEncState, name: Str) -> Option[Int] =
  qc_lookup_scope_loop(s.scope, name, 0)

fn qc_enc_ref(s: QcEncState, name: Str) -> QcEncState =
  if qc_is_prelude_type_in_env(s.env, name) then
    qc_enc_str(qc_enc_byte(s, 2), name) # R_PRELUDE = 2
  else
    let s_rec = QcEncState {
      env: s.env,
      scope: s.scope,
      locals: s.locals,
      tparams: s.tparams,
      eparams: s.eparams,
      refs_map: s.refs_map,
      group_map: s.group_map,
      ref_names: AccPush(s.ref_names, name),
      resolve_refs: s.resolve_refs,
      v2: s.v2,
      err: s.err,
      bytes: s.bytes
    } in
    if !s_rec.resolve_refs then
      qc_enc_varint(qc_enc_byte(s_rec, 1), 0)
    else
      match map_get(s_rec.group_map, name) {
        Some(pos) =>
          qc_enc_varint(qc_enc_byte(s_rec, 1), pos), # R_GROUP = 1
        None =>
          match map_get(s_rec.refs_map, name) {
            Some(h) =>
              let s1 = qc_enc_byte(s_rec, 0) in # R_HASH = 0
              QcEncState {
                env: s1.env,
                scope: s1.scope,
                locals: s1.locals,
                tparams: s1.tparams,
                eparams: s1.eparams,
                refs_map: s1.refs_map,
                group_map: s1.group_map,
                ref_names: s1.ref_names,
                resolve_refs: s1.resolve_refs,
                v2: s1.v2,
                err: s1.err,
                bytes: qc_raw_bytes_acc(h, s1.bytes)
              },
            None =>
              qc_enc_fail(s_rec, "the reference to `" ++ name ++ "` cannot be resolved")
          }
      }

fn qc_enc_type(s: QcEncState, t: QcType) -> QcEncState =
  match t {
    QcTInt => qc_enc_byte(s, 0),
    QcTFloat => qc_enc_byte(s, 1),
    QcTBool => qc_enc_byte(s, 2),
    QcTUnit => qc_enc_byte(s, 3),
    QcTStr => qc_enc_byte(s, 4),
    QcTList(elem) => qc_enc_type(qc_enc_byte(s, 5), elem),
    QcTOption(elem) => qc_enc_type(qc_enc_byte(s, 6), elem),
    QcTResult(ok, err) => qc_enc_type(qc_enc_type(qc_enc_byte(s, 7), ok), err),
    QcTNamed(n) =>
      let tidx = qc_lookup_scope_loop(s.tparams, n, 0) in
      match tidx {
        Some(i) =>
          let s1 = qc_enc_set_v2(s) in
          qc_enc_varint(qc_enc_byte(s1, 11), i), # T_PARAM = 11
        None =>
          let s1 = if !qc_is_type_in_env(s.env, n) then qc_enc_fail(s, "unknown type `" ++ n ++ "`") else s in
          qc_enc_ref(qc_enc_byte(s1, 8), n) # T_NAMED = 8
      },
    QcTParam(n) =>
      let tidx = qc_lookup_scope_loop(s.tparams, n, 0) in
      match tidx {
        Some(i) =>
          let s1 = qc_enc_set_v2(s) in
          qc_enc_varint(qc_enc_byte(s1, 11), i),
        None =>
          qc_enc_fail(s, "unknown type parameter `" ++ n ++ "`")
      },
    QcTFn(ps, ret, effs) =>
      let sorted_effs = qc_sort_dedup_strs(qc_enc_map_eparams(s, effs)) in
      let s1 = qc_enc_varint(qc_enc_byte(s, 9), len(ps)) in
      let s2 = fold(ps, s1, fn(st: QcEncState, param_ty: QcType) => qc_enc_type(st, param_ty)) in
      let s3 = qc_enc_type(s2, ret) in
      let s4 = qc_enc_varint(s3, len(sorted_effs)) in
      fold(sorted_effs, s4, fn(st: QcEncState, e: Str) => qc_enc_str(st, e)),
    QcTApp(n, args) =>
      let s1 = qc_enc_set_v2(s) in
      let valid_app = map_has(s1.env.types, n) || (qc_is_prelude_type_in_env(s1.env, n) && n == "Accum") in
      let s2 = if !valid_app then qc_enc_fail(s1, "unknown type `" ++ n ++ "`") else s1 in
      let s3 = qc_enc_ref(qc_enc_byte(s2, 10), n) in
      let s4 = qc_enc_varint(s3, len(args)) in
      fold(args, s4, fn(st: QcEncState, a: QcType) => qc_enc_type(st, a)),
    QcTMap(k, v) =>
      let s1 = qc_enc_set_v2(s) in
      qc_enc_type(qc_enc_type(qc_enc_byte(s1, 12), k), v),
    QcTBytes =>
      let s1 = qc_enc_set_v2(s) in
      qc_enc_byte(s1, 13),
    QcTVar(_) => qc_enc_fail(s, "inference variable in a written type")
  }


fn qc_enc_variant_owner(s: QcEncState, name: Str) -> QcEncState =
  if name == "None" || name == "Some" then qc_enc_byte(s, 0)
  else if name == "Ok" || name == "Err" then qc_enc_byte(s, 1)
  else
    let owner_opt = match map_get(s.env.variants, name) {
      Some(o) => Some(o),
      None => qc_prelude_variant_owner(name)
    } in
    match owner_opt {
      Some(owner) => qc_enc_ref(qc_enc_byte(s, 2), owner),
      None => qc_enc_fail(s, "unknown variant `" ++ name ++ "`")
    }

fn qc_is_variant_name(s: QcEncState, name: Str) -> Bool =
  if name == "None" || name == "Some" || name == "Ok" || name == "Err" then true
  else if map_has(s.env.variants, name) then true
  else
    match qc_prelude_variant_owner(name) {
      Some(_) => true,
      None => false
    }

fn qc_enc_pat(s: QcEncState, p: QcPat) -> QcEncState =
  match p {
    QcPWild => qc_enc_byte(s, 0),
    QcPBind(n) => qc_enc_bind(qc_enc_byte(s, 1), n),
    QcPInt(n) => qc_enc_i64(qc_enc_byte(s, 2), n),
    QcPStr(str_val) => qc_enc_str(qc_enc_byte(s, 3), str_val),
    QcPBool(b) => qc_enc_byte(qc_enc_byte(s, 4), if b then 1 else 0),
    QcPUnit => qc_enc_byte(s, 5),
    QcPVariant(n, ps) =>
      let s1 = qc_enc_str(qc_enc_variant_owner(qc_enc_byte(s, 6), n), n) in
      let s2 = qc_enc_varint(s1, len(ps)) in
      fold(ps, s2, fn(st: QcEncState, subp: QcPat) => qc_enc_pat(st, subp)),
    QcPRecord(n, fs) =>
      let s0 = qc_enc_byte(s, 7) in
      let s0_chk = if !qc_is_type_in_env(s0.env, n) then qc_enc_fail(s0, "unknown type `" ++ n ++ "`") else s0 in
      let s1 = qc_enc_varint(qc_enc_ref(s0_chk, n), len(fs)) in
      fold(fs, s1, fn(st: QcEncState, f: QcFieldPat) => qc_enc_pat(qc_enc_str(st, f.name), f.pat))
  }

fn qc_binop_tag(op: QcBinOp) -> Int =
  match op {
    QcOpAdd => 0,
    QcOpSub => 1,
    QcOpMul => 2,
    QcOpDiv => 3,
    QcOpRem => 4,
    QcOpConcat => 5,
    QcOpEq => 6,
    QcOpNe => 7,
    QcOpLt => 8,
    QcOpLe => 9,
    QcOpGt => 10,
    QcOpGe => 11,
    QcOpAnd => 12,
    QcOpOr => 13
  }

fn qc_enc_expr(s: QcEncState, e: QcExpr) -> QcEncState =
  match e {
    QcEInt(n) => qc_enc_i64(qc_enc_byte(s, 0), n),
    QcEFloat(x) => qc_enc_float(qc_enc_byte(s, 1), x),
    QcEBool(b) => qc_enc_byte(qc_enc_byte(s, 2), if b then 1 else 0),
    QcEStr(str_val) => qc_enc_str(qc_enc_byte(s, 3), str_val),
    QcEUnit => qc_enc_byte(s, 4),
    QcEVar(v) =>
      match qc_lookup_scope(s, v) {
        Some(i) => qc_enc_varint(qc_enc_byte(s, 5), i), # E_LOCAL = 5
        None =>
          if map_has(s.env.fns, v) then qc_enc_ref(qc_enc_byte(s, 6), v) # E_FN_REF = 6
          else if qc_is_variant_name(s, v) then
            let s1 = qc_enc_str(qc_enc_variant_owner(qc_enc_byte(s, 7), v), v) in # E_VARIANT = 7
            qc_enc_varint(s1, 0)
          else qc_enc_fail(s, "unknown name `" ++ v ++ "`")
      },
    QcECall(f, args) =>
      match qc_lookup_scope(s, f) {
        Some(i) =>
          let s1 = qc_enc_varint(qc_enc_byte(s, 8), i) in # E_CALL_LOCAL = 8
          let s2 = qc_enc_varint(s1, len(args)) in
          fold(args, s2, fn(st: QcEncState, a: QcExpr) => qc_enc_expr(st, a)),
        None =>
          if map_has(s.env.fns, f) then
            let s1 = qc_enc_ref(qc_enc_byte(s, 9), f) in # E_CALL_FN = 9
            let s2 = qc_enc_varint(s1, len(args)) in
            fold(args, s2, fn(st: QcEncState, a: QcExpr) => qc_enc_expr(st, a))
          else if qc_is_variant_name(s, f) then
            let s1 = qc_enc_str(qc_enc_variant_owner(qc_enc_byte(s, 7), f), f) in # E_VARIANT = 7
            let s2 = qc_enc_varint(s1, len(args)) in
            fold(args, s2, fn(st: QcEncState, a: QcExpr) => qc_enc_expr(st, a))
          else if qc_is_builtin_name(f) then
            let s1 = qc_enc_str(qc_enc_byte(s, 10), f) in # E_BUILTIN = 10
            let s2 = qc_enc_varint(s1, len(args)) in
            fold(args, s2, fn(st: QcEncState, a: QcExpr) => qc_enc_expr(st, a))
          else
            qc_enc_fail(s, "unknown name `" ++ f ++ "`")
      },
    QcEBin(op, l, r) =>
      let s1 = qc_enc_byte(qc_enc_byte(s, 11), qc_binop_tag(op)) in
      qc_enc_expr(qc_enc_expr(s1, l), r),
    QcEUn(op, x) =>
      let tag = match op { QcUnNeg => 0, QcUnNot => 1 } in
      qc_enc_expr(qc_enc_byte(qc_enc_byte(s, 12), tag), x),
    QcEIf(c, t, f) =>
      qc_enc_expr(qc_enc_expr(qc_enc_expr(qc_enc_byte(s, 13), c), t), f),
    QcELet(n, ann, val, body) =>
      let s1 = qc_enc_byte(s, 14) in
      let s2 = match ann {
        Some(ty) => qc_enc_type(qc_enc_byte(s1, 1), ty),
        None => qc_enc_byte(s1, 0)
      } in
      let s3 = qc_enc_expr(s2, val) in
      let s4 = qc_enc_bind(s3, n) in
      let s5 = qc_enc_expr(s4, body) in
      qc_enc_set_scope(s5, s.scope),
    QcEList(items) =>
      let s1 = qc_enc_varint(qc_enc_byte(s, 15), len(items)) in
      fold(items, s1, fn(st: QcEncState, x: QcExpr) => qc_enc_expr(st, x)),
    QcERecord(n, fs) =>
      let s0 = qc_enc_byte(s, 16) in
      let s0_chk = if !qc_is_type_in_env(s0.env, n) then qc_enc_fail(s0, "unknown type `" ++ n ++ "`") else s0 in
      let s1 = qc_enc_varint(qc_enc_ref(s0_chk, n), len(fs)) in
      fold(fs, s1, fn(st: QcEncState, f: QcFieldExpr) => qc_enc_expr(qc_enc_str(st, f.name), f.expr)),
    QcEField(target, field) =>
      qc_enc_str(qc_enc_expr(qc_enc_byte(s, 17), target), field),
    QcEMatch(scrut, arms) =>
      let s1 = qc_enc_varint(qc_enc_expr(qc_enc_byte(s, 18), scrut), len(arms)) in
      fold(arms, s1, fn(st: QcEncState, a: QcArm) =>
        let orig_scope = st.scope in
        let s_pat = qc_enc_pat(st, a.pat) in
        let s_guard = match a.guard {
          Some(g) => qc_enc_expr(qc_enc_byte(s_pat, 1), g),
          None => qc_enc_byte(s_pat, 0)
        } in
        let s_body = qc_enc_expr(s_guard, a.body) in
        qc_enc_set_scope(s_body, orig_scope)
      ),
    QcESeq(items) =>
      let s1 = qc_enc_varint(qc_enc_byte(s, 19), len(items)) in
      fold(items, s1, fn(st: QcEncState, x: QcExpr) => qc_enc_expr(st, x)),
    QcELambda(params, body) =>
      let s1 = qc_enc_set_v2(s) in
      let s2 = qc_enc_varint(qc_enc_byte(s1, 20), len(params)) in
      let s3 = fold(params, s2, fn(st: QcEncState, p: QcLambdaParam) =>
        match p.ty {
          Some(ty) => qc_enc_type(qc_enc_byte(st, 1), ty),
          None => qc_enc_byte(st, 0)
        }
      ) in
      let s4 = fold(params, s3, fn(st: QcEncState, p: QcLambdaParam) => qc_enc_bind(st, p.name)) in
      let s5 = qc_enc_expr(s4, body) in
      qc_enc_set_scope(s5, s.scope)
  }

type QcEncodedMember = {
  bytes: Bytes,
  locals: List[Str],
  refs: List[Str],
  v2: Bool,
  err: Option[Str]
}


fn qc_def_kind(d: QcDef) -> Int =
  match d {
    QcDefType(_) => 0,
    QcDefFn(_) => 1,
    QcDefTest(_) => 2
  }

fn qc_def_effects(d: QcDef) -> List[Str] =
  match d {
    # The store's effect column holds concrete effects only: an effect parameter is bound per call.
    QcDefFn(f) => filter(qc_sort_dedup_strs(f.effects), fn(e: Str) => !qc_str_list_contains(f.eparams, e)),
    _ => []
  }

fn qc_encode_member_ext(d: QcDef, env: QcCanonEnv, refs_map: Map[Str, Bytes], group_map: Map[Str, Int], resolve_refs: Bool) -> QcEncodedMember =
  let init_st = QcEncState { env: env, scope: [], locals: AccEnd, tparams: [], eparams: [], refs_map: refs_map, group_map: group_map, ref_names: AccEnd, resolve_refs: resolve_refs, v2: false, err: None, bytes: AccEnd } in
  let final_st = match d {
    QcDefType(t) =>
      let is_gen = len(t.params) > 0 in
      let s0 = if is_gen then
        qc_enc_varint(qc_enc_byte(qc_enc_set_tparams(qc_enc_set_v2(init_st), t.params), 3), len(t.params))
      else qc_enc_byte(init_st, 0) in
      match t.body {
        QcBodyRecord(fields) =>
          let s1 = qc_enc_varint(qc_enc_byte(s0, 0), len(fields)) in
          fold(fields, s1, fn(st: QcEncState, f: QcFieldType) => qc_enc_type(qc_enc_str(st, f.name), f.ty)),
        QcBodyEnum(variants) =>
          let s1 = qc_enc_varint(qc_enc_byte(s0, 1), len(variants)) in
          fold(variants, s1, fn(st: QcEncState, v: QcVariant) =>
            let sv = qc_enc_varint(qc_enc_str(st, v.name), len(v.fields)) in
            fold(v.fields, sv, fn(st2: QcEncState, fty: QcType) => qc_enc_type(st2, fty))
          )
      },
    QcDefFn(f) =>
      let is_gen = len(f.tparams) > 0 in
      let tps = qc_fn_tparams(f) in
      let s0 = if is_gen then
        qc_enc_varint(qc_enc_byte(qc_enc_set_tparams(qc_enc_set_v2(init_st), tps), 4), len(tps))
      else qc_enc_byte(init_st, 1) in
      let s_ep = qc_enc_set_eparams(s0, f) in
      let s1 = qc_enc_varint(s_ep, len(f.params)) in
      let s2 = fold(f.params, s1, fn(st: QcEncState, p: QcFieldType) => qc_enc_type(st, p.ty)) in
      let s3 = qc_enc_type(s2, f.ret) in
      let sorted_effs = qc_sort_dedup_strs(qc_enc_map_eparams(s3, f.effects)) in
      let s4 = qc_enc_varint(s3, len(sorted_effs)) in
      let s5 = fold(sorted_effs, s4, fn(st: QcEncState, e: Str) => qc_enc_str(st, e)) in
      # Bind parameters in order
      let s_bound = fold(f.params, s5, fn(st: QcEncState, p: QcFieldType) => qc_enc_bind(st, p.name)) in
      # req
      let s6 = qc_enc_varint(s_bound, len(f.reqs)) in
      let s7 = fold(f.reqs, s6, fn(st: QcEncState, c: QcExpr) => qc_enc_expr(st, c)) in
      # ens (with `r` bound in scope only, not stored in local_names)
      let s8 = qc_enc_varint(s7, len(f.enss)) in
      let s9 = if len(f.enss) == 0 then s8
      else
        let s_ens_scope = qc_enc_set_scope(s8, ["r"] ++ s_bound.scope) in
        let s_ens_done = fold(f.enss, s_ens_scope, fn(st: QcEncState, c: QcExpr) => qc_enc_expr(st, c)) in
        qc_enc_set_scope(s_ens_done, s_bound.scope) in
      # body
      qc_enc_expr(s9, f.body),
    QcDefTest(t) =>
      let s0 = qc_enc_byte(init_st, 2) in
      qc_enc_expr(s0, t.body)
  } in
  QcEncodedMember {
    bytes: bytes_from(acc_list(final_st.bytes)),
    locals: acc_list(final_st.locals),
    refs: qc_sort_dedup_strs(acc_list(final_st.ref_names)),
    v2: final_st.v2,
    err: final_st.err
  }

fn qc_encode_member(d: QcDef, env: QcCanonEnv, refs_map: Map[Str, Bytes], group_map: Map[Str, Int]) -> QcEncodedMember =
  qc_encode_member_ext(d, env, refs_map, group_map, true)

fn qc_varint_bytes(n: Int) -> Bytes =
  bytes_from(acc_list(qc_varint_acc(n, AccEnd)))

fn qc_group_prefix(size: Int, ver: Int) -> Bytes =
  bytes_from([81, 65, 76, 0, ver]) ++ qc_varint_bytes(size)

fn qc_canon_form_single(member_bytes: Bytes, v2: Bool) -> Bytes =
  let ver = if v2 then 2 else 1 in
  qc_group_prefix(1, ver) ++ bytes_from([0]) ++ member_bytes

fn qc_int_list_contains(xs: List[Int], target: Int) -> Bool =
  fold(xs, false, fn(found: Bool, x: Int) => if found then true else x == target)

fn qc_edges_for_def(refs: List[Str], by_name: Map[Str, Int]) -> List[Int] =
  fold(refs, [], fn(acc: List[Int], r: Str) =>
    match map_get(by_name, r) {
      Some(w) => if qc_int_list_contains(acc, w) then acc else acc ++ [w],
      None => acc
    }
  )

fn qc_filter_refs_for_def(refs: List[Str], dname: Str, by_name: Map[Str, Int]) -> List[Str] =
  fold(refs, [], fn(acc: List[Str], r: Str) =>
    if r != dname && map_has(by_name, r) then acc ++ [r] else acc
  )

fn qc_build_by_name_loop(defs: List[QcDef], idx: Int, acc: Map[Str, Int]) -> Result[Map[Str, Int], Str] =
  if idx >= len(defs) then Ok(acc)
  else
    let d = list_at(defs, idx) in
    let dname = qc_def_name(d) in
    if map_has(acc, dname) then Err("`" ++ dname ++ "` is defined more than once")
    else qc_build_by_name_loop(defs, idx + 1, map_put(acc, dname, idx))

fn qc_build_edges_loop(defs: List[QcDef], idx: Int, env: QcCanonEnv, by_name: Map[Str, Int], acc: Accum[List[Int]]) -> Result[List[List[Int]], Str] =
  if idx >= len(defs) then Ok(acc_list(acc))
  else
    let d = list_at(defs, idx) in
    let dname = qc_def_name(d) in
    let enc = qc_encode_member_ext(d, env, map_new(), map_new(), false) in
    match enc.err {
      Some(e) => Err("`" ++ dname ++ "`: " ++ e),
      None =>
        let cur_edges = qc_edges_for_def(enc.refs, by_name) in
        qc_build_edges_loop(defs, idx + 1, env, by_name, AccPush(acc, cur_edges))
    }

type QcLabelKey = {
  label: Int,
  bytes: Bytes
}

fn qc_cmp_label_key(a: QcLabelKey, b: QcLabelKey) -> Int =
  if a.label < b.label then -1
  else if a.label > b.label then 1
  else compare(a.bytes, b.bytes)

fn qc_append_rest_lkey(xs: List[QcLabelKey], idx: Int, acc: Accum[QcLabelKey]) -> List[QcLabelKey] =
  if idx >= len(xs) then acc_list(acc)
  else qc_append_rest_lkey(xs, idx + 1, AccPush(acc, list_at(xs, idx)))

fn qc_insert_distinct_lkey_rec(xs: List[QcLabelKey], x: QcLabelKey, idx: Int, acc: Accum[QcLabelKey]) -> List[QcLabelKey] =
  if idx >= len(xs) then acc_list(AccPush(acc, x))
  else
    let cur = list_at(xs, idx) in
    let c = qc_cmp_label_key(x, cur) in
    if c == 0 then
      qc_append_rest_lkey(xs, idx, acc)
    else if c < 0 then
      qc_append_rest_lkey(xs, idx, AccPush(acc, x))
    else
      qc_insert_distinct_lkey_rec(xs, x, idx + 1, AccPush(acc, cur))

fn qc_sort_dedup_lkeys(xs: List[QcLabelKey]) -> List[QcLabelKey] =
  fold(xs, [], fn(acc: List[QcLabelKey], x: QcLabelKey) => qc_insert_distinct_lkey_rec(acc, x, 0, AccEnd))

fn qc_find_lkey_idx(distinct: List[QcLabelKey], target: QcLabelKey, idx: Int) -> Int =
  if idx >= len(distinct) then 0
  else if qc_cmp_label_key(list_at(distinct, idx), target) == 0 then idx
  else qc_find_lkey_idx(distinct, target, idx + 1)

fn qc_count_distinct_ints_loop(xs: List[Int], idx: Int, seen: Map[Int, Bool], count: Int) -> Int =
  if idx >= len(xs) then count
  else
    let v = list_at(xs, idx) in
    if map_has(seen, v) then qc_count_distinct_ints_loop(xs, idx + 1, seen, count)
    else qc_count_distinct_ints_loop(xs, idx + 1, map_put(seen, v, true), count + 1)

fn qc_build_lab_map_loop(defs: List[QcDef], labels: List[Int], idx: Int, acc: Map[Str, Int]) -> Map[Str, Int] =
  if idx >= len(defs) then acc
  else
    let d = list_at(defs, idx) in
    let l = list_at(labels, idx) in
    qc_build_lab_map_loop(defs, labels, idx + 1, map_put(acc, qc_def_name(d), l))

fn qc_build_lkeys_loop(defs: List[QcDef], labels: List[Int], idx: Int, env: QcCanonEnv, refs_map: Map[Str, Bytes], lab_map: Map[Str, Int], acc: Accum[QcLabelKey]) -> List[QcLabelKey] =
  if idx >= len(defs) then acc_list(acc)
  else
    let d = list_at(defs, idx) in
    let l = list_at(labels, idx) in
    let enc = qc_encode_member(d, env, refs_map, lab_map) in
    qc_build_lkeys_loop(defs, labels, idx + 1, env, refs_map, lab_map, AccPush(acc, QcLabelKey { label: l, bytes: enc.bytes }))

fn qc_refine_labels(defs: List[QcDef], labels: List[Int], env: QcCanonEnv, refs_map: Map[Str, Bytes]) -> List[Int] =
  let before = qc_count_distinct_ints_loop(labels, 0, map_new(), 0) in
  let lab_map = qc_build_lab_map_loop(defs, labels, 0, map_new()) in
  let keys = qc_build_lkeys_loop(defs, labels, 0, env, refs_map, lab_map, AccEnd) in
  let distinct = qc_sort_dedup_lkeys(keys) in
  let new_labels = map(keys, fn(k: QcLabelKey) => qc_find_lkey_idx(distinct, k, 0)) in
  if len(distinct) == before then new_labels
  else qc_refine_labels(defs, new_labels, env, refs_map)

fn qc_count_label_occurrences_loop(labels: List[Int], idx: Int, acc: Map[Int, Int]) -> Map[Int, Int] =
  if idx >= len(labels) then acc
  else
    let l = list_at(labels, idx) in
    let c = match map_get(acc, l) { Some(n) => n + 1, None => 1 } in
    qc_count_label_occurrences_loop(labels, idx + 1, map_put(acc, l, c))

fn qc_find_min_dup_label_loop(labels: List[Int], counts: Map[Int, Int], idx: Int, best: Option[Int]) -> Option[Int] =
  if idx >= len(labels) then best
  else
    let l = list_at(labels, idx) in
    let c = match map_get(counts, l) { Some(n) => n, None => 0 } in
    let next_best = if c > 1 then
      match best {
        None => Some(l),
        Some(b) => if l < b then Some(l) else Some(b)
      }
    else best in
    qc_find_min_dup_label_loop(labels, counts, idx + 1, next_best)

fn qc_find_def_with_label(defs: List[QcDef], labels: List[Int], target_label: Int, idx: Int) -> QcDef =
  if idx >= len(defs) then list_at(defs, 0)
  else if list_at(labels, idx) == target_label then list_at(defs, idx)
  else qc_find_def_with_label(defs, labels, target_label, idx + 1)

fn qc_order_from_labels_loop(defs: List[QcDef], labels: List[Int], pos: Int, k: Int, acc: Accum[QcDef]) -> List[QcDef] =
  if pos >= k then acc_list(acc)
  else
    let d = qc_find_def_with_label(defs, labels, pos, 0) in
    qc_order_from_labels_loop(defs, labels, pos + 1, k, AccPush(acc, d))

fn qc_order_pos_loop(order: List[QcDef], idx: Int, acc: Map[Str, Int]) -> Map[Str, Int] =
  if idx >= len(order) then acc
  else
    let d = list_at(order, idx) in
    qc_order_pos_loop(order, idx + 1, map_put(acc, qc_def_name(d), idx))

type QcGroupEval = {
  form: Bytes,
  v2: Bool,
  encs: List[QcEncodedMember]
}

fn qc_eval_order_loop(order: List[QcDef], idx: Int, env: QcCanonEnv, refs_map: Map[Str, Bytes], pos_map: Map[Str, Int], any_v2: Bool, bytes_acc: Accum[Int], encs_acc: Accum[QcEncodedMember]) -> QcGroupEval =
  if idx >= len(order) then
    let ver = if any_v2 then 2 else 1 in
    let full_form = qc_group_prefix(len(order), ver) ++ bytes_from(acc_list(bytes_acc)) in
    QcGroupEval { form: full_form, v2: any_v2, encs: acc_list(encs_acc) }
  else
    let d = list_at(order, idx) in
    let enc = qc_encode_member(d, env, refs_map, pos_map) in
    let next_acc = fold(bytes_to_list(enc.bytes), bytes_acc, fn(a: Accum[Int], b: Int) => AccPush(a, b)) in
    qc_eval_order_loop(order, idx + 1, env, refs_map, pos_map, any_v2 || enc.v2, next_acc, AccPush(encs_acc, enc))

type QcBestOrder = {
  order: List[QcDef],
  form: Bytes,
  v2: Bool,
  encs: List[QcEncodedMember],
  symmetric: Bool
}

fn qc_same_def_order_loop(a: List[QcDef], b: List[QcDef], idx: Int) -> Bool =
  if idx >= len(a) then true
  else if qc_def_name(list_at(a, idx)) != qc_def_name(list_at(b, idx)) then false
  else qc_same_def_order_loop(a, b, idx + 1)

fn qc_split_labels_loop(labels: List[Int], target: Int, chosen_idx: Int, idx: Int, acc: Accum[Int]) -> List[Int] =
  if idx >= len(labels) then acc_list(acc)
  else
    let l = list_at(labels, idx) in
    let nl =
      if l < target then 2 * l
      else if l == target && idx == chosen_idx then 2 * l
      else 2 * l + 1 in
    qc_split_labels_loop(labels, target, chosen_idx, idx + 1, AccPush(acc, nl))

fn qc_search_labels(defs: List[QcDef], labels: List[Int], env: QcCanonEnv, refs_map: Map[Str, Bytes], best: Option[QcBestOrder]) -> Option[QcBestOrder] =
  let ref_labels = qc_refine_labels(defs, labels, env, refs_map) in
  let counts = qc_count_label_occurrences_loop(ref_labels, 0, map_new()) in
  let dup_opt = qc_find_min_dup_label_loop(ref_labels, counts, 0, None) in
  match dup_opt {
    None =>
      let order = qc_order_from_labels_loop(defs, ref_labels, 0, len(defs), AccEnd) in
      let pos_map = qc_order_pos_loop(order, 0, map_new()) in
      let ev = qc_eval_order_loop(order, 0, env, refs_map, pos_map, false, AccEnd, AccEnd) in
      match best {
        None =>
          Some(QcBestOrder { order: order, form: ev.form, v2: ev.v2, encs: ev.encs, symmetric: false }),
        Some(b) =>
          let c = compare(ev.form, b.form) in
          if c < 0 then
            Some(QcBestOrder { order: order, form: ev.form, v2: ev.v2, encs: ev.encs, symmetric: false })
          else if c == 0 then
            let is_sym = b.symmetric || !qc_same_def_order_loop(order, b.order, 0) in
            Some(QcBestOrder { order: b.order, form: b.form, v2: b.v2, encs: b.encs, symmetric: is_sym })
          else
            best
      },
    Some(target) =>
      qc_search_branch_loop(defs, ref_labels, target, 0, env, refs_map, best)
  }

fn qc_search_branch_loop(defs: List[QcDef], labels: List[Int], target: Int, idx: Int, env: QcCanonEnv, refs_map: Map[Str, Bytes], best: Option[QcBestOrder]) -> Option[QcBestOrder] =
  if idx >= len(labels) then best
  else if list_at(labels, idx) != target then
    qc_search_branch_loop(defs, labels, target, idx + 1, env, refs_map, best)
  else
    let next_labels = qc_split_labels_loop(labels, target, idx, 0, AccEnd) in
    let next_best = qc_search_labels(defs, next_labels, env, refs_map, best) in
    qc_search_branch_loop(defs, labels, target, idx + 1, env, refs_map, next_best)

fn qc_zeros_loop(count: Int, acc: Accum[Int]) -> List[Int] =
  if count <= 0 then acc_list(acc)
  else qc_zeros_loop(count - 1, AccPush(acc, 0))

fn qc_find_best_order(defs: List[QcDef], env: QcCanonEnv, refs_map: Map[Str, Bytes]) -> QcBestOrder =
  let init_labels = qc_zeros_loop(len(defs), AccEnd) in
  match qc_search_labels(defs, init_labels, env, refs_map, None) {
    Some(b) => b,
    None => QcBestOrder { order: [], form: bytes_from([]), v2: false, encs: [], symmetric: false }
  }

fn qc_append_rest_bytes(xs: List[Bytes], idx: Int, acc: Accum[Bytes]) -> List[Bytes] =
  if idx >= len(xs) then acc_list(acc)
  else qc_append_rest_bytes(xs, idx + 1, AccPush(acc, list_at(xs, idx)))

fn qc_insert_distinct_bytes_rec(xs: List[Bytes], x: Bytes, idx: Int, acc: Accum[Bytes]) -> List[Bytes] =
  if idx >= len(xs) then acc_list(AccPush(acc, x))
  else
    let cur = list_at(xs, idx) in
    let c = compare(x, cur) in
    if c == 0 then qc_append_rest_bytes(xs, idx, acc)
    else if c < 0 then qc_append_rest_bytes(xs, idx, AccPush(acc, x))
    else qc_insert_distinct_bytes_rec(xs, x, idx + 1, AccPush(acc, cur))

fn qc_sort_dedup_bytes(xs: List[Bytes]) -> List[Bytes] =
  fold(xs, [], fn(acc: List[Bytes], x: Bytes) => qc_insert_distinct_bytes_rec(acc, x, 0, AccEnd))

fn qc_deps_for_refs(refs: List[Str], self_hash: Bytes, refs_map: Map[Str, Bytes]) -> List[Bytes] =
  let raw = fold(refs, [], fn(acc: List[Bytes], r: Str) =>
    match map_get(refs_map, r) {
      Some(h) => if compare(h, self_hash) == 0 then acc else acc ++ [h],
      None => acc
    }
  ) in
  qc_sort_dedup_bytes(raw)

fn qc_add_group_hashes_loop(order: List[QcDef], idx: Int, size: Int, ver: Int, gh: Bytes, refs_map: Map[Str, Bytes]) -> Map[Str, Bytes] =
  if idx >= len(order) then refs_map
  else
    let d = list_at(order, idx) in
    let dname = qc_def_name(d) in
    let member_canon = qc_group_prefix(size, ver) ++ qc_varint_bytes(idx) ++ gh in
    let h = sha256(member_canon) in
    qc_add_group_hashes_loop(order, idx + 1, size, ver, gh, map_put(refs_map, dname, h))

fn qc_add_group_canons_loop(order: List[QcDef], encs: List[QcEncodedMember], idx: Int, size: Int, ver: Int, gh: Bytes, by_name: Map[Str, Int], refs_map: Map[Str, Bytes], canons_map: Map[Str, QcCanon]) -> Map[Str, QcCanon] =
  if idx >= len(order) then canons_map
  else
    let d = list_at(order, idx) in
    let enc = list_at(encs, idx) in
    let dname = qc_def_name(d) in
    let member_canon = qc_group_prefix(size, ver) ++ qc_varint_bytes(idx) ++ gh in
    let h = sha256(member_canon) in
    let clean_refs = qc_filter_refs_for_def(enc.refs, dname, by_name) in
    let c = QcCanon {
      name: dname,
      kind: qc_def_kind(d),
      hash: h,
      canonical: member_canon,
      signature: qc_signature_text_mapped(d, refs_map),
      effects: qc_def_effects(d),
      local_names: enc.locals,
      refs: clean_refs,
      deps: qc_deps_for_refs(clean_refs, h, refs_map),
      group: Some(gh)
    } in
    qc_add_group_canons_loop(order, encs, idx + 1, size, ver, gh, by_name, refs_map, map_put(canons_map, dname, c))

type QcTarjanState = {
  n: Int,
  edges: List[List[Int]],
  indices: Map[Int, Int],
  lowlinks: Map[Int, Int],
  on_stack: Map[Int, Bool],
  stack: List[Int],
  next_idx: Int,
  sccs: Accum[List[Int]]
}

type QcTarjanPopRes = {
  comp_acc: Accum[Int],
  on_stack: Map[Int, Bool],
  rest_stack: List[Int]
}

fn qc_tail_int_loop(xs: List[Int], idx: Int, acc: Accum[Int]) -> List[Int] =
  if idx >= len(xs) then acc_list(acc)
  else qc_tail_int_loop(xs, idx + 1, AccPush(acc, list_at(xs, idx)))

fn qc_tail_int_list(xs: List[Int]) -> List[Int] =
  qc_tail_int_loop(xs, 1, AccEnd)

fn qc_tarjan_pop_loop(stack: List[Int], on_stack: Map[Int, Bool], target: Int, acc: Accum[Int]) -> QcTarjanPopRes =
  if len(stack) == 0 then QcTarjanPopRes { comp_acc: acc, on_stack: on_stack, rest_stack: [] }
  else
    let w = list_at(stack, 0) in
    let rest = qc_tail_int_list(stack) in
    let next_on_stack = map_put(on_stack, w, false) in
    let next_acc = AccPush(acc, w) in
    if w == target then
      QcTarjanPopRes { comp_acc: next_acc, on_stack: next_on_stack, rest_stack: rest }
    else
      qc_tarjan_pop_loop(rest, next_on_stack, target, next_acc)

fn qc_append_rest_int(xs: List[Int], idx: Int, acc: Accum[Int]) -> List[Int] =
  if idx >= len(xs) then acc_list(acc)
  else qc_append_rest_int(xs, idx + 1, AccPush(acc, list_at(xs, idx)))

fn qc_insert_sorted_int_rec(xs: List[Int], x: Int, idx: Int, acc: Accum[Int]) -> List[Int] =
  if idx >= len(xs) then acc_list(AccPush(acc, x))
  else
    let cur = list_at(xs, idx) in
    if x <= cur then
      qc_append_rest_int(xs, idx, AccPush(acc, x))
    else
      qc_insert_sorted_int_rec(xs, x, idx + 1, AccPush(acc, cur))

fn qc_insert_sorted_int(xs: List[Int], x: Int) -> List[Int] =
  qc_insert_sorted_int_rec(xs, x, 0, AccEnd)

fn qc_sort_int_list(xs: List[Int]) -> List[Int] =
  fold(xs, [], qc_insert_sorted_int)

fn qc_tarjan_dfs(st: QcTarjanState, u: Int) -> QcTarjanState =
  let cur_idx = st.next_idx in
  let st1 = QcTarjanState {
    n: st.n,
    edges: st.edges,
    indices: map_put(st.indices, u, cur_idx),
    lowlinks: map_put(st.lowlinks, u, cur_idx),
    on_stack: map_put(st.on_stack, u, true),
    stack: [u] ++ st.stack,
    next_idx: cur_idx + 1,
    sccs: st.sccs
  } in
  let u_edges = list_at(st1.edges, u) in
  let st2 = qc_tarjan_edges_loop(st1, u, u_edges, 0) in
  let u_low = match map_get(st2.lowlinks, u) { Some(x) => x, None => 0 } in
  let u_ind = match map_get(st2.indices, u) { Some(x) => x, None => 0 } in
  if u_low == u_ind then
    let pop_res = qc_tarjan_pop_loop(st2.stack, st2.on_stack, u, AccEnd) in
    let comp = qc_sort_int_list(acc_list(pop_res.comp_acc)) in
    QcTarjanState {
      n: st2.n,
      edges: st2.edges,
      indices: st2.indices,
      lowlinks: st2.lowlinks,
      on_stack: pop_res.on_stack,
      stack: pop_res.rest_stack,
      next_idx: st2.next_idx,
      sccs: AccPush(st2.sccs, comp)
    }
  else
    st2

fn qc_tarjan_edges_loop(st: QcTarjanState, u: Int, edges: List[Int], idx: Int) -> QcTarjanState =
  if idx >= len(edges) then st
  else
    let w = list_at(edges, idx) in
    if !map_has(st.indices, w) then
      let st_after = qc_tarjan_dfs(st, w) in
      let w_low = match map_get(st_after.lowlinks, w) { Some(x) => x, None => 0 } in
      let u_low = match map_get(st_after.lowlinks, u) { Some(x) => x, None => 0 } in
      let new_u_low = if w_low < u_low then w_low else u_low in
      let st_next = QcTarjanState {
        n: st_after.n,
        edges: st_after.edges,
        indices: st_after.indices,
        lowlinks: map_put(st_after.lowlinks, u, new_u_low),
        on_stack: st_after.on_stack,
        stack: st_after.stack,
        next_idx: st_after.next_idx,
        sccs: st_after.sccs
      } in
      qc_tarjan_edges_loop(st_next, u, edges, idx + 1)
    else if match map_get(st.on_stack, w) { Some(b) => b, None => false } then
      let w_idx = match map_get(st.indices, w) { Some(x) => x, None => 0 } in
      let u_low = match map_get(st.lowlinks, u) { Some(x) => x, None => 0 } in
      let new_u_low = if w_idx < u_low then w_idx else u_low in
      let st_next = QcTarjanState {
        n: st.n,
        edges: st.edges,
        indices: st.indices,
        lowlinks: map_put(st.lowlinks, u, new_u_low),
        on_stack: st.on_stack,
        stack: st.stack,
        next_idx: st.next_idx,
        sccs: st.sccs
      } in
      qc_tarjan_edges_loop(st_next, u, edges, idx + 1)
    else
      qc_tarjan_edges_loop(st, u, edges, idx + 1)

fn qc_tarjan_loop(st: QcTarjanState, root: Int) -> QcTarjanState =
  if root >= st.n then st
  else if map_has(st.indices, root) then
    qc_tarjan_loop(st, root + 1)
  else
    let next_st = qc_tarjan_dfs(st, root) in
    qc_tarjan_loop(next_st, root + 1)

type QcHashMaps = {
  refs_map: Map[Str, Bytes],
  canons_map: Map[Str, QcCanon],
  groups: List[QcGroup]
}

fn qc_append_rest_group(xs: List[QcGroup], idx: Int, acc: Accum[QcGroup]) -> List[QcGroup] =
  if idx >= len(xs) then acc_list(acc)
  else qc_append_rest_group(xs, idx + 1, AccPush(acc, list_at(xs, idx)))

fn qc_insert_distinct_group_rec(xs: List[QcGroup], x: QcGroup, idx: Int, acc: Accum[QcGroup]) -> List[QcGroup] =
  if idx >= len(xs) then acc_list(AccPush(acc, x))
  else
    let cur = list_at(xs, idx) in
    let c = compare(x.hash, cur.hash) in
    if c == 0 then qc_append_rest_group(xs, idx, acc)
    else if c < 0 then qc_append_rest_group(xs, idx, AccPush(acc, x))
    else qc_insert_distinct_group_rec(xs, x, idx + 1, AccPush(acc, cur))

fn qc_defs_for_comp_loop(defs: List[QcDef], comp: List[Int], idx: Int, acc: Accum[QcDef]) -> List[QcDef] =
  if idx >= len(comp) then acc_list(acc)
  else
    let d_idx = list_at(comp, idx) in
    qc_defs_for_comp_loop(defs, comp, idx + 1, AccPush(acc, list_at(defs, d_idx)))

fn qc_first_member_err_loop(order: List[QcDef], encs: List[QcEncodedMember], idx: Int) -> Option[Str] =
  if idx >= len(encs) then None
  else
    let enc = list_at(encs, idx) in
    match enc.err {
      Some(e) => Some("`" ++ qc_def_name(list_at(order, idx)) ++ "`: " ++ e),
      None => qc_first_member_err_loop(order, encs, idx + 1)
    }

fn qc_process_sccs_loop(sccs: List[List[Int]], scc_idx: Int, p: QcProgram, env: QcCanonEnv, by_name: Map[Str, Int], refs_map: Map[Str, Bytes], canons_map: Map[Str, QcCanon], groups: List[QcGroup]) -> Result[QcHashMaps, Str] =
  if scc_idx >= len(sccs) then
    Ok(QcHashMaps { refs_map: refs_map, canons_map: canons_map, groups: groups })
  else
    let comp = list_at(sccs, scc_idx) in
    if len(comp) == 1 then
      let d_idx = list_at(comp, 0) in
      let d = list_at(p.defs, d_idx) in
      let dname = qc_def_name(d) in
      let group_map = map_put(map_new(), dname, 0) in
      let enc = qc_encode_member(d, env, refs_map, group_map) in
      match enc.err {
        Some(e) => Err("`" ++ dname ++ "`: " ++ e),
        None =>
          let canon_bytes = qc_canon_form_single(enc.bytes, enc.v2) in
          let h = sha256(canon_bytes) in
          let next_refs_map = map_put(refs_map, dname, h) in
          let clean_refs = qc_filter_refs_for_def(enc.refs, dname, by_name) in
          let c = QcCanon {
            name: dname,
            kind: qc_def_kind(d),
            hash: h,
            canonical: canon_bytes,
            signature: qc_signature_text_mapped(d, next_refs_map),
            effects: qc_def_effects(d),
            local_names: enc.locals,
            refs: clean_refs,
            deps: qc_deps_for_refs(clean_refs, h, next_refs_map),
            group: None
          } in
          qc_process_sccs_loop(sccs, scc_idx + 1, p, env, by_name, next_refs_map, map_put(canons_map, dname, c), groups)
      }
    else
      let comp_defs = qc_defs_for_comp_loop(p.defs, comp, 0, AccEnd) in
      let best = qc_find_best_order(comp_defs, env, refs_map) in
      match qc_first_member_err_loop(best.order, best.encs, 0) {
        Some(e) => Err(e),
        None =>
          if best.symmetric then
            let names = map(comp_defs, fn(d: QcDef) => qc_def_name(d)) in
            Err("the recursive group " ++ join(names, ", ") ++ " has interchangeable members")
          else
            let gh = sha256(best.form) in
            let g_obj = QcGroup { hash: gh, form: best.form } in
            let ver = if best.v2 then 2 else 1 in
            let size = len(best.order) in
            let next_refs_map = qc_add_group_hashes_loop(best.order, 0, size, ver, gh, refs_map) in
            let next_canons_map = qc_add_group_canons_loop(best.order, best.encs, 0, size, ver, gh, by_name, next_refs_map, canons_map) in
            let next_groups = qc_insert_distinct_group_rec(groups, g_obj, 0, AccEnd) in
            qc_process_sccs_loop(sccs, scc_idx + 1, p, env, by_name, next_refs_map, next_canons_map, next_groups)
      }

fn qc_hash_program_res(p: QcProgram) -> Result[QcHashed, Str] =
  let env = qc_canon_env_of(p) in
  let n = len(p.defs) in
  match qc_build_by_name_loop(p.defs, 0, map_new()) {
    Err(e) => Err(e),
    Ok(by_name) =>
      match qc_build_edges_loop(p.defs, 0, env, by_name, AccEnd) {
        Err(e) => Err(e),
        Ok(edges) =>
          let init_tarjan = QcTarjanState {
            n: n,
            edges: edges,
            indices: map_new(),
            lowlinks: map_new(),
            on_stack: map_new(),
            stack: [],
            next_idx: 0,
            sccs: AccEnd
          } in
          let tarjan_res = qc_tarjan_loop(init_tarjan, 0) in
          let sccs = acc_list(tarjan_res.sccs) in
          match qc_process_sccs_loop(sccs, 0, p, env, by_name, map_new(), map_new(), []) {
            Err(e) => Err(e),
            Ok(final_st) =>
              let canons = fold(p.defs, AccEnd, fn(a: Accum[QcCanon], d: QcDef) =>
                match map_get(final_st.canons_map, qc_def_name(d)) {
                  Some(c) => AccPush(a, c),
                  None => a
                }
              ) in
              Ok(QcHashed { canons: acc_list(canons), groups: final_st.groups })
          }
      }
  }

fn qc_hash_program(p: QcProgram) -> QcHashed =
  match qc_hash_program_res(p) {
    Ok(h) => h,
    Err(_) => QcHashed { canons: [], groups: [] }
  }

# Canonical Decoder (qc_decode_canonical)
type QcDecState = {
  bytes: Bytes,
  pos: Int,
  scope: List[Str],
  local_names: List[Str],
  next_name: Int,
  tparams: List[Str],
  saw_eparam: Bool,
  def_name: Str,
  hash_to_name: Map[Str, Str],
  group_names: List[Str],
  self_index: Int
}

type QcDecRes[T] = {
  val: T,
  s: QcDecState
}


fn qc_dec_byte(s: QcDecState) -> QcDecRes[Int] =
  let b = bytes_at(s.bytes, s.pos) in
  QcDecRes {
    val: b,
    s: QcDecState {
      bytes: s.bytes,
      pos: s.pos + 1,
      scope: s.scope,
      local_names: s.local_names,
      next_name: s.next_name,
      tparams: s.tparams,
      saw_eparam: s.saw_eparam,
      def_name: s.def_name,
      hash_to_name: s.hash_to_name,
      group_names: s.group_names,
      self_index: s.self_index
    }
  }

fn qc_dec_varint_loop(s: QcDecState, shift: Int, acc: Int) -> QcDecRes[Int] =
  let b = bytes_at(s.bytes, s.pos) in
  let val = bit_or(acc, shl(bit_and(b, 127), shift)) in
  let next_s = QcDecState {
    bytes: s.bytes,
    pos: s.pos + 1,
    scope: s.scope,
    local_names: s.local_names,
    next_name: s.next_name,
    tparams: s.tparams,
    saw_eparam: s.saw_eparam,
    def_name: s.def_name,
    hash_to_name: s.hash_to_name,
    group_names: s.group_names,
    self_index: s.self_index
  } in
  if bit_and(b, 128) == 0 then QcDecRes { val: val, s: next_s }
  else qc_dec_varint_loop(next_s, shift + 7, val)

fn qc_dec_varint(s: QcDecState) -> QcDecRes[Int] =
  qc_dec_varint_loop(s, 0, 0)

fn qc_dec_i64(s: QcDecState) -> QcDecRes[Int] =
  let b0 = bytes_at(s.bytes, s.pos) in
  let b1 = bytes_at(s.bytes, s.pos + 1) in
  let b2 = bytes_at(s.bytes, s.pos + 2) in
  let b3 = bytes_at(s.bytes, s.pos + 3) in
  let b4 = bytes_at(s.bytes, s.pos + 4) in
  let b5 = bytes_at(s.bytes, s.pos + 5) in
  let b6 = bytes_at(s.bytes, s.pos + 6) in
  let b7 = bytes_at(s.bytes, s.pos + 7) in
  let low = bit_or(b0, bit_or(shl(b1, 8), bit_or(shl(b2, 16), shl(b3, 24)))) in
  let high = bit_or(b4, bit_or(shl(b5, 8), bit_or(shl(b6, 16), shl(b7, 24)))) in
  let n = bit_or(bit_and(low, 4294967295), shl(high, 32)) in
  QcDecRes {
    val: n,
    s: QcDecState {
      bytes: s.bytes,
      pos: s.pos + 8,
      scope: s.scope,
      local_names: s.local_names,
      next_name: s.next_name,
      tparams: s.tparams,
      saw_eparam: s.saw_eparam,
      def_name: s.def_name,
      hash_to_name: s.hash_to_name,
      group_names: s.group_names,
      self_index: s.self_index
    }
  }

fn qc_dec_float(s: QcDecState) -> QcDecRes[Float] =
  let i_res = qc_dec_i64(s) in
  QcDecRes { val: float_of_bits(i_res.val), s: i_res.s }

fn qc_dec_str(s: QcDecState) -> QcDecRes[Str] =
  let len_res = qc_dec_varint(s) in
  let str_bytes = bytes_slice(len_res.s.bytes, len_res.s.pos, len_res.s.pos + len_res.val) in
  let str_val = match bytes_to_str(str_bytes) {
    Some(v) => v,
    None => ""
  } in
  QcDecRes {
    val: str_val,
    s: QcDecState {
      bytes: len_res.s.bytes,
      pos: len_res.s.pos + len_res.val,
      scope: len_res.s.scope,
      local_names: len_res.s.local_names,
      next_name: len_res.s.next_name,
      tparams: len_res.s.tparams,
      saw_eparam: len_res.s.saw_eparam,
      def_name: len_res.s.def_name,
      hash_to_name: len_res.s.hash_to_name,
      group_names: len_res.s.group_names,
      self_index: len_res.s.self_index
    }
  }

fn qc_dec_bind(s: QcDecState) -> QcDecRes[Str] =
  let name = if s.next_name < len(s.local_names) then list_at(s.local_names, s.next_name) else "x" ++ from_int(s.next_name) in
  QcDecRes {
    val: name,
    s: QcDecState {
      bytes: s.bytes,
      pos: s.pos,
      scope: [name] ++ s.scope,
      local_names: s.local_names,
      next_name: s.next_name + 1,
      tparams: s.tparams,
      saw_eparam: s.saw_eparam,
      def_name: s.def_name,
      hash_to_name: s.hash_to_name,
      group_names: s.group_names,
      self_index: s.self_index
    }
  }

fn qc_dec_local(s: QcDecState) -> QcDecRes[Str] =
  let idx_res = qc_dec_varint(s) in
  let name = if idx_res.val < len(idx_res.s.scope) then list_at(idx_res.s.scope, idx_res.val) else "unknown" in
  QcDecRes { val: name, s: idx_res.s }

fn qc_dec_ref(s: QcDecState) -> QcDecRes[Str] =
  let tag_res = qc_dec_byte(s) in
  if tag_res.val == 0 then
    # R_HASH = 0 (32 bytes)
    let hash_bytes = bytes_slice(tag_res.s.bytes, tag_res.s.pos, tag_res.s.pos + 32) in
    let next_s = QcDecState {
      bytes: tag_res.s.bytes,
      pos: tag_res.s.pos + 32,
      scope: tag_res.s.scope,
      local_names: tag_res.s.local_names,
      next_name: tag_res.s.next_name,
      tparams: tag_res.s.tparams,
      saw_eparam: tag_res.s.saw_eparam,
      def_name: tag_res.s.def_name,
      hash_to_name: tag_res.s.hash_to_name,
      group_names: tag_res.s.group_names,
      self_index: tag_res.s.self_index
    } in
    let hex = qc_hash_to_hex(hash_bytes) in
    let name = match map_get(next_s.hash_to_name, hex) {
      Some(n) => n,
      None => slice(hex, 0, 12)
    } in
    QcDecRes { val: name, s: next_s }
  else if tag_res.val == 1 then
    # R_GROUP = 1
    let j_res = qc_dec_varint(tag_res.s) in
    let name =
      if j_res.val == j_res.s.self_index then j_res.s.def_name
      else if j_res.val < len(j_res.s.group_names) then list_at(j_res.s.group_names, j_res.val)
      else j_res.s.def_name in
    QcDecRes { val: name, s: j_res.s }
  else
    # R_PRELUDE = 2
    qc_dec_str(tag_res.s)

fn qc_dec_set_saw_eparam(s: QcDecState, saw: Bool) -> QcDecState =
  QcDecState {
    bytes: s.bytes,
    pos: s.pos,
    scope: s.scope,
    local_names: s.local_names,
    next_name: s.next_name,
    tparams: s.tparams,
    saw_eparam: saw,
    def_name: s.def_name,
    hash_to_name: s.hash_to_name,
    group_names: s.group_names,
    self_index: s.self_index
  }

# `#0` names the effect parameter; its name is substituted once the function's signature is read.
fn qc_dec_effects_loop(s: QcDecState, count: Int, acc: Accum[Str]) -> QcDecRes[List[Str]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let str_res = qc_dec_str(s) in
    let s2 = if str_res.val == "#0" then qc_dec_set_saw_eparam(str_res.s, true) else str_res.s in
    qc_dec_effects_loop(s2, count - 1, AccPush(acc, str_res.val))

type QcDecEparam = {
  eparams: List[Str],
  s: QcDecState
}

# The effect parameter's name follows the type parameters among the local names.
fn qc_dec_eparam(s: QcDecState) -> QcDecEparam =
  if s.saw_eparam then
    let b_res = qc_dec_bind(qc_dec_set_saw_eparam(s, false)) in
    let popped_s = QcDecState {
      bytes: b_res.s.bytes,
      pos: b_res.s.pos,
      scope: s.scope,
      local_names: b_res.s.local_names,
      next_name: b_res.s.next_name,
      tparams: b_res.s.tparams,
      saw_eparam: b_res.s.saw_eparam,
      def_name: b_res.s.def_name,
      hash_to_name: b_res.s.hash_to_name,
      group_names: b_res.s.group_names,
      self_index: b_res.s.self_index
    } in
    QcDecEparam { eparams: [b_res.val], s: popped_s }
  else QcDecEparam { eparams: [], s: s }

fn qc_dec_effects(s: QcDecState) -> QcDecRes[List[Str]] =
  let n_res = qc_dec_varint(s) in
  qc_dec_effects_loop(n_res.s, n_res.val, AccEnd)

fn qc_dec_types_loop(s: QcDecState, count: Int, acc: Accum[QcType]) -> QcDecRes[List[QcType]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let t_res = qc_dec_type(s) in
    qc_dec_types_loop(t_res.s, count - 1, AccPush(acc, t_res.val))

fn qc_dec_type(s: QcDecState) -> QcDecRes[QcType] =
  let tag_res = qc_dec_byte(s) in
  let tag = tag_res.val in
  let s1 = tag_res.s in
  if tag == 0 then QcDecRes { val: QcTInt, s: s1 }
  else if tag == 1 then QcDecRes { val: QcTFloat, s: s1 }
  else if tag == 2 then QcDecRes { val: QcTBool, s: s1 }
  else if tag == 3 then QcDecRes { val: QcTUnit, s: s1 }
  else if tag == 4 then QcDecRes { val: QcTStr, s: s1 }
  else if tag == 5 then
    let elem_res = qc_dec_type(s1) in
    QcDecRes { val: QcTList(elem_res.val), s: elem_res.s }
  else if tag == 6 then
    let elem_res = qc_dec_type(s1) in
    QcDecRes { val: QcTOption(elem_res.val), s: elem_res.s }
  else if tag == 7 then
    let ok_res = qc_dec_type(s1) in
    let err_res = qc_dec_type(ok_res.s) in
    QcDecRes { val: QcTResult(ok_res.val, err_res.val), s: err_res.s }
  else if tag == 8 then
    let ref_res = qc_dec_ref(s1) in
    QcDecRes { val: QcTNamed(ref_res.val), s: ref_res.s }
  else if tag == 9 then
    let n_res = qc_dec_varint(s1) in
    let params_res = qc_dec_types_loop(n_res.s, n_res.val, AccEnd) in
    let ret_res = qc_dec_type(params_res.s) in
    let effs_res = qc_dec_effects(ret_res.s) in
    QcDecRes { val: QcTFn(params_res.val, ret_res.val, effs_res.val), s: effs_res.s }
  else if tag == 10 then
    let ref_res = qc_dec_ref(s1) in
    let n_res = qc_dec_varint(ref_res.s) in
    let args_res = qc_dec_types_loop(n_res.s, n_res.val, AccEnd) in
    QcDecRes { val: QcTApp(ref_res.val, args_res.val), s: args_res.s }
  else if tag == 11 then
    let i_res = qc_dec_varint(s1) in
    let name = if i_res.val < len(s1.tparams) then list_at(s1.tparams, i_res.val) else "T" ++ from_int(i_res.val) in
    QcDecRes { val: QcTNamed(name), s: i_res.s }
  else if tag == 12 then
    let k_res = qc_dec_type(s1) in
    let v_res = qc_dec_type(k_res.s) in
    QcDecRes { val: QcTMap(k_res.val, v_res.val), s: v_res.s }
  else if tag == 13 then
    QcDecRes { val: QcTBytes, s: s1 }
  else
    QcDecRes { val: QcTUnit, s: s1 }

fn qc_dec_variant_name(s: QcDecState) -> QcDecRes[Str] =
  let owner_res = qc_dec_byte(s) in
  let s_after_owner = if owner_res.val == 2 then
    let ref_res = qc_dec_ref(owner_res.s) in
    ref_res.s
  else owner_res.s in
  qc_dec_str(s_after_owner)

fn qc_binop_from_tag(tag: Int) -> QcBinOp =
  if tag == 0 then QcOpAdd
  else if tag == 1 then QcOpSub
  else if tag == 2 then QcOpMul
  else if tag == 3 then QcOpDiv
  else if tag == 4 then QcOpRem
  else if tag == 5 then QcOpConcat
  else if tag == 6 then QcOpEq
  else if tag == 7 then QcOpNe
  else if tag == 8 then QcOpLt
  else if tag == 9 then QcOpLe
  else if tag == 10 then QcOpGt
  else if tag == 11 then QcOpGe
  else if tag == 12 then QcOpAnd
  else QcOpOr

fn qc_dec_pats_loop(s: QcDecState, count: Int, acc: Accum[QcPat]) -> QcDecRes[List[QcPat]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let p_res = qc_dec_pat(s) in
    qc_dec_pats_loop(p_res.s, count - 1, AccPush(acc, p_res.val))

fn qc_dec_field_pats_loop(s: QcDecState, count: Int, acc: Accum[QcFieldPat]) -> QcDecRes[List[QcFieldPat]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let f_name = qc_dec_str(s) in
    let f_pat = qc_dec_pat(f_name.s) in
    let fp = QcFieldPat { name: f_name.val, pat: f_pat.val } in
    qc_dec_field_pats_loop(f_pat.s, count - 1, AccPush(acc, fp))

fn qc_dec_pat(s: QcDecState) -> QcDecRes[QcPat] =
  let tag_res = qc_dec_byte(s) in
  let tag = tag_res.val in
  let s1 = tag_res.s in
  if tag == 0 then QcDecRes { val: QcPWild, s: s1 }
  else if tag == 1 then
    let b_res = qc_dec_bind(s1) in
    QcDecRes { val: QcPBind(b_res.val), s: b_res.s }
  else if tag == 2 then
    let i_res = qc_dec_i64(s1) in
    QcDecRes { val: QcPInt(i_res.val), s: i_res.s }
  else if tag == 3 then
    let s_res = qc_dec_str(s1) in
    QcDecRes { val: QcPStr(s_res.val), s: s_res.s }
  else if tag == 4 then
    let b_res = qc_dec_byte(s1) in
    QcDecRes { val: QcPBool(b_res.val == 1), s: b_res.s }
  else if tag == 5 then
    QcDecRes { val: QcPUnit, s: s1 }
  else if tag == 6 then
    let vn_res = qc_dec_variant_name(s1) in
    let n_res = qc_dec_varint(vn_res.s) in
    let pats_res = qc_dec_pats_loop(n_res.s, n_res.val, AccEnd) in
    QcDecRes { val: QcPVariant(vn_res.val, pats_res.val), s: pats_res.s }
  else if tag == 7 then
    let ref_res = qc_dec_ref(s1) in
    let n_res = qc_dec_varint(ref_res.s) in
    let fields_res = qc_dec_field_pats_loop(n_res.s, n_res.val, AccEnd) in
    QcDecRes { val: QcPRecord(ref_res.val, fields_res.val), s: fields_res.s }
  else
    QcDecRes { val: QcPWild, s: s1 }

fn qc_dec_exprs_loop(s: QcDecState, count: Int, acc: Accum[QcExpr]) -> QcDecRes[List[QcExpr]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let e_res = qc_dec_expr(s) in
    qc_dec_exprs_loop(e_res.s, count - 1, AccPush(acc, e_res.val))

fn qc_dec_exprs(s: QcDecState) -> QcDecRes[List[QcExpr]] =
  let n_res = qc_dec_varint(s) in
  qc_dec_exprs_loop(n_res.s, n_res.val, AccEnd)

fn qc_dec_record_fields_loop(s: QcDecState, count: Int, acc: Accum[QcFieldExpr]) -> QcDecRes[List[QcFieldExpr]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let fn_res = qc_dec_str(s) in
    let fv_res = qc_dec_expr(fn_res.s) in
    let rf = QcFieldExpr { name: fn_res.val, expr: fv_res.val } in
    qc_dec_record_fields_loop(fv_res.s, count - 1, AccPush(acc, rf))

fn qc_dec_arms_loop(s: QcDecState, count: Int, acc: Accum[QcArm]) -> QcDecRes[List[QcArm]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let orig_scope = s.scope in
    let pat_res = qc_dec_pat(s) in
    let g_flag = qc_dec_byte(pat_res.s) in
    let guard_res = if g_flag.val == 1 then
      let ge = qc_dec_expr(g_flag.s) in
      QcDecRes { val: Some(ge.val), s: ge.s }
    else
      QcDecRes { val: None, s: g_flag.s } in
    let body_res = qc_dec_expr(guard_res.s) in
    let arm = QcArm { pat: pat_res.val, guard: guard_res.val, body: body_res.val } in
    let next_s = QcDecState {
      bytes: body_res.s.bytes,
      pos: body_res.s.pos,
      scope: orig_scope,
      local_names: body_res.s.local_names,
      next_name: body_res.s.next_name,
      tparams: body_res.s.tparams,
      saw_eparam: body_res.s.saw_eparam,
      def_name: body_res.s.def_name,
      hash_to_name: body_res.s.hash_to_name,
      group_names: body_res.s.group_names,
      self_index: body_res.s.self_index
    } in
    qc_dec_arms_loop(next_s, count - 1, AccPush(acc, arm))

fn qc_dec_lambda_types_loop(s: QcDecState, count: Int, acc: Accum[Option[QcType]]) -> QcDecRes[List[Option[QcType]]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let flag_res = qc_dec_byte(s) in
    if flag_res.val == 1 then
      let ty_res = qc_dec_type(flag_res.s) in
      qc_dec_lambda_types_loop(ty_res.s, count - 1, AccPush(acc, Some(ty_res.val)))
    else
      qc_dec_lambda_types_loop(flag_res.s, count - 1, AccPush(acc, None))

fn qc_dec_lambda_binds_loop(s: QcDecState, tys: List[Option[QcType]], idx: Int, acc: Accum[QcLambdaParam]) -> QcDecRes[List[QcLambdaParam]] =
  if idx >= len(tys) then QcDecRes { val: acc_list(acc), s: s }
  else
    let opt_ty = list_at(tys, idx) in
    let b_res = qc_dec_bind(s) in
    let param = QcLambdaParam { name: b_res.val, ty: opt_ty } in
    qc_dec_lambda_binds_loop(b_res.s, tys, idx + 1, AccPush(acc, param))

fn qc_dec_expr(s: QcDecState) -> QcDecRes[QcExpr] =
  let tag_res = qc_dec_byte(s) in
  let tag = tag_res.val in
  let s1 = tag_res.s in
  if tag == 0 then
    let i_res = qc_dec_i64(s1) in
    QcDecRes { val: QcEInt(i_res.val), s: i_res.s }
  else if tag == 1 then
    let f_res = qc_dec_float(s1) in
    QcDecRes { val: QcEFloat(f_res.val), s: f_res.s }
  else if tag == 2 then
    let b_res = qc_dec_byte(s1) in
    QcDecRes { val: QcEBool(b_res.val == 1), s: b_res.s }
  else if tag == 3 then
    let s_res = qc_dec_str(s1) in
    QcDecRes { val: QcEStr(s_res.val), s: s_res.s }
  else if tag == 4 then
    QcDecRes { val: QcEUnit, s: s1 }
  else if tag == 5 then
    let v_res = qc_dec_local(s1) in
    QcDecRes { val: QcEVar(v_res.val), s: v_res.s }
  else if tag == 6 then
    let r_res = qc_dec_ref(s1) in
    QcDecRes { val: QcEVar(r_res.val), s: r_res.s }
  else if tag == 7 then
    let vn_res = qc_dec_variant_name(s1) in
    let n_res = qc_dec_varint(vn_res.s) in
    let args_res = qc_dec_exprs_loop(n_res.s, n_res.val, AccEnd) in
    if n_res.val == 0 then QcDecRes { val: QcEVar(vn_res.val), s: args_res.s }
    else QcDecRes { val: QcECall(vn_res.val, args_res.val), s: args_res.s }
  else if tag == 8 || tag == 9 || tag == 10 then
    let fn_res =
      if tag == 8 then qc_dec_local(s1)
      else if tag == 9 then qc_dec_ref(s1)
      else qc_dec_str(s1) in
    let n_res = qc_dec_varint(fn_res.s) in
    let args_res = qc_dec_exprs_loop(n_res.s, n_res.val, AccEnd) in
    QcDecRes { val: QcECall(fn_res.val, args_res.val), s: args_res.s }
  else if tag == 11 then
    let op_res = qc_dec_byte(s1) in
    let l_res = qc_dec_expr(op_res.s) in
    let r_res = qc_dec_expr(l_res.s) in
    QcDecRes { val: QcEBin(qc_binop_from_tag(op_res.val), l_res.val, r_res.val), s: r_res.s }
  else if tag == 12 then
    let op_res = qc_dec_byte(s1) in
    let x_res = qc_dec_expr(op_res.s) in
    let op = if op_res.val == 0 then QcUnNeg else QcUnNot in
    QcDecRes { val: QcEUn(op, x_res.val), s: x_res.s }
  else if tag == 13 then
    let c_res = qc_dec_expr(s1) in
    let t_res = qc_dec_expr(c_res.s) in
    let e_res = qc_dec_expr(t_res.s) in
    QcDecRes { val: QcEIf(c_res.val, t_res.val, e_res.val), s: e_res.s }
  else if tag == 14 then
    let flag_res = qc_dec_byte(s1) in
    let ann_res = if flag_res.val == 1 then
      let ty_res = qc_dec_type(flag_res.s) in
      QcDecRes { val: Some(ty_res.val), s: ty_res.s }
    else
      QcDecRes { val: None, s: flag_res.s } in
    let val_res = qc_dec_expr(ann_res.s) in
    let orig_scope = val_res.s.scope in
    let bind_res = qc_dec_bind(val_res.s) in
    let body_res = qc_dec_expr(bind_res.s) in
    let popped_s = QcDecState {
      bytes: body_res.s.bytes,
      pos: body_res.s.pos,
      scope: orig_scope,
      local_names: body_res.s.local_names,
      next_name: body_res.s.next_name,
      tparams: body_res.s.tparams,
      saw_eparam: body_res.s.saw_eparam,
      def_name: body_res.s.def_name,
      hash_to_name: body_res.s.hash_to_name,
      group_names: body_res.s.group_names,
      self_index: body_res.s.self_index
    } in
    QcDecRes { val: QcELet(bind_res.val, ann_res.val, val_res.val, body_res.val), s: popped_s }
  else if tag == 15 then
    let n_res = qc_dec_varint(s1) in
    let items_res = qc_dec_exprs_loop(n_res.s, n_res.val, AccEnd) in
    QcDecRes { val: QcEList(items_res.val), s: items_res.s }
  else if tag == 16 then
    let ref_res = qc_dec_ref(s1) in
    let n_res = qc_dec_varint(ref_res.s) in
    let fields_res = qc_dec_record_fields_loop(n_res.s, n_res.val, AccEnd) in
    QcDecRes { val: QcERecord(ref_res.val, fields_res.val), s: fields_res.s }
  else if tag == 17 then
    let target_res = qc_dec_expr(s1) in
    let fname_res = qc_dec_str(target_res.s) in
    QcDecRes { val: QcEField(target_res.val, fname_res.val), s: fname_res.s }
  else if tag == 18 then
    let scrut_res = qc_dec_expr(s1) in
    let n_res = qc_dec_varint(scrut_res.s) in
    let arms_res = qc_dec_arms_loop(n_res.s, n_res.val, AccEnd) in
    QcDecRes { val: QcEMatch(scrut_res.val, arms_res.val), s: arms_res.s }
  else if tag == 19 then
    let n_res = qc_dec_varint(s1) in
    let items_res = qc_dec_exprs_loop(n_res.s, n_res.val, AccEnd) in
    QcDecRes { val: QcESeq(items_res.val), s: items_res.s }
  else if tag == 20 then
    let n_res = qc_dec_varint(s1) in
    let types_res = qc_dec_lambda_types_loop(n_res.s, n_res.val, AccEnd) in
    let orig_scope = types_res.s.scope in
    let binds_res = qc_dec_lambda_binds_loop(types_res.s, types_res.val, 0, AccEnd) in
    let body_res = qc_dec_expr(binds_res.s) in
    let popped_s = QcDecState {
      bytes: body_res.s.bytes,
      pos: body_res.s.pos,
      scope: orig_scope,
      local_names: body_res.s.local_names,
      next_name: body_res.s.next_name,
      tparams: body_res.s.tparams,
      saw_eparam: body_res.s.saw_eparam,
      def_name: body_res.s.def_name,
      hash_to_name: body_res.s.hash_to_name,
      group_names: body_res.s.group_names,
      self_index: body_res.s.self_index
    } in
    QcDecRes { val: QcELambda(binds_res.val, body_res.val), s: popped_s }
  else
    QcDecRes { val: QcEUnit, s: s1 }

fn qc_dec_tparams_loop(s: QcDecState, count: Int, acc: Accum[Str]) -> QcDecRes[List[Str]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let b_res = qc_dec_bind(s) in
    let popped_s = QcDecState {
      bytes: b_res.s.bytes,
      pos: b_res.s.pos,
      scope: s.scope,
      local_names: b_res.s.local_names,
      next_name: b_res.s.next_name,
      tparams: b_res.s.tparams,
      saw_eparam: b_res.s.saw_eparam,
      def_name: b_res.s.def_name,
      hash_to_name: b_res.s.hash_to_name,
      group_names: b_res.s.group_names,
      self_index: b_res.s.self_index
    } in
    qc_dec_tparams_loop(popped_s, count - 1, AccPush(acc, b_res.val))

fn qc_dec_type_fields_loop(s: QcDecState, count: Int, acc: Accum[QcFieldType]) -> QcDecRes[List[QcFieldType]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let fname_res = qc_dec_str(s) in
    let fty_res = qc_dec_type(fname_res.s) in
    let ft = QcFieldType { name: fname_res.val, ty: fty_res.val } in
    qc_dec_type_fields_loop(fty_res.s, count - 1, AccPush(acc, ft))

fn qc_dec_variants_loop(s: QcDecState, count: Int, acc: Accum[QcVariant]) -> QcDecRes[List[QcVariant]] =
  if count <= 0 then QcDecRes { val: acc_list(acc), s: s }
  else
    let vname_res = qc_dec_str(s) in
    let k_res = qc_dec_varint(vname_res.s) in
    let fields_res = qc_dec_types_loop(k_res.s, k_res.val, AccEnd) in
    let v = QcVariant { name: vname_res.val, fields: fields_res.val } in
    qc_dec_variants_loop(fields_res.s, count - 1, AccPush(acc, v))

fn qc_dec_bind_params_loop(s: QcDecState, tys: List[QcType], idx: Int, acc: Accum[QcFieldType]) -> QcDecRes[List[QcFieldType]] =
  if idx >= len(tys) then QcDecRes { val: acc_list(acc), s: s }
  else
    let ty = list_at(tys, idx) in
    let b_res = qc_dec_bind(s) in
    let param = QcFieldType { name: b_res.val, ty: ty } in
    qc_dec_bind_params_loop(b_res.s, tys, idx + 1, AccPush(acc, param))

fn qc_dec_member(s: QcDecState) -> QcDecRes[QcDef] =
  let kind_res = qc_dec_byte(s) in
  let raw_kind = kind_res.val in
  let tparams_res = if raw_kind == 3 || raw_kind == 4 then
    let n_res = qc_dec_varint(kind_res.s) in
    qc_dec_tparams_loop(n_res.s, n_res.val, AccEnd)
  else
    QcDecRes { val: [], s: kind_res.s } in
  let kind = if raw_kind >= 3 then raw_kind - 3 else raw_kind in
  let s_with_tparams = QcDecState {
    bytes: tparams_res.s.bytes,
    pos: tparams_res.s.pos,
    scope: tparams_res.s.scope,
    local_names: tparams_res.s.local_names,
    next_name: tparams_res.s.next_name,
    tparams: tparams_res.val,
    saw_eparam: tparams_res.s.saw_eparam,
    def_name: tparams_res.s.def_name,
    hash_to_name: tparams_res.s.hash_to_name,
    group_names: tparams_res.s.group_names,
    self_index: tparams_res.s.self_index
  } in
  if kind == 0 then
    let tag_res = qc_dec_byte(s_with_tparams) in
    if tag_res.val == 0 then
      let n_res = qc_dec_varint(tag_res.s) in
      let fields_res = qc_dec_type_fields_loop(n_res.s, n_res.val, AccEnd) in
      QcDecRes {
        val: QcDefType(QcTypeDef { name: s.def_name, params: tparams_res.val, body: QcBodyRecord(fields_res.val) }),
        s: fields_res.s
      }
    else
      let n_res = qc_dec_varint(tag_res.s) in
      let variants_res = qc_dec_variants_loop(n_res.s, n_res.val, AccEnd) in
      QcDecRes {
        val: QcDefType(QcTypeDef { name: s.def_name, params: tparams_res.val, body: QcBodyEnum(variants_res.val) }),
        s: variants_res.s
      }
  else if kind == 1 then
    let n_res = qc_dec_varint(s_with_tparams) in
    let param_tys_res = qc_dec_types_loop(n_res.s, n_res.val, AccEnd) in
    let ret_res = qc_dec_type(param_tys_res.s) in
    let effs_res = qc_dec_effects(ret_res.s) in
    let ep = qc_dec_eparam(effs_res.s) in
    let ep_from = ["#0"] in
    let param_tys = map(param_tys_res.val, fn(t: QcType) => qc_type_map_effects(t, ep_from, ep.eparams)) in
    let ret_ty = qc_type_map_effects(ret_res.val, ep_from, ep.eparams) in
    let effects = qc_rename_effects(effs_res.val, ep_from, ep.eparams) in
    let params_res = qc_dec_bind_params_loop(ep.s, param_tys, 0, AccEnd) in
    let params_scope = params_res.s.scope in
    let reqs_res = qc_dec_exprs(params_res.s) in
    let s_with_r = QcDecState {
      bytes: reqs_res.s.bytes,
      pos: reqs_res.s.pos,
      scope: ["r"] ++ params_scope,
      local_names: reqs_res.s.local_names,
      next_name: reqs_res.s.next_name,
      tparams: reqs_res.s.tparams,
      saw_eparam: reqs_res.s.saw_eparam,
      def_name: reqs_res.s.def_name,
      hash_to_name: reqs_res.s.hash_to_name,
      group_names: reqs_res.s.group_names,
      self_index: reqs_res.s.self_index
    } in
    let enss_res = qc_dec_exprs(s_with_r) in
    let s_for_body = QcDecState {
      bytes: enss_res.s.bytes,
      pos: enss_res.s.pos,
      scope: params_scope,
      local_names: enss_res.s.local_names,
      next_name: enss_res.s.next_name,
      tparams: enss_res.s.tparams,
      saw_eparam: enss_res.s.saw_eparam,
      def_name: enss_res.s.def_name,
      hash_to_name: enss_res.s.hash_to_name,
      group_names: enss_res.s.group_names,
      self_index: enss_res.s.self_index
    } in
    let body_res = qc_dec_expr(s_for_body) in
    QcDecRes {
      val: QcDefFn(QcFnDef {
        name: s.def_name,
        tparams: tparams_res.val,
        eparams: ep.eparams,
        params: params_res.val,
        ret: ret_ty,
        effects: effects,
        reqs: reqs_res.val,
        enss: enss_res.val,
        body: body_res.val
      }),
      s: body_res.s
    }
  else
    let body_res = qc_dec_expr(s_with_tparams) in
    QcDecRes {
      val: QcDefTest(QcTestDef { name: s.def_name, body: body_res.val }),
      s: body_res.s
    }

fn qc_skip_members_loop(s: QcDecState, count: Int) -> QcDecState =
  if count <= 0 then s
  else
    let dec = qc_dec_member(s) in
    qc_skip_members_loop(dec.s, count - 1)

fn qc_decode_canonical(canonical: Bytes, local_names: List[Str], def_name: Str, group_form: Option[Bytes], hash_to_name: Map[Str, Str], group_names: List[Str]) -> Option[QcDef] =
  if bytes_len(canonical) < 6 then None
  else
    let s0 = QcDecState {
      bytes: canonical,
      pos: 5,
      scope: [],
      local_names: local_names,
      next_name: 0,
      tparams: [],
      saw_eparam: false,
      def_name: def_name,
      hash_to_name: hash_to_name,
      group_names: group_names,
      self_index: 0
    } in
    let size_res = qc_dec_varint(s0) in
    let index_res = qc_dec_varint(size_res.s) in
    if size_res.val == 1 then
      let s_member = QcDecState {
        bytes: canonical,
        pos: index_res.s.pos,
        scope: [],
        local_names: local_names,
        next_name: 0,
        tparams: [],
        saw_eparam: false,
        def_name: def_name,
        hash_to_name: hash_to_name,
        group_names: group_names,
        self_index: 0
      } in
      let res = qc_dec_member(s_member) in
      Some(res.val)
    else
      match group_form {
        Some(g_bytes) =>
          let g_s0 = QcDecState {
            bytes: g_bytes,
            pos: 5,
            scope: [],
            local_names: local_names,
            next_name: 0,
            tparams: [],
            saw_eparam: false,
            def_name: def_name,
            hash_to_name: hash_to_name,
            group_names: group_names,
            self_index: index_res.val
          } in
          let g_size_res = qc_dec_varint(g_s0) in
          let target_idx = index_res.val in
          let s_target = qc_skip_members_loop(g_size_res.s, target_idx) in
          let s_member = QcDecState {
            bytes: g_bytes,
            pos: s_target.pos,
            scope: [],
            local_names: local_names,
            next_name: 0,
            tparams: [],
            saw_eparam: false,
            def_name: def_name,
            hash_to_name: hash_to_name,
            group_names: group_names,
            self_index: target_idx
          } in
          let res = qc_dec_member(s_member) in
          Some(res.val),
        None => None
      }

fn qc_find_group_form_loop(target_hash: Bytes, groups: List[QcGroup], idx: Int) -> Option[Bytes] =
  if idx >= len(groups) then None
  else
    let g = list_at(groups, idx) in
    if g.hash == target_hash then Some(g.form)
    else qc_find_group_form_loop(target_hash, groups, idx + 1)

fn qc_find_group_form(canonical: Bytes, groups: List[QcGroup]) -> Option[Bytes] =
  if bytes_len(canonical) < 37 then None
  else
    let hash_start = bytes_len(canonical) - 32 in
    let gh = bytes_slice(canonical, hash_start, bytes_len(canonical)) in
    qc_find_group_form_loop(gh, groups, 0)

fn qc_find_member_name_at_idx(entries: List[QcStateEntry], target_gh: Bytes, target_idx: Int, idx: Int) -> Str =
  if idx >= len(entries) then ""
  else
    let e = list_at(entries, idx) in
    if bytes_len(e.canonical) < 37 then qc_find_member_name_at_idx(entries, target_gh, target_idx, idx + 1)
    else
      let gh = bytes_slice(e.canonical, bytes_len(e.canonical) - 32, bytes_len(e.canonical)) in
      if gh != target_gh then qc_find_member_name_at_idx(entries, target_gh, target_idx, idx + 1)
      else
        let dummy_s = QcDecState { bytes: e.canonical, pos: 5, scope: [], local_names: [], next_name: 0, tparams: [], saw_eparam: false, def_name: "", hash_to_name: map_new(), group_names: [], self_index: 0 } in
        let size_res = qc_dec_varint(dummy_s) in
        let idx_res = qc_dec_varint(size_res.s) in
        if idx_res.val == target_idx then e.name
        else qc_find_member_name_at_idx(entries, target_gh, target_idx, idx + 1)

fn qc_build_group_names_loop(entries: List[QcStateEntry], target_gh: Bytes, cur_idx: Int, size: Int, acc: Accum[Str]) -> List[Str] =
  if cur_idx >= size then acc_list(acc)
  else
    let name = qc_find_member_name_at_idx(entries, target_gh, cur_idx, 0) in
    qc_build_group_names_loop(entries, target_gh, cur_idx + 1, size, AccPush(acc, name))

fn qc_find_group_names(canonical: Bytes, entries: List[QcStateEntry]) -> List[Str] =
  if bytes_len(canonical) < 37 then []
  else
    let dummy_s = QcDecState { bytes: canonical, pos: 5, scope: [], local_names: [], next_name: 0, tparams: [], saw_eparam: false, def_name: "", hash_to_name: map_new(), group_names: [], self_index: 0 } in
    let size_res = qc_dec_varint(dummy_s) in
    if size_res.val <= 1 then []
    else
      let gh = bytes_slice(canonical, bytes_len(canonical) - 32, bytes_len(canonical)) in
      qc_build_group_names_loop(entries, gh, 0, size_res.val, AccEnd)

test qc_canon_test =
  let src = "fn add(a: Int, b: Int) -> Int !io\n  req a >= 0\n= a + b * 2\n" in
  match qc_parse(src) {
    Ok(p) =>
      let h = qc_hash_program(p) in
      len(h.canons) == 1 && bytes_len((list_at(h.canons, 0)).hash) == 32,
    Err(_) => false
  }

# Typed AST (TProgram) and QALT binary format codec for QAL self-hosting compiler (spec §7: qc_tform)

type QcReader = {
  bytes: Bytes,
  pos: Int
}

type QcReadRes[T] = {
  val: T,
  r: QcReader
}

fn qc_reader_byte(r: QcReader) -> QcReadRes[Int] =
  let b = bytes_at(r.bytes, r.pos) in
  QcReadRes { val: b, r: QcReader { bytes: r.bytes, pos: r.pos + 1 } }

fn qc_reader_varint_loop(r: QcReader, shift: Int, acc: Int) -> QcReadRes[Int] =
  let b = bytes_at(r.bytes, r.pos) in
  let r2 = QcReader { bytes: r.bytes, pos: r.pos + 1 } in
  let val = bit_or(acc, shl(bit_and(b, 127), shift)) in
  if bit_and(b, 128) == 0 then QcReadRes { val: val, r: r2 }
  else qc_reader_varint_loop(r2, shift + 7, val)

fn qc_reader_varint(r: QcReader) -> QcReadRes[Int] =
  qc_reader_varint_loop(r, 0, 0)

fn qc_reader_raw_bytes(r: QcReader, count: Int) -> QcReadRes[Bytes] =
  let slice = bytes_slice(r.bytes, r.pos, r.pos + count) in
  QcReadRes { val: slice, r: QcReader { bytes: r.bytes, pos: r.pos + count } }

fn qc_reader_bytes(r: QcReader) -> QcReadRes[Bytes] =
  let len_res = qc_reader_varint(r) in
  qc_reader_raw_bytes(len_res.r, len_res.val)

fn qc_reader_str(r: QcReader) -> QcReadRes[Str] =
  let b_res = qc_reader_bytes(r) in
  let s = match bytes_to_str(b_res.val) {
    Some(str_val) => str_val,
    None => ""
  } in
  QcReadRes { val: s, r: b_res.r }

fn qc_reader_strs_loop(r: QcReader, count: Int, acc: Accum[Str]) -> QcReadRes[List[Str]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let s_res = qc_reader_str(r) in
    qc_reader_strs_loop(s_res.r, count - 1, AccPush(acc, s_res.val))

fn qc_reader_strs(r: QcReader) -> QcReadRes[List[Str]] =
  let count_res = qc_reader_varint(r) in
  qc_reader_strs_loop(count_res.r, count_res.val, AccEnd)

fn qc_reader_ids_loop(r: QcReader, count: Int, acc: Accum[Int]) -> QcReadRes[List[Int]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let i_res = qc_reader_varint(r) in
    qc_reader_ids_loop(i_res.r, count - 1, AccPush(acc, i_res.val))

fn qc_reader_ids(r: QcReader) -> QcReadRes[List[Int]] =
  let count_res = qc_reader_varint(r) in
  qc_reader_ids_loop(count_res.r, count_res.val, AccEnd)

fn qc_reader_int_loop(r: QcReader, shift: Int, acc: Int) -> QcReadRes[Int] =
  let b = bytes_at(r.bytes, r.pos) in
  let r2 = QcReader { bytes: r.bytes, pos: r.pos + 1 } in
  let val = bit_or(acc, shl(bit_and(b, 127), shift)) in
  let next_shift = shift + 7 in
  if bit_and(b, 128) == 0 then
    let final_val = if next_shift < 64 && bit_and(b, 64) != 0 then
      bit_or(val, shl(-1, next_shift))
    else val in
    QcReadRes { val: final_val, r: r2 }
  else
    qc_reader_int_loop(r2, next_shift, val)

fn qc_reader_int(r: QcReader) -> QcReadRes[Int] =
  qc_reader_int_loop(r, 0, 0)

fn qc_reader_float(r: QcReader) -> QcReadRes[Float] =
  let b0 = bytes_at(r.bytes, r.pos) in
  let b1 = bytes_at(r.bytes, r.pos + 1) in
  let b2 = bytes_at(r.bytes, r.pos + 2) in
  let b3 = bytes_at(r.bytes, r.pos + 3) in
  let b4 = bytes_at(r.bytes, r.pos + 4) in
  let b5 = bytes_at(r.bytes, r.pos + 5) in
  let b6 = bytes_at(r.bytes, r.pos + 6) in
  let b7 = bytes_at(r.bytes, r.pos + 7) in
  let low = bit_or(b0, bit_or(shl(b1, 8), bit_or(shl(b2, 16), shl(b3, 24)))) in
  let high = bit_or(b4, bit_or(shl(b5, 8), bit_or(shl(b6, 16), shl(b7, 24)))) in
  let n = bit_or(bit_and(low, 4294967295), shl(high, 32)) in
  QcReadRes { val: float_of_bits(n), r: QcReader { bytes: r.bytes, pos: r.pos + 8 } }

# TForm AST encoder
fn qc_tform_put_int_loop(n: Int, acc: Accum[Int]) -> Accum[Int] =
  let b = bit_and(n, 127) in
  let next_n = shr(n, 7) in
  let b_sign = bit_and(b, 64) in
  let done = (next_n == 0 && b_sign == 0) || (next_n == -1 && b_sign != 0) in
  if done then AccPush(acc, b)
  else qc_tform_put_int_loop(next_n, AccPush(acc, bit_or(b, 128)))

fn qc_tform_type_acc(t: QcType, acc: Accum[Int]) -> Accum[Int] =
  match t {
    QcTInt => AccPush(acc, 0),
    QcTFloat => AccPush(acc, 1),
    QcTBool => AccPush(acc, 2),
    QcTUnit => AccPush(acc, 3),
    QcTStr => AccPush(acc, 4),
    QcTList(x) => qc_tform_type_acc(x, AccPush(acc, 5)),
    QcTOption(x) => qc_tform_type_acc(x, AccPush(acc, 6)),
    QcTResult(a, b) => qc_tform_type_acc(b, qc_tform_type_acc(a, AccPush(acc, 7))),
    QcTNamed(n) => qc_str_acc(n, AccPush(acc, 8)),
    QcTFn(ps, ret, effs) =>
      let a1 = qc_varint_acc(len(ps), AccPush(acc, 9)) in
      let a2 = fold(ps, a1, fn(st: Accum[Int], p: QcType) => qc_tform_type_acc(p, st)) in
      let a3 = qc_tform_type_acc(ret, a2) in
      let a4 = qc_varint_acc(len(effs), a3) in
      fold(effs, a4, fn(st: Accum[Int], e: Str) => qc_str_acc(e, st)),
    QcTApp(n, args) =>
      let a1 = qc_varint_acc(len(args), qc_str_acc(n, AccPush(acc, 10))) in
      fold(args, a1, fn(st: Accum[Int], arg: QcType) => qc_tform_type_acc(arg, st)),
    QcTParam(n) => qc_str_acc(n, AccPush(acc, 11)),
    QcTMap(k, v) => qc_tform_type_acc(v, qc_tform_type_acc(k, AccPush(acc, 12))),
    QcTBytes => AccPush(acc, 13),
    QcTVar(v) => qc_varint_acc(v, AccPush(acc, 14))
  }

fn qc_tform_opt_type_acc(ot: Option[QcType], acc: Accum[Int]) -> Accum[Int] =
  match ot {
    Some(t) => qc_tform_type_acc(t, AccPush(acc, 1)),
    None => AccPush(acc, 0)
  }

fn qc_tform_pat_acc(p: QcPat, acc: Accum[Int]) -> Accum[Int] =
  match p {
    QcPWild => AccPush(acc, 0),
    QcPBind(n) => qc_str_acc(n, AccPush(acc, 1)),
    QcPInt(n) => qc_tform_put_int_loop(n, AccPush(acc, 2)),
    QcPStr(s) => qc_str_acc(s, AccPush(acc, 3)),
    QcPBool(b) => AccPush(AccPush(acc, 4), if b then 1 else 0),
    QcPUnit => AccPush(acc, 5),
    QcPVariant(n, ps) =>
      let a1 = qc_varint_acc(len(ps), qc_str_acc(n, AccPush(acc, 6))) in
      fold(ps, a1, fn(st: Accum[Int], subp: QcPat) => qc_tform_pat_acc(subp, st)),
    QcPRecord(n, fs) =>
      let a1 = qc_varint_acc(len(fs), qc_str_acc(n, AccPush(acc, 7))) in
      fold(fs, a1, fn(st: Accum[Int], f: QcFieldPat) => qc_tform_pat_acc(f.pat, qc_str_acc(f.name, st)))
  }

fn qc_tform_expr_acc(e: QcExpr, acc: Accum[Int]) -> Accum[Int] =
  match e {
    QcEInt(n) => qc_tform_put_int_loop(n, AccPush(acc, 0)),
    QcEFloat(x) => qc_float_acc(x, AccPush(acc, 1)),
    QcEBool(b) => AccPush(AccPush(acc, 2), if b then 1 else 0),
    QcEStr(s) => qc_str_acc(s, AccPush(acc, 3)),
    QcEUnit => AccPush(acc, 4),
    QcEVar(v) => qc_str_acc(v, AccPush(acc, 5)),
    QcEBin(op, l, r) =>
      let a1 = AccPush(AccPush(acc, 6), qc_binop_tag(op)) in
      qc_tform_expr_acc(r, qc_tform_expr_acc(l, a1)),
    QcEUn(op, x) =>
      let tag = match op { QcUnNeg => 0, QcUnNot => 1 } in
      qc_tform_expr_acc(x, AccPush(AccPush(acc, 7), tag)),
    QcEIf(c, t, f) =>
      qc_tform_expr_acc(f, qc_tform_expr_acc(t, qc_tform_expr_acc(c, AccPush(acc, 8)))),
    QcELet(n, ann, val, body) =>
      let a1 = qc_tform_opt_type_acc(ann, qc_str_acc(n, AccPush(acc, 9))) in
      qc_tform_expr_acc(body, qc_tform_expr_acc(val, a1)),
    QcECall(f, args) =>
      let a1 = qc_varint_acc(len(args), qc_str_acc(f, AccPush(acc, 10))) in
      fold(args, a1, fn(st: Accum[Int], a: QcExpr) => qc_tform_expr_acc(a, st)),
    QcEList(items) =>
      let a1 = qc_varint_acc(len(items), AccPush(acc, 11)) in
      fold(items, a1, fn(st: Accum[Int], x: QcExpr) => qc_tform_expr_acc(x, st)),
    QcERecord(n, fs) =>
      let a1 = qc_varint_acc(len(fs), qc_str_acc(n, AccPush(acc, 12))) in
      fold(fs, a1, fn(st: Accum[Int], f: QcFieldExpr) => qc_tform_expr_acc(f.expr, qc_str_acc(f.name, st))),
    QcEField(target, field) =>
      qc_str_acc(field, qc_tform_expr_acc(target, AccPush(acc, 13))),
    QcEMatch(scrut, arms) =>
      let a1 = qc_varint_acc(len(arms), qc_tform_expr_acc(scrut, AccPush(acc, 14))) in
      fold(arms, a1, fn(st: Accum[Int], a: QcArm) =>
        let a_pat = qc_tform_pat_acc(a.pat, st) in
        let a_guard = match a.guard {
          Some(g) => qc_tform_expr_acc(g, AccPush(a_pat, 1)),
          None => AccPush(a_pat, 0)
        } in
        qc_tform_expr_acc(a.body, a_guard)
      ),
    QcESeq(items) =>
      let a1 = qc_varint_acc(len(items), AccPush(acc, 15)) in
      fold(items, a1, fn(st: Accum[Int], x: QcExpr) => qc_tform_expr_acc(x, st)),
    QcELambda(params, body) =>
      let a1 = qc_varint_acc(len(params), AccPush(acc, 16)) in
      let a2 = fold(params, a1, fn(st: Accum[Int], p: QcLambdaParam) =>
        qc_tform_opt_type_acc(p.ty, qc_str_acc(p.name, st))
      ) in
      qc_tform_expr_acc(body, a2)
  }

fn qc_tform_typedef_acc(t: QcTypeDef, acc: Accum[Int]) -> Accum[Int] =
  let a1 = qc_varint_acc(len(t.params), qc_str_acc(t.name, acc)) in
  let a2 = fold(t.params, a1, fn(st: Accum[Int], p: Str) => qc_str_acc(p, st)) in
  match t.body {
    QcBodyRecord(fields) =>
      let a3 = qc_varint_acc(len(fields), AccPush(a2, 0)) in
      fold(fields, a3, fn(st: Accum[Int], f: QcFieldType) => qc_tform_type_acc(f.ty, qc_str_acc(f.name, st))),
    QcBodyEnum(variants) =>
      let a3 = qc_varint_acc(len(variants), AccPush(a2, 1)) in
      fold(variants, a3, fn(st: Accum[Int], v: QcVariant) =>
        let av = qc_varint_acc(len(v.fields), qc_str_acc(v.name, st)) in
        fold(v.fields, av, fn(st2: Accum[Int], ty: QcType) => qc_tform_type_acc(ty, st2))
      )
  }

fn qc_tform_fndef_acc(f: QcFnDef, acc: Accum[Int]) -> Accum[Int] =
  # Effect parameters travel in the type-parameter list as `!name` entries.
  let heads = f.tparams ++ map(f.eparams, fn(e: Str) => "!" ++ e) in
  let a1 = qc_varint_acc(len(heads), qc_str_acc(f.name, acc)) in
  let a2 = fold(heads, a1, fn(st: Accum[Int], p: Str) => qc_str_acc(p, st)) in
  let a3 = qc_varint_acc(len(f.params), a2) in
  let a4 = fold(f.params, a3, fn(st: Accum[Int], p: QcFieldType) => qc_tform_type_acc(p.ty, qc_str_acc(p.name, st))) in
  let a5 = qc_tform_type_acc(f.ret, a4) in
  let a6 = qc_varint_acc(len(f.effects), a5) in
  let a7 = fold(f.effects, a6, fn(st: Accum[Int], e: Str) => qc_str_acc(e, st)) in
  let a8 = qc_varint_acc(len(f.reqs), a7) in
  let a9 = fold(f.reqs, a8, fn(st: Accum[Int], c: QcExpr) => qc_tform_expr_acc(c, st)) in
  let a10 = qc_varint_acc(len(f.enss), a9) in
  let a11 = fold(f.enss, a10, fn(st: Accum[Int], c: QcExpr) => qc_tform_expr_acc(c, st)) in
  qc_tform_expr_acc(f.body, a11)

fn qc_tform_def_acc(d: QcDef, acc: Accum[Int]) -> Accum[Int] =
  match d {
    QcDefType(t) => qc_tform_typedef_acc(t, AccPush(acc, 0)),
    QcDefFn(f) => qc_tform_fndef_acc(f, AccPush(acc, 1)),
    QcDefTest(t) =>
      let a1 = qc_str_acc(t.name, AccPush(acc, 2)) in
      qc_tform_expr_acc(t.body, a1)
  }

fn qc_encode_program(p: QcProgram) -> Bytes =
  let a0 = qc_varint_acc(len(p.defs), AccEnd) in
  let a1 = fold(p.defs, a0, fn(st: Accum[Int], d: QcDef) => qc_tform_def_acc(d, st)) in
  bytes_from(acc_list(a1))

# TForm AST decoder
fn qc_tform_dec_types_loop(r: QcReader, count: Int, acc: Accum[QcType]) -> QcReadRes[List[QcType]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let t_res = qc_tform_dec_type(r) in
    qc_tform_dec_types_loop(t_res.r, count - 1, AccPush(acc, t_res.val))

fn qc_tform_dec_types(r: QcReader) -> QcReadRes[List[QcType]] =
  let c_res = qc_reader_varint(r) in
  qc_tform_dec_types_loop(c_res.r, c_res.val, AccEnd)

fn qc_tform_dec_type(r: QcReader) -> QcReadRes[QcType] =
  let tag_res = qc_reader_byte(r) in
  let tag = tag_res.val in
  let r1 = tag_res.r in
  if tag == 0 then QcReadRes { val: QcTInt, r: r1 }
  else if tag == 1 then QcReadRes { val: QcTFloat, r: r1 }
  else if tag == 2 then QcReadRes { val: QcTBool, r: r1 }
  else if tag == 3 then QcReadRes { val: QcTUnit, r: r1 }
  else if tag == 4 then QcReadRes { val: QcTStr, r: r1 }
  else if tag == 5 then
    let x_res = qc_tform_dec_type(r1) in
    QcReadRes { val: QcTList(x_res.val), r: x_res.r }
  else if tag == 6 then
    let x_res = qc_tform_dec_type(r1) in
    QcReadRes { val: QcTOption(x_res.val), r: x_res.r }
  else if tag == 7 then
    let a_res = qc_tform_dec_type(r1) in
    let b_res = qc_tform_dec_type(a_res.r) in
    QcReadRes { val: QcTResult(a_res.val, b_res.val), r: b_res.r }
  else if tag == 8 then
    let n_res = qc_reader_str(r1) in
    QcReadRes { val: QcTNamed(n_res.val), r: n_res.r }
  else if tag == 9 then
    let ps_res = qc_tform_dec_types(r1) in
    let ret_res = qc_tform_dec_type(ps_res.r) in
    let effs_res = qc_reader_strs(ret_res.r) in
    QcReadRes { val: QcTFn(ps_res.val, ret_res.val, effs_res.val), r: effs_res.r }
  else if tag == 10 then
    let n_res = qc_reader_str(r1) in
    let args_res = qc_tform_dec_types(n_res.r) in
    QcReadRes { val: QcTApp(n_res.val, args_res.val), r: args_res.r }
  else if tag == 11 then
    let n_res = qc_reader_str(r1) in
    QcReadRes { val: QcTParam(n_res.val), r: n_res.r }
  else if tag == 12 then
    let k_res = qc_tform_dec_type(r1) in
    let v_res = qc_tform_dec_type(k_res.r) in
    QcReadRes { val: QcTMap(k_res.val, v_res.val), r: v_res.r }
  else if tag == 13 then
    QcReadRes { val: QcTBytes, r: r1 }
  else
    let v_res = qc_reader_varint(r1) in
    QcReadRes { val: QcTVar(v_res.val), r: v_res.r }

fn qc_tform_dec_opt_type(r: QcReader) -> QcReadRes[Option[QcType]] =
  let b_res = qc_reader_byte(r) in
  if b_res.val == 1 then
    let t_res = qc_tform_dec_type(b_res.r) in
    QcReadRes { val: Some(t_res.val), r: t_res.r }
  else
    QcReadRes { val: None, r: b_res.r }

fn qc_tform_dec_pats_loop(r: QcReader, count: Int, acc: Accum[QcPat]) -> QcReadRes[List[QcPat]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let p_res = qc_tform_dec_pat(r) in
    qc_tform_dec_pats_loop(p_res.r, count - 1, AccPush(acc, p_res.val))

fn qc_tform_dec_field_pats_loop(r: QcReader, count: Int, acc: Accum[QcFieldPat]) -> QcReadRes[List[QcFieldPat]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let fn_res = qc_reader_str(r) in
    let fp_res = qc_tform_dec_pat(fn_res.r) in
    qc_tform_dec_field_pats_loop(fp_res.r, count - 1, AccPush(acc, QcFieldPat { name: fn_res.val, pat: fp_res.val }))

fn qc_tform_dec_pat(r: QcReader) -> QcReadRes[QcPat] =
  let tag_res = qc_reader_byte(r) in
  let tag = tag_res.val in
  let r1 = tag_res.r in
  if tag == 0 then QcReadRes { val: QcPWild, r: r1 }
  else if tag == 1 then
    let n_res = qc_reader_str(r1) in
    QcReadRes { val: QcPBind(n_res.val), r: n_res.r }
  else if tag == 2 then
    let n_res = qc_reader_int(r1) in
    QcReadRes { val: QcPInt(n_res.val), r: n_res.r }
  else if tag == 3 then
    let s_res = qc_reader_str(r1) in
    QcReadRes { val: QcPStr(s_res.val), r: s_res.r }
  else if tag == 4 then
    let b_res = qc_reader_byte(r1) in
    QcReadRes { val: QcPBool(b_res.val == 1), r: b_res.r }
  else if tag == 5 then
    QcReadRes { val: QcPUnit, r: r1 }
  else if tag == 6 then
    let n_res = qc_reader_str(r1) in
    let c_res = qc_reader_varint(n_res.r) in
    let ps_res = qc_tform_dec_pats_loop(c_res.r, c_res.val, AccEnd) in
    QcReadRes { val: QcPVariant(n_res.val, ps_res.val), r: ps_res.r }
  else
    let n_res = qc_reader_str(r1) in
    let c_res = qc_reader_varint(n_res.r) in
    let fs_res = qc_tform_dec_field_pats_loop(c_res.r, c_res.val, AccEnd) in
    QcReadRes { val: QcPRecord(n_res.val, fs_res.val), r: fs_res.r }

fn qc_tform_dec_exprs_loop(r: QcReader, count: Int, acc: Accum[QcExpr]) -> QcReadRes[List[QcExpr]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let e_res = qc_tform_dec_expr(r) in
    qc_tform_dec_exprs_loop(e_res.r, count - 1, AccPush(acc, e_res.val))

fn qc_tform_dec_exprs(r: QcReader) -> QcReadRes[List[QcExpr]] =
  let c_res = qc_reader_varint(r) in
  qc_tform_dec_exprs_loop(c_res.r, c_res.val, AccEnd)

fn qc_tform_dec_field_exprs_loop(r: QcReader, count: Int, acc: Accum[QcFieldExpr]) -> QcReadRes[List[QcFieldExpr]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let fn_res = qc_reader_str(r) in
    let fe_res = qc_tform_dec_expr(fn_res.r) in
    qc_tform_dec_field_exprs_loop(fe_res.r, count - 1, AccPush(acc, QcFieldExpr { name: fn_res.val, expr: fe_res.val }))

fn qc_tform_dec_arms_loop(r: QcReader, count: Int, acc: Accum[QcArm]) -> QcReadRes[List[QcArm]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let pat_res = qc_tform_dec_pat(r) in
    let g_flag = qc_reader_byte(pat_res.r) in
    let g_res = if g_flag.val == 1 then
      let ge = qc_tform_dec_expr(g_flag.r) in
      QcReadRes { val: Some(ge.val), r: ge.r }
    else
      QcReadRes { val: None, r: g_flag.r } in
    let body_res = qc_tform_dec_expr(g_res.r) in
    qc_tform_dec_arms_loop(body_res.r, count - 1, AccPush(acc, QcArm { pat: pat_res.val, guard: g_res.val, body: body_res.val }))

fn qc_tform_dec_lambda_params_loop(r: QcReader, count: Int, acc: Accum[QcLambdaParam]) -> QcReadRes[List[QcLambdaParam]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let n_res = qc_reader_str(r) in
    let ty_res = qc_tform_dec_opt_type(n_res.r) in
    qc_tform_dec_lambda_params_loop(ty_res.r, count - 1, AccPush(acc, QcLambdaParam { name: n_res.val, ty: ty_res.val }))

fn qc_tform_dec_expr(r: QcReader) -> QcReadRes[QcExpr] =
  let tag_res = qc_reader_byte(r) in
  let tag = tag_res.val in
  let r1 = tag_res.r in
  if tag == 0 then
    let n_res = qc_reader_int(r1) in
    QcReadRes { val: QcEInt(n_res.val), r: n_res.r }
  else if tag == 1 then
    let f_res = qc_reader_float(r1) in
    QcReadRes { val: QcEFloat(f_res.val), r: f_res.r }
  else if tag == 2 then
    let b_res = qc_reader_byte(r1) in
    QcReadRes { val: QcEBool(b_res.val == 1), r: b_res.r }
  else if tag == 3 then
    let s_res = qc_reader_str(r1) in
    QcReadRes { val: QcEStr(s_res.val), r: s_res.r }
  else if tag == 4 then
    QcReadRes { val: QcEUnit, r: r1 }
  else if tag == 5 then
    let v_res = qc_reader_str(r1) in
    QcReadRes { val: QcEVar(v_res.val), r: v_res.r }
  else if tag == 6 then
    let op_res = qc_reader_byte(r1) in
    let l_res = qc_tform_dec_expr(op_res.r) in
    let r_res = qc_tform_dec_expr(l_res.r) in
    QcReadRes { val: QcEBin(qc_binop_from_tag(op_res.val), l_res.val, r_res.val), r: r_res.r }
  else if tag == 7 then
    let op_res = qc_reader_byte(r1) in
    let x_res = qc_tform_dec_expr(op_res.r) in
    let op = if op_res.val == 0 then QcUnNeg else QcUnNot in
    QcReadRes { val: QcEUn(op, x_res.val), r: x_res.r }
  else if tag == 8 then
    let c_res = qc_tform_dec_expr(r1) in
    let t_res = qc_tform_dec_expr(c_res.r) in
    let f_res = qc_tform_dec_expr(t_res.r) in
    QcReadRes { val: QcEIf(c_res.val, t_res.val, f_res.val), r: f_res.r }
  else if tag == 9 then
    let n_res = qc_reader_str(r1) in
    let ann_res = qc_tform_dec_opt_type(n_res.r) in
    let val_res = qc_tform_dec_expr(ann_res.r) in
    let body_res = qc_tform_dec_expr(val_res.r) in
    QcReadRes { val: QcELet(n_res.val, ann_res.val, val_res.val, body_res.val), r: body_res.r }
  else if tag == 10 then
    let f_res = qc_reader_str(r1) in
    let args_res = qc_tform_dec_exprs(f_res.r) in
    QcReadRes { val: QcECall(f_res.val, args_res.val), r: args_res.r }
  else if tag == 11 then
    let items_res = qc_tform_dec_exprs(r1) in
    QcReadRes { val: QcEList(items_res.val), r: items_res.r }
  else if tag == 12 then
    let n_res = qc_reader_str(r1) in
    let c_res = qc_reader_varint(n_res.r) in
    let fs_res = qc_tform_dec_field_exprs_loop(c_res.r, c_res.val, AccEnd) in
    QcReadRes { val: QcERecord(n_res.val, fs_res.val), r: fs_res.r }
  else if tag == 13 then
    let t_res = qc_tform_dec_expr(r1) in
    let f_res = qc_reader_str(t_res.r) in
    QcReadRes { val: QcEField(t_res.val, f_res.val), r: f_res.r }
  else if tag == 14 then
    let s_res = qc_tform_dec_expr(r1) in
    let c_res = qc_reader_varint(s_res.r) in
    let arms_res = qc_tform_dec_arms_loop(c_res.r, c_res.val, AccEnd) in
    QcReadRes { val: QcEMatch(s_res.val, arms_res.val), r: arms_res.r }
  else if tag == 15 then
    let items_res = qc_tform_dec_exprs(r1) in
    QcReadRes { val: QcESeq(items_res.val), r: items_res.r }
  else
    let c_res = qc_reader_varint(r1) in
    let ps_res = qc_tform_dec_lambda_params_loop(c_res.r, c_res.val, AccEnd) in
    let body_res = qc_tform_dec_expr(ps_res.r) in
    QcReadRes { val: QcELambda(ps_res.val, body_res.val), r: body_res.r }

fn qc_tform_dec_field_types_loop(r: QcReader, count: Int, acc: Accum[QcFieldType]) -> QcReadRes[List[QcFieldType]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let fn_res = qc_reader_str(r) in
    let ft_res = qc_tform_dec_type(fn_res.r) in
    qc_tform_dec_field_types_loop(ft_res.r, count - 1, AccPush(acc, QcFieldType { name: fn_res.val, ty: ft_res.val }))

fn qc_tform_dec_variants_loop(r: QcReader, count: Int, acc: Accum[QcVariant]) -> QcReadRes[List[QcVariant]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let vn_res = qc_reader_str(r) in
    let fs_res = qc_tform_dec_types(vn_res.r) in
    qc_tform_dec_variants_loop(fs_res.r, count - 1, AccPush(acc, QcVariant { name: vn_res.val, fields: fs_res.val }))

fn qc_tform_dec_params_loop(r: QcReader, count: Int, acc: Accum[QcFieldType]) -> QcReadRes[List[QcFieldType]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let pn_res = qc_reader_str(r) in
    let pt_res = qc_tform_dec_type(pn_res.r) in
    qc_tform_dec_params_loop(pt_res.r, count - 1, AccPush(acc, QcFieldType { name: pn_res.val, ty: pt_res.val }))

fn qc_tform_dec_typedef(r: QcReader) -> QcReadRes[QcTypeDef] =
  let n_res = qc_reader_str(r) in
  let ps_res = qc_reader_strs(n_res.r) in
  let btag_res = qc_reader_byte(ps_res.r) in
  if btag_res.val == 0 then
    let c_res = qc_reader_varint(btag_res.r) in
    let fs_res = qc_tform_dec_field_types_loop(c_res.r, c_res.val, AccEnd) in
    QcReadRes { val: QcTypeDef { name: n_res.val, params: ps_res.val, body: QcBodyRecord(fs_res.val) }, r: fs_res.r }
  else
    let c_res = qc_reader_varint(btag_res.r) in
    let vs_res = qc_tform_dec_variants_loop(c_res.r, c_res.val, AccEnd) in
    QcReadRes { val: QcTypeDef { name: n_res.val, params: ps_res.val, body: QcBodyEnum(vs_res.val) }, r: vs_res.r }

fn qc_tform_dec_fndef(r: QcReader) -> QcReadRes[QcFnDef] =
  let n_res = qc_reader_str(r) in
  # Effect parameters are the `!name` entries of the type-parameter list.
  let tps_res = qc_reader_strs(n_res.r) in
  let pc_res = qc_reader_varint(tps_res.r) in
  let ps_res = qc_tform_dec_params_loop(pc_res.r, pc_res.val, AccEnd) in
  let ret_res = qc_tform_dec_type(ps_res.r) in
  let effs_res = qc_reader_strs(ret_res.r) in
  let reqs_res = qc_tform_dec_exprs(effs_res.r) in
  let enss_res = qc_tform_dec_exprs(reqs_res.r) in
  let body_res = qc_tform_dec_expr(enss_res.r) in
  QcReadRes {
    val: QcFnDef {
      name: n_res.val,
      tparams: filter(tps_res.val, fn(h: Str) => !starts_with(h, "!")),
      eparams: map(filter(tps_res.val, fn(h: Str) => starts_with(h, "!")), fn(h: Str) => slice(h, 1, len(h))),
      params: ps_res.val,
      ret: ret_res.val,
      effects: effs_res.val,
      reqs: reqs_res.val,
      enss: enss_res.val,
      body: body_res.val
    },
    r: body_res.r
  }

fn qc_tform_dec_def(r: QcReader) -> QcReadRes[QcDef] =
  let tag_res = qc_reader_byte(r) in
  let tag = tag_res.val in
  let r1 = tag_res.r in
  if tag == 0 then
    let td_res = qc_tform_dec_typedef(r1) in
    QcReadRes { val: QcDefType(td_res.val), r: td_res.r }
  else if tag == 1 then
    let fd_res = qc_tform_dec_fndef(r1) in
    QcReadRes { val: QcDefFn(fd_res.val), r: fd_res.r }
  else
    let n_res = qc_reader_str(r1) in
    let body_res = qc_tform_dec_expr(n_res.r) in
    QcReadRes { val: QcDefTest(QcTestDef { name: n_res.val, body: body_res.val }), r: body_res.r }

fn qc_tform_dec_defs_loop(r: QcReader, count: Int, acc: Accum[QcDef]) -> QcReadRes[List[QcDef]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let d_res = qc_tform_dec_def(r) in
    qc_tform_dec_defs_loop(d_res.r, count - 1, AccPush(acc, d_res.val))

fn qc_tform_dec_program(b: Bytes) -> QcProgram =
  let r0 = QcReader { bytes: b, pos: 0 } in
  let c_res = qc_reader_varint(r0) in
  let defs_res = qc_tform_dec_defs_loop(c_res.r, c_res.val, AccEnd) in
  QcProgram { defs: defs_res.val }

# Typed AST (TProgram, TFn, TTest, TExpr, TKind, TPat, Builtin)
# Builtin indices match Builtin::ALL in qal-core/src/tast.rs (0..71).
type QcBuiltin =
  | QcBStrLen
  | QcBListLen
  | QcBSlice
  | QcBSplit
  | QcBJoin
  | QcBTrim
  | QcBContains
  | QcBStartsWith
  | QcBToInt
  | QcBToFloat
  | QcBFromInt
  | QcBFromFloat
  | QcBChars
  | QcBGet
  | QcBPush
  | QcBConcat
  | QcBMap
  | QcBFilter
  | QcBFold
  | QcBRange
  | QcBReverse
  | QcBSortInt
  | QcBIntToFloat
  | QcBFloatToInt
  | QcBPrint
  | QcBReadLine
  | QcBReadFile
  | QcBWriteFile
  | QcBNowMs
  | QcBRandInt
  | QcBReadAll
  | QcBSortStr
  | QcBCharCode
  | QcBFromCharCode
  | QcBToUpper
  | QcBToLower
  | QcBReplace
  | QcBIndexOf
  | QcBMapNew
  | QcBMapGet
  | QcBMapPut
  | QcBMapDel
  | QcBMapHas
  | QcBMapSize
  | QcBMapKeys
  | QcBMapValues
  | QcBToBytes
  | QcBBytesLen
  | QcBBytesGet
  | QcBBytesSlice
  | QcBBytesFrom
  | QcBBytesToList
  | QcBBytesToStr
  | QcBCompare
  | QcBHttp
  | QcBDbExec
  | QcBDbQuery
  | QcBBitAnd
  | QcBBitOr
  | QcBBitXor
  | QcBBitNot
  | QcBShl
  | QcBShr
  | QcBUshr
  | QcBFloatBits
  | QcBFloatOfBits
  | QcBListAt
  | QcBBytesAt
  | QcBAccList
  | QcBBytesJoin
  | QcBSha256
  | QcBTodo
  | QcBModelAsk
  | QcBTensorMatmul

fn qc_builtin_from_idx(i: Int) -> QcBuiltin =
  if i == 0 then QcBStrLen
  else if i == 1 then QcBListLen
  else if i == 2 then QcBSlice
  else if i == 3 then QcBSplit
  else if i == 4 then QcBJoin
  else if i == 5 then QcBTrim
  else if i == 6 then QcBContains
  else if i == 7 then QcBStartsWith
  else if i == 8 then QcBToInt
  else if i == 9 then QcBToFloat
  else if i == 10 then QcBFromInt
  else if i == 11 then QcBFromFloat
  else if i == 12 then QcBChars
  else if i == 13 then QcBGet
  else if i == 14 then QcBPush
  else if i == 15 then QcBConcat
  else if i == 16 then QcBMap
  else if i == 17 then QcBFilter
  else if i == 18 then QcBFold
  else if i == 19 then QcBRange
  else if i == 20 then QcBReverse
  else if i == 21 then QcBSortInt
  else if i == 22 then QcBIntToFloat
  else if i == 23 then QcBFloatToInt
  else if i == 24 then QcBPrint
  else if i == 25 then QcBReadLine
  else if i == 26 then QcBReadFile
  else if i == 27 then QcBWriteFile
  else if i == 28 then QcBNowMs
  else if i == 29 then QcBRandInt
  else if i == 30 then QcBReadAll
  else if i == 31 then QcBSortStr
  else if i == 32 then QcBCharCode
  else if i == 33 then QcBFromCharCode
  else if i == 34 then QcBToUpper
  else if i == 35 then QcBToLower
  else if i == 36 then QcBReplace
  else if i == 37 then QcBIndexOf
  else if i == 38 then QcBMapNew
  else if i == 39 then QcBMapGet
  else if i == 40 then QcBMapPut
  else if i == 41 then QcBMapDel
  else if i == 42 then QcBMapHas
  else if i == 43 then QcBMapSize
  else if i == 44 then QcBMapKeys
  else if i == 45 then QcBMapValues
  else if i == 46 then QcBToBytes
  else if i == 47 then QcBBytesLen
  else if i == 48 then QcBBytesGet
  else if i == 49 then QcBBytesSlice
  else if i == 50 then QcBBytesFrom
  else if i == 51 then QcBBytesToList
  else if i == 52 then QcBBytesToStr
  else if i == 53 then QcBCompare
  else if i == 54 then QcBHttp
  else if i == 55 then QcBDbExec
  else if i == 56 then QcBDbQuery
  else if i == 57 then QcBBitAnd
  else if i == 58 then QcBBitOr
  else if i == 59 then QcBBitXor
  else if i == 60 then QcBBitNot
  else if i == 61 then QcBShl
  else if i == 62 then QcBShr
  else if i == 63 then QcBUshr
  else if i == 64 then QcBFloatBits
  else if i == 65 then QcBFloatOfBits
  else if i == 66 then QcBListAt
  else if i == 67 then QcBBytesAt
  else if i == 68 then QcBAccList
  else if i == 69 then QcBBytesJoin
  else if i == 70 then QcBSha256
  else if i == 71 then QcBTodo
  else if i == 73 then QcBTensorMatmul
  else QcBModelAsk

fn qc_builtin_to_idx(b: QcBuiltin) -> Int =
  match b {
    QcBStrLen => 0,
    QcBListLen => 1,
    QcBSlice => 2,
    QcBSplit => 3,
    QcBJoin => 4,
    QcBTrim => 5,
    QcBContains => 6,
    QcBStartsWith => 7,
    QcBToInt => 8,
    QcBToFloat => 9,
    QcBFromInt => 10,
    QcBFromFloat => 11,
    QcBChars => 12,
    QcBGet => 13,
    QcBPush => 14,
    QcBConcat => 15,
    QcBMap => 16,
    QcBFilter => 17,
    QcBFold => 18,
    QcBRange => 19,
    QcBReverse => 20,
    QcBSortInt => 21,
    QcBIntToFloat => 22,
    QcBFloatToInt => 23,
    QcBPrint => 24,
    QcBReadLine => 25,
    QcBReadFile => 26,
    QcBWriteFile => 27,
    QcBNowMs => 28,
    QcBRandInt => 29,
    QcBReadAll => 30,
    QcBSortStr => 31,
    QcBCharCode => 32,
    QcBFromCharCode => 33,
    QcBToUpper => 34,
    QcBToLower => 35,
    QcBReplace => 36,
    QcBIndexOf => 37,
    QcBMapNew => 38,
    QcBMapGet => 39,
    QcBMapPut => 40,
    QcBMapDel => 41,
    QcBMapHas => 42,
    QcBMapSize => 43,
    QcBMapKeys => 44,
    QcBMapValues => 45,
    QcBToBytes => 46,
    QcBBytesLen => 47,
    QcBBytesGet => 48,
    QcBBytesSlice => 49,
    QcBBytesFrom => 50,
    QcBBytesToList => 51,
    QcBBytesToStr => 52,
    QcBCompare => 53,
    QcBHttp => 54,
    QcBDbExec => 55,
    QcBDbQuery => 56,
    QcBBitAnd => 57,
    QcBBitOr => 58,
    QcBBitXor => 59,
    QcBBitNot => 60,
    QcBShl => 61,
    QcBShr => 62,
    QcBUshr => 63,
    QcBFloatBits => 64,
    QcBFloatOfBits => 65,
    QcBListAt => 66,
    QcBBytesAt => 67,
    QcBAccList => 68,
    QcBBytesJoin => 69,
    QcBSha256 => 70,
    QcBTodo => 71,
    QcBModelAsk => 72,
    QcBTensorMatmul => 73
  }

type QcTPField = {
  idx: Int,
  pat: QcTPat
}

type QcTPat =
  | QcTPWild
  | QcTPBind(Int)
  | QcTPInt(Int)
  | QcTPStr(Str)
  | QcTPBool(Bool)
  | QcTPUnit
  | QcTPVariant(Int, List[QcTPat])
  | QcTPRecord(List[QcTPField])

type QcTLambda = {
  params: List[Int],
  captures: List[Int],
  body: QcTExpr
}

type QcTArm = {
  pat: QcTPat,
  guard: Option[QcTExpr],
  body: QcTExpr
}

type QcTField = {
  idx: Int,
  expr: QcTExpr
}

type QcTKind =
  | QcTKInt(Int)
  | QcTKFloat(Float)
  | QcTKBool(Bool)
  | QcTKStr(Str)
  | QcTKUnit
  | QcTKLocal(Int)
  | QcTKFnRef(Int)
  | QcTKBin(QcBinOp, QcTExpr, QcTExpr, Str)
  | QcTKUn(QcUnOp, QcTExpr, Str)
  | QcTKIf(QcTExpr, QcTExpr, QcTExpr)
  | QcTKLet(Int, QcTExpr, QcTExpr)
  | QcTKCall(Int, List[QcTExpr])
  | QcTKCallG(Int, List[QcType], List[QcTExpr])
  | QcTKFnRefG(Int, List[QcType])
  | QcTKLambda(QcTLambda)
  | QcTKCallIndirect(QcTExpr, List[QcTExpr])
  | QcTKBuiltin(QcBuiltin, List[QcTExpr], Str)
  | QcTKList(List[QcTExpr])
  | QcTKVariant(Int, List[QcTExpr])
  | QcTKRecord(List[QcTField])
  | QcTKField(QcTExpr, Int)
  | QcTKMatch(QcTExpr, List[QcTArm])
  | QcTKSeq(List[QcTExpr])

type QcTExpr = {
  ty: QcType,
  kind: QcTKind
}

type QcTFnInstance = {
  gen_idx: Int,
  args: List[QcType]
}

type QcTFn = {
  def: QcFnDef,
  locals: List[QcType],
  reqs: List[QcTExpr],
  enss: List[QcTExpr],
  result_local: Option[Int],
  body: QcTExpr,
  instance: Option[QcTFnInstance]
}

type QcTTest = {
  name: Str,
  locals: List[QcType],
  body: QcTExpr
}

type QcTProgram = {
  types: List[QcTypeDef],
  fns: List[QcTFn],
  tests: List[QcTTest],
  generics: List[QcTFn]
}

# QALT encoder
fn qc_tform_tpat_acc(p: QcTPat, acc: Accum[Int]) -> Accum[Int] =
  match p {
    QcTPWild => AccPush(acc, 0),
    QcTPBind(id) => qc_varint_acc(id, AccPush(acc, 1)),
    QcTPInt(n) => qc_tform_put_int_loop(n, AccPush(acc, 2)),
    QcTPStr(s) => qc_str_acc(s, AccPush(acc, 3)),
    QcTPBool(b) => AccPush(AccPush(acc, 4), if b then 1 else 0),
    QcTPUnit => AccPush(acc, 5),
    QcTPVariant(tag, ps) =>
      let a1 = qc_varint_acc(len(ps), qc_varint_acc(tag, AccPush(acc, 6))) in
      fold(ps, a1, fn(st: Accum[Int], subp: QcTPat) => qc_tform_tpat_acc(subp, st)),
    QcTPRecord(fs) =>
      let a1 = qc_varint_acc(len(fs), AccPush(acc, 7)) in
      fold(fs, a1, fn(st: Accum[Int], f: QcTPField) => qc_tform_tpat_acc(f.pat, qc_varint_acc(f.idx, st)))
  }

fn qc_tform_texprs_acc(xs: List[QcTExpr], acc: Accum[Int]) -> Accum[Int] =
  let a1 = qc_varint_acc(len(xs), acc) in
  fold(xs, a1, fn(st: Accum[Int], x: QcTExpr) => qc_tform_texpr_acc(x, st))

fn qc_tform_ids_acc(ids: List[Int], acc: Accum[Int]) -> Accum[Int] =
  let a1 = qc_varint_acc(len(ids), acc) in
  fold(ids, a1, fn(st: Accum[Int], i: Int) => qc_varint_acc(i, st))

fn qc_tform_types_acc(tys: List[QcType], acc: Accum[Int]) -> Accum[Int] =
  let a1 = qc_varint_acc(len(tys), acc) in
  fold(tys, a1, fn(st: Accum[Int], t: QcType) => qc_tform_type_acc(t, st))

fn qc_tform_texpr_acc(e: QcTExpr, acc: Accum[Int]) -> Accum[Int] =
  let a0 = qc_tform_type_acc(e.ty, acc) in
  match e.kind {
    QcTKInt(n) => qc_tform_put_int_loop(n, AccPush(a0, 0)),
    QcTKFloat(x) => qc_float_acc(x, AccPush(a0, 1)),
    QcTKBool(b) => AccPush(AccPush(a0, 2), if b then 1 else 0),
    QcTKStr(s) => qc_str_acc(s, AccPush(a0, 3)),
    QcTKUnit => AccPush(a0, 4),
    QcTKLocal(id) => qc_varint_acc(id, AccPush(a0, 5)),
    QcTKFnRef(i) => qc_varint_acc(i, AccPush(a0, 6)),
    QcTKBin(op, l, r, path) =>
      let a1 = AccPush(AccPush(a0, 7), qc_binop_tag(op)) in
      qc_str_acc(path, qc_tform_texpr_acc(r, qc_tform_texpr_acc(l, a1))),
    QcTKUn(op, x, path) =>
      let tag = match op { QcUnNeg => 0, QcUnNot => 1 } in
      qc_str_acc(path, qc_tform_texpr_acc(x, AccPush(AccPush(a0, 8), tag))),
    QcTKIf(c, t, f) =>
      qc_tform_texpr_acc(f, qc_tform_texpr_acc(t, qc_tform_texpr_acc(c, AccPush(a0, 9)))),
    QcTKLet(id, v, b) =>
      qc_tform_texpr_acc(b, qc_tform_texpr_acc(v, qc_varint_acc(id, AccPush(a0, 10)))),
    QcTKCall(i, args) =>
      qc_tform_texprs_acc(args, qc_varint_acc(i, AccPush(a0, 11))),
    QcTKCallG(i, tys, args) =>
      qc_tform_texprs_acc(args, qc_tform_types_acc(tys, qc_varint_acc(i, AccPush(a0, 12)))),
    QcTKFnRefG(i, tys) =>
      qc_tform_types_acc(tys, qc_varint_acc(i, AccPush(a0, 13))),
    QcTKLambda(l) =>
      qc_tform_texpr_acc(l.body, qc_tform_ids_acc(l.captures, qc_tform_ids_acc(l.params, AccPush(a0, 14)))),
    QcTKCallIndirect(f, args) =>
      qc_tform_texprs_acc(args, qc_tform_texpr_acc(f, AccPush(a0, 15))),
    QcTKBuiltin(b, args, path) =>
      qc_str_acc(path, qc_tform_texprs_acc(args, qc_varint_acc(qc_builtin_to_idx(b), AccPush(a0, 16)))),
    QcTKList(xs) =>
      qc_tform_texprs_acc(xs, AccPush(a0, 17)),
    QcTKVariant(tag, xs) =>
      qc_tform_texprs_acc(xs, qc_varint_acc(tag, AccPush(a0, 18))),
    QcTKRecord(fs) =>
      let a1 = qc_varint_acc(len(fs), AccPush(a0, 19)) in
      fold(fs, a1, fn(st: Accum[Int], f: QcTField) => qc_tform_texpr_acc(f.expr, qc_varint_acc(f.idx, st))),
    QcTKField(x, i) =>
      qc_varint_acc(i, qc_tform_texpr_acc(x, AccPush(a0, 20))),
    QcTKMatch(s, arms) =>
      let a1 = qc_varint_acc(len(arms), qc_tform_texpr_acc(s, AccPush(a0, 21))) in
      fold(arms, a1, fn(st: Accum[Int], a: QcTArm) =>
        let ap = qc_tform_tpat_acc(a.pat, st) in
        let ag = match a.guard {
          Some(g) => qc_tform_texpr_acc(g, AccPush(ap, 1)),
          None => AccPush(ap, 0)
        } in
        qc_tform_texpr_acc(a.body, ag)
      ),
    QcTKSeq(xs) =>
      qc_tform_texprs_acc(xs, AccPush(a0, 22))
  }

fn qc_tform_tfn_acc(f: QcTFn, acc: Accum[Int]) -> Accum[Int] =
  let a1 = qc_tform_fndef_acc(f.def, acc) in
  let a2 = qc_tform_types_acc(f.locals, a1) in
  let a3 = qc_tform_texprs_acc(f.reqs, a2) in
  let a4 = qc_tform_texprs_acc(f.enss, a3) in
  let a5 = match f.result_local {
    Some(r) => qc_varint_acc(r, AccPush(a4, 1)),
    None => AccPush(a4, 0)
  } in
  let a6 = qc_tform_texpr_acc(f.body, a5) in
  match f.instance {
    Some(inst) => qc_tform_types_acc(inst.args, qc_varint_acc(inst.gen_idx, AccPush(a6, 1))),
    None => AccPush(a6, 0)
  }

fn qc_tform_encode(p: QcTProgram) -> Bytes =
  let a0 = AccPush(AccPush(AccPush(AccPush(AccPush(AccEnd, 81), 65), 76), 84), 1) in # "QALT", version 1
  let a1 = fold(p.types, qc_varint_acc(len(p.types), a0), fn(st: Accum[Int], t: QcTypeDef) => qc_tform_typedef_acc(t, st)) in
  let a2 = fold(p.fns, qc_varint_acc(len(p.fns), a1), fn(st: Accum[Int], f: QcTFn) => qc_tform_tfn_acc(f, st)) in
  let a3 = fold(p.tests, qc_varint_acc(len(p.tests), a2), fn(st: Accum[Int], t: QcTTest) =>
    qc_tform_texpr_acc(t.body, qc_tform_types_acc(t.locals, qc_str_acc(t.name, st)))
  ) in
  let a4 = fold(p.generics, qc_varint_acc(len(p.generics), a3), fn(st: Accum[Int], f: QcTFn) => qc_tform_tfn_acc(f, st)) in
  bytes_from(acc_list(a4))

# QALT decoder
fn qc_tform_dec_tpats_loop(r: QcReader, count: Int, acc: Accum[QcTPat]) -> QcReadRes[List[QcTPat]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let p_res = qc_tform_dec_tpat(r) in
    qc_tform_dec_tpats_loop(p_res.r, count - 1, AccPush(acc, p_res.val))

fn qc_tform_dec_tpfields_loop(r: QcReader, count: Int, acc: Accum[QcTPField]) -> QcReadRes[List[QcTPField]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let idx_res = qc_reader_varint(r) in
    let pat_res = qc_tform_dec_tpat(idx_res.r) in
    qc_tform_dec_tpfields_loop(pat_res.r, count - 1, AccPush(acc, QcTPField { idx: idx_res.val, pat: pat_res.val }))

fn qc_tform_dec_tpat(r: QcReader) -> QcReadRes[QcTPat] =
  let tag_res = qc_reader_byte(r) in
  let tag = tag_res.val in
  let r1 = tag_res.r in
  if tag == 0 then QcReadRes { val: QcTPWild, r: r1 }
  else if tag == 1 then
    let id_res = qc_reader_varint(r1) in
    QcReadRes { val: QcTPBind(id_res.val), r: id_res.r }
  else if tag == 2 then
    let n_res = qc_reader_int(r1) in
    QcReadRes { val: QcTPInt(n_res.val), r: n_res.r }
  else if tag == 3 then
    let s_res = qc_reader_str(r1) in
    QcReadRes { val: QcTPStr(s_res.val), r: s_res.r }
  else if tag == 4 then
    let b_res = qc_reader_byte(r1) in
    QcReadRes { val: QcTPBool(b_res.val == 1), r: b_res.r }
  else if tag == 5 then
    QcReadRes { val: QcTPUnit, r: r1 }
  else if tag == 6 then
    let vtag_res = qc_reader_varint(r1) in
    let c_res = qc_reader_varint(vtag_res.r) in
    let ps_res = qc_tform_dec_tpats_loop(c_res.r, c_res.val, AccEnd) in
    QcReadRes { val: QcTPVariant(vtag_res.val, ps_res.val), r: ps_res.r }
  else
    let c_res = qc_reader_varint(r1) in
    let fs_res = qc_tform_dec_tpfields_loop(c_res.r, c_res.val, AccEnd) in
    QcReadRes { val: QcTPRecord(fs_res.val), r: fs_res.r }

fn qc_tform_dec_texprs_loop(r: QcReader, count: Int, acc: Accum[QcTExpr]) -> QcReadRes[List[QcTExpr]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let e_res = qc_tform_dec_texpr(r) in
    qc_tform_dec_texprs_loop(e_res.r, count - 1, AccPush(acc, e_res.val))

fn qc_tform_dec_texprs(r: QcReader) -> QcReadRes[List[QcTExpr]] =
  let c_res = qc_reader_varint(r) in
  qc_tform_dec_texprs_loop(c_res.r, c_res.val, AccEnd)

fn qc_tform_dec_tfields_loop(r: QcReader, count: Int, acc: Accum[QcTField]) -> QcReadRes[List[QcTField]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let idx_res = qc_reader_varint(r) in
    let expr_res = qc_tform_dec_texpr(idx_res.r) in
    qc_tform_dec_tfields_loop(expr_res.r, count - 1, AccPush(acc, QcTField { idx: idx_res.val, expr: expr_res.val }))

fn qc_tform_dec_tarms_loop(r: QcReader, count: Int, acc: Accum[QcTArm]) -> QcReadRes[List[QcTArm]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let pat_res = qc_tform_dec_tpat(r) in
    let g_flag = qc_reader_byte(pat_res.r) in
    let g_res = if g_flag.val == 1 then
      let ge = qc_tform_dec_texpr(g_flag.r) in
      QcReadRes { val: Some(ge.val), r: ge.r }
    else
      QcReadRes { val: None, r: g_flag.r } in
    let body_res = qc_tform_dec_texpr(g_res.r) in
    qc_tform_dec_tarms_loop(body_res.r, count - 1, AccPush(acc, QcTArm { pat: pat_res.val, guard: g_res.val, body: body_res.val }))

fn qc_tform_dec_texpr(r: QcReader) -> QcReadRes[QcTExpr] =
  let ty_res = qc_tform_dec_type(r) in
  let ty = ty_res.val in
  let tag_res = qc_reader_byte(ty_res.r) in
  let tag = tag_res.val in
  let r1 = tag_res.r in
  if tag == 0 then
    let n_res = qc_reader_int(r1) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKInt(n_res.val) }, r: n_res.r }
  else if tag == 1 then
    let f_res = qc_reader_float(r1) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKFloat(f_res.val) }, r: f_res.r }
  else if tag == 2 then
    let b_res = qc_reader_byte(r1) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKBool(b_res.val == 1) }, r: b_res.r }
  else if tag == 3 then
    let s_res = qc_reader_str(r1) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKStr(s_res.val) }, r: s_res.r }
  else if tag == 4 then
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKUnit }, r: r1 }
  else if tag == 5 then
    let id_res = qc_reader_varint(r1) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKLocal(id_res.val) }, r: id_res.r }
  else if tag == 6 then
    let i_res = qc_reader_varint(r1) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKFnRef(i_res.val) }, r: i_res.r }
  else if tag == 7 then
    let op_res = qc_reader_byte(r1) in
    let l_res = qc_tform_dec_texpr(op_res.r) in
    let r_res = qc_tform_dec_texpr(l_res.r) in
    let p_res = qc_reader_str(r_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKBin(qc_binop_from_tag(op_res.val), l_res.val, r_res.val, p_res.val) }, r: p_res.r }
  else if tag == 8 then
    let op_res = qc_reader_byte(r1) in
    let x_res = qc_tform_dec_texpr(op_res.r) in
    let p_res = qc_reader_str(x_res.r) in
    let op = if op_res.val == 0 then QcUnNeg else QcUnNot in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKUn(op, x_res.val, p_res.val) }, r: p_res.r }
  else if tag == 9 then
    let c_res = qc_tform_dec_texpr(r1) in
    let t_res = qc_tform_dec_texpr(c_res.r) in
    let f_res = qc_tform_dec_texpr(t_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKIf(c_res.val, t_res.val, f_res.val) }, r: f_res.r }
  else if tag == 10 then
    let id_res = qc_reader_varint(r1) in
    let v_res = qc_tform_dec_texpr(id_res.r) in
    let b_res = qc_tform_dec_texpr(v_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKLet(id_res.val, v_res.val, b_res.val) }, r: b_res.r }
  else if tag == 11 then
    let i_res = qc_reader_varint(r1) in
    let args_res = qc_tform_dec_texprs(i_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKCall(i_res.val, args_res.val) }, r: args_res.r }
  else if tag == 12 then
    let i_res = qc_reader_varint(r1) in
    let tys_res = qc_tform_dec_types(i_res.r) in
    let args_res = qc_tform_dec_texprs(tys_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKCallG(i_res.val, tys_res.val, args_res.val) }, r: args_res.r }
  else if tag == 13 then
    let i_res = qc_reader_varint(r1) in
    let tys_res = qc_tform_dec_types(i_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKFnRefG(i_res.val, tys_res.val) }, r: tys_res.r }
  else if tag == 14 then
    let ps_res = qc_reader_ids(r1) in
    let cs_res = qc_reader_ids(ps_res.r) in
    let body_res = qc_tform_dec_texpr(cs_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKLambda(QcTLambda { params: ps_res.val, captures: cs_res.val, body: body_res.val }) }, r: body_res.r }
  else if tag == 15 then
    let f_res = qc_tform_dec_texpr(r1) in
    let args_res = qc_tform_dec_texprs(f_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKCallIndirect(f_res.val, args_res.val) }, r: args_res.r }
  else if tag == 16 then
    let bi_res = qc_reader_varint(r1) in
    let args_res = qc_tform_dec_texprs(bi_res.r) in
    let p_res = qc_reader_str(args_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKBuiltin(qc_builtin_from_idx(bi_res.val), args_res.val, p_res.val) }, r: p_res.r }
  else if tag == 17 then
    let xs_res = qc_tform_dec_texprs(r1) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKList(xs_res.val) }, r: xs_res.r }
  else if tag == 18 then
    let vtag_res = qc_reader_varint(r1) in
    let xs_res = qc_tform_dec_texprs(vtag_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKVariant(vtag_res.val, xs_res.val) }, r: xs_res.r }
  else if tag == 19 then
    let c_res = qc_reader_varint(r1) in
    let fs_res = qc_tform_dec_tfields_loop(c_res.r, c_res.val, AccEnd) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKRecord(fs_res.val) }, r: fs_res.r }
  else if tag == 20 then
    let x_res = qc_tform_dec_texpr(r1) in
    let i_res = qc_reader_varint(x_res.r) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKField(x_res.val, i_res.val) }, r: i_res.r }
  else if tag == 21 then
    let s_res = qc_tform_dec_texpr(r1) in
    let c_res = qc_reader_varint(s_res.r) in
    let arms_res = qc_tform_dec_tarms_loop(c_res.r, c_res.val, AccEnd) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKMatch(s_res.val, arms_res.val) }, r: arms_res.r }
  else
    let xs_res = qc_tform_dec_texprs(r1) in
    QcReadRes { val: QcTExpr { ty: ty, kind: QcTKSeq(xs_res.val) }, r: xs_res.r }

fn qc_tform_dec_typedefs_loop(r: QcReader, count: Int, acc: Accum[QcTypeDef]) -> QcReadRes[List[QcTypeDef]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let td_res = qc_tform_dec_typedef(r) in
    qc_tform_dec_typedefs_loop(td_res.r, count - 1, AccPush(acc, td_res.val))

fn qc_tform_dec_tfn(r: QcReader) -> QcReadRes[QcTFn] =
  let def_res = qc_tform_dec_fndef(r) in
  let locals_res = qc_tform_dec_types(def_res.r) in
  let req_res = qc_tform_dec_texprs(locals_res.r) in
  let ens_res = qc_tform_dec_texprs(req_res.r) in
  let rl_flag = qc_reader_byte(ens_res.r) in
  let rl_res = if rl_flag.val == 1 then
    let r_id = qc_reader_varint(rl_flag.r) in
    QcReadRes { val: Some(r_id.val), r: r_id.r }
  else
    QcReadRes { val: None, r: rl_flag.r } in
  let body_res = qc_tform_dec_texpr(rl_res.r) in
  let inst_flag = qc_reader_byte(body_res.r) in
  let inst_res = if inst_flag.val == 1 then
    let g_res = qc_reader_varint(inst_flag.r) in
    let args_res = qc_tform_dec_types(g_res.r) in
    QcReadRes { val: Some(QcTFnInstance { gen_idx: g_res.val, args: args_res.val }), r: args_res.r }
  else
    QcReadRes { val: None, r: inst_flag.r } in
  QcReadRes {
    val: QcTFn {
      def: def_res.val,
      locals: locals_res.val,
      reqs: req_res.val,
      enss: ens_res.val,
      result_local: rl_res.val,
      body: body_res.val,
      instance: inst_res.val
    },
    r: inst_res.r
  }

fn qc_tform_dec_tfns_loop(r: QcReader, count: Int, acc: Accum[QcTFn]) -> QcReadRes[List[QcTFn]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let f_res = qc_tform_dec_tfn(r) in
    qc_tform_dec_tfns_loop(f_res.r, count - 1, AccPush(acc, f_res.val))

fn qc_tform_dec_ttests_loop(r: QcReader, count: Int, acc: Accum[QcTTest]) -> QcReadRes[List[QcTTest]] =
  if count <= 0 then QcReadRes { val: acc_list(acc), r: r }
  else
    let n_res = qc_reader_str(r) in
    let locals_res = qc_tform_dec_types(n_res.r) in
    let body_res = qc_tform_dec_texpr(locals_res.r) in
    qc_tform_dec_ttests_loop(body_res.r, count - 1, AccPush(acc, QcTTest { name: n_res.val, locals: locals_res.val, body: body_res.val }))

fn qc_tform_decode(b: Bytes) -> Result[QcTProgram, Str] =
  if bytes_len(b) < 5 then Err("truncated QALT header")
  else if bytes_slice(b, 0, 4) != to_bytes("QALT") then Err("not a QALT typed form")
  else if bytes_at(b, 4) != 1 then Err("unsupported QALT version")
  else
    let r0 = QcReader { bytes: b, pos: 5 } in
    let tc_res = qc_reader_varint(r0) in
    let types_res = qc_tform_dec_typedefs_loop(tc_res.r, tc_res.val, AccEnd) in
    let fc_res = qc_reader_varint(types_res.r) in
    let fns_res = qc_tform_dec_tfns_loop(fc_res.r, fc_res.val, AccEnd) in
    let testc_res = qc_reader_varint(fns_res.r) in
    let tests_res = qc_tform_dec_ttests_loop(testc_res.r, testc_res.val, AccEnd) in
    let gc_res = qc_reader_varint(tests_res.r) in
    let gens_res = qc_tform_dec_tfns_loop(gc_res.r, gc_res.val, AccEnd) in
    Ok(QcTProgram {
      types: types_res.val,
      fns: fns_res.val,
      tests: tests_res.val,
      generics: gens_res.val
    })

# Type instantiation and TProgram lookup helpers (matching qal-core/src/tast.rs)
fn qc_find_param_idx_loop(params: List[Str], target: Str, idx: Int) -> Option[Int] =
  if idx >= len(params) then None
  else if list_at(params, idx) == target then Some(idx)
  else qc_find_param_idx_loop(params, target, idx + 1)

fn qc_type_instantiate_list_loop(tys: List[QcType], params: List[Str], args: List[QcType], idx: Int, acc: Accum[QcType]) -> List[QcType] =
  if idx >= len(tys) then acc_list(acc)
  else
    let sub = qc_type_instantiate(list_at(tys, idx), params, args) in
    qc_type_instantiate_list_loop(tys, params, args, idx + 1, AccPush(acc, sub))

fn qc_type_instantiate(ty: QcType, params: List[Str], args: List[QcType]) -> QcType =
  match ty {
    QcTParam(p) =>
      match qc_find_param_idx_loop(params, p, 0) {
        Some(i) => if i < len(args) then list_at(args, i) else ty,
        None => ty
      },
    QcTList(x) => QcTList(qc_type_instantiate(x, params, args)),
    QcTOption(x) => QcTOption(qc_type_instantiate(x, params, args)),
    QcTResult(a, b) => QcTResult(qc_type_instantiate(a, params, args), qc_type_instantiate(b, params, args)),
    QcTMap(a, b) => QcTMap(qc_type_instantiate(a, params, args), qc_type_instantiate(b, params, args)),
    QcTApp(n, targs) => QcTApp(n, qc_type_instantiate_list_loop(targs, params, args, 0, AccEnd)),
    QcTFn(ps, r, effs) => QcTFn(qc_type_instantiate_list_loop(ps, params, args, 0, AccEnd), qc_type_instantiate(r, params, args), effs),
    _ => ty
  }

fn qc_tp_find_type_def_loop(types: List[QcTypeDef], name: Str, idx: Int) -> Option[QcTypeDef] =
  if idx >= len(types) then None
  else
    let t = list_at(types, idx) in
    if t.name == name then Some(t)
    else qc_tp_find_type_def_loop(types, name, idx + 1)

fn qc_tp_type_def(tp: QcTProgram, name: Str) -> Option[QcTypeDef] =
  qc_tp_find_type_def_loop(tp.types, name, 0)

fn qc_tp_find_fn_idx_loop(fns: List[QcTFn], name: Str, idx: Int) -> Option[Int] =
  if idx >= len(fns) then None
  else
    let f = list_at(fns, idx) in
    if f.def.name == name then Some(idx)
    else qc_tp_find_fn_idx_loop(fns, name, idx + 1)

fn qc_tp_sub_fields_loop(fs: List[QcFieldType], params: List[Str], args: List[QcType], idx: Int, acc: Accum[QcFieldType]) -> List[QcFieldType] =
  if idx >= len(fs) then acc_list(acc)
  else
    let f = list_at(fs, idx) in
    let sub_f = QcFieldType { name: f.name, ty: qc_type_instantiate(f.ty, params, args) } in
    qc_tp_sub_fields_loop(fs, params, args, idx + 1, AccPush(acc, sub_f))

fn qc_tp_sub_variants_loop(vs: List[QcVariant], params: List[Str], args: List[QcType], idx: Int, acc: Accum[QcVariant]) -> List[QcVariant] =
  if idx >= len(vs) then acc_list(acc)
  else
    let v = list_at(vs, idx) in
    let sub_v = QcVariant { name: v.name, fields: qc_type_instantiate_list_loop(v.fields, params, args, 0, AccEnd) } in
    qc_tp_sub_variants_loop(vs, params, args, idx + 1, AccPush(acc, sub_v))

fn qc_tp_decl_for(p: QcTProgram, name: Str, args: List[QcType]) -> Option[QcTypeBody] =
  match qc_tp_find_type_def_loop(p.types, name, 0) {
    None => None,
    Some(d) =>
      if len(d.params) != len(args) then None
      else
        match d.body {
          QcBodyRecord(fs) => Some(QcBodyRecord(qc_tp_sub_fields_loop(fs, d.params, args, 0, AccEnd))),
          QcBodyEnum(vs) => Some(QcBodyEnum(qc_tp_sub_variants_loop(vs, d.params, args, 0, AccEnd)))
        }
  }

fn qc_tp_decl(p: QcTProgram, ty: QcType) -> Option[QcTypeBody] =
  match ty {
    QcTNamed(n) => qc_tp_decl_for(p, n, []),
    QcTApp(n, args) => qc_tp_decl_for(p, n, args),
    _ => None
  }

fn qc_tp_variant_names_loop(vs: List[QcVariant], idx: Int, acc: Accum[Str]) -> List[Str] =
  if idx >= len(vs) then acc_list(acc)
  else
    let v = list_at(vs, idx) in
    qc_tp_variant_names_loop(vs, idx + 1, AccPush(acc, v.name))

fn qc_tp_variant_names(p: QcTProgram, ty: QcType) -> List[Str] =
  match ty {
    QcTOption(_) => ["None", "Some"],
    QcTResult(_, _) => ["Ok", "Err"],
    _ =>
      match qc_tp_decl(p, ty) {
        Some(QcBodyEnum(vs)) => qc_tp_variant_names_loop(vs, 0, AccEnd),
        _ => []
      }
  }

fn qc_tp_variant_fields(p: QcTProgram, ty: QcType, tag: Int) -> List[QcType] =
  match ty {
    QcTOption(t) => if tag == 0 then [] else [t],
    QcTResult(t, e) => if tag == 0 then [t] else [e],
    _ =>
      match qc_tp_decl(p, ty) {
        Some(QcBodyEnum(vs)) =>
          if tag >= 0 && tag < len(vs) then
            let v = list_at(vs, tag) in
            v.fields
          else [],
        _ => []
      }
  }

fn qc_tp_record_fields(p: QcTProgram, ty: QcType) -> List[QcFieldType] =
  match qc_tp_decl(p, ty) {
    Some(QcBodyRecord(fs)) => fs,
    _ => []
  }

fn qc_tp_is_record(p: QcTProgram, ty: QcType) -> Bool =
  match qc_tp_decl(p, ty) {
    Some(QcBodyRecord(_)) => true,
    _ => false
  }
# Built-in prelude types, reserved names, and diagnostic constructors for QAL self-hosting compiler (spec §7: qc_prelude)

fn qc_prelude_types() -> List[QcTypeDef] =
  let headers_ty = QcTList(QcTNamed("HttpHeader")) in
  let str_ty = QcTStr in
  let int_ty = QcTInt in
  let float_ty = QcTFloat in
  let sql_val_ty = QcTNamed("SqlValue") in
  let http_header = QcTypeDef {
    name: "HttpHeader",
    params: [],
    body: QcBodyRecord([
      QcFieldType { name: "name", ty: str_ty },
      QcFieldType { name: "value", ty: str_ty }
    ])
  } in
  let http_req = QcTypeDef {
    name: "HttpRequest",
    params: [],
    body: QcBodyRecord([
      QcFieldType { name: "method", ty: str_ty },
      QcFieldType { name: "path", ty: str_ty },
      QcFieldType { name: "query", ty: str_ty },
      QcFieldType { name: "headers", ty: headers_ty },
      QcFieldType { name: "body", ty: str_ty }
    ])
  } in
  let http_resp = QcTypeDef {
    name: "HttpResponse",
    params: [],
    body: QcBodyRecord([
      QcFieldType { name: "status", ty: int_ty },
      QcFieldType { name: "headers", ty: headers_ty },
      QcFieldType { name: "body", ty: str_ty }
    ])
  } in
  let http_call = QcTypeDef {
    name: "HttpCall",
    params: [],
    body: QcBodyRecord([
      QcFieldType { name: "method", ty: str_ty },
      QcFieldType { name: "url", ty: str_ty },
      QcFieldType { name: "headers", ty: headers_ty },
      QcFieldType { name: "body", ty: str_ty }
    ])
  } in
  let net_error = QcTypeDef {
    name: "NetError",
    params: [],
    body: QcBodyEnum([
      QcVariant { name: "NetDenied", fields: [str_ty] },
      QcVariant { name: "NetInvalid", fields: [str_ty] },
      QcVariant { name: "NetConnect", fields: [str_ty] },
      QcVariant { name: "NetTimeout", fields: [] },
      QcVariant { name: "NetTooLarge", fields: [] }
    ])
  } in
  let sql_val = QcTypeDef {
    name: "SqlValue",
    params: [],
    body: QcBodyEnum([
      QcVariant { name: "SqlNull", fields: [] },
      QcVariant { name: "SqlInt", fields: [int_ty] },
      QcVariant { name: "SqlFloat", fields: [float_ty] },
      QcVariant { name: "SqlText", fields: [str_ty] }
    ])
  } in
  let db_rows = QcTypeDef {
    name: "DbRows",
    params: [],
    body: QcBodyRecord([
      QcFieldType { name: "columns", ty: QcTList(str_ty) },
      QcFieldType { name: "rows", ty: QcTList(QcTList(sql_val_ty)) }
    ])
  } in
  let db_error = QcTypeDef {
    name: "DbError",
    params: [],
    body: QcBodyEnum([
      QcVariant { name: "DbConstraint", fields: [str_ty] },
      QcVariant { name: "DbSql", fields: [str_ty] },
      QcVariant { name: "DbBusy", fields: [] },
      QcVariant { name: "DbFull", fields: [] },
      QcVariant { name: "DbTooLarge", fields: [] }
    ])
  } in
  let model_resp = QcTypeDef {
    name: "ModelResponse",
    params: [],
    body: QcBodyRecord([
      QcFieldType { name: "text", ty: str_ty },
      QcFieldType { name: "model", ty: str_ty },
      QcFieldType { name: "in_tokens", ty: int_ty },
      QcFieldType { name: "out_tokens", ty: int_ty },
      QcFieldType { name: "cost_microcents", ty: int_ty }
    ])
  } in
  let model_error = QcTypeDef {
    name: "ModelError",
    params: [],
    body: QcBodyEnum([
      QcVariant { name: "ModelDenied", fields: [str_ty] },
      QcVariant { name: "ModelBudgetExceeded", fields: [int_ty] },
      QcVariant { name: "ModelFailed", fields: [str_ty] },
      QcVariant { name: "ModelInvalid", fields: [str_ty] },
      QcVariant { name: "ModelTimeout", fields: [] }
    ])
  } in
  let accum_t = QcTypeDef {
    name: "Accum",
    params: ["T"],
    body: QcBodyEnum([
      QcVariant { name: "AccEnd", fields: [] },
      QcVariant { name: "AccPush", fields: [QcTApp("Accum", [QcTNamed("T")]), QcTNamed("T")] }
    ])
  } in
  [http_header, http_req, http_resp, http_call, net_error, sql_val, db_rows, db_error, model_resp, model_error, accum_t]

fn qc_prelude_is_type(name: Str) -> Bool =
  name == "HttpHeader" || name == "HttpRequest" || name == "HttpResponse" ||
  name == "HttpCall" || name == "NetError" || name == "SqlValue" ||
  name == "DbRows" || name == "DbError" || name == "ModelResponse" || name == "ModelError" || name == "Accum"

fn qc_prelude_arity(name: Str) -> Option[Int] =
  if name == "Accum" then Some(1)
  else if qc_prelude_is_type(name) then Some(0)
  else None


fn qc_prelude_is_reserved(name: Str) -> Bool =
  qc_prelude_is_type(name) || (match qc_prelude_variant_owner(name) { Some(_) => true, None => false })

fn qc_is_builtin_type_name(name: Str) -> Bool =
  name == "Int" || name == "Float" || name == "Bool" || name == "Unit" ||
  name == "Str" || name == "List" || name == "Option" || name == "Result" ||
  name == "Map" || name == "Bytes"

fn qc_foreign_name_hint(name: Str) -> Option[Str] =
  let qal_name =
    if name == "String" || name == "string" || name == "str" then Some("`Str`")
    else if name == "i64" || name == "i32" || name == "int" || name == "Integer" || name == "u64" || name == "usize" || name == "long" then Some("`Int` (64-bit)")
    else if name == "f64" || name == "f32" || name == "float" || name == "double" || name == "Double" then Some("`Float`")
    else if name == "bool" || name == "boolean" || name == "Boolean" then Some("`Bool`")
    else if name == "Vec" || name == "Array" || name == "list" || name == "ArrayList" || name == "vector" then Some("`List[T]`")
    else if name == "HashMap" || name == "Dict" || name == "dict" || name == "BTreeMap" || name == "HashTable" then Some("`Map[K, V]`")
    else if name == "Optional" || name == "Maybe" || name == "option" then Some("`Option[T]`")
    else if name == "void" || name == "unit" then Some("`Unit` (value `()`)")
    else if name == "char" || name == "Char" || name == "rune" then Some("a one-character `Str` (`chars(s)` splits a Str into them)")
    else if name == "u8" || name == "byte" || name == "Byte" then Some("`Int` (an element of `Bytes`, 0..=255)")
    else None in
  match qal_name {
    Some(qn) => Some("QAL has no type `" ++ name ++ "`; use " ++ qn),
    None => None
  }

# Diagnostic constructors
fn qc_diag_new(code: Str, kind: Str, def: Str, path: Str, msg: Str) -> QcDiag =
  QcDiag {
    code: code,
    kind: kind,
    def: def,
    path: path,
    message: msg,
    expected: None,
    found: None,
    hints: [],
    dependents: [],
    counterexample: None
  }

fn qc_diag_expected_found(d: QcDiag, exp: Str, fnd: Str) -> QcDiag =
  QcDiag {
    code: d.code,
    kind: d.kind,
    def: d.def,
    path: d.path,
    message: d.message,
    expected: Some(exp),
    found: Some(fnd),
    hints: d.hints,
    dependents: d.dependents,
    counterexample: d.counterexample
  }

fn qc_diag_hint(d: QcDiag, h: Str) -> QcDiag =
  QcDiag {
    code: d.code,
    kind: d.kind,
    def: d.def,
    path: d.path,
    message: d.message,
    expected: d.expected,
    found: d.found,
    hints: push(d.hints, h),
    dependents: d.dependents,
    counterexample: d.counterexample
  }

fn qc_diag_type_mismatch(def: Str, path: Str, exp: Str, fnd: Str) -> QcDiag =
  qc_diag_expected_found(qc_diag_new("E0203", "type_mismatch", def, path, "expected " ++ exp ++ ", found " ++ fnd), exp, fnd)

fn qc_diag_arity(def: Str, path: Str, callee: Str, exp: Int, fnd: Int) -> QcDiag =
  let exp_s = from_int(exp) in
  let fnd_s = from_int(fnd) in
  qc_diag_expected_found(qc_diag_new("E0204", "type_mismatch", def, path, "`" ++ callee ++ "` takes " ++ exp_s ++ " argument(s), " ++ fnd_s ++ " given"), exp_s, fnd_s)

fn qc_diag_unknown_name(def: Str, path: Str, name: Str) -> QcDiag =
  qc_diag_new("E0201", "unknown_name", def, path, "unknown name `" ++ name ++ "`")

fn qc_diag_duplicate_name(def: Str, path: Str, name: Str) -> QcDiag =
  qc_diag_new("E0202", "duplicate_name", def, path, "`" ++ name ++ "` is defined more than once")

fn qc_diag_builtin_name(name: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0202", "duplicate_name", name, "", "`" ++ name ++ "` is the name of a built-in function"),
    "choose another name; a `" ++ name ++ "` stored before this built-in existed must be renamed first: qal_rename it, e.g. to `my_" ++ name ++ "`"
  )

fn qc_diag_effect_violation(def: Str, path: Str, callee: Str, missing: List[Str]) -> QcDiag =
  let miss_str = join(missing, ", ") in
  let hint_effs = join(missing, " !") in
  qc_diag_hint(
    qc_diag_new("E0301", "effect_violation", def, path, "call to `" ++ callee ++ "` needs effect(s) " ++ miss_str ++ " not declared here"),
    "add `!" ++ hint_effs ++ "` to the signature of `" ++ def ++ "`"
  )

fn qc_diag_non_exhaustive(def: Str, path: Str, missing: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0205", "non_exhaustive_match", def, path, "match does not cover `" ++ missing ++ "`"),
    "add an arm `" ++ missing ++ " => ...` or a final `_ => ...` arm"
  )

fn qc_diag_type_too_deep(def: Str, path: Str, max_depth: Int) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0207", "type_too_deep", def, path, "inferred type is nested too deeply (max " ++ from_int(max_depth) ++ " levels)"),
    "declare a record or enum type for the nested data instead of nesting List/Option/Result this deeply"
  )

fn qc_diag_type_too_large(def: Str, path: Str, max_size: Int) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0208", "type_too_large", def, path, "inferred type is too large (max " ++ from_int(max_size) ++ " nodes)"),
    "annotate the values with `let x: T = ...` or declare a record or enum type; shared `Ok`/`Err`/`None` values can make inferred types grow exponentially"
  )

fn qc_diag_unused_type_param(def: Str, path: Str, param: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0211", "unused_type_parameter", def, path, "type parameter `" ++ param ++ "` does not occur in the parameter or result types"),
    "remove `" ++ param ++ "` or use it in a parameter type"
  )

# E0310: more than one effect parameter.
fn qc_diag_effect_params(def: Str, path: Str, names: List[Str]) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0310", "effect_params", def, path, "`" ++ def ++ "` declares " ++ from_int(len(names)) ++ " effect parameters (" ++ join(names, ", ") ++ "); a function has at most one"),
    "use one effect parameter for every callback: `fn both[!e](a: fn() -> Unit !e, b: fn() -> Unit !e) -> Unit !e`; a call binds it to the union of the arguments' effects"
  )

# E0311: an effect parameter that occurs in no parameter type.
fn qc_diag_effect_param_unused(def: Str, path: Str, param: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0311", "effect_param_unused", def, path, "effect parameter `" ++ param ++ "` occurs in no parameter type"),
    "give a parameter a function type with it, e.g. `f: fn(T) -> Unit !" ++ param ++ "`; a call determines `" ++ param ++ "` from that argument"
  )

fn qc_diag_irregular_recursion(def: Str, path: Str, used: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0212", "irregular_recursion", def, path, "recursive use `" ++ used ++ "` must pass plain type parameters"),
    "inside its own definition, a recursive generic type can only be applied to type parameters, e.g. `Tree[T]`"
  )

fn qc_diag_polymorphic_recursion(def: Str, path: Str, callee: Str, targs: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0213", "polymorphic_recursion", def, path, "recursive call of `" ++ callee ++ "` at type [" ++ targs ++ "]"),
    "recursive calls of a generic function must use its own type parameters (e.g. `f[T]` calls `f[T]`)"
  )

fn qc_diag_instantiation_limit(def: Str, path: Str, instance: Str, max_inst: Int) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0214", "instantiation_limit", def, path, "instantiating `" ++ instance ++ "` exceeds the limit of " ++ from_int(max_inst) ++ " generic instances, the type size or depth limit or the size limit of all instances"),
    "deeply nested generic calls multiply instances; use fewer distinct type arguments"
  )

fn qc_diag_reserved_name(def: Str, path: Str, name: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0240", "reserved_name", def, path, "`" ++ name ++ "` is a built-in prelude name"),
    "prelude types (HttpHeader, HttpRequest, HttpResponse, HttpCall, NetError, SqlValue, DbRows, DbError, ModelResponse, ModelError, Accum) and their variants exist in every program; choose another name"
  )

fn qc_diag_prelude_shadowed(def: Str, path: Str, callee: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0240", "reserved_name", def, path, "`" ++ callee ++ "` needs the prelude types, but this codebase defines prelude names itself"),
    "rename the stored types (qal_rename) or redefine the enums whose names or variants are prelude names (HttpHeader, HttpRequest, HttpResponse, HttpCall, NetError, SqlValue, DbRows, DbError, ModelResponse, ModelError, Accum and their variants)"
  )

fn qc_diag_sql_not_literal(def: Str, path: Str, callee: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0241", "sql_not_literal", def, path, "the SQL text of `" ++ callee ++ "` must be a string literal"),
    "values belong in `params` as `?` placeholders, e.g. db_query(\"SELECT * FROM t WHERE id = ?\", [SqlInt(id)]); for variants (e.g. ORDER BY) write one literal per variant and choose with `match`"
  )

fn qc_diag_sql_invalid(def: Str, path: Str, reason: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0242", "sql_invalid", def, path, "invalid SQL literal: " ++ reason),
    "one statement, positional `?` parameters only; ATTACH, DETACH, PRAGMA, VACUUM and transaction statements are not allowed (one transaction per execution is automatic)"
  )

fn qc_diag_missing_field(def: Str, path: Str, record_name: Str, field_name: Str) -> QcDiag =
  qc_diag_hint(
    qc_diag_new("E0206", "type_mismatch", def, path, "`" ++ record_name ++ "` needs field `" ++ field_name ++ "`"),
    "add `" ++ field_name ++ ": ...` to the `" ++ record_name ++ " { ... }` literal"
  )

test qc_prelude_test =
  let ts = qc_prelude_types() in
  len(ts) == 11 &&
  qc_prelude_is_type("Accum") &&
  qc_prelude_is_type("ModelResponse") &&
  qc_prelude_is_reserved("SqlInt") &&
  qc_prelude_is_reserved("ModelDenied") &&
  qc_prelude_variant_owner("AccPush") == Some("Accum") &&
  qc_prelude_variant_owner("ModelDenied") == Some("ModelError") &&
  qc_foreign_name_hint("String") == Some("QAL has no type `String`; use `Str`")
# Typing signatures and properties of built-in function calls (spec §7: qc_builtin, matching qal-check/src/builtins.rs)

type QcBuiltinSig = {
  builtin: QcBuiltin,
  params: List[QcType],
  ret: QcType
}

fn qc_builtin_fn_type(ps: List[QcType], r: QcType) -> QcType =
  QcTFn(ps, r, [])

fn qc_builtin_signature(name: Str, a: QcType, b: QcType) -> Option[QcBuiltinSig] =
  let t_int = QcTInt in
  let t_float = QcTFloat in
  let t_bool = QcTBool in
  let t_unit = QcTUnit in
  let t_str = QcTStr in
  let t_bytes = QcTBytes in
  let t_list_str = QcTList(t_str) in
  let t_list_int = QcTList(t_int) in
  let t_opt_int = QcTOption(t_int) in
  let t_opt_float = QcTOption(t_float) in
  let t_opt_str = QcTOption(t_str) in
  let t_res_str_str = QcTResult(t_str, t_str) in
  let t_res_unit_str = QcTResult(t_unit, t_str) in
  let t_list_a = QcTList(a) in
  let t_list_b = QcTList(b) in
  let t_opt_a = QcTOption(a) in
  let t_opt_b = QcTOption(b) in
  let t_map_a_b = QcTMap(a, b) in
  let http_call_ty = QcTNamed("HttpCall") in
  let http_resp_ty = QcTNamed("HttpResponse") in
  let net_err_ty = QcTNamed("NetError") in
  let sql_val_ty = QcTNamed("SqlValue") in
  let db_rows_ty = QcTNamed("DbRows") in
  let db_err_ty = QcTNamed("DbError") in
  let model_resp_ty = QcTNamed("ModelResponse") in
  let model_err_ty = QcTNamed("ModelError") in
  let accum_a_ty = QcTApp("Accum", [a]) in

  if name == "slice" then Some(QcBuiltinSig { builtin: QcBSlice, params: [t_str, t_int, t_int], ret: t_str })
  else if name == "split" then Some(QcBuiltinSig { builtin: QcBSplit, params: [t_str, t_str], ret: t_list_str })
  else if name == "join" then Some(QcBuiltinSig { builtin: QcBJoin, params: [t_list_str, t_str], ret: t_str })
  else if name == "trim" then Some(QcBuiltinSig { builtin: QcBTrim, params: [t_str], ret: t_str })
  else if name == "contains" then Some(QcBuiltinSig { builtin: QcBContains, params: [t_str, t_str], ret: t_bool })
  else if name == "starts_with" then Some(QcBuiltinSig { builtin: QcBStartsWith, params: [t_str, t_str], ret: t_bool })
  else if name == "to_int" then Some(QcBuiltinSig { builtin: QcBToInt, params: [t_str], ret: t_opt_int })
  else if name == "to_float" then Some(QcBuiltinSig { builtin: QcBToFloat, params: [t_str], ret: t_opt_float })
  else if name == "from_int" then Some(QcBuiltinSig { builtin: QcBFromInt, params: [t_int], ret: t_str })
  else if name == "from_float" then Some(QcBuiltinSig { builtin: QcBFromFloat, params: [t_float], ret: t_str })
  else if name == "chars" then Some(QcBuiltinSig { builtin: QcBChars, params: [t_str], ret: t_list_str })
  else if name == "get" then Some(QcBuiltinSig { builtin: QcBGet, params: [t_list_a, t_int], ret: t_opt_a })
  else if name == "push" then Some(QcBuiltinSig { builtin: QcBPush, params: [t_list_a, a], ret: t_list_a })
  else if name == "concat" then Some(QcBuiltinSig { builtin: QcBConcat, params: [t_list_a, t_list_a], ret: t_list_a })
  else if name == "map" then Some(QcBuiltinSig { builtin: QcBMap, params: [t_list_a, qc_builtin_fn_type([a], b)], ret: t_list_b })
  else if name == "filter" then Some(QcBuiltinSig { builtin: QcBFilter, params: [t_list_a, qc_builtin_fn_type([a], t_bool)], ret: t_list_a })
  else if name == "fold" then Some(QcBuiltinSig { builtin: QcBFold, params: [t_list_a, b, qc_builtin_fn_type([b, a], b)], ret: b })
  else if name == "range" then Some(QcBuiltinSig { builtin: QcBRange, params: [t_int, t_int], ret: t_list_int })
  else if name == "reverse" then Some(QcBuiltinSig { builtin: QcBReverse, params: [t_list_a], ret: t_list_a })
  else if name == "sort_int" then Some(QcBuiltinSig { builtin: QcBSortInt, params: [t_list_int], ret: t_list_int })
  else if name == "int_to_float" then Some(QcBuiltinSig { builtin: QcBIntToFloat, params: [t_int], ret: t_float })
  else if name == "float_to_int" then Some(QcBuiltinSig { builtin: QcBFloatToInt, params: [t_float], ret: t_opt_int })
  else if name == "print" then Some(QcBuiltinSig { builtin: QcBPrint, params: [t_str], ret: t_unit })
  else if name == "read_line" then Some(QcBuiltinSig { builtin: QcBReadLine, params: [], ret: t_opt_str })
  else if name == "read_file" then Some(QcBuiltinSig { builtin: QcBReadFile, params: [t_str], ret: t_res_str_str })
  else if name == "write_file" then Some(QcBuiltinSig { builtin: QcBWriteFile, params: [t_str, t_str], ret: t_res_unit_str })
  else if name == "now_ms" then Some(QcBuiltinSig { builtin: QcBNowMs, params: [], ret: t_int })
  else if name == "rand_int" then Some(QcBuiltinSig { builtin: QcBRandInt, params: [t_int, t_int], ret: t_int })
  else if name == "read_all" then Some(QcBuiltinSig { builtin: QcBReadAll, params: [], ret: t_str })
  else if name == "sort_str" then Some(QcBuiltinSig { builtin: QcBSortStr, params: [t_list_str], ret: t_list_str })
  else if name == "char_code" then Some(QcBuiltinSig { builtin: QcBCharCode, params: [t_str], ret: t_int })
  else if name == "from_char_code" then Some(QcBuiltinSig { builtin: QcBFromCharCode, params: [t_int], ret: t_str })
  else if name == "to_upper" then Some(QcBuiltinSig { builtin: QcBToUpper, params: [t_str], ret: t_str })
  else if name == "to_lower" then Some(QcBuiltinSig { builtin: QcBToLower, params: [t_str], ret: t_str })
  else if name == "replace" then Some(QcBuiltinSig { builtin: QcBReplace, params: [t_str, t_str, t_str], ret: t_str })
  else if name == "index_of" then Some(QcBuiltinSig { builtin: QcBIndexOf, params: [t_str, t_str], ret: t_opt_int })
  else if name == "map_new" then Some(QcBuiltinSig { builtin: QcBMapNew, params: [], ret: t_map_a_b })
  else if name == "map_get" then Some(QcBuiltinSig { builtin: QcBMapGet, params: [t_map_a_b, a], ret: t_opt_b })
  else if name == "map_put" then Some(QcBuiltinSig { builtin: QcBMapPut, params: [t_map_a_b, a, b], ret: t_map_a_b })
  else if name == "map_del" then Some(QcBuiltinSig { builtin: QcBMapDel, params: [t_map_a_b, a], ret: t_map_a_b })
  else if name == "map_has" then Some(QcBuiltinSig { builtin: QcBMapHas, params: [t_map_a_b, a], ret: t_bool })
  else if name == "map_size" then Some(QcBuiltinSig { builtin: QcBMapSize, params: [t_map_a_b], ret: t_int })
  else if name == "map_keys" then Some(QcBuiltinSig { builtin: QcBMapKeys, params: [t_map_a_b], ret: t_list_a })
  else if name == "map_values" then Some(QcBuiltinSig { builtin: QcBMapValues, params: [t_map_a_b], ret: t_list_b })
  else if name == "to_bytes" then Some(QcBuiltinSig { builtin: QcBToBytes, params: [t_str], ret: t_bytes })
  else if name == "bytes_len" then Some(QcBuiltinSig { builtin: QcBBytesLen, params: [t_bytes], ret: t_int })
  else if name == "bytes_get" then Some(QcBuiltinSig { builtin: QcBBytesGet, params: [t_bytes, t_int], ret: t_opt_int })
  else if name == "bytes_slice" then Some(QcBuiltinSig { builtin: QcBBytesSlice, params: [t_bytes, t_int, t_int], ret: t_bytes })
  else if name == "bytes_from" then Some(QcBuiltinSig { builtin: QcBBytesFrom, params: [t_list_int], ret: t_bytes })
  else if name == "bytes_to_list" then Some(QcBuiltinSig { builtin: QcBBytesToList, params: [t_bytes], ret: t_list_int })
  else if name == "bytes_to_str" then Some(QcBuiltinSig { builtin: QcBBytesToStr, params: [t_bytes], ret: t_opt_str })
  else if name == "compare" then Some(QcBuiltinSig { builtin: QcBCompare, params: [a, a], ret: t_int })
  else if name == "http" then Some(QcBuiltinSig { builtin: QcBHttp, params: [http_call_ty], ret: QcTResult(http_resp_ty, net_err_ty) })
  else if name == "db_exec" then Some(QcBuiltinSig { builtin: QcBDbExec, params: [t_str, QcTList(sql_val_ty)], ret: QcTResult(t_int, db_err_ty) })
  else if name == "db_query" then Some(QcBuiltinSig { builtin: QcBDbQuery, params: [t_str, QcTList(sql_val_ty)], ret: QcTResult(db_rows_ty, db_err_ty) })
  else if name == "bit_and" then Some(QcBuiltinSig { builtin: QcBBitAnd, params: [t_int, t_int], ret: t_int })
  else if name == "bit_or" then Some(QcBuiltinSig { builtin: QcBBitOr, params: [t_int, t_int], ret: t_int })
  else if name == "bit_xor" then Some(QcBuiltinSig { builtin: QcBBitXor, params: [t_int, t_int], ret: t_int })
  else if name == "bit_not" then Some(QcBuiltinSig { builtin: QcBBitNot, params: [t_int], ret: t_int })
  else if name == "shl" then Some(QcBuiltinSig { builtin: QcBShl, params: [t_int, t_int], ret: t_int })
  else if name == "shr" then Some(QcBuiltinSig { builtin: QcBShr, params: [t_int, t_int], ret: t_int })
  else if name == "ushr" then Some(QcBuiltinSig { builtin: QcBUshr, params: [t_int, t_int], ret: t_int })
  else if name == "float_bits" then Some(QcBuiltinSig { builtin: QcBFloatBits, params: [t_float], ret: t_int })
  else if name == "float_of_bits" then Some(QcBuiltinSig { builtin: QcBFloatOfBits, params: [t_int], ret: t_float })
  else if name == "list_at" then Some(QcBuiltinSig { builtin: QcBListAt, params: [t_list_a, t_int], ret: a })
  else if name == "bytes_at" then Some(QcBuiltinSig { builtin: QcBBytesAt, params: [t_bytes, t_int], ret: t_int })
  else if name == "acc_list" then Some(QcBuiltinSig { builtin: QcBAccList, params: [accum_a_ty], ret: t_list_a })
  else if name == "bytes_join" then Some(QcBuiltinSig { builtin: QcBBytesJoin, params: [QcTList(t_bytes)], ret: t_bytes })
  else if name == "sha256" then Some(QcBuiltinSig { builtin: QcBSha256, params: [t_bytes], ret: t_bytes })
  else if name == "todo" then Some(QcBuiltinSig { builtin: QcBTodo, params: [], ret: a })
  else if name == "model_ask" then Some(QcBuiltinSig { builtin: QcBModelAsk, params: [t_str, t_str], ret: QcTResult(model_resp_ty, model_err_ty) })
  else if name == "tensor_matmul" then Some(QcBuiltinSig { builtin: QcBTensorMatmul, params: [t_str, t_str, t_int], ret: t_str })
  else None

fn qc_builtin_arity(name: Str) -> Option[Int] =
  if name == "len" then Some(1)
  else
    match qc_builtin_signature(name, QcTUnit, QcTUnit) {
      Some(s) => Some(len(s.params)),
      None => None
    }

fn qc_builtin_is_name(name: Str) -> Bool =
  if name == "len" then true
  else match qc_builtin_signature(name, QcTUnit, QcTUnit) {
    Some(_) => true,
    None => false
  }

fn qc_builtin_effect(b: QcBuiltin) -> Option[Str] =
  match b {
    QcBPrint => Some("io"),
    QcBReadLine => Some("io"),
    QcBReadAll => Some("io"),
    QcBReadFile => Some("fs"),
    QcBWriteFile => Some("fs"),
    QcBNowMs => Some("time"),
    QcBRandInt => Some("rand"),
    QcBHttp => Some("net"),
    QcBDbExec => Some("db"),
    QcBDbQuery => Some("db"),
    QcBModelAsk => Some("model"),
    QcBTensorMatmul => Some("tensor"),
    _ => None
  }

fn qc_builtin_needs_prelude(b: QcBuiltin) -> Bool =
  match b {
    QcBHttp => true,
    QcBDbExec => true,
    QcBDbQuery => true,
    QcBAccList => true,
    QcBModelAsk => true,
    _ => false
  }

test qc_builtin_test =
  qc_builtin_is_name("len") &&
  qc_builtin_is_name("map") &&
  qc_builtin_is_name("sha256") &&
  qc_builtin_is_name("model_ask") &&
  qc_builtin_arity("slice") == Some(3) &&
  qc_builtin_arity("model_ask") == Some(2) &&
  qc_builtin_effect(QcBPrint) == Some("io") &&
  qc_builtin_effect(QcBModelAsk) == Some("model") &&
  qc_builtin_effect(QcBTensorMatmul) == Some("tensor") &&
  qc_builtin_effect(QcBSha256) == None
# Type variables and unification for local type inference (spec §7: qc_unify, matching qal-check/src/unify.rs)

# An effect variable (spec 2026-10-22 §4): the effects it must at least carry (names, or `?M` for
# other variables), and whether it may still grow. It grows while it stands on the expected side
# of a check; it is frozen as soon as a check depends on its value staying as it is.
type QcEvar = {
  lower: List[Str],
  frozen: Bool
}

type QcSubst = {
  vars: List[Option[QcType]],
  depth: List[Int],
  size: List[Int],
  users: List[List[Int]],
  evars: List[QcEvar],
  too_deep: Bool,
  too_large: Bool
}

type QcFreshEffRes = {
  subst: QcSubst,
  name: Str
}

# The effects an effect list carries (following variables, a sorted set) and the variables in it
# that may still grow (sorted).
type QcEffRes = {
  names: List[Str],
  open: List[Int]
}

type QcSubstRes = {
  subst: QcSubst,
  ok: Bool
}

type QcFreshRes = {
  subst: QcSubst,
  ty: QcType
}

type QcJoinRes = {
  subst: QcSubst,
  res: Option[QcType],
  changed: Bool
}

fn qc_subst_new() -> QcSubst =
  QcSubst {
    vars: [],
    depth: [],
    size: [],
    users: [],
    evars: [],
    too_deep: false,
    too_large: false
  }

fn qc_list_set_loop[T](xs: List[T], idx: Int, val: T, cur: Int, acc: Accum[T]) -> List[T] =
  if cur >= len(xs) then acc_list(acc)
  else if cur == idx then qc_list_set_loop(xs, idx, val, cur + 1, AccPush(acc, val))
  else qc_list_set_loop(xs, idx, val, cur + 1, AccPush(acc, list_at(xs, cur)))

fn qc_list_set[T](xs: List[T], idx: Int, val: T) -> List[T] =
  qc_list_set_loop(xs, idx, val, 0, AccEnd)

fn qc_subst_fresh(s: QcSubst) -> QcFreshRes =
  let id = len(s.vars) in
  let next_s = QcSubst {
    vars: push(s.vars, None),
    depth: push(s.depth, 1),
    size: push(s.size, 1),
    users: push(s.users, []),
    evars: s.evars,
    too_deep: s.too_deep,
    too_large: s.too_large
  } in
  QcFreshRes { subst: next_s, ty: QcTVar(id) }

fn qc_subst_resolve_loop(s: QcSubst, t: QcType) -> QcType =
  match t {
    QcTVar(v) =>
      if v < len(s.vars) then
        match list_at(s.vars, v) {
          Some(bound) => qc_subst_resolve_loop(s, bound),
          None => t
        }
      else t,
    _ => t
  }

fn qc_subst_resolve(s: QcSubst, t: QcType) -> QcType =
  qc_subst_resolve_loop(s, t)

fn qc_subst_finish(s: QcSubst, t: QcType) -> QcType =
  match qc_subst_resolve(s, t) {
    QcTVar(_) => QcTUnit,
    QcTList(x) => QcTList(qc_subst_finish(s, x)),
    QcTOption(x) => QcTOption(qc_subst_finish(s, x)),
    QcTResult(a, b) => QcTResult(qc_subst_finish(s, a), qc_subst_finish(s, b)),
    QcTMap(a, b) => QcTMap(qc_subst_finish(s, a), qc_subst_finish(s, b)),
    QcTApp(n, args) => QcTApp(n, map(args, fn(arg: QcType) => qc_subst_finish(s, arg))),
    QcTFn(ps, r, effs) => QcTFn(map(ps, fn(p: QcType) => qc_subst_finish(s, p)), qc_subst_finish(s, r), (qc_subst_resolve_effects(s, effs)).names),
    other => other
  }

fn qc_max_int(a: Int, b: Int) -> Int = if a > b then a else b

fn qc_max_list_int_loop(xs: List[Int], idx: Int, cur_max: Int) -> Int =
  if idx >= len(xs) then cur_max
  else qc_max_list_int_loop(xs, idx + 1, qc_max_int(cur_max, list_at(xs, idx)))

fn qc_subst_depth_of(s: QcSubst, t: QcType) -> Int =
  match t {
    QcTVar(v) => if v < len(s.depth) then list_at(s.depth, v) else 1,
    QcTList(x) => 1 + qc_subst_depth_of(s, x),
    QcTOption(x) => 1 + qc_subst_depth_of(s, x),
    QcTResult(a, b) => 1 + qc_max_int(qc_subst_depth_of(s, a), qc_subst_depth_of(s, b)),
    QcTMap(a, b) => 1 + qc_max_int(qc_subst_depth_of(s, a), qc_subst_depth_of(s, b)),
    QcTApp(_, args) =>
      let ds = map(args, fn(a: QcType) => qc_subst_depth_of(s, a)) in
      1 + qc_max_list_int_loop(ds, 0, 0),
    QcTFn(ps, r, _) =>
      let ds = map(ps, fn(p: QcType) => qc_subst_depth_of(s, p)) in
      1 + qc_max_int(qc_max_list_int_loop(ds, 0, 0), qc_subst_depth_of(s, r)),
    _ => 1
  }

fn qc_sat_add(a: Int, b: Int) -> Int =
  let sum = a + b in
  if sum > 4097 then 4097 else sum

fn qc_subst_size_of(s: QcSubst, t: QcType) -> Int =
  let n = match t {
    QcTVar(v) => if v < len(s.size) then list_at(s.size, v) else 1,
    QcTList(x) => 1 + qc_subst_size_of(s, x),
    QcTOption(x) => 1 + qc_subst_size_of(s, x),
    QcTResult(a, b) => qc_sat_add(1 + qc_subst_size_of(s, a), qc_subst_size_of(s, b)),
    QcTMap(a, b) => qc_sat_add(1 + qc_subst_size_of(s, a), qc_subst_size_of(s, b)),
    QcTApp(_, args) =>
      fold(args, 1, fn(acc_n: Int, arg: QcType) => qc_sat_add(acc_n, qc_subst_size_of(s, arg))),
    QcTFn(ps, r, _) =>
      fold(ps, 1 + qc_subst_size_of(s, r), fn(acc_n: Int, p: QcType) => qc_sat_add(acc_n, qc_subst_size_of(s, p))),
    _ => 1
  } in
  if n > 4097 then 4097 else n

fn qc_subst_within_limits(s: QcSubst, depth: Int, size: Int) -> QcSubstRes =
  if depth > 256 then
    QcSubstRes {
      subst: QcSubst { vars: s.vars, depth: s.depth, size: s.size, users: s.users, evars: s.evars, too_deep: true, too_large: s.too_large },
      ok: false
    }
  else if size > 4096 then
    QcSubstRes {
      subst: QcSubst { vars: s.vars, depth: s.depth, size: s.size, users: s.users, evars: s.evars, too_deep: s.too_deep, too_large: true },
      ok: false
    }
  else
    QcSubstRes { subst: s, ok: true }

fn qc_subst_vars_in_walk(t: QcType, acc: Accum[Int]) -> Accum[Int] =
  match t {
    QcTVar(v) => AccPush(acc, v),
    QcTList(x) => qc_subst_vars_in_walk(x, acc),
    QcTOption(x) => qc_subst_vars_in_walk(x, acc),
    QcTResult(a, b) => qc_subst_vars_in_walk(b, qc_subst_vars_in_walk(a, acc)),
    QcTMap(a, b) => qc_subst_vars_in_walk(b, qc_subst_vars_in_walk(a, acc)),
    QcTApp(_, args) => fold(args, acc, fn(st: Accum[Int], a: QcType) => qc_subst_vars_in_walk(a, st)),
    QcTFn(ps, r, _) =>
      let st1 = fold(ps, acc, fn(st: Accum[Int], p: QcType) => qc_subst_vars_in_walk(p, st)) in
      qc_subst_vars_in_walk(r, st1),
    _ => acc
  }

fn qc_subst_vars_in(t: QcType) -> List[Int] =
  acc_list(qc_subst_vars_in_walk(t, AccEnd))

fn qc_subst_has_vars(t: QcType) -> Bool =
  match t {
    QcTVar(_) => true,
    QcTList(x) => qc_subst_has_vars(x),
    QcTOption(x) => qc_subst_has_vars(x),
    QcTResult(a, b) => qc_subst_has_vars(a) || qc_subst_has_vars(b),
    QcTMap(a, b) => qc_subst_has_vars(a) || qc_subst_has_vars(b),
    QcTApp(_, args) => fold(args, false, fn(acc: Bool, a: QcType) => acc || qc_subst_has_vars(a)),
    QcTFn(ps, r, _) => fold(ps, qc_subst_has_vars(r), fn(acc: Bool, p: QcType) => acc || qc_subst_has_vars(p)),
    _ => false
  }

type QcOccursRes = {
  seen: Map[Int, Bool],
  found: Bool
}

fn qc_subst_occurs(s: QcSubst, v: Int, t: QcType, seen: Map[Int, Bool]) -> QcOccursRes =
  match t {
    QcTVar(w) =>
      if w == v then QcOccursRes { seen: seen, found: true }
      else if map_has(seen, w) then QcOccursRes { seen: seen, found: false }
      else
        let next_seen = map_put(seen, w, true) in
        if w < len(s.vars) then
          match list_at(s.vars, w) {
            Some(bound) => qc_subst_occurs(s, v, bound, next_seen),
            None => QcOccursRes { seen: next_seen, found: false }
          }
        else QcOccursRes { seen: next_seen, found: false },
    QcTList(x) => qc_subst_occurs(s, v, x, seen),
    QcTOption(x) => qc_subst_occurs(s, v, x, seen),
    QcTResult(a, b) =>
      let res_a = qc_subst_occurs(s, v, a, seen) in
      if res_a.found then res_a
      else qc_subst_occurs(s, v, b, res_a.seen),
    QcTMap(a, b) =>
      let res_a = qc_subst_occurs(s, v, a, seen) in
      if res_a.found then res_a
      else qc_subst_occurs(s, v, b, res_a.seen),
    QcTApp(_, args) => qc_subst_occurs_list_loop(s, v, args, 0, seen),
    QcTFn(ps, r, _) =>
      let res_ps = qc_subst_occurs_list_loop(s, v, ps, 0, seen) in
      if res_ps.found then res_ps
      else qc_subst_occurs(s, v, r, res_ps.seen),
    _ => QcOccursRes { seen: seen, found: false }
  }

fn qc_subst_occurs_list_loop(s: QcSubst, v: Int, ts: List[QcType], idx: Int, seen: Map[Int, Bool]) -> QcOccursRes =
  if idx >= len(ts) then QcOccursRes { seen: seen, found: false }
  else
    let res = qc_subst_occurs(s, v, list_at(ts, idx), seen) in
    if res.found then res
    else qc_subst_occurs_list_loop(s, v, ts, idx + 1, res.seen)

fn qc_subst_add_user(s: QcSubst, target_var: Int, user_var: Int) -> QcSubst =
  if target_var < len(s.users) then
    let cur_users = list_at(s.users, target_var) in
    let next_users = qc_list_set(s.users, target_var, push(cur_users, user_var)) in
    QcSubst { vars: s.vars, depth: s.depth, size: s.size, users: next_users, evars: s.evars, too_deep: s.too_deep, too_large: s.too_large }
  else s

fn qc_subst_propagate_loop(s: QcSubst, changed: List[Int]) -> QcSubstRes =
  if len(changed) == 0 then QcSubstRes { subst: s, ok: true }
  else
    let v = list_at(changed, len(changed) - 1) in
    let rest_changed = bytes_slice(to_bytes(""), 0, 0) in # dummy
    let next_changed = fold(changed, AccEnd, fn(acc: Accum[Int], x: Int) => AccPush(acc, x)) in
    let pop_changed = match qc_list_pop(changed) { Some(xs) => xs, None => [] } in
    let users_v = if v < len(s.users) then list_at(s.users, v) else [] in
    qc_subst_propagate_users_loop(s, users_v, 0, pop_changed)

fn qc_list_pop[T](xs: List[T]) -> Option[List[T]] =
  let n = len(xs) in
  if n == 0 then None
  else Some(qc_list_take_loop(xs, n - 1, 0, AccEnd))

fn qc_list_take_loop[T](xs: List[T], count: Int, cur: Int, acc: Accum[T]) -> List[T] =
  if cur >= count then acc_list(acc)
  else qc_list_take_loop(xs, count, cur + 1, AccPush(acc, list_at(xs, cur)))

fn qc_subst_propagate_users_loop(s: QcSubst, users: List[Int], k: Int, changed: List[Int]) -> QcSubstRes =
  if k >= len(users) then qc_subst_propagate_loop(s, changed)
  else
    let u = list_at(users, k) in
    if u < len(s.vars) then
      match list_at(s.vars, u) {
        None => qc_subst_propagate_users_loop(s, users, k + 1, changed),
        Some(bound) =>
          let nd = qc_subst_depth_of(s, bound) in
          let nn = qc_subst_size_of(s, bound) in
          let cur_d = list_at(s.depth, u) in
          let cur_n = list_at(s.size, u) in
          if nd > cur_d || nn > cur_n then
            let lim_res = qc_subst_within_limits(s, nd, nn) in
            if !lim_res.ok then lim_res
            else
              let s1 = lim_res.subst in
              let next_depth = qc_list_set(s1.depth, u, nd) in
              let next_size = qc_list_set(s1.size, u, nn) in
              let s2 = QcSubst { vars: s1.vars, depth: next_depth, size: next_size, users: s1.users, evars: s1.evars, too_deep: s1.too_deep, too_large: s1.too_large } in
              qc_subst_propagate_users_loop(s2, users, k + 1, push(changed, u))
          else
            qc_subst_propagate_users_loop(s, users, k + 1, changed)
      }
    else qc_subst_propagate_users_loop(s, users, k + 1, changed)

fn qc_subst_bind(s: QcSubst, x: Int, t: QcType) -> QcSubstRes =
  let d = qc_subst_depth_of(s, t) in
  let n = qc_subst_size_of(s, t) in
  let lim_res = qc_subst_within_limits(s, d, n) in
  if !lim_res.ok then lim_res
  else
    let s0 = lim_res.subst in
    let direct = qc_subst_vars_in(t) in
    let s1 = fold(direct, s0, fn(acc_s: QcSubst, w: Int) => qc_subst_add_user(acc_s, w, x)) in
    let next_vars = qc_list_set(s1.vars, x, Some(t)) in
    let next_depth = qc_list_set(s1.depth, x, d) in
    let next_size = qc_list_set(s1.size, x, n) in
    let s2 = QcSubst { vars: next_vars, depth: next_depth, size: next_size, users: s1.users, evars: s1.evars, too_deep: s1.too_deep, too_large: s1.too_large } in
    qc_subst_propagate_loop(s2, [x])

fn qc_subst_wrap(s: QcSubst, t: QcType) -> QcFreshRes =
  let fresh_res = qc_subst_fresh(s) in
  let v = fresh_res.ty in
  let un_res = qc_subst_unify(fresh_res.subst, v, t) in
  QcFreshRes { subst: un_res.subst, ty: v }

fn qc_subst_unify(s: QcSubst, expected: QcType, found: QcType) -> QcSubstRes =
  qc_subst_unify_in(s, expected, found, false)

fn qc_subst_unify_exact(s: QcSubst, a: QcType, b: QcType) -> QcSubstRes =
  qc_subst_unify_in(s, a, b, true)

# Effect variables (unify.rs: fresh_effect, resolve_effects, freeze_effects, unify_effects).
fn qc_subst_fresh_effect(s: QcSubst) -> QcFreshEffRes =
  let id = len(s.evars) in
  let next_s = QcSubst { vars: s.vars, depth: s.depth, size: s.size, users: s.users, evars: push(s.evars, QcEvar { lower: [], frozen: false }), too_deep: s.too_deep, too_large: s.too_large } in
  QcFreshEffRes { subst: next_s, name: "?" ++ from_int(id) }

fn qc_evar_of(e: Str) -> Option[Int] =
  if starts_with(e, "?") then
    match to_int(slice(e, 1, len(e))) {
      Some(n) => if n >= 0 then Some(n) else None,
      None => None
    }
  else None

fn qc_subst_set_evar(s: QcSubst, v: Int, ev: QcEvar) -> QcSubst =
  QcSubst { vars: s.vars, depth: s.depth, size: s.size, users: s.users, evars: qc_list_set(s.evars, v, ev), too_deep: s.too_deep, too_large: s.too_large }

fn qc_subst_freeze_evar(s: QcSubst, v: Int) -> QcSubst =
  if v < len(s.evars) then qc_subst_set_evar(s, v, QcEvar { lower: (list_at(s.evars, v)).lower, frozen: true })
  else s

fn qc_subst_resolve_effects(s: QcSubst, effs: List[Str]) -> QcEffRes =
  qc_resolve_effects_loop(s, effs, [], AccEnd, AccEnd)

fn qc_resolve_effects_loop(s: QcSubst, stack: List[Str], seen: List[Int], names: Accum[Str], open: Accum[Int]) -> QcEffRes =
  if len(stack) == 0 then QcEffRes { names: qc_sort_dedup_strs(acc_list(names)), open: qc_sort_dedup_ints(acc_list(open)) }
  else
    let e = list_at(stack, len(stack) - 1) in
    let rest = match qc_list_pop(stack) { Some(xs) => xs, None => [] } in
    match qc_evar_of(e) {
      Some(v) =>
        if qc_int_list_contains(seen, v) || v >= len(s.evars) then qc_resolve_effects_loop(s, rest, push(seen, v), names, open)
        else
          let ev = list_at(s.evars, v) in
          let next_open = if ev.frozen then open else AccPush(open, v) in
          qc_resolve_effects_loop(s, rest ++ ev.lower, push(seen, v), names, next_open),
      None => qc_resolve_effects_loop(s, rest, seen, AccPush(names, e), open)
    }

fn qc_subst_freeze_effects(s: QcSubst, effs: List[Str]) -> QcSubst =
  fold((qc_subst_resolve_effects(s, effs)).open, s, fn(st: QcSubst, v: Int) => qc_subst_freeze_evar(st, v))

# `found ⊆ expected` as effect sets (`exact`: equal). A growable variable on the expected side
# takes what `found` has beyond `expected`; without one, the check is on the effects as they are,
# and the variables of `found` are frozen.
fn qc_subst_unify_effects(s: QcSubst, expected: List[Str], found: List[Str], exact: Bool) -> QcSubstRes =
  let r1 = qc_effects_sub(s, expected, found) in
  if !r1.ok || !exact then r1
  else qc_effects_sub(r1.subst, found, expected)

fn qc_effects_sub(s: QcSubst, expected: List[Str], found: List[Str]) -> QcSubstRes =
  let r1 = qc_subst_resolve_effects(s, expected) in
  let r2 = qc_subst_resolve_effects(s, found) in
  if len(r1.open) > 0 then
    let v = list_at(r1.open, 0) in
    let extra_names = filter(r2.names, fn(e: Str) => !qc_contains_str_loop(r1.names, e, 0)) in
    let extra_vars = map(filter(r2.open, fn(w: Int) => !qc_int_list_contains(r1.open, w)), fn(w: Int) => "?" ++ from_int(w)) in
    let ev = list_at(s.evars, v) in
    let next_lower = fold(extra_names ++ extra_vars, ev.lower, fn(acc: List[Str], e: Str) => if qc_contains_str_loop(acc, e, 0) then acc else push(acc, e)) in
    QcSubstRes { subst: qc_subst_set_evar(s, v, QcEvar { lower: next_lower, frozen: ev.frozen }), ok: true }
  else if !qc_all_contained_loop(r2.names, r1.names, 0) then QcSubstRes { subst: s, ok: false }
  else QcSubstRes { subst: fold(r2.open, s, fn(st: QcSubst, w: Int) => qc_subst_freeze_evar(st, w)), ok: true }

fn qc_contains_str_loop(xs: List[Str], s: Str, idx: Int) -> Bool =
  if idx >= len(xs) then false
  else if list_at(xs, idx) == s then true
  else qc_contains_str_loop(xs, s, idx + 1)

fn qc_all_contained_loop(sub: List[Str], super_set: List[Str], idx: Int) -> Bool =
  if idx >= len(sub) then true
  else if !qc_contains_str_loop(super_set, list_at(sub, idx), 0) then false
  else qc_all_contained_loop(sub, super_set, idx + 1)

fn qc_subst_unify_in(s: QcSubst, expected: QcType, found: QcType, exact: Bool) -> QcSubstRes =
  match expected {
    QcTVar(x) => match found {
      QcTVar(y) =>
        if x == y then QcSubstRes { subst: s, ok: true }
        else qc_subst_unify_resolved(s, expected, found, exact),
      _ => qc_subst_unify_resolved(s, expected, found, exact)
    },
    _ => qc_subst_unify_resolved(s, expected, found, exact)
  }

fn qc_subst_unify_resolved(s: QcSubst, expected: QcType, found: QcType, exact: Bool) -> QcSubstRes =
  let a = qc_subst_resolve(s, expected) in
  let b = qc_subst_resolve(s, found) in
  if a == b && !qc_subst_has_vars(a) then QcSubstRes { subst: s, ok: true }
  else
    match a {
      QcTVar(x) => match b {
        QcTVar(y) =>
          if x == y then QcSubstRes { subst: s, ok: true }
          else
            let occ_res = qc_subst_occurs(s, x, b, map_new()) in
            if occ_res.found then QcSubstRes { subst: s, ok: false }
            else qc_subst_bind(s, x, b),
        _ =>
          let occ_res = qc_subst_occurs(s, x, b, map_new()) in
          if occ_res.found then QcSubstRes { subst: s, ok: false }
          else qc_subst_bind(s, x, b)
      },
      _ => match b {
        QcTVar(x) =>
          let occ_res = qc_subst_occurs(s, x, a, map_new()) in
          if occ_res.found then QcSubstRes { subst: s, ok: false }
          else qc_subst_bind(s, x, a),
        _ => match a {
          QcTList(x) => match b {
            QcTList(y) => qc_subst_unify_in(s, x, y, exact),
            _ => QcSubstRes { subst: s, ok: false }
          },
          QcTOption(x) => match b {
            QcTOption(y) => qc_subst_unify_in(s, x, y, exact),
            _ => QcSubstRes { subst: s, ok: false }
          },
          QcTResult(a1, b1) => match b {
            QcTResult(a2, b2) =>
              let res1 = qc_subst_unify_in(s, a1, a2, exact) in
              if !res1.ok then res1
              else qc_subst_unify_in(res1.subst, b1, b2, exact),
            _ => QcSubstRes { subst: s, ok: false }
          },
          QcTMap(a1, b1) => match b {
            QcTMap(a2, b2) =>
              let res1 = qc_subst_unify_in(s, a1, a2, exact) in
              if !res1.ok then res1
              else qc_subst_unify_in(res1.subst, b1, b2, exact),
            _ => QcSubstRes { subst: s, ok: false }
          },
          QcTApp(n1, x1) => match b {
            QcTApp(n2, x2) =>
              if n1 != n2 || len(x1) != len(x2) then QcSubstRes { subst: s, ok: false }
              else qc_subst_unify_exact_list_loop(s, x1, x2, 0),
            _ => QcSubstRes { subst: s, ok: false }
          },
          QcTFn(p1, r1, e1) => match b {
            QcTFn(p2, r2, e2) =>
              if len(p1) != len(p2) then QcSubstRes { subst: s, ok: false }
              else
                let res_ps = qc_subst_unify_params_loop(s, p1, p2, 0, exact) in
                if !res_ps.ok then res_ps
                else
                  let res_r = qc_subst_unify_in(res_ps.subst, r1, r2, exact) in
                  if !res_r.ok then res_r
                  else
                    qc_subst_unify_effects(res_r.subst, e1, e2, exact),
            _ => QcSubstRes { subst: s, ok: false }
          },
          _ => QcSubstRes { subst: s, ok: a == b }
        }
      }
    }

fn qc_subst_unify_exact_list_loop(s: QcSubst, xs1: List[QcType], xs2: List[QcType], idx: Int) -> QcSubstRes =
  if idx >= len(xs1) then QcSubstRes { subst: s, ok: true }
  else
    let res = qc_subst_unify_in(s, list_at(xs1, idx), list_at(xs2, idx), true) in
    if !res.ok then res
    else qc_subst_unify_exact_list_loop(res.subst, xs1, xs2, idx + 1)

fn qc_subst_unify_params_loop(s: QcSubst, p1: List[QcType], p2: List[QcType], idx: Int, exact: Bool) -> QcSubstRes =
  if idx >= len(p1) then QcSubstRes { subst: s, ok: true }
  else
    # p2 is found, p1 is expected -> unify_in(p2, p1)
    let res = qc_subst_unify_in(s, list_at(p2, idx), list_at(p1, idx), exact) in
    if !res.ok then res
    else qc_subst_unify_params_loop(res.subst, p1, p2, idx + 1, exact)

fn qc_subst_has_join_fn(s: QcSubst, t: QcType) -> Bool =
  qc_subst_join_fn_in(s, t, map_new()).found

fn qc_subst_join_fn_in(s: QcSubst, t: QcType, seen: Map[Int, Bool]) -> QcOccursRes =
  match t {
    QcTVar(v) =>
      if map_has(seen, v) then QcOccursRes { seen: seen, found: false }
      else
        let next_seen = map_put(seen, v, true) in
        if v < len(s.vars) then
          match list_at(s.vars, v) {
            Some(bound) => qc_subst_join_fn_in(s, bound, next_seen),
            None => QcOccursRes { seen: next_seen, found: false }
          }
        else QcOccursRes { seen: next_seen, found: false },
    QcTFn(_, _, _) => QcOccursRes { seen: seen, found: true },
    QcTList(x) => qc_subst_join_fn_in(s, x, seen),
    QcTOption(x) => qc_subst_join_fn_in(s, x, seen),
    QcTResult(a, b) =>
      let res_a = qc_subst_join_fn_in(s, a, seen) in
      if res_a.found then res_a
      else qc_subst_join_fn_in(s, b, res_a.seen),
    QcTMap(a, b) =>
      let res_a = qc_subst_join_fn_in(s, a, seen) in
      if res_a.found then res_a
      else qc_subst_join_fn_in(s, b, res_a.seen),
    _ => QcOccursRes { seen: seen, found: false }
  }

fn qc_subst_join(s: QcSubst, a: QcType, b: QcType, covariant: Bool) -> QcJoinRes =
  qc_subst_join_in(s, a, b, covariant)

fn qc_subst_join_in(s: QcSubst, a: QcType, b: QcType, covariant: Bool) -> QcJoinRes =
  match a {
    QcTVar(x) => match b {
      QcTVar(y) =>
        if x == y then QcJoinRes { subst: s, res: Some(a), changed: false }
        else qc_subst_join_resolved(s, a, b, covariant),
      _ => qc_subst_join_resolved(s, a, b, covariant)
    },
    _ => qc_subst_join_resolved(s, a, b, covariant)
  }

fn qc_subst_join_default(s: QcSubst, ra: QcType, rb: QcType, a: QcType) -> QcJoinRes =
  let un_res = qc_subst_unify_exact(s, ra, rb) in
  if un_res.ok then QcJoinRes { subst: un_res.subst, res: Some(a), changed: false }
  else QcJoinRes { subst: un_res.subst, res: None, changed: false }

fn qc_subst_join_resolved(s: QcSubst, a: QcType, b: QcType, covariant: Bool) -> QcJoinRes =
  let ra = qc_subst_resolve(s, a) in
  let rb = qc_subst_resolve(s, b) in
  match ra {
    QcTList(x) => match rb {
      QcTList(y) =>
        let j_res = qc_subst_join_in(s, x, y, covariant) in
        match j_res.res {
          None => QcJoinRes { subst: j_res.subst, res: None, changed: false },
          Some(j) =>
            if j_res.changed then
              let wrap_res = qc_subst_wrap(j_res.subst, QcTList(j)) in
              QcJoinRes { subst: wrap_res.subst, res: Some(wrap_res.ty), changed: true }
            else
              QcJoinRes { subst: j_res.subst, res: Some(a), changed: false }
        },
      _ => qc_subst_join_default(s, ra, rb, a)
    },
    QcTOption(x) => match rb {
      QcTOption(y) =>
        let j_res = qc_subst_join_in(s, x, y, covariant) in
        match j_res.res {
          None => QcJoinRes { subst: j_res.subst, res: None, changed: false },
          Some(j) =>
            if j_res.changed then
              let wrap_res = qc_subst_wrap(j_res.subst, QcTOption(j)) in
              QcJoinRes { subst: wrap_res.subst, res: Some(wrap_res.ty), changed: true }
            else
              QcJoinRes { subst: j_res.subst, res: Some(a), changed: false }
        },
      _ => qc_subst_join_default(s, ra, rb, a)
    },
    QcTResult(a1, b1) => match rb {
      QcTResult(a2, b2) =>
        let ja_res = qc_subst_join_in(s, a1, a2, covariant) in
        match ja_res.res {
          None => QcJoinRes { subst: ja_res.subst, res: None, changed: false },
          Some(ja) =>
            let jb_res = qc_subst_join_in(ja_res.subst, b1, b2, covariant) in
            match jb_res.res {
              None => QcJoinRes { subst: jb_res.subst, res: None, changed: false },
              Some(jb) =>
                let changed = ja_res.changed || jb_res.changed in
                if changed then
                  let wrap_res = qc_subst_wrap(jb_res.subst, QcTResult(ja, jb)) in
                  QcJoinRes { subst: wrap_res.subst, res: Some(wrap_res.ty), changed: true }
                else
                  QcJoinRes { subst: jb_res.subst, res: Some(a), changed: false }
            }
        },
      _ => qc_subst_join_default(s, ra, rb, a)
    },
    QcTMap(a1, b1) => match rb {
      QcTMap(a2, b2) =>
        let ja_res = qc_subst_join_in(s, a1, a2, covariant) in
        match ja_res.res {
          None => QcJoinRes { subst: ja_res.subst, res: None, changed: false },
          Some(ja) =>
            let jb_res = qc_subst_join_in(ja_res.subst, b1, b2, covariant) in
            match jb_res.res {
              None => QcJoinRes { subst: jb_res.subst, res: None, changed: false },
              Some(jb) =>
                let changed = ja_res.changed || jb_res.changed in
                if changed then
                  let wrap_res = qc_subst_wrap(jb_res.subst, QcTMap(ja, jb)) in
                  QcJoinRes { subst: wrap_res.subst, res: Some(wrap_res.ty), changed: true }
                else
                  QcJoinRes { subst: jb_res.subst, res: Some(a), changed: false }
            }
        },
      _ => qc_subst_join_default(s, ra, rb, a)
    },
    QcTFn(p1, r1, e1) => match rb {
      QcTFn(p2, r2, e2) =>
        if len(p1) != len(p2) then QcJoinRes { subst: s, res: None, changed: false }
        else
          let ps_res = qc_subst_join_params_loop(s, p1, p2, 0, !covariant, AccEnd, false) in
          if !ps_res.ok then QcJoinRes { subst: ps_res.subst, res: None, changed: false }
          else
            let r_res = qc_subst_join_in(ps_res.subst, r1, r2, covariant) in
            match r_res.res {
              None => QcJoinRes { subst: r_res.subst, res: None, changed: false },
              Some(r) =>
                # Open effect variables stay in a union (the join may still grow) and leave an
                # intersection.
                let r1e = qc_subst_resolve_effects(r_res.subst, e1) in
                let r2e = qc_subst_resolve_effects(r_res.subst, e2) in
                let effs =
                  if covariant then qc_sort_dedup_strs(r1e.names ++ r2e.names) ++ map(qc_sort_dedup_ints(r1e.open ++ r2e.open), fn(v: Int) => "?" ++ from_int(v))
                  else qc_eff_intersect(r1e.names, r2e.names) in
                let eff_changed = len(effs) != len(e1) || !qc_all_contained_loop(effs, e1, 0) in
                let changed = ps_res.changed || r_res.changed || eff_changed in
                if changed then
                  let wrap_res = qc_subst_wrap(r_res.subst, QcTFn(ps_res.ps, r, effs)) in
                  QcJoinRes { subst: wrap_res.subst, res: Some(wrap_res.ty), changed: true }
                else
                  QcJoinRes { subst: r_res.subst, res: Some(a), changed: false }
            },
      _ => qc_subst_join_default(s, ra, rb, a)
    },
    _ => qc_subst_join_default(s, ra, rb, a)
  }

fn qc_eff_intersect_loop(e1: List[Str], e2: List[Str], idx: Int, acc: Accum[Str]) -> List[Str] =
  if idx >= len(e1) then qc_sort_dedup_strs(acc_list(acc))
  else
    let ef = list_at(e1, idx) in
    if qc_contains_str_loop(e2, ef, 0) then qc_eff_intersect_loop(e1, e2, idx + 1, AccPush(acc, ef))
    else qc_eff_intersect_loop(e1, e2, idx + 1, acc)

fn qc_eff_intersect(e1: List[Str], e2: List[Str]) -> List[Str] =
  qc_eff_intersect_loop(e1, e2, 0, AccEnd)

type QcJoinParamsRes = {
  subst: QcSubst,
  ps: List[QcType],
  changed: Bool,
  ok: Bool
}

fn qc_subst_join_params_loop(s: QcSubst, p1: List[QcType], p2: List[QcType], idx: Int, param_cov: Bool, acc: Accum[QcType], cur_changed: Bool) -> QcJoinParamsRes =
  if idx >= len(p1) then
    QcJoinParamsRes { subst: s, ps: acc_list(acc), changed: cur_changed, ok: true }
  else
    let j_res = qc_subst_join_in(s, list_at(p1, idx), list_at(p2, idx), param_cov) in
    match j_res.res {
      None => QcJoinParamsRes { subst: j_res.subst, ps: [], changed: false, ok: false },
      Some(j) =>
        qc_subst_join_params_loop(j_res.subst, p1, p2, idx + 1, param_cov, AccPush(acc, j), cur_changed || j_res.changed)
    }

test qc_unify_test =
  let s0 = qc_subst_new() in
  let f_res = qc_subst_fresh(s0) in
  let a = f_res.ty in
  let un_res = qc_subst_unify(f_res.subst, QcTList(a), QcTList(QcTInt)) in
  un_res.ok && qc_subst_finish(un_res.subst, QcTOption(a)) == QcTOption(QcTInt)
# Match exhaustiveness (usefulness algorithm after Maranget) for QAL self-hosting compiler (spec §7: qc_exhaust, matching qal-check/src/exhaust.rs)

type QcKey =
  | QcKeyTag(Int)
  | QcKeyBool(Bool)
  | QcKeyUnit
  | QcKeyRecord
  | QcKeyLit(Str)

type QcP =
  | QcExWild
  | QcExC(QcKey, List[QcP])

type QcCtor = {
  key: QcKey,
  name: Str,
  args: List[QcType],
  fields: List[Str]
}

type QcW =
  | QcWWild
  | QcWC(Str, List[QcW], List[Str], Bool)

fn qc_exhaust_show_fields_loop(fields: List[Str], args: List[QcW], idx: Int, acc: Accum[Str]) -> List[Str] =
  if idx >= len(fields) || idx >= len(args) then acc_list(acc)
  else
    let f = list_at(fields, idx) in
    let a = list_at(args, idx) in
    let part = f ++ ": " ++ qc_exhaust_show(a) in
    qc_exhaust_show_fields_loop(fields, args, idx + 1, AccPush(acc, part))

fn qc_exhaust_show(w: QcW) -> Str =
  match w {
    QcWWild => "_",
    QcWC(name, args, _, false) =>
      if len(args) == 0 then name
      else name ++ "(" ++ join(map(args, qc_exhaust_show), ", ") ++ ")",
    QcWC(name, args, fields, true) =>
      let parts = qc_exhaust_show_fields_loop(fields, args, 0, AccEnd) in
      name ++ " { " ++ join(parts, ", ") ++ " }"
  }

fn qc_exhaust_variants(tp: QcTProgram, ty: QcType) -> List[QcCtor] =
  let names = qc_tp_variant_names(tp, ty) in
  qc_exhaust_variants_loop(tp, ty, names, 0, AccEnd)

fn qc_exhaust_variants_loop(tp: QcTProgram, ty: QcType, names: List[Str], tag: Int, acc: Accum[QcCtor]) -> List[QcCtor] =
  if tag >= len(names) then acc_list(acc)
  else
    let name = list_at(names, tag) in
    let flds = qc_tp_variant_fields(tp, ty, tag) in
    let ctor = QcCtor { key: QcKeyTag(tag), name: name, args: flds, fields: [] } in
    qc_exhaust_variants_loop(tp, ty, names, tag + 1, AccPush(acc, ctor))

fn qc_exhaust_ctors(tp: QcTProgram, ty: QcType) -> Option[List[QcCtor]] =
  match ty {
    QcTBool => Some([
      QcCtor { key: QcKeyBool(false), name: "false", args: [], fields: [] },
      QcCtor { key: QcKeyBool(true), name: "true", args: [], fields: [] }
    ]),
    QcTUnit => Some([QcCtor { key: QcKeyUnit, name: "()", args: [], fields: [] }]),
    QcTOption(_) => Some(qc_exhaust_variants(tp, ty)),
    QcTResult(_, _) => Some(qc_exhaust_variants(tp, ty)),
    QcTNamed(n) =>
      match qc_tp_decl(tp, ty) {
        Some(QcBodyEnum(_)) => Some(qc_exhaust_variants(tp, ty)),
        Some(QcBodyRecord(fs)) =>
          Some([QcCtor {
            key: QcKeyRecord,
            name: n,
            args: map(fs, fn(f: QcFieldType) => f.ty),
            fields: map(fs, fn(f: QcFieldType) => f.name)
          }]),
        None => None
      },
    QcTApp(n, _) =>
      match qc_tp_decl(tp, ty) {
        Some(QcBodyEnum(_)) => Some(qc_exhaust_variants(tp, ty)),
        Some(QcBodyRecord(fs)) =>
          Some([QcCtor {
            key: QcKeyRecord,
            name: n,
            args: map(fs, fn(f: QcFieldType) => f.ty),
            fields: map(fs, fn(f: QcFieldType) => f.name)
          }]),
        None => None
      },
    _ => None
  }

fn qc_exhaust_find_field_pat_loop(fs: List[QcTPField], target_idx: Int, cur: Int) -> Option[QcTPat] =
  if cur >= len(fs) then None
  else
    let f = list_at(fs, cur) in
    if f.idx == target_idx then Some(f.pat)
    else qc_exhaust_find_field_pat_loop(fs, target_idx, cur + 1)

fn qc_exhaust_reduce_record_fields_loop(tp: QcTProgram, all_fields: List[QcFieldType], fs: List[QcTPField], i: Int, acc: Accum[QcP]) -> List[QcP] =
  if i >= len(all_fields) then acc_list(acc)
  else
    let fld = list_at(all_fields, i) in
    let p_reduced = match qc_exhaust_find_field_pat_loop(fs, i, 0) {
      Some(p) => qc_exhaust_reduce(tp, p, fld.ty),
      None => QcExWild
    } in
    qc_exhaust_reduce_record_fields_loop(tp, all_fields, fs, i + 1, AccPush(acc, p_reduced))

fn qc_exhaust_reduce_variant_sub_loop(tp: QcTProgram, ps: List[QcTPat], tys: List[QcType], idx: Int, acc: Accum[QcP]) -> List[QcP] =
  if idx >= len(ps) || idx >= len(tys) then acc_list(acc)
  else
    let sub_p = qc_exhaust_reduce(tp, list_at(ps, idx), list_at(tys, idx)) in
    qc_exhaust_reduce_variant_sub_loop(tp, ps, tys, idx + 1, AccPush(acc, sub_p))

fn qc_exhaust_reduce(tp: QcTProgram, p: QcTPat, ty: QcType) -> QcP =
  match p {
    QcTPWild => QcExWild,
    QcTPBind(_) => QcExWild,
    QcTPInt(n) => QcExC(QcKeyLit(from_int(n)), []),
    QcTPStr(s) => QcExC(QcKeyLit("\"" ++ s ++ "\""), []),
    QcTPBool(b) => QcExC(QcKeyBool(b), []),
    QcTPUnit => QcExC(QcKeyUnit, []),
    QcTPVariant(tag, ps) =>
      let tys = qc_tp_variant_fields(tp, ty, tag) in
      let sub = qc_exhaust_reduce_variant_sub_loop(tp, ps, tys, 0, AccEnd) in
      QcExC(QcKeyTag(tag), sub),
    QcTPRecord(fs) =>
      let all = qc_tp_record_fields(tp, ty) in
      let args = qc_exhaust_reduce_record_fields_loop(tp, all, fs, 0, AccEnd) in
      QcExC(QcKeyRecord, args)
  }

fn qc_exhaust_head(row: List[QcP]) -> Option[QcKey] =
  if len(row) == 0 then None
  else
    match list_at(row, 0) {
      QcExC(k, _) => Some(k),
      QcExWild => None
    }

fn qc_key_eq(k1: QcKey, k2: QcKey) -> Bool =
  match k1 {
    QcKeyTag(t1) => match k2 { QcKeyTag(t2) => t1 == t2, _ => false },
    QcKeyBool(b1) => match k2 { QcKeyBool(b2) => b1 == b2, _ => false },
    QcKeyUnit => match k2 { QcKeyUnit => true, _ => false },
    QcKeyRecord => match k2 { QcKeyRecord => true, _ => false },
    QcKeyLit(s1) => match k2 { QcKeyLit(s2) => s1 == s2, _ => false }
  }

fn qc_repeat_wild_loop(count: Int, acc: Accum[QcP]) -> List[QcP] =
  if count <= 0 then acc_list(acc)
  else qc_repeat_wild_loop(count - 1, AccPush(acc, QcExWild))

fn qc_exhaust_specialize_row(row: List[QcP], key: QcKey, arity: Int) -> Option[List[QcP]] =
  if len(row) == 0 then None
  else
    let head_p = list_at(row, 0) in
    let tail_p = match qc_list_slice(row, 1, len(row)) { Some(xs) => xs, None => [] } in
    match head_p {
      QcExC(k, args) =>
        if qc_key_eq(k, key) then Some(args ++ tail_p)
        else None,
      QcExWild =>
        let wilds = qc_repeat_wild_loop(arity, AccEnd) in
        Some(wilds ++ tail_p)
    }

fn qc_list_slice[T](xs: List[T], start_idx: Int, end_idx: Int) -> Option[List[T]] =
  if start_idx < 0 || end_idx < start_idx || end_idx > len(xs) then None
  else Some(qc_list_slice_loop(xs, start_idx, end_idx, start_idx, AccEnd))

fn qc_list_slice_loop[T](xs: List[T], start_idx: Int, end_idx: Int, cur: Int, acc: Accum[T]) -> List[T] =
  if cur >= end_idx then acc_list(acc)
  else qc_list_slice_loop(xs, start_idx, end_idx, cur + 1, AccPush(acc, list_at(xs, cur)))

fn qc_exhaust_specialize_loop(rows: List[List[QcP]], key: QcKey, arity: Int, idx: Int, acc: Accum[List[QcP]]) -> List[List[QcP]] =
  if idx >= len(rows) then acc_list(acc)
  else
    match qc_exhaust_specialize_row(list_at(rows, idx), key, arity) {
      Some(spec_row) => qc_exhaust_specialize_loop(rows, key, arity, idx + 1, AccPush(acc, spec_row)),
      None => qc_exhaust_specialize_loop(rows, key, arity, idx + 1, acc)
    }

fn qc_exhaust_specialize(rows: List[List[QcP]], key: QcKey, arity: Int) -> List[List[QcP]] =
  qc_exhaust_specialize_loop(rows, key, arity, 0, AccEnd)

fn qc_exhaust_heads_loop(rows: List[List[QcP]], idx: Int, acc: Accum[QcKey]) -> List[QcKey] =
  if idx >= len(rows) then acc_list(acc)
  else
    match qc_exhaust_head(list_at(rows, idx)) {
      Some(k) => qc_exhaust_heads_loop(rows, idx + 1, AccPush(acc, k)),
      None => qc_exhaust_heads_loop(rows, idx + 1, acc)
    }

fn qc_exhaust_heads_contain_loop(heads: List[QcKey], key: QcKey, idx: Int) -> Bool =
  if idx >= len(heads) then false
  else if qc_key_eq(list_at(heads, idx), key) then true
  else qc_exhaust_heads_contain_loop(heads, key, idx + 1)

fn qc_exhaust_all_ctors_covered_loop(all: List[QcCtor], heads: List[QcKey], idx: Int) -> Bool =
  if idx >= len(all) then true
  else
    let c = list_at(all, idx) in
    if !qc_exhaust_heads_contain_loop(heads, c.key, 0) then false
    else qc_exhaust_all_ctors_covered_loop(all, heads, idx + 1)

fn qc_exhaust_missing(tp: QcTProgram, rows: List[List[QcP]], tys: List[QcType]) -> Option[List[QcW]] =
  if len(tys) == 0 then
    if len(rows) == 0 then Some([])
    else None
  else
    let heads = qc_exhaust_heads_loop(rows, 0, AccEnd) in
    let ty0 = list_at(tys, 0) in
    let opt_all = qc_exhaust_ctors(tp, ty0) in
    let tail_tys = match qc_list_slice(tys, 1, len(tys)) { Some(xs) => xs, None => [] } in
    match opt_all {
      Some(all) if len(all) == 0 => None,
      Some(all) if qc_exhaust_all_ctors_covered_loop(all, heads, 0) =>
        qc_exhaust_missing_sub_loop(tp, rows, all, tail_tys, 0),
      _ =>
        let default_rows = qc_exhaust_default_rows_loop(rows, 0, AccEnd) in
        match qc_exhaust_missing(tp, default_rows, tail_tys) {
          None => None,
          Some(rest) =>
            let first = match opt_all {
              Some(all) =>
                match qc_exhaust_find_uncovered_ctor_loop(all, heads, 0) {
                  Some(c) =>
                    let wilds = qc_repeat_wild_w_loop(len(c.args), AccEnd) in
                    QcWC(c.name, wilds, c.fields, qc_key_eq(c.key, QcKeyRecord)),
                  None => QcWWild
                },
              None => QcWWild
            } in
            Some([first] ++ rest)
        }
    }

fn qc_repeat_wild_w_loop(count: Int, acc: Accum[QcW]) -> List[QcW] =
  if count <= 0 then acc_list(acc)
  else qc_repeat_wild_w_loop(count - 1, AccPush(acc, QcWWild))

fn qc_exhaust_find_uncovered_ctor_loop(all: List[QcCtor], heads: List[QcKey], idx: Int) -> Option[QcCtor] =
  if idx >= len(all) then None
  else
    let c = list_at(all, idx) in
    if !qc_exhaust_heads_contain_loop(heads, c.key, 0) then Some(c)
    else qc_exhaust_find_uncovered_ctor_loop(all, heads, idx + 1)

fn qc_exhaust_default_rows_loop(rows: List[List[QcP]], idx: Int, acc: Accum[List[QcP]]) -> List[List[QcP]] =
  if idx >= len(rows) then acc_list(acc)
  else
    let r = list_at(rows, idx) in
    match qc_exhaust_head(r) {
      None =>
        let tail_r = match qc_list_slice(r, 1, len(r)) { Some(xs) => xs, None => [] } in
        qc_exhaust_default_rows_loop(rows, idx + 1, AccPush(acc, tail_r)),
      Some(_) => qc_exhaust_default_rows_loop(rows, idx + 1, acc)
    }

fn qc_exhaust_missing_sub_loop(tp: QcTProgram, rows: List[List[QcP]], all: List[QcCtor], tail_tys: List[QcType], idx: Int) -> Option[List[QcW]] =
  if idx >= len(all) then None
  else
    let c = list_at(all, idx) in
    let sub = qc_exhaust_specialize(rows, c.key, len(c.args)) in
    let sub_tys = c.args ++ tail_tys in
    match qc_exhaust_missing(tp, sub, sub_tys) {
      Some(w) =>
        let w_args = match qc_list_slice(w, 0, len(c.args)) { Some(xs) => xs, None => [] } in
        let rest = match qc_list_slice(w, len(c.args), len(w)) { Some(xs) => xs, None => [] } in
        let first = QcWC(c.name, w_args, c.fields, qc_key_eq(c.key, QcKeyRecord)) in
        Some([first] ++ rest),
      None => qc_exhaust_missing_sub_loop(tp, rows, all, tail_tys, idx + 1)
    }

fn qc_missing_pattern(tp: QcTProgram, ty: QcType, rows: List[QcTPat]) -> Option[Str] =
  let p_rows = map(rows, fn(p: QcTPat) => [qc_exhaust_reduce(tp, p, ty)]) in
  match qc_exhaust_missing(tp, p_rows, [ty]) {
    Some(ws) =>
      if len(ws) > 0 then Some(qc_exhaust_show(list_at(ws, 0)))
      else None,
    None => None
  }

test qc_exhaust_test =
  let empty_tp = QcTProgram { types: [], fns: [], tests: [], generics: [] } in
  let rows = [QcTPBool(false)] in
  qc_missing_pattern(empty_tp, QcTBool, rows) == Some("true")
# Static checks of SQL literals for db_exec / db_query (spec §7: qc_sql, matching qal-core/src/sql.rs)

type QcSqlTok =
  | QcSqlWord(Str)
  | QcSqlParam
  | QcSqlSemicolon
  | QcSqlOther

fn qc_sql_is_ident(c: Int) -> Bool =
  (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36 || c > 127

fn qc_sql_is_whitespace(c: Int) -> Bool =
  c == 32 || c == 9 || c == 10 || c == 13

fn qc_sql_is_digit(c: Int) -> Bool =
  c >= 48 && c <= 57

fn qc_sql_close_quote(b: Bytes, start_idx: Int, q: Int, what: Str) -> Result[Int, Str] =
  let n = bytes_len(b) in
  qc_sql_close_quote_loop(b, start_idx, n, q, what)

fn qc_sql_close_quote_loop(b: Bytes, i: Int, n: Int, q: Int, what: Str) -> Result[Int, Str] =
  if i >= n then Err("unterminated " ++ what)
  else
    let c = bytes_at(b, i) in
    if c == q then
      if i + 1 < n && bytes_at(b, i + 1) == q then
        qc_sql_close_quote_loop(b, i + 2, n, q, what)
      else Ok(i + 1)
    else
      qc_sql_close_quote_loop(b, i + 1, n, q, what)

fn qc_sql_close_bracket_loop(b: Bytes, i: Int, n: Int) -> Result[Int, Str] =
  if i >= n then Err("unterminated quoted identifier")
  else if bytes_at(b, i) == 93 then Ok(i + 1) # ']'
  else qc_sql_close_bracket_loop(b, i + 1, n)

fn qc_sql_skip_line_comment_loop(b: Bytes, i: Int, n: Int) -> Int =
  if i >= n then i
  else if bytes_at(b, i) == 10 then i # '\n'
  else qc_sql_skip_line_comment_loop(b, i + 1, n)

fn qc_sql_skip_block_comment_loop(b: Bytes, i: Int, n: Int) -> Result[Int, Str] =
  if i >= n then Err("unterminated comment")
  else if bytes_at(b, i) == 42 && i + 1 < n && bytes_at(b, i + 1) == 47 then Ok(i + 2) # '*/'
  else qc_sql_skip_block_comment_loop(b, i + 1, n)

fn qc_sql_read_word_loop(b: Bytes, i: Int, n: Int) -> Int =
  if i >= n then i
  else if qc_sql_is_ident(bytes_at(b, i)) then qc_sql_read_word_loop(b, i + 1, n)
  else i

fn qc_sql_tokenize_loop(b: Bytes, i: Int, n: Int, acc: Accum[QcSqlTok]) -> Result[List[QcSqlTok], Str] =
  if i >= n then Ok(acc_list(acc))
  else
    let c = bytes_at(b, i) in
    if qc_sql_is_whitespace(c) then
      qc_sql_tokenize_loop(b, i + 1, n, acc)
    else if c == 45 && i + 1 < n && bytes_at(b, i + 1) == 45 then # '--'
      let next_i = qc_sql_skip_line_comment_loop(b, i + 2, n) in
      qc_sql_tokenize_loop(b, next_i, n, acc)
    else if c == 47 && i + 1 < n && bytes_at(b, i + 1) == 42 then # '/*'
      match qc_sql_skip_block_comment_loop(b, i + 2, n) {
        Err(e) => Err(e),
        Ok(next_i) => qc_sql_tokenize_loop(b, next_i, n, acc)
      }
    else if c == 39 then # '\''
      match qc_sql_close_quote(b, i + 1, 39, "string") {
        Err(e) => Err(e),
        Ok(next_i) => qc_sql_tokenize_loop(b, next_i, n, AccPush(acc, QcSqlOther))
      }
    else if c == 34 || c == 96 then # '"' or '`'
      match qc_sql_close_quote(b, i + 1, c, "quoted identifier") {
        Err(e) => Err(e),
        Ok(next_i) => qc_sql_tokenize_loop(b, next_i, n, AccPush(acc, QcSqlOther))
      }
    else if c == 91 then # '['
      match qc_sql_close_bracket_loop(b, i + 1, n) {
        Err(e) => Err(e),
        Ok(next_i) => qc_sql_tokenize_loop(b, next_i, n, AccPush(acc, QcSqlOther))
      }
    else if c == 59 then # ';'
      qc_sql_tokenize_loop(b, i + 1, n, AccPush(acc, QcSqlSemicolon))
    else if c == 63 then # '?'
      if i + 1 < n && qc_sql_is_digit(bytes_at(b, i + 1)) then
        Err("numbered parameters (`?NNN`) are not allowed: use `?` and pass the values in order")
      else
        qc_sql_tokenize_loop(b, i + 1, n, AccPush(acc, QcSqlParam))
    else if (c == 58 || c == 64 || c == 36 || c == 35) && i + 1 < n && qc_sql_is_ident(bytes_at(b, i + 1)) then
      # ':' '@' '$' '#'
      let char_str = match bytes_to_str(bytes_from([c])) { Some(s) => s, None => "?" } in
      Err("named parameters (`" ++ char_str ++ "name`) are not allowed: use `?` and pass the values in order")
    else if qc_sql_is_ident(c) then
      let end_word = qc_sql_read_word_loop(b, i, n) in
      let w_bytes = bytes_slice(b, i, end_word) in
      let w_str = match bytes_to_str(w_bytes) { Some(s) => s, None => "" } in
      qc_sql_tokenize_loop(b, end_word, n, AccPush(acc, QcSqlWord(w_str)))
    else
      qc_sql_tokenize_loop(b, i + 1, n, AccPush(acc, QcSqlOther))

fn qc_sql_tokens(sql: Str) -> Result[List[QcSqlTok], Str] =
  let b = to_bytes(sql) in
  qc_sql_tokenize_loop(b, 0, bytes_len(b), AccEnd)

fn qc_sql_tok_word(t: QcSqlTok) -> Option[Str] =
  match t {
    QcSqlWord(w) => Some(to_upper(w)),
    _ => None
  }

fn qc_sql_is_trigger(toks: List[QcSqlTok]) -> Bool =
  if len(toks) < 2 then false
  else
    match qc_sql_tok_word(list_at(toks, 0)) {
      Some(w0) =>
        if w0 != "CREATE" then false
        else
          let w1 = qc_sql_tok_word(list_at(toks, 1)) in
          if w1 == Some("TRIGGER") then true
          else if w1 == Some("TEMP") || w1 == Some("TEMPORARY") then
            if len(toks) >= 3 && qc_sql_tok_word(list_at(toks, 2)) == Some("TRIGGER") then true
            else false
          else false,
      None => false
    }

fn qc_sql_statement_end_loop(toks: List[QcSqlTok], k: Int, n: Int, trigger: Bool) -> Int =
  if k >= n then n
  else
    let t = list_at(toks, k) in
    match t {
      QcSqlSemicolon =>
        if !trigger then k
        else if k >= 2 && qc_sql_tok_word(list_at(toks, k - 1)) == Some("END") && list_at(toks, k - 2) == QcSqlSemicolon then k
        else qc_sql_statement_end_loop(toks, k + 1, n, trigger),
      _ => qc_sql_statement_end_loop(toks, k + 1, n, trigger)
    }

fn qc_sql_statement_end(toks: List[QcSqlTok]) -> Int =
  let trigger = qc_sql_is_trigger(toks) in
  qc_sql_statement_end_loop(toks, 0, len(toks), trigger)

fn qc_sql_is_forbidden(w: Str) -> Bool =
  w == "ATTACH" || w == "DETACH" || w == "PRAGMA" || w == "VACUUM" ||
  w == "BEGIN" || w == "COMMIT" || w == "END" || w == "ROLLBACK" ||
  w == "SAVEPOINT" || w == "RELEASE"

fn qc_sql_extract_words_loop(toks: List[QcSqlTok], i: Int, end_idx: Int, acc: Accum[Str]) -> List[Str] =
  if i >= end_idx then acc_list(acc)
  else
    match list_at(toks, i) {
      QcSqlWord(w) => qc_sql_extract_words_loop(toks, i + 1, end_idx, AccPush(acc, to_upper(w))),
      _ => qc_sql_extract_words_loop(toks, i + 1, end_idx, acc)
    }

fn qc_sql_count_params_loop(toks: List[QcSqlTok], i: Int, end_idx: Int, count: Int) -> Int =
  if i >= end_idx then count
  else
    match list_at(toks, i) {
      QcSqlParam => qc_sql_count_params_loop(toks, i + 1, end_idx, count + 1),
      _ => qc_sql_count_params_loop(toks, i + 1, end_idx, count)
    }

fn qc_sql_has_nul_loop(b: Bytes, i: Int, n: Int) -> Bool =
  if i >= n then false
  else if bytes_at(b, i) == 0 then true
  else qc_sql_has_nul_loop(b, i + 1, n)

fn qc_sql_check_statement(sql: Str) -> Result[Int, Str] =
  let b = to_bytes(sql) in
  if bytes_len(b) > 65536 then Err("the SQL text is longer than 65536 bytes")
  else if qc_sql_has_nul_loop(b, 0, bytes_len(b)) then Err("the SQL text contains a NUL character")
  else
    match qc_sql_tokens(sql) {
      Err(e) => Err(e),
      Ok(toks) =>
        let end_idx = qc_sql_statement_end(toks) in
        if len(toks) > end_idx + 1 then Err("only one statement is allowed (a single trailing `;` is fine)")
        else
          let words = qc_sql_extract_words_loop(toks, 0, end_idx, AccEnd) in
          if len(words) == 0 then Err("the SQL text has no statement")
          else
            let first0 = list_at(words, 0) in
            let first =
              if first0 == "EXPLAIN" then
                let next1 = if len(words) > 1 then list_at(words, 1) else "" in
                if next1 == "QUERY" then
                  if len(words) > 3 then list_at(words, 3) else ""
                else next1
              else first0 in
            if qc_sql_is_forbidden(first) then
              Err("`" ++ first ++ "` statements are not allowed: the host controls the database file, its settings and the transaction")
            else
              Ok(qc_sql_count_params_loop(toks, 0, end_idx, 0))
    }

test qc_sql_test =
  qc_sql_check_statement("SELECT id, title FROM todos WHERE id = ?") == Ok(1) &&
  qc_sql_check_statement("insert into t (a, b) values (?, ?);") == Ok(2) &&
  qc_sql_check_statement("ATTACH 'x' AS y") == Err("`ATTACH` statements are not allowed: the host controls the database file, its settings and the transaction")
# Monomorphisation and concrete type validation (spec §7: qc_mono, matching qal-check/src/mono.rs)

fn qc_type_depth(t: QcType) -> Int =
  1 + (match t {
    QcTList(x) => qc_type_depth(x),
    QcTOption(x) => qc_type_depth(x),
    QcTResult(a, b) => qc_max_int(qc_type_depth(a), qc_type_depth(b)),
    QcTMap(a, b) => qc_max_int(qc_type_depth(a), qc_type_depth(b)),
    QcTApp(_, args) =>
      let ds = map(args, qc_type_depth) in
      qc_max_list_int_loop(ds, 0, 0),
    QcTFn(ps, r, _) =>
      let ds = map(ps, qc_type_depth) in
      qc_max_int(qc_max_list_int_loop(ds, 0, 0), qc_type_depth(r)),
    _ => 0
  })

fn qc_type_size(t: QcType) -> Int =
  1 + (match t {
    QcTList(x) => qc_type_size(x),
    QcTOption(x) => qc_type_size(x),
    QcTResult(a, b) => qc_type_size(a) + qc_type_size(b),
    QcTMap(a, b) => qc_type_size(a) + qc_type_size(b),
    QcTApp(_, args) => fold(args, 0, fn(acc: Int, a: QcType) => acc + qc_type_size(a)),
    QcTFn(ps, r, _) => fold(ps, qc_type_size(r), fn(acc: Int, p: QcType) => acc + qc_type_size(p)),
    _ => 0
  })

fn qc_show_targs(targs: List[QcType]) -> Str =
  join(map(targs, qc_print_type), ", ")

# Expression substitution: replace tps by targs
fn qc_subst_expr(e: QcTExpr, tps: List[Str], targs: List[QcType]) -> QcTExpr =
  let next_ty = qc_type_instantiate(e.ty, tps, targs) in
  let next_kind = match e.kind {
    QcTKCallG(h, ts, xs) =>
      let next_ts = map(ts, fn(t: QcType) => qc_type_instantiate(t, tps, targs)) in
      let next_xs = map(xs, fn(x: QcTExpr) => qc_subst_expr(x, tps, targs)) in
      QcTKCallG(h, next_ts, next_xs),
    QcTKFnRefG(h, ts) =>
      let next_ts = map(ts, fn(t: QcType) => qc_type_instantiate(t, tps, targs)) in
      QcTKFnRefG(h, next_ts),
    QcTKLambda(l) =>
      QcTKLambda(QcTLambda {
        params: l.params,
        captures: l.captures,
        body: qc_subst_expr(l.body, tps, targs)
      }),
    QcTKUn(op, x, path) => QcTKUn(op, qc_subst_expr(x, tps, targs), path),
    QcTKField(x, i) => QcTKField(qc_subst_expr(x, tps, targs), i),
    QcTKBin(op, l, r, path) => QcTKBin(op, qc_subst_expr(l, tps, targs), qc_subst_expr(r, tps, targs), path),
    QcTKLet(id, l, r) => QcTKLet(id, qc_subst_expr(l, tps, targs), qc_subst_expr(r, tps, targs)),
    QcTKIf(c, t, f) => QcTKIf(qc_subst_expr(c, tps, targs), qc_subst_expr(t, tps, targs), qc_subst_expr(f, tps, targs)),
    QcTKCall(i, xs) => QcTKCall(i, map(xs, fn(x: QcTExpr) => qc_subst_expr(x, tps, targs))),
    QcTKList(xs) => QcTKList(map(xs, fn(x: QcTExpr) => qc_subst_expr(x, tps, targs))),
    QcTKVariant(tag, xs) => QcTKVariant(tag, map(xs, fn(x: QcTExpr) => qc_subst_expr(x, tps, targs))),
    QcTKSeq(xs) => QcTKSeq(map(xs, fn(x: QcTExpr) => qc_subst_expr(x, tps, targs))),
    QcTKBuiltin(b, xs, path) => QcTKBuiltin(b, map(xs, fn(x: QcTExpr) => qc_subst_expr(x, tps, targs)), path),
    QcTKCallIndirect(f, xs) => QcTKCallIndirect(qc_subst_expr(f, tps, targs), map(xs, fn(x: QcTExpr) => qc_subst_expr(x, tps, targs))),
    QcTKRecord(fs) => QcTKRecord(map(fs, fn(fld: QcTField) => QcTField { idx: fld.idx, expr: qc_subst_expr(fld.expr, tps, targs) })),
    QcTKMatch(s, arms) =>
      let next_s = qc_subst_expr(s, tps, targs) in
      let next_arms = map(arms, fn(a: QcTArm) =>
        let next_guard = match a.guard {
          Some(g) => Some(qc_subst_expr(g, tps, targs)),
          None => None
        } in
        QcTArm { pat: a.pat, guard: next_guard, body: qc_subst_expr(a.body, tps, targs) }
      ) in
      QcTKMatch(next_s, next_arms),
    other => other
  } in
  QcTExpr { ty: next_ty, kind: next_kind }

# Monomorphisation state
type QcMonoState = {
  generics: List[QcTFn],
  sizes: List[Int],
  copied: Int,
  base: Int,
  instances: Map[Str, Int],
  new_fns: List[QcTFn],
  queue: List[Int],
  failed: Option[QcDiag],
  # Rewritten instances by index into new_fns (avoids copying new_fns per instance)
  done: Map[Str, QcTFn]
}

type QcMonoRewriteRes = {
  st: QcMonoState,
  expr: QcTExpr
}

type QcMonoInstRes = {
  st: QcMonoState,
  idx: Int
}

fn qc_mono_fn_nodes(f: QcTFn) -> Int =
  let req_nodes = fold(f.reqs, 0, fn(acc: Int, e: QcTExpr) => acc + qc_mono_expr_nodes(e)) in
  let ens_nodes = fold(f.enss, 0, fn(acc: Int, e: QcTExpr) => acc + qc_mono_expr_nodes(e)) in
  req_nodes + ens_nodes + qc_mono_expr_nodes(f.body)

fn qc_mono_expr_nodes(e: QcTExpr) -> Int =
  1 + (match e.kind {
    QcTKLambda(l) => qc_mono_expr_nodes(l.body),
    QcTKUn(_, x, _) => qc_mono_expr_nodes(x),
    QcTKField(x, _) => qc_mono_expr_nodes(x),
    QcTKBin(_, l, r, _) => qc_mono_expr_nodes(l) + qc_mono_expr_nodes(r),
    QcTKLet(_, l, r) => qc_mono_expr_nodes(l) + qc_mono_expr_nodes(r),
    QcTKIf(c, t, f) => qc_mono_expr_nodes(c) + qc_mono_expr_nodes(t) + qc_mono_expr_nodes(f),
    QcTKCall(_, xs) => fold(xs, 0, fn(acc: Int, x: QcTExpr) => acc + qc_mono_expr_nodes(x)),
    QcTKCallG(_, _, xs) => fold(xs, 0, fn(acc: Int, x: QcTExpr) => acc + qc_mono_expr_nodes(x)),
    QcTKList(xs) => fold(xs, 0, fn(acc: Int, x: QcTExpr) => acc + qc_mono_expr_nodes(x)),
    QcTKVariant(_, xs) => fold(xs, 0, fn(acc: Int, x: QcTExpr) => acc + qc_mono_expr_nodes(x)),
    QcTKSeq(xs) => fold(xs, 0, fn(acc: Int, x: QcTExpr) => acc + qc_mono_expr_nodes(x)),
    QcTKBuiltin(_, xs, _) => fold(xs, 0, fn(acc: Int, x: QcTExpr) => acc + qc_mono_expr_nodes(x)),
    QcTKCallIndirect(f, xs) => fold(xs, qc_mono_expr_nodes(f), fn(acc: Int, x: QcTExpr) => acc + qc_mono_expr_nodes(x)),
    QcTKRecord(fs) => fold(fs, 0, fn(acc: Int, f: QcTField) => acc + qc_mono_expr_nodes(f.expr)),
    QcTKMatch(s, arms) =>
      let s_nodes = qc_mono_expr_nodes(s) in
      fold(arms, s_nodes, fn(acc: Int, a: QcTArm) =>
        let g_nodes = match a.guard { Some(g) => qc_mono_expr_nodes(g), None => 0 } in
        acc + g_nodes + qc_mono_expr_nodes(a.body)
      ),
    _ => 0
  })

fn qc_mono_inst_params_loop(params: List[QcFieldType], locals: List[QcType], tps: List[Str], targs: List[QcType], idx: Int, acc: Accum[QcFieldType]) -> List[QcFieldType] =
  if idx >= len(params) then acc_list(acc)
  else
    let p = list_at(params, idx) in
    let loc_ty = if idx < len(locals) then list_at(locals, idx) else p.ty in
    let next_p = QcFieldType { name: p.name, ty: qc_type_instantiate(loc_ty, tps, targs) } in
    qc_mono_inst_params_loop(params, locals, tps, targs, idx + 1, AccPush(acc, next_p))

fn qc_mono_instance(st: QcMonoState, caller: Str, g: Int, targs: List[QcType]) -> QcMonoInstRes =
  let key = from_int(g) ++ ":" ++ join(map(targs, qc_print_type), ",") in
  match map_get(st.instances, key) {
    Some(i) => QcMonoInstRes { st: st, idx: i },
    None =>
      let gf = list_at(st.generics, g) in
      let name = gf.def.name ++ "[" ++ qc_show_targs(targs) ++ "]" in
      let g_size = if g < len(st.sizes) then list_at(st.sizes, g) else 0 in
      let targs_size = fold(targs, 1, fn(acc: Int, t: QcType) => acc + qc_type_size(t)) in
      let size = g_size * targs_size in
      let too_big = fold(targs, false, fn(acc: Bool, t: QcType) => acc || qc_type_size(t) > 4096 || qc_type_depth(t) > 256) in
      if map_size(st.instances) >= 1000 || too_big || st.copied + size > 500000 then
        let diag = match st.failed {
          Some(d) => d,
          None => qc_diag_instantiation_limit(caller, "", name, 1000)
        } in
        QcMonoInstRes {
          st: QcMonoState {
            generics: st.generics,
            sizes: st.sizes,
            copied: st.copied,
            base: st.base,
            instances: st.instances,
            new_fns: st.new_fns,
            queue: st.queue,
            failed: Some(diag),
            done: st.done
          },
          idx: 0
        }
      else
        let tps = gf.def.tparams in
        let next_params = qc_mono_inst_params_loop(gf.def.params, gf.locals, tps, targs, 0, AccEnd) in
        let next_def = QcFnDef {
          name: name,
          tparams: [],
          eparams: gf.def.eparams,
          params: next_params,
          ret: qc_type_instantiate(gf.body.ty, tps, targs),
          effects: gf.def.effects,
          reqs: gf.def.reqs,
          enss: gf.def.enss,
          body: gf.def.body
        } in
        let inst_fn = QcTFn {
          def: next_def,
          locals: map(gf.locals, fn(t: QcType) => qc_type_instantiate(t, tps, targs)),
          reqs: map(gf.reqs, fn(e: QcTExpr) => qc_subst_expr(e, tps, targs)),
          enss: map(gf.enss, fn(e: QcTExpr) => qc_subst_expr(e, tps, targs)),
          result_local: gf.result_local,
          body: qc_subst_expr(gf.body, tps, targs),
          instance: Some(QcTFnInstance { gen_idx: g, args: targs })
        } in
        let k = len(st.new_fns) in
        let idx = st.base + k in
        let next_st = QcMonoState {
          generics: st.generics,
          sizes: st.sizes,
          copied: st.copied + size,
          base: st.base,
          instances: map_put(st.instances, key, idx),
          new_fns: push(st.new_fns, inst_fn),
          queue: push(st.queue, k),
          failed: st.failed,
          done: st.done
        } in
        QcMonoInstRes { st: next_st, idx: idx }
  }

fn qc_mono_rewrite(st: QcMonoState, caller: Str, e: QcTExpr) -> QcMonoRewriteRes =
  match e.kind {
    QcTKCallG(g, targs, args) =>
      let args_res = qc_mono_rewrite_list_loop(st, caller, args, 0, AccEnd) in
      let inst_res = qc_mono_instance(args_res.st, caller, g, targs) in
      QcMonoRewriteRes {
        st: inst_res.st,
        expr: QcTExpr { ty: e.ty, kind: QcTKCall(inst_res.idx, args_res.xs) }
      },
    QcTKFnRefG(g, targs) =>
      let inst_res = qc_mono_instance(st, caller, g, targs) in
      QcMonoRewriteRes {
        st: inst_res.st,
        expr: QcTExpr { ty: e.ty, kind: QcTKFnRef(inst_res.idx) }
      },
    QcTKLambda(l) =>
      let body_res = qc_mono_rewrite(st, caller, l.body) in
      QcMonoRewriteRes {
        st: body_res.st,
        expr: QcTExpr { ty: e.ty, kind: QcTKLambda(QcTLambda { params: l.params, captures: l.captures, body: body_res.expr }) }
      },
    QcTKUn(op, x, path) =>
      let x_res = qc_mono_rewrite(st, caller, x) in
      QcMonoRewriteRes { st: x_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKUn(op, x_res.expr, path) } },
    QcTKField(x, i) =>
      let x_res = qc_mono_rewrite(st, caller, x) in
      QcMonoRewriteRes { st: x_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKField(x_res.expr, i) } },
    QcTKBin(op, l, r, path) =>
      let l_res = qc_mono_rewrite(st, caller, l) in
      let r_res = qc_mono_rewrite(l_res.st, caller, r) in
      QcMonoRewriteRes { st: r_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKBin(op, l_res.expr, r_res.expr, path) } },
    QcTKLet(id, l, r) =>
      let l_res = qc_mono_rewrite(st, caller, l) in
      let r_res = qc_mono_rewrite(l_res.st, caller, r) in
      QcMonoRewriteRes { st: r_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKLet(id, l_res.expr, r_res.expr) } },
    QcTKIf(c, t, f) =>
      let c_res = qc_mono_rewrite(st, caller, c) in
      let t_res = qc_mono_rewrite(c_res.st, caller, t) in
      let f_res = qc_mono_rewrite(t_res.st, caller, f) in
      QcMonoRewriteRes { st: f_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKIf(c_res.expr, t_res.expr, f_res.expr) } },
    QcTKCall(i, xs) =>
      let xs_res = qc_mono_rewrite_list_loop(st, caller, xs, 0, AccEnd) in
      QcMonoRewriteRes { st: xs_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKCall(i, xs_res.xs) } },
    QcTKList(xs) =>
      let xs_res = qc_mono_rewrite_list_loop(st, caller, xs, 0, AccEnd) in
      QcMonoRewriteRes { st: xs_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKList(xs_res.xs) } },
    QcTKVariant(tag, xs) =>
      let xs_res = qc_mono_rewrite_list_loop(st, caller, xs, 0, AccEnd) in
      QcMonoRewriteRes { st: xs_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKVariant(tag, xs_res.xs) } },
    QcTKSeq(xs) =>
      let xs_res = qc_mono_rewrite_list_loop(st, caller, xs, 0, AccEnd) in
      QcMonoRewriteRes { st: xs_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKSeq(xs_res.xs) } },
    QcTKBuiltin(b, xs, path) =>
      let xs_res = qc_mono_rewrite_list_loop(st, caller, xs, 0, AccEnd) in
      QcMonoRewriteRes { st: xs_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKBuiltin(b, xs_res.xs, path) } },
    QcTKCallIndirect(f, xs) =>
      let f_res = qc_mono_rewrite(st, caller, f) in
      let xs_res = qc_mono_rewrite_list_loop(f_res.st, caller, xs, 0, AccEnd) in
      QcMonoRewriteRes { st: xs_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKCallIndirect(f_res.expr, xs_res.xs) } },
    QcTKRecord(fs) =>
      let fs_res = qc_mono_rewrite_fields_loop(st, caller, fs, 0, AccEnd) in
      QcMonoRewriteRes { st: fs_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKRecord(fs_res.fs) } },
    QcTKMatch(s, arms) =>
      let s_res = qc_mono_rewrite(st, caller, s) in
      let arms_res = qc_mono_rewrite_arms_loop(s_res.st, caller, arms, 0, AccEnd) in
      QcMonoRewriteRes { st: arms_res.st, expr: QcTExpr { ty: e.ty, kind: QcTKMatch(s_res.expr, arms_res.arms) } },
    _ => QcMonoRewriteRes { st: st, expr: e }
  }

type QcMonoListRes = {
  st: QcMonoState,
  xs: List[QcTExpr]
}

fn qc_mono_rewrite_list_loop(st: QcMonoState, caller: Str, xs: List[QcTExpr], idx: Int, acc: Accum[QcTExpr]) -> QcMonoListRes =
  if idx >= len(xs) then QcMonoListRes { st: st, xs: acc_list(acc) }
  else
    let res = qc_mono_rewrite(st, caller, list_at(xs, idx)) in
    qc_mono_rewrite_list_loop(res.st, caller, xs, idx + 1, AccPush(acc, res.expr))

type QcMonoFieldsRes = {
  st: QcMonoState,
  fs: List[QcTField]
}

fn qc_mono_rewrite_fields_loop(st: QcMonoState, caller: Str, fs: List[QcTField], idx: Int, acc: Accum[QcTField]) -> QcMonoFieldsRes =
  if idx >= len(fs) then QcMonoFieldsRes { st: st, fs: acc_list(acc) }
  else
    let fld = list_at(fs, idx) in
    let res = qc_mono_rewrite(st, caller, fld.expr) in
    qc_mono_rewrite_fields_loop(res.st, caller, fs, idx + 1, AccPush(acc, QcTField { idx: fld.idx, expr: res.expr }))

type QcMonoArmRes = {
  st: QcMonoState,
  arm: QcTArm
}

type QcMonoArmsRes = {
  st: QcMonoState,
  arms: List[QcTArm]
}

fn qc_mono_rewrite_arms_loop(st: QcMonoState, caller: Str, arms: List[QcTArm], idx: Int, acc: Accum[QcTArm]) -> QcMonoArmsRes =
  if idx >= len(arms) then QcMonoArmsRes { st: st, arms: acc_list(acc) }
  else
    let a = list_at(arms, idx) in
    let arm_res = match a.guard {
      Some(g) =>
        let g_res = qc_mono_rewrite(st, caller, g) in
        let b_res = qc_mono_rewrite(g_res.st, caller, a.body) in
        QcMonoArmRes { st: b_res.st, arm: QcTArm { pat: a.pat, guard: Some(g_res.expr), body: b_res.expr } },
      None =>
        let b_res = qc_mono_rewrite(st, caller, a.body) in
        QcMonoArmRes { st: b_res.st, arm: QcTArm { pat: a.pat, guard: None, body: b_res.expr } }
    } in
    qc_mono_rewrite_arms_loop(arm_res.st, caller, arms, idx + 1, AccPush(acc, arm_res.arm))

type QcMonoRewriteFnRes = {
  st: QcMonoState,
  f: QcTFn
}

fn qc_mono_rewrite_fn(st: QcMonoState, f: QcTFn) -> QcMonoRewriteFnRes =
  let name = f.def.name in
  let req_res = qc_mono_rewrite_list_loop(st, name, f.reqs, 0, AccEnd) in
  let ens_res = qc_mono_rewrite_list_loop(req_res.st, name, f.enss, 0, AccEnd) in
  let body_res = qc_mono_rewrite(ens_res.st, name, f.body) in
  let next_fn = QcTFn {
    def: f.def,
    locals: f.locals,
    reqs: req_res.xs,
    enss: ens_res.xs,
    result_local: f.result_local,
    body: body_res.expr,
    instance: f.instance
  } in
  QcMonoRewriteFnRes { st: body_res.st, f: next_fn }

fn qc_monomorphise_queue_loop(st: QcMonoState) -> QcMonoState =
  match st.failed {
    Some(_) => st,
    None =>
      match qc_list_pop(st.queue) {
        None => st,
        Some(rest_queue) =>
          let k = list_at(st.queue, len(st.queue) - 1) in
          let st_popped = QcMonoState {
            generics: st.generics,
            sizes: st.sizes,
            copied: st.copied,
            base: st.base,
            instances: st.instances,
            new_fns: st.new_fns,
            queue: rest_queue,
            failed: st.failed,
            done: st.done
          } in
          if k < len(st_popped.new_fns) then
            let f = list_at(st_popped.new_fns, k) in
            let fn_res = qc_mono_rewrite_fn(st_popped, f) in
            let st_next = QcMonoState {
              generics: fn_res.st.generics,
              sizes: fn_res.st.sizes,
              copied: fn_res.st.copied,
              base: fn_res.st.base,
              instances: fn_res.st.instances,
              new_fns: fn_res.st.new_fns,
              queue: fn_res.st.queue,
              failed: fn_res.st.failed,
              done: map_put(fn_res.st.done, from_int(k), fn_res.f)
            } in
            qc_monomorphise_queue_loop(st_next)
          else
            qc_monomorphise_queue_loop(st_popped)
      }
  }

type QcMonoRes = {
  tp: QcTProgram,
  diag: Option[QcDiag]
}

type QcMonoRewriteFnsRes = {
  st: QcMonoState,
  fns: List[QcTFn]
}

type QcMonoRewriteTestsRes = {
  st: QcMonoState,
  tests: List[QcTTest]
}

fn qc_monomorphise(tp: QcTProgram) -> QcMonoRes =
  let generics = tp.generics in
  let fns = tp.fns in
  let sizes = map(generics, qc_mono_fn_nodes) in
  let init_st = QcMonoState {
    generics: generics,
    sizes: sizes,
    copied: 0,
    base: len(fns),
    instances: map_new(),
    new_fns: [],
    queue: [],
    failed: None,
    done: map_new()
  } in
  # Rewrite monomorphic fns
  let fns_res = qc_mono_rewrite_fns_loop(init_st, fns, 0, AccEnd) in
  # Rewrite tests
  let tests_res = qc_mono_rewrite_tests_loop(fns_res.st, tp.tests, 0, AccEnd) in
  # Process instance queue
  let st3 = qc_monomorphise_queue_loop(tests_res.st) in
  match st3.failed {
    Some(d) => QcMonoRes { tp: tp, diag: Some(d) },
    None =>
      let final_tp = QcTProgram {
        types: tp.types,
        fns: fns_res.fns ++ qc_mono_done_loop(st3, 0, AccEnd),
        tests: tests_res.tests,
        generics: generics
      } in
      QcMonoRes { tp: final_tp, diag: None }
  }

# The instances in index order, each in its rewritten form.
fn qc_mono_done_loop(st: QcMonoState, k: Int, acc: Accum[QcTFn]) -> List[QcTFn] =
  if k >= len(st.new_fns) then acc_list(acc)
  else
    let f = match map_get(st.done, from_int(k)) {
      Some(rf) => rf,
      None => list_at(st.new_fns, k)
    } in
    qc_mono_done_loop(st, k + 1, AccPush(acc, f))

fn qc_mono_rewrite_fns_loop(st: QcMonoState, fns: List[QcTFn], idx: Int, acc: Accum[QcTFn]) -> QcMonoRewriteFnsRes =
  if idx >= len(fns) then QcMonoRewriteFnsRes { st: st, fns: acc_list(acc) }
  else
    let fn_res = qc_mono_rewrite_fn(st, list_at(fns, idx)) in
    qc_mono_rewrite_fns_loop(fn_res.st, fns, idx + 1, AccPush(acc, fn_res.f))

fn qc_mono_rewrite_tests_loop(st: QcMonoState, tests: List[QcTTest], idx: Int, acc: Accum[QcTTest]) -> QcMonoRewriteTestsRes =
  if idx >= len(tests) then QcMonoRewriteTestsRes { st: st, tests: acc_list(acc) }
  else
    let t = list_at(tests, idx) in
    let res = qc_mono_rewrite(st, t.name, t.body) in
    let next_test = QcTTest { name: t.name, locals: t.locals, body: res.expr } in
    qc_mono_rewrite_tests_loop(res.st, tests, idx + 1, AccPush(acc, next_test))

# Polymorphic recursion check
type QcCallG = {
  callee: Int,
  targs: List[QcType]
}

fn qc_collect_calls_g(e: QcTExpr, acc: Accum[QcCallG]) -> Accum[QcCallG] =
  let acc1 = match e.kind {
    QcTKCallG(h, targs, _) => AccPush(acc, QcCallG { callee: h, targs: targs }),
    QcTKFnRefG(h, targs) => AccPush(acc, QcCallG { callee: h, targs: targs }),
    _ => acc
  } in
  match e.kind {
    QcTKLambda(l) => qc_collect_calls_g(l.body, acc1),
    QcTKUn(_, x, _) => qc_collect_calls_g(x, acc1),
    QcTKField(x, _) => qc_collect_calls_g(x, acc1),
    QcTKBin(_, l, r, _) => qc_collect_calls_g(r, qc_collect_calls_g(l, acc1)),
    QcTKLet(_, l, r) => qc_collect_calls_g(r, qc_collect_calls_g(l, acc1)),
    QcTKIf(c, t, f) => qc_collect_calls_g(f, qc_collect_calls_g(t, qc_collect_calls_g(c, acc1))),
    QcTKCall(_, xs) => fold(xs, acc1, fn(st: Accum[QcCallG], x: QcTExpr) => qc_collect_calls_g(x, st)),
    QcTKCallG(_, _, xs) => fold(xs, acc1, fn(st: Accum[QcCallG], x: QcTExpr) => qc_collect_calls_g(x, st)),
    QcTKList(xs) => fold(xs, acc1, fn(st: Accum[QcCallG], x: QcTExpr) => qc_collect_calls_g(x, st)),
    QcTKVariant(_, xs) => fold(xs, acc1, fn(st: Accum[QcCallG], x: QcTExpr) => qc_collect_calls_g(x, st)),
    QcTKSeq(xs) => fold(xs, acc1, fn(st: Accum[QcCallG], x: QcTExpr) => qc_collect_calls_g(x, st)),
    QcTKBuiltin(_, xs, _) => fold(xs, acc1, fn(st: Accum[QcCallG], x: QcTExpr) => qc_collect_calls_g(x, st)),
    QcTKCallIndirect(f, xs) => fold(xs, qc_collect_calls_g(f, acc1), fn(st: Accum[QcCallG], x: QcTExpr) => qc_collect_calls_g(x, st)),
    QcTKRecord(fs) => fold(fs, acc1, fn(st: Accum[QcCallG], f: QcTField) => qc_collect_calls_g(f.expr, st)),
    QcTKMatch(s, arms) =>
      let st_s = qc_collect_calls_g(s, acc1) in
      fold(arms, st_s, fn(st: Accum[QcCallG], a: QcTArm) =>
        let st_g = match a.guard { Some(g) => qc_collect_calls_g(g, st), None => st } in
        qc_collect_calls_g(a.body, st_g)
      ),
    _ => acc1
  }

fn qc_fn_calls_g(f: QcTFn) -> List[QcCallG] =
  let st0 = fold(f.reqs, AccEnd, fn(st: Accum[QcCallG], e: QcTExpr) => qc_collect_calls_g(e, st)) in
  let st1 = fold(f.enss, st0, fn(st: Accum[QcCallG], e: QcTExpr) => qc_collect_calls_g(e, st)) in
  acc_list(qc_collect_calls_g(f.body, st1))

fn qc_mono_polymorphic_recursion(tp: QcTProgram) -> Option[QcDiag] =
  let n = len(tp.generics) in
  if n == 0 then None
  else
    let all_calls = map(tp.generics, qc_fn_calls_g) in
    let succ = map(all_calls, fn(cs: List[QcCallG]) =>
      map(filter(cs, fn(c: QcCallG) => c.callee < n), fn(c: QcCallG) => c.callee)
    ) in
    let init_tarjan = QcTarjanState {
      n: n,
      edges: succ,
      indices: map_new(),
      lowlinks: map_new(),
      on_stack: map_new(),
      stack: [],
      next_idx: 0,
      sccs: AccEnd
    } in
    let tarjan_res = qc_tarjan_loop(init_tarjan, 0) in
    let sccs = acc_list(tarjan_res.sccs) in
    let comp_map = qc_build_comp_map_loop(sccs, 0, map_new()) in
    qc_check_poly_rec_loop(tp.generics, all_calls, comp_map, 0)

fn qc_build_comp_map_loop(sccs: List[List[Int]], c_idx: Int, acc: Map[Int, Int]) -> Map[Int, Int] =
  if c_idx >= len(sccs) then acc
  else
    let nodes = list_at(sccs, c_idx) in
    let next_acc = fold(nodes, acc, fn(st: Map[Int, Int], node: Int) => map_put(st, node, c_idx)) in
    qc_build_comp_map_loop(sccs, c_idx + 1, next_acc)

fn qc_check_poly_rec_loop(generics: List[QcTFn], all_calls: List[List[QcCallG]], comp_map: Map[Int, Int], g: Int) -> Option[QcDiag] =
  if g >= len(generics) then None
  else
    let gf = list_at(generics, g) in
    let calls = list_at(all_calls, g) in
    let g_comp = map_get(comp_map, g) in
    match qc_check_poly_calls_loop(gf.def.name, generics, calls, g_comp, comp_map, 0) {
      Some(d) => Some(d),
      None => qc_check_poly_rec_loop(generics, all_calls, comp_map, g + 1)
    }

fn qc_check_poly_calls_loop(caller_name: Str, generics: List[QcTFn], calls: List[QcCallG], g_comp: Option[Int], comp_map: Map[Int, Int], idx: Int) -> Option[QcDiag] =
  if idx >= len(calls) then None
  else
    let c = list_at(calls, idx) in
    let h = c.callee in
    let h_comp = map_get(comp_map, h) in
    let same_group = (g_comp != None) && (g_comp == h_comp) in
    if same_group then
      let all_plain_params = fold(c.targs, true, fn(acc: Bool, t: QcType) =>
        acc && (match t { QcTParam(_) => true, _ => false })
      ) in
      if !all_plain_params then
        let callee_name = if h < len(generics) then (list_at(generics, h)).def.name else "" in
        Some(qc_diag_polymorphic_recursion(caller_name, "", callee_name, qc_show_targs(c.targs)))
      else
        qc_check_poly_calls_loop(caller_name, generics, calls, g_comp, comp_map, idx + 1)
    else
      qc_check_poly_calls_loop(caller_name, generics, calls, g_comp, comp_map, idx + 1)

# Concrete type validation (bad map keys, compare with functions, == in instances)
fn qc_contains_fn(tp: QcTProgram, t: QcType, seen: List[Str]) -> Bool =
  if len(seen) >= 256 then true
  else
    match t {
      QcTFn(_, _, _) => true,
      QcTList(x) => qc_contains_fn(tp, x, seen),
      QcTOption(x) => qc_contains_fn(tp, x, seen),
      QcTResult(a, b) => qc_contains_fn(tp, a, seen) || qc_contains_fn(tp, b, seen),
      QcTMap(a, b) => qc_contains_fn(tp, a, seen) || qc_contains_fn(tp, b, seen),
      QcTNamed(_) => qc_contains_fn_named(tp, t, seen),
      QcTApp(_, _) => qc_contains_fn_named(tp, t, seen),
      _ => false
    }

fn qc_contains_fn_named(tp: QcTProgram, t: QcType, seen: List[Str]) -> Bool =
  let key = qc_print_type(t) in
  if qc_contains_str_loop(seen, key, 0) then false
  else
    let next_seen = push(seen, key) in
    match qc_tp_decl(tp, t) {
      Some(QcBodyRecord(fs)) => fold(fs, false, fn(acc: Bool, f: QcFieldType) => acc || qc_contains_fn(tp, f.ty, next_seen)),
      Some(QcBodyEnum(vs)) => fold(vs, false, fn(acc: Bool, v: QcVariant) =>
        acc || fold(v.fields, false, fn(acc_f: Bool, f: QcType) => acc_f || qc_contains_fn(tp, f, next_seen))
      ),
      None => false
    }

fn qc_bad_map_key(tp: QcTProgram, t: QcType, seen: List[Str]) -> Option[QcType] =
  if len(seen) >= 256 then None
  else
    match t {
      QcTMap(k, v) =>
        if qc_contains_fn(tp, k, []) then Some(k)
        else
          match qc_bad_map_key(tp, k, seen) {
            Some(bad) => Some(bad),
            None => qc_bad_map_key(tp, v, seen)
          },
      QcTList(x) => qc_bad_map_key(tp, x, seen),
      QcTOption(x) => qc_bad_map_key(tp, x, seen),
      QcTResult(a, b) =>
        match qc_bad_map_key(tp, a, seen) {
          Some(bad) => Some(bad),
          None => qc_bad_map_key(tp, b, seen)
        },
      QcTFn(ps, r, _) =>
        let bad_p = fold(ps, None, fn(acc: Option[QcType], p: QcType) =>
          match acc { Some(_) => acc, None => qc_bad_map_key(tp, p, seen) }
        ) in
        match bad_p {
          Some(bad) => Some(bad),
          None => qc_bad_map_key(tp, r, seen)
        },
      QcTNamed(_) => qc_bad_map_key_named(tp, t, seen),
      QcTApp(_, _) => qc_bad_map_key_named(tp, t, seen),
      _ => None
    }

fn qc_bad_map_key_named(tp: QcTProgram, t: QcType, seen: List[Str]) -> Option[QcType] =
  let key = qc_print_type(t) in
  if qc_contains_str_loop(seen, key, 0) then None
  else
    let next_seen = push(seen, key) in
    match qc_tp_decl(tp, t) {
      Some(QcBodyRecord(fs)) =>
        fold(fs, None, fn(acc: Option[QcType], f: QcFieldType) =>
          match acc { Some(_) => acc, None => qc_bad_map_key(tp, f.ty, next_seen) }
        ),
      Some(QcBodyEnum(vs)) =>
        fold(vs, None, fn(acc: Option[QcType], v: QcVariant) =>
          match acc {
            Some(_) => acc,
            None => fold(v.fields, None, fn(acc_f: Option[QcType], f: QcType) =>
              match acc_f { Some(_) => acc_f, None => qc_bad_map_key(tp, f, next_seen) }
            )
          }
        ),
      None => None
    }

fn qc_validate_expr(tp: QcTProgram, def_name: Str, e: QcTExpr, is_inst: Bool) -> Option[QcDiag] =
  match qc_bad_map_key(tp, e.ty, []) {
    Some(k) =>
      Some(qc_diag_hint(
        qc_diag_type_mismatch(def_name, "", "a comparable key type", qc_print_type(k)),
        "map keys cannot contain functions"
      )),
    None =>
      match e.kind {
        QcTKBuiltin(QcBCompare, args, path) =>
          if len(args) > 0 && qc_contains_fn(tp, (list_at(args, 0)).ty, []) then
            Some(qc_diag_hint(
              qc_diag_type_mismatch(def_name, path, "a comparable type", qc_print_type((list_at(args, 0)).ty)),
              "`compare` orders values without functions inside"
            ))
          else qc_validate_children(tp, def_name, e, is_inst),
        QcTKBin(op, l, _, path) if (op == QcOpEq || op == QcOpNe) && is_inst =>
          if qc_contains_fn(tp, l.ty, []) then
            Some(qc_diag_hint(
              qc_diag_type_mismatch(def_name, path, "a comparable type", qc_print_type(l.ty)),
              "functions cannot be compared; this generic function compares values of a type parameter"
            ))
          else qc_validate_children(tp, def_name, e, is_inst),
        _ => qc_validate_children(tp, def_name, e, is_inst)
      }
  }

fn qc_validate_children(tp: QcTProgram, def_name: Str, e: QcTExpr, is_inst: Bool) -> Option[QcDiag] =
  match e.kind {
    QcTKLambda(l) => qc_validate_expr(tp, def_name, l.body, is_inst),
    QcTKUn(_, x, _) => qc_validate_expr(tp, def_name, x, is_inst),
    QcTKField(x, _) => qc_validate_expr(tp, def_name, x, is_inst),
    QcTKBin(_, l, r, _) =>
      match qc_validate_expr(tp, def_name, l, is_inst) {
        Some(d) => Some(d),
        None => qc_validate_expr(tp, def_name, r, is_inst)
      },
    QcTKLet(_, l, r) =>
      match qc_validate_expr(tp, def_name, l, is_inst) {
        Some(d) => Some(d),
        None => qc_validate_expr(tp, def_name, r, is_inst)
      },
    QcTKIf(c, t, f) =>
      match qc_validate_expr(tp, def_name, c, is_inst) {
        Some(d) => Some(d),
        None => match qc_validate_expr(tp, def_name, t, is_inst) {
          Some(d) => Some(d),
          None => qc_validate_expr(tp, def_name, f, is_inst)
        }
      },
    QcTKCall(_, xs) => qc_validate_list_loop(tp, def_name, xs, is_inst, 0),
    QcTKCallG(_, _, xs) => qc_validate_list_loop(tp, def_name, xs, is_inst, 0),
    QcTKList(xs) => qc_validate_list_loop(tp, def_name, xs, is_inst, 0),
    QcTKVariant(_, xs) => qc_validate_list_loop(tp, def_name, xs, is_inst, 0),
    QcTKSeq(xs) => qc_validate_list_loop(tp, def_name, xs, is_inst, 0),
    QcTKBuiltin(_, xs, _) => qc_validate_list_loop(tp, def_name, xs, is_inst, 0),
    QcTKCallIndirect(f, xs) =>
      match qc_validate_expr(tp, def_name, f, is_inst) {
        Some(d) => Some(d),
        None => qc_validate_list_loop(tp, def_name, xs, is_inst, 0)
      },
    QcTKRecord(fs) => qc_validate_fields_loop(tp, def_name, fs, is_inst, 0),
    QcTKMatch(s, arms) =>
      match qc_validate_expr(tp, def_name, s, is_inst) {
        Some(d) => Some(d),
        None => qc_validate_arms_loop(tp, def_name, arms, is_inst, 0)
      },
    _ => None
  }

fn qc_validate_list_loop(tp: QcTProgram, def_name: Str, xs: List[QcTExpr], is_inst: Bool, idx: Int) -> Option[QcDiag] =
  if idx >= len(xs) then None
  else
    match qc_validate_expr(tp, def_name, list_at(xs, idx), is_inst) {
      Some(d) => Some(d),
      None => qc_validate_list_loop(tp, def_name, xs, is_inst, idx + 1)
    }

fn qc_validate_fields_loop(tp: QcTProgram, def_name: Str, fs: List[QcTField], is_inst: Bool, idx: Int) -> Option[QcDiag] =
  if idx >= len(fs) then None
  else
    match qc_validate_expr(tp, def_name, (list_at(fs, idx)).expr, is_inst) {
      Some(d) => Some(d),
      None => qc_validate_fields_loop(tp, def_name, fs, is_inst, idx + 1)
    }

fn qc_validate_arms_loop(tp: QcTProgram, def_name: Str, arms: List[QcTArm], is_inst: Bool, idx: Int) -> Option[QcDiag] =
  if idx >= len(arms) then None
  else
    let a = list_at(arms, idx) in
    let guard_diag = match a.guard {
      Some(g) => qc_validate_expr(tp, def_name, g, is_inst),
      None => None
    } in
    match guard_diag {
      Some(d) => Some(d),
      None =>
        match qc_validate_expr(tp, def_name, a.body, is_inst) {
          Some(d) => Some(d),
          None => qc_validate_arms_loop(tp, def_name, arms, is_inst, idx + 1)
        }
    }

fn qc_validate_locals_loop(tp: QcTProgram, def_name: Str, locals: List[QcType], idx: Int) -> Option[QcDiag] =
  if idx >= len(locals) then None
  else
    match qc_bad_map_key(tp, list_at(locals, idx), []) {
      Some(k) =>
        Some(qc_diag_hint(
          qc_diag_type_mismatch(def_name, "", "a comparable key type", qc_print_type(k)),
          "map keys cannot contain functions"
        )),
      None => qc_validate_locals_loop(tp, def_name, locals, idx + 1)
    }

fn qc_mono_validate(tp: QcTProgram) -> Option[QcDiag] =
  match qc_validate_fns_loop(tp, tp.fns, 0) {
    Some(d) => Some(d),
    None => qc_validate_tests_loop(tp, tp.tests, 0)
  }

fn qc_validate_fns_loop(tp: QcTProgram, fns: List[QcTFn], idx: Int) -> Option[QcDiag] =
  if idx >= len(fns) then None
  else
    let f = list_at(fns, idx) in
    let is_inst = f.instance != None in
    match qc_validate_locals_loop(tp, f.def.name, f.locals, 0) {
      Some(d) => Some(d),
      None =>
        match qc_validate_list_loop(tp, f.def.name, f.reqs, is_inst, 0) {
          Some(d) => Some(d),
          None => match qc_validate_list_loop(tp, f.def.name, f.enss, is_inst, 0) {
            Some(d) => Some(d),
            None => match qc_validate_expr(tp, f.def.name, f.body, is_inst) {
              Some(d) => Some(d),
              None => qc_validate_fns_loop(tp, fns, idx + 1)
            }
          }
        }
    }

fn qc_validate_tests_loop(tp: QcTProgram, tests: List[QcTTest], idx: Int) -> Option[QcDiag] =
  if idx >= len(tests) then None
  else
    let t = list_at(tests, idx) in
    match qc_validate_locals_loop(tp, t.name, t.locals, 0) {
      Some(d) => Some(d),
      None =>
        match qc_validate_expr(tp, t.name, t.body, false) {
          Some(d) => Some(d),
          None => qc_validate_tests_loop(tp, tests, idx + 1)
        }
    }

fn qc_range_loop[T](xs: List[T], idx: Int, hi: Int, acc: Accum[T]) -> List[T] =
  if idx >= hi || idx >= len(xs) then acc_list(acc)
  else qc_range_loop(xs, idx + 1, hi, AccPush(acc, list_at(xs, idx)))

# Validation of the functions (kind 0) or tests (kind 1) `lo..hi`: one work item of a split check.
fn qc_mono_validate_range(tp: QcTProgram, kind: Int, lo: Int, hi: Int) -> Option[QcDiag] =
  if kind == 0 then qc_validate_fns_loop(tp, qc_range_loop(tp.fns, lo, hi, AccEnd), 0)
  else qc_validate_tests_loop(tp, qc_range_loop(tp.tests, lo, hi, AccEnd), 0)

test qc_mono_test =
  let empty_tp = QcTProgram { types: [], fns: [], tests: [], generics: [] } in
  qc_mono_polymorphic_recursion(empty_tp) == None &&
  qc_mono_validate(empty_tp) == None
# QAL self-hosting type checker (spec §7: qc_check, matching qal-check/src/lib.rs and qal-check/src/infer.rs)

type QcSig = {
  tparams: List[Str],
  eparams: List[Str],
  params: List[QcType],
  ret: QcType,
  effects: List[Str]
}

fn qc_sig_fn_type(s: QcSig) -> QcType =
  QcTFn(s.params, s.ret, s.effects)

type QcFnEntry = {
  name: Str,
  idx: Int,
  sig: QcSig
}

type QcVariantEntry = {
  name: Str,
  enum_name: Str,
  tag: Int,
  fields: List[QcType]
}

type QcGlobals = {
  tp: QcTProgram,
  fns: List[QcFnEntry],
  variants: List[QcVariantEntry],
  type_index: Map[Str, Int],
  # The position in `fns` / `variants` of the first entry of each name: lookups were linear
  # searches, quadratic in the size of the codebase (1520 definitions: most of a define's time).
  fn_index: Map[Str, Int],
  variant_index: Map[Str, Int],
  prelude: Bool
}

fn qc_g_find_fn(g: QcGlobals, name: Str) -> Option[QcFnEntry] =
  match map_get(g.fn_index, name) {
    Some(i) => if i < len(g.fns) then Some(list_at(g.fns, i)) else None,
    None => None
  }

fn qc_g_find_variant(g: QcGlobals, name: Str) -> Option[QcVariantEntry] =
  match map_get(g.variant_index, name) {
    Some(i) => if i < len(g.variants) then Some(list_at(g.variants, i)) else None,
    None => None
  }

# `index` with the names of `vars` from position `from` on that it does not have yet.
fn qc_index_variants(vars: List[QcVariantEntry], from: Int, index: Map[Str, Int]) -> Map[Str, Int] =
  if from >= len(vars) then index
  else
    let n = (list_at(vars, from)).name in
    qc_index_variants(vars, from + 1, if map_has(index, n) then index else map_put(index, n, from))

fn qc_g_type_def(g: QcGlobals, name: Str) -> Option[QcTypeDef] =
  match map_get(g.type_index, name) {
    Some(i) => if i < len(g.tp.types) then Some(list_at(g.tp.types, i)) else None,
    None => None
  }

# Deferred checks
type QcDeferred =
  | QcDefEq(Str, QcType)
  | QcDefConcat(Str, QcType)
  | QcDefExhaust(Str, QcType, List[QcTPat])

type QcScopeEntry = {
  name: Str,
  id: Int
}

type QcCx = {
  g: QcGlobals,
  def: Str,
  effects: List[Str],
  tps: List[Str],
  eps: List[Str],
  frames: List[List[Str]],
  ret: Option[QcType],
  diags: List[QcDiag],
  start: Int,
  sub: QcSubst,
  locals: List[QcType],
  scope: List[QcScopeEntry],
  deferred: List[QcDeferred],
  seq_lets: List[Str]
}

type QcInferRes = {
  cx: QcCx,
  expr: QcTExpr
}

type QcBranchRes = {
  cx: QcCx,
  expr: QcTExpr,
  ty: QcType
}

type QcCxIntRes = { cx: QcCx, id: Int }
type QcCxBoolRes = { cx: QcCx, ok: Bool }
type QcCxExprsRes = { cx: QcCx, exprs: List[QcTExpr] }
type QcCxTypesRes = { cx: QcCx, tys: List[QcType] }
type QcCxTypeRes = { cx: QcCx, ty: QcType }
type QcCxLambdaBindRes = { cx: QcCx, ids: List[Int], tys: List[QcType] }
type QcCxFieldsRes = { cx: QcCx, fields: List[QcTField] }
type QcCxArmsRes = { cx: QcCx, arms: List[QcTArm], rows: List[QcTPat], ty: QcType }
type QcOptExprRes = { cx: QcCx, expr: Option[QcTExpr] }
type QcOptTypeRes = { cx: QcCx, ty: Option[QcType] }
type QcCxPatRes = { cx: QcCx, pat: QcTPat, bound: List[Str] }
type QcCxSubPatsRes = { cx: QcCx, pats: List[QcTPat], bound: List[Str] }
type QcCxPatFieldsRes = { cx: QcCx, fields: List[QcTPField], bound: List[Str] }
type QcCxListRes = { cx: QcCx, items: List[QcTExpr], ty: QcType }
type QcCxFinishOk = { locals: List[QcType], exprs: List[QcTExpr] }
type QcCxFinishRes = { res: Option[QcCxFinishOk], diags: List[QcDiag] }
type QcCxTArmsRes = { cx: QcCx, arms: List[QcTArm] }
type QcDiagTypeRes = { diags: List[QcDiag], ty: QcType }
type QcDiagTypesRes = { diags: List[QcDiag], tys: List[QcType] }
type QcCheckFnRes = { diags: List[QcDiag], tf: Option[QcTFn] }
type QcResLocal = { cx: QcCx, id: Option[Int] }
type QcGlobalsDiagsRes = { g: QcGlobals, diags: List[QcDiag] }
type QcDiagStrsRes = { diags: List[QcDiag], strs: List[Str] }
type QcDiagVariantsRes = { diags: List[QcDiag], vars: List[QcVariantEntry] }
type QcDiagFieldsRes = { diags: List[QcDiag], fields: List[QcFieldType] }
type QcDiagVariantsRes2 = { diags: List[QcDiag], vars: List[QcVariant] }
type QcCheckDefsRes = { diags: List[QcDiag], fns: List[QcTFn], gens: List[QcTFn], tests: List[QcTTest] }
type QcGlobalsFoldAcc = { g: QcGlobals, idx: Int }
type QcZonkBuiltinRes = { cx: QcCx, b: QcBuiltin }
type QcResolvedBodyRes = { diags: List[QcDiag], body: QcTypeBody }

fn qc_cx_new(g: QcGlobals, def_name: Str, effs: List[Str], cur_diags: List[QcDiag]) -> QcCx =
  QcCx {
    g: g,
    def: def_name,
    effects: effs,
    tps: [],
    eps: [],
    frames: [],
    ret: None,
    diags: cur_diags,
    start: len(cur_diags),
    sub: qc_subst_new(),
    locals: [],
    scope: [],
    deferred: [],
    seq_lets: []
  }

# E0201 for `name`: the hint names a sequence `let` whose scope ended, if there is one.
fn qc_cx_unknown_name(cx: QcCx, path: Str, name: Str) -> QcDiag =
  let d = qc_diag_unknown_name(cx.def, path, name) in
  if qc_str_list_contains(cx.seq_lets, name) then
    qc_diag_hint(d, "the `let " ++ name ++ "` in an earlier item of this sequence ends at its `;`; bind it before the sequence: `let " ++ name ++ " = ... in { ...; ... }`")
  else
    qc_diag_hint(d, "not a built-in or stored definition; built-ins are listed in the qal_define description; define it in the same call or check qal_query")

fn qc_cx_bind(cx: QcCx, name: Str, ty: QcType) -> QcCxIntRes =
  let id = len(cx.locals) in
  let next_cx = QcCx {
    g: cx.g,
    def: cx.def,
    effects: cx.effects,
    tps: cx.tps,
    eps: cx.eps,
    frames: cx.frames,
    ret: cx.ret,
    diags: cx.diags,
    start: cx.start,
    sub: cx.sub,
    locals: push(cx.locals, ty),
    scope: push(cx.scope, QcScopeEntry { name: name, id: id }),
    deferred: cx.deferred,
    seq_lets: cx.seq_lets
  } in
  QcCxIntRes { cx: next_cx, id: id }

fn qc_cx_unbind(cx: QcCx) -> QcCx =
  let next_scope = match qc_list_pop(cx.scope) { Some(xs) => xs, None => [] } in
  QcCx {
    g: cx.g,
    def: cx.def,
    effects: cx.effects,
    tps: cx.tps,
    eps: cx.eps,
    frames: cx.frames,
    ret: cx.ret,
    diags: cx.diags,
    start: cx.start,
    sub: cx.sub,
    locals: cx.locals,
    scope: next_scope,
    deferred: cx.deferred,
    seq_lets: cx.seq_lets
  }

fn qc_cx_lookup_loop(scope: List[QcScopeEntry], name: Str, idx: Int) -> Option[Int] =
  if idx < 0 then None
  else
    let e = list_at(scope, idx) in
    if e.name == name then Some(e.id)
    else qc_cx_lookup_loop(scope, name, idx - 1)

fn qc_cx_lookup(cx: QcCx, name: Str) -> Option[Int] =
  qc_cx_lookup_loop(cx.scope, name, len(cx.scope) - 1)

fn qc_cx_has_errors(cx: QcCx) -> Bool =
  len(cx.diags) > cx.start

fn qc_cx_poison(cx: QcCx) -> QcInferRes =
  let fresh_res = qc_subst_fresh(cx.sub) in
  let next_cx = QcCx {
    g: cx.g,
    def: cx.def,
    effects: cx.effects,
    tps: cx.tps,
    eps: cx.eps,
    frames: cx.frames,
    ret: cx.ret,
    diags: cx.diags,
    start: cx.start,
    sub: fresh_res.subst,
    locals: cx.locals,
    scope: cx.scope,
    deferred: cx.deferred,
    seq_lets: cx.seq_lets
  } in
  QcInferRes { cx: next_cx, expr: QcTExpr { ty: fresh_res.ty, kind: QcTKUnit } }

fn qc_cx_mismatch(cx: QcCx, path: Str, expected: QcType, found: QcType) -> QcCx =
  if cx.sub.too_deep then
    let s_reset = QcSubst { vars: cx.sub.vars, depth: cx.sub.depth, size: cx.sub.size, users: cx.sub.users, evars: cx.sub.evars, too_deep: false, too_large: cx.sub.too_large } in
    let d = qc_diag_type_too_deep(cx.def, path, 256) in
    QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: s_reset, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }
  else if cx.sub.too_large then
    let s_reset = QcSubst { vars: cx.sub.vars, depth: cx.sub.depth, size: cx.sub.size, users: cx.sub.users, evars: cx.sub.evars, too_deep: cx.sub.too_deep, too_large: false } in
    let d = qc_diag_type_too_large(cx.def, path, 4096) in
    QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: s_reset, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }
  else
    let e_fin = qc_subst_finish(cx.sub, expected) in
    let f_fin = qc_subst_finish(cx.sub, found) in
    let exp_s = qc_print_type(e_fin) in
    let fnd_s = qc_print_type(f_fin) in
    let d0 = qc_diag_type_mismatch(cx.def, path, exp_s, fnd_s) in
    let d = match e_fin {
      QcTBool => match f_fin { QcTInt => qc_diag_hint(d0, "compare explicitly, e.g. `x != 0`"), _ => d0 },
      QcTOption(x) => if x == f_fin then qc_diag_hint(d0, "wrap the value: `Some(...)`") else d0,
      QcTFloat => match f_fin { QcTInt => qc_diag_hint(d0, "convert with `int_to_float(n)`"), _ => d0 },
      QcTInt => match f_fin { QcTFloat => qc_diag_hint(d0, "convert with `float_to_int(x)` (returns Option[Int])"), _ => d0 },
      QcTStr => match f_fin { QcTInt => qc_diag_hint(d0, "convert with `from_int(n)`"), _ => d0 },
      _ => match f_fin {
        QcTOption(y) => if e_fin == y then qc_diag_hint(d0, "unpack the Option with `match v { Some(x) => ..., None => ... }`") else d0,
        QcTResult(y, _) => if e_fin == y then qc_diag_hint(d0, "unpack the Result with `match v { Ok(x) => ..., Err(e) => ... }`") else d0,
        _ => d0
      }
    } in
    QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }

fn qc_cx_unify_at(cx: QcCx, path: Str, expected: QcType, found: QcType) -> QcCxBoolRes =
  let un_res = qc_subst_unify(cx.sub, expected, found) in
  let next_cx = QcCx {
    g: cx.g,
    def: cx.def,
    effects: cx.effects,
    tps: cx.tps,
    eps: cx.eps,
    frames: cx.frames,
    ret: cx.ret,
    diags: cx.diags,
    start: cx.start,
    sub: un_res.subst,
    locals: cx.locals,
    scope: cx.scope,
    deferred: cx.deferred,
    seq_lets: cx.seq_lets
  } in
  if un_res.ok then QcCxBoolRes { cx: next_cx, ok: true }
  else QcCxBoolRes { cx: qc_cx_mismatch(next_cx, path, expected, found), ok: false }

fn qc_cx_expect(cx: QcCx, e: QcExpr, want: QcType, path: Str) -> QcInferRes =
  let infer_res = match e {
    QcELambda(params, body) => qc_cx_lambda_against(cx, params, body, want, path),
    _ => qc_cx_infer(cx, e, path)
  } in
  let un_res = qc_cx_unify_at(infer_res.cx, path, want, infer_res.expr.ty) in
  QcInferRes { cx: un_res.cx, expr: infer_res.expr }

fn qc_cx_branch(cx: QcCx, e: QcExpr, acc: QcType, path: Str) -> QcBranchRes =
  let infer_res = match e {
    QcELambda(params, body) => qc_cx_lambda_against(cx, params, body, acc, path),
    _ => qc_cx_infer(cx, e, path)
  } in
  let cur_cx = infer_res.cx in
  let t = infer_res.expr in
  if !qc_subst_has_join_fn(cur_cx.sub, acc) && !qc_subst_has_join_fn(cur_cx.sub, t.ty) then
    let un_res = qc_cx_unify_at(cur_cx, path, acc, t.ty) in
    QcBranchRes { cx: un_res.cx, expr: t, ty: acc }
  else
    let join_res = qc_subst_join(cur_cx.sub, acc, t.ty, true) in
    let sub_after_join = join_res.subst in
    let opt_j = join_res.res in
    let limits = sub_after_join.too_deep || sub_after_join.too_large in
    match opt_j {
      Some(j) =>
        let un1 = qc_subst_unify(sub_after_join, j, acc) in
        let un2 = if un1.ok then qc_subst_unify(un1.subst, j, t.ty) else un1 in
        if !limits && un2.ok then
          let wrap_res = qc_cx_wrap_at(QcCx { g: cur_cx.g, def: cur_cx.def, effects: cur_cx.effects, tps: cur_cx.tps, eps: cur_cx.eps, frames: cur_cx.frames, ret: cur_cx.ret, diags: cur_cx.diags, start: cur_cx.start, sub: un2.subst, locals: cur_cx.locals, scope: cur_cx.scope, deferred: cur_cx.deferred, seq_lets: cur_cx.seq_lets }, path, j) in
          QcBranchRes { cx: wrap_res.cx, expr: t, ty: wrap_res.ty }
        else
          let un_fallback = qc_subst_unify(cur_cx.sub, acc, t.ty) in
          let cx_fb = QcCx { g: cur_cx.g, def: cur_cx.def, effects: cur_cx.effects, tps: cur_cx.tps, eps: cur_cx.eps, frames: cur_cx.frames, ret: cur_cx.ret, diags: cur_cx.diags, start: cur_cx.start, sub: un_fallback.subst, locals: cur_cx.locals, scope: cur_cx.scope, deferred: cur_cx.deferred, seq_lets: cur_cx.seq_lets } in
          if limits || !un_fallback.ok || cx_fb.sub.too_deep || cx_fb.sub.too_large then
            QcBranchRes { cx: qc_cx_mismatch(cx_fb, path, acc, t.ty), expr: t, ty: acc }
          else
            QcBranchRes { cx: cx_fb, expr: t, ty: acc },
      None =>
        let un_fallback = qc_subst_unify(cur_cx.sub, acc, t.ty) in
        let cx_fb = QcCx { g: cur_cx.g, def: cur_cx.def, effects: cur_cx.effects, tps: cur_cx.tps, eps: cur_cx.eps, frames: cur_cx.frames, ret: cur_cx.ret, diags: cur_cx.diags, start: cur_cx.start, sub: un_fallback.subst, locals: cur_cx.locals, scope: cur_cx.scope, deferred: cur_cx.deferred, seq_lets: cur_cx.seq_lets } in
        if limits || !un_fallback.ok || cx_fb.sub.too_deep || cx_fb.sub.too_large then
          QcBranchRes { cx: qc_cx_mismatch(cx_fb, path, acc, t.ty), expr: t, ty: acc }
        else
          QcBranchRes { cx: cx_fb, expr: t, ty: acc }
    }

fn qc_cx_wrap_at(cx: QcCx, path: Str, t: QcType) -> QcCxTypeRes =
  let fresh_res = qc_subst_fresh(cx.sub) in
  let v = fresh_res.ty in
  let un_res = qc_subst_unify(fresh_res.subst, v, t) in
  let next_cx = QcCx {
    g: cx.g,
    def: cx.def,
    effects: cx.effects,
    tps: cx.tps,
    eps: cx.eps,
    frames: cx.frames,
    ret: cx.ret,
    diags: cx.diags,
    start: cx.start,
    sub: un_res.subst,
    locals: cx.locals,
    scope: cx.scope,
    deferred: cx.deferred,
    seq_lets: cx.seq_lets
  } in
  if !un_res.ok then
    QcCxTypeRes { cx: qc_cx_mismatch(next_cx, path, v, t), ty: v }
  else
    QcCxTypeRes { cx: next_cx, ty: v }

fn qc_cx_lambda_against(cx: QcCx, params: List[QcLambdaParam], body: QcExpr, want: QcType, path: Str) -> QcInferRes =
  match qc_subst_resolve(cx.sub, want) {
    QcTFn(ps, _, _) if len(ps) == len(params) => qc_cx_lambda(cx, params, body, path, Some(ps)),
    _ => qc_cx_lambda(cx, params, body, path, None)
  }

fn qc_cx_effect_check(cx0: QcCx, path: Str, callee: Str, needed: List[Str]) -> QcCx =
  if len(cx0.frames) > 0 then
    let cur_frame = list_at(cx0.frames, len(cx0.frames) - 1) in
    let next_frame = qc_sort_dedup_strs(cur_frame ++ needed) in
    let next_frames = qc_list_set(cx0.frames, len(cx0.frames) - 1, next_frame) in
    QcCx { g: cx0.g, def: cx0.def, effects: cx0.effects, tps: cx0.tps, eps: cx0.eps, frames: next_frames, ret: cx0.ret, diags: cx0.diags, start: cx0.start, sub: cx0.sub, locals: cx0.locals, scope: cx0.scope, deferred: cx0.deferred, seq_lets: cx0.seq_lets }
  else
    # A top-level call settles its effect variables: what the arguments carry is what the call
    # needs, and nothing may grow it afterwards.
    let resolved = qc_subst_resolve_effects(cx0.sub, needed) in
    let cx = QcCx { g: cx0.g, def: cx0.def, effects: cx0.effects, tps: cx0.tps, eps: cx0.eps, frames: cx0.frames, ret: cx0.ret, diags: cx0.diags, start: cx0.start, sub: qc_subst_freeze_effects(cx0.sub, needed), locals: cx0.locals, scope: cx0.scope, deferred: cx0.deferred, seq_lets: cx0.seq_lets } in
    let missing = filter(resolved.names, fn(e: Str) => !qc_contains_str_loop(cx.effects, e, 0)) in
    if len(missing) == 0 then cx
    else
      let d0 = qc_diag_effect_violation(cx.def, path, callee, missing) in
      let d = match cx.ret {
        Some(QcTFn(_, _, _)) =>
          let effs = join(map(cx.effects ++ missing, fn(e: Str) => " !" ++ e), "") in
          QcDiag {
            code: d0.code,
            kind: d0.kind,
            def: d0.def,
            path: d0.path,
            message: d0.message,
            expected: d0.expected,
            found: d0.found,
            hints: ["add `!" ++ join(missing, " !") ++ "` to the signature of `" ++ cx.def ++ "`: `-> (" ++ qc_print_type(match cx.ret { Some(t) => t, None => QcTUnit }) ++ ")" ++ effs ++ "`"],
            dependents: d0.dependents,
            counterexample: d0.counterexample
          },
        _ => d0
      } in
      QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }

fn qc_cx_infer_all_loop(cx: QcCx, args: List[QcExpr], path: Str, idx: Int, acc: Accum[QcTExpr]) -> QcCxExprsRes =
  if idx >= len(args) then QcCxExprsRes { cx: cx, exprs: acc_list(acc) }
  else
    let res = qc_cx_infer(cx, list_at(args, idx), path ++ ".args[" ++ from_int(idx) ++ "]") in
    qc_cx_infer_all_loop(res.cx, args, path, idx + 1, AccPush(acc, res.expr))

fn qc_cx_args(cx: QcCx, callee: Str, args: List[QcExpr], params: List[QcType], path: Str) -> QcCxExprsRes =
  if len(args) != len(params) then
    let d = qc_diag_arity(cx.def, path, callee, len(params), len(args)) in
    let cx_with_d = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
    qc_cx_infer_all_loop(cx_with_d, args, path, 0, AccEnd)
  else
    qc_cx_args_loop(cx, args, params, path, 0, AccEnd)

fn qc_cx_args_loop(cx: QcCx, args: List[QcExpr], params: List[QcType], path: Str, idx: Int, acc: Accum[QcTExpr]) -> QcCxExprsRes =
  if idx >= len(args) then QcCxExprsRes { cx: cx, exprs: acc_list(acc) }
  else
    let ap = path ++ ".args[" ++ from_int(idx) ++ "]" in
    let res = qc_cx_expect(cx, list_at(args, idx), list_at(params, idx), ap) in
    qc_cx_args_loop(res.cx, args, params, path, idx + 1, AccPush(acc, res.expr))

type QcInstSigRes = {
  cx: QcCx,
  targs: List[QcType],
  params: List[QcType],
  ret: QcType,
  effects: List[Str]
}

type QcCxNamesRes = { cx: QcCx, names: List[Str] }

# Fresh type arguments for a generic signature; an effect parameter becomes a fresh effect
# variable in the parameters, the result and the effects of the call.
fn qc_cx_instantiate(cx: QcCx, sig: QcSig) -> QcInstSigRes =
  let targs_res = qc_cx_fresh_targs_loop(cx, len(sig.tparams), AccEnd) in
  let evars_res = qc_cx_fresh_evars_loop(targs_res.cx, len(sig.eparams), AccEnd) in
  let params_res = qc_cx_wrap_types_loop(evars_res.cx, sig.params, sig.tparams, targs_res.tys, sig.eparams, evars_res.names, 0, AccEnd) in
  let ret_t = qc_type_map_effects(qc_type_instantiate(sig.ret, sig.tparams, targs_res.tys), sig.eparams, evars_res.names) in
  let wrap_ret = qc_cx_wrap_type(params_res.cx, ret_t) in
  QcInstSigRes { cx: wrap_ret.cx, targs: targs_res.tys, params: params_res.tys, ret: wrap_ret.ty, effects: qc_rename_effects(sig.effects, sig.eparams, evars_res.names) }

fn qc_cx_fresh_evars_loop(cx: QcCx, count: Int, acc: Accum[Str]) -> QcCxNamesRes =
  if count <= 0 then QcCxNamesRes { cx: cx, names: acc_list(acc) }
  else
    let fresh_res = qc_subst_fresh_effect(cx.sub) in
    let next_cx = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: cx.diags, start: cx.start, sub: fresh_res.subst, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
    qc_cx_fresh_evars_loop(next_cx, count - 1, AccPush(acc, fresh_res.name))

fn qc_cx_fresh_targs_loop(cx: QcCx, count: Int, acc: Accum[QcType]) -> QcCxTypesRes =
  if count <= 0 then QcCxTypesRes { cx: cx, tys: acc_list(acc) }
  else
    let fresh_res = qc_subst_fresh(cx.sub) in
    let next_cx = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: cx.diags, start: cx.start, sub: fresh_res.subst, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
    qc_cx_fresh_targs_loop(next_cx, count - 1, AccPush(acc, fresh_res.ty))

fn qc_cx_wrap_type(cx: QcCx, t: QcType) -> QcCxTypeRes =
  let fresh_res = qc_subst_fresh(cx.sub) in
  let un_res = qc_subst_unify(fresh_res.subst, fresh_res.ty, t) in
  let next_cx = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: cx.diags, start: cx.start, sub: un_res.subst, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
  QcCxTypeRes { cx: next_cx, ty: fresh_res.ty }

fn qc_cx_wrap_types_loop(cx: QcCx, params: List[QcType], tparams: List[Str], targs: List[QcType], eparams: List[Str], evars: List[Str], idx: Int, acc: Accum[QcType]) -> QcCxTypesRes =
  if idx >= len(params) then QcCxTypesRes { cx: cx, tys: acc_list(acc) }
  else
    let sub_p = qc_type_map_effects(qc_type_instantiate(list_at(params, idx), tparams, targs), eparams, evars) in
    let wrap_res = qc_cx_wrap_type(cx, sub_p) in
    qc_cx_wrap_types_loop(wrap_res.cx, params, tparams, targs, eparams, evars, idx + 1, AccPush(acc, wrap_res.ty))

type QcFreshDeclRes = {
  cx: QcCx,
  ty: QcType,
  body: QcTypeBody
}

fn qc_cx_fresh_decl(cx: QcCx, name: Str) -> Option[QcFreshDeclRes] =
  match qc_g_type_def(cx.g, name) {
    None => None,
    Some(d) =>
      if len(d.params) == 0 then
        Some(QcFreshDeclRes { cx: cx, ty: QcTNamed(name), body: d.body })
      else
        let targs_res = qc_cx_fresh_targs_loop(cx, len(d.params), AccEnd) in
        let ty = QcTApp(name, targs_res.tys) in
        match qc_tp_decl(targs_res.cx.g.tp, ty) {
          None => None,
          Some(b) =>
            let wrap_res = qc_cx_wrap_type(targs_res.cx, ty) in
            Some(QcFreshDeclRes { cx: wrap_res.cx, ty: wrap_res.ty, body: b })
        }
  }

type QcVariantLookup = {
  cx: QcCx,
  ty: QcType,
  tag: Int,
  fields: List[QcType]
}

fn qc_cx_variant(cx: QcCx, name: Str) -> Option[QcVariantLookup] =
  let a_res = qc_subst_fresh(cx.sub) in
  let b_res = qc_subst_fresh(a_res.subst) in
  let cx_ab = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: cx.diags, start: cx.start, sub: b_res.subst, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
  let a = a_res.ty in
  let b = b_res.ty in
  if name == "None" then
    let w = qc_cx_wrap_type(cx_ab, QcTOption(a)) in
    Some(QcVariantLookup { cx: w.cx, ty: w.ty, tag: 0, fields: [] })
  else if name == "Some" then
    let w = qc_cx_wrap_type(cx_ab, QcTOption(a)) in
    Some(QcVariantLookup { cx: w.cx, ty: w.ty, tag: 1, fields: [a] })
  else if name == "Ok" then
    let w = qc_cx_wrap_type(cx_ab, QcTResult(a, b)) in
    Some(QcVariantLookup { cx: w.cx, ty: w.ty, tag: 0, fields: [a] })
  else if name == "Err" then
    let w = qc_cx_wrap_type(cx_ab, QcTResult(a, b)) in
    Some(QcVariantLookup { cx: w.cx, ty: w.ty, tag: 1, fields: [b] })
  else
    match qc_g_find_variant(cx.g, name) {
      None => None,
      Some(ventry) =>
        match qc_cx_fresh_decl(cx, ventry.enum_name) {
          None => None,
          Some(fres) =>
            match fres.body {
              QcBodyEnum(vs) =>
                if ventry.tag < len(vs) then
                  Some(QcVariantLookup { cx: fres.cx, ty: fres.ty, tag: ventry.tag, fields: (list_at(vs, ventry.tag)).fields })
                else None,
              _ => None
            }
        }
    }

fn qc_cx_var(cx: QcCx, v: Str, path: Str) -> QcInferRes =
  match qc_cx_lookup(cx, v) {
    Some(id) =>
      let ty = if id < len(cx.locals) then list_at(cx.locals, id) else QcTUnit in
      QcInferRes { cx: cx, expr: QcTExpr { ty: ty, kind: QcTKLocal(id) } },
    None =>
      match qc_g_find_fn(cx.g, v) {
        Some(fentry) =>
          if len(fentry.sig.tparams) == 0 && len(fentry.sig.eparams) == 0 then
            QcInferRes { cx: cx, expr: QcTExpr { ty: qc_sig_fn_type(fentry.sig), kind: QcTKFnRef(fentry.idx) } }
          else
            let inst = qc_cx_instantiate(cx, fentry.sig) in
            let wrap_fn = qc_cx_wrap_type(inst.cx, QcTFn(inst.params, inst.ret, inst.effects)) in
            # Effect parameters alone make no instances: the function stays monomorphic.
            let kind = if len(fentry.sig.tparams) == 0 then QcTKFnRef(fentry.idx) else QcTKFnRefG(fentry.idx, inst.targs) in
            QcInferRes { cx: wrap_fn.cx, expr: QcTExpr { ty: wrap_fn.ty, kind: kind } },
        None =>
          match qc_cx_variant(cx, v) {
            Some(vlookup) =>
              if len(vlookup.fields) != 0 then
                let d = qc_diag_arity(cx.def, path, v, len(vlookup.fields), 0) in
                let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
                qc_cx_poison(cx_err)
              else
                QcInferRes { cx: vlookup.cx, expr: QcTExpr { ty: vlookup.ty, kind: QcTKVariant(vlookup.tag, []) } },
            None =>
              let d0 = qc_diag_unknown_name(cx.def, path, v) in
              let d = if qc_builtin_is_name(v) then
                let ar = match qc_builtin_arity(v) { Some(n) => n, None => 1 } in
                let ps_str = join(map(qc_repeat_param_names_loop(ar, AccEnd), fn(s: Str) => s), ", ") in
                let hint_str = if v == "db_exec" || v == "db_query" then
                  "built-in `" ++ v ++ "` cannot be used as a value; call it directly with the SQL literal, also inside a closure: `fn(id) => " ++ v ++ "(\"SELECT ... WHERE id = ?\", [SqlInt(id)])`"
                else
                  "built-in `" ++ v ++ "` cannot be used as a value; wrap it in a closure: `fn(" ++ ps_str ++ ") => " ++ v ++ "(" ++ ps_str ++ ")`" in
                QcDiag {
                  code: d0.code,
                  kind: d0.kind,
                  def: d0.def,
                  path: d0.path,
                  message: "built-in `" ++ v ++ "` is not a value",
                  expected: d0.expected,
                  found: d0.found,
                  hints: [hint_str],
                  dependents: d0.dependents,
                  counterexample: d0.counterexample
                }
              else
                qc_cx_unknown_name(cx, path, v) in
              let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
              qc_cx_poison(cx_err)
          }
      }
  }

fn qc_repeat_param_names_loop(count: Int, acc: Accum[Str]) -> List[Str] =
  let names = ["x", "y", "z", "w"] in
  let idx = len(acc_list(acc)) in
  if idx >= count then acc_list(acc)
  else
    let n = if idx < len(names) then list_at(names, idx) else "p" ++ from_int(idx) in
    qc_repeat_param_names_loop(count, AccPush(acc, n))

fn qc_cx_numeric(cx: QcCx, path: Str, t: QcType) -> QcCxTypeRes =
  match qc_subst_resolve(cx.sub, t) {
    QcTInt => QcCxTypeRes { cx: cx, ty: QcTInt },
    QcTFloat => QcCxTypeRes { cx: cx, ty: QcTFloat },
    QcTVar(_) =>
      let un_res = qc_subst_unify(cx.sub, QcTInt, t) in
      let next_cx = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: cx.diags, start: cx.start, sub: un_res.subst, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
      QcCxTypeRes { cx: next_cx, ty: QcTInt },
    other =>
      let d = qc_diag_type_mismatch(cx.def, path, "Int or Float", qc_print_type(qc_subst_finish(cx.sub, other))) in
      let fresh_res = qc_subst_fresh(cx.sub) in
      let next_cx = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: fresh_res.subst, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
      QcCxTypeRes { cx: next_cx, ty: fresh_res.ty }
  }

fn qc_cx_ordered(cx: QcCx, path: Str, t: QcType) -> QcCxTypeRes =
  match qc_subst_resolve(cx.sub, t) {
    QcTStr => QcCxTypeRes { cx: cx, ty: QcTStr },
    QcTInt => QcCxTypeRes { cx: cx, ty: QcTInt },
    QcTFloat => QcCxTypeRes { cx: cx, ty: QcTFloat },
    QcTVar(_) => qc_cx_numeric(cx, path, t),
    other =>
      let d = qc_diag_type_mismatch(cx.def, path, "Int, Float or Str", qc_print_type(qc_subst_finish(cx.sub, other))) in
      let fresh_res = qc_subst_fresh(cx.sub) in
      let next_cx = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: fresh_res.subst, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
      QcCxTypeRes { cx: next_cx, ty: fresh_res.ty }
  }

fn qc_cx_binary(cx: QcCx, op: QcBinOp, l: QcExpr, r: QcExpr, path: Str) -> QcInferRes =
  let lp = path ++ ".left" in
  let rp = path ++ ".right" in
  if op == QcOpAnd || op == QcOpOr then
    let l_res = qc_cx_expect(cx, l, QcTBool, lp) in
    let r_res = qc_cx_expect(l_res.cx, r, QcTBool, rp) in
    QcInferRes { cx: r_res.cx, expr: QcTExpr { ty: QcTBool, kind: QcTKBin(op, l_res.expr, r_res.expr, path) } }
  else if op == QcOpRem then
    let l_res = qc_cx_expect(cx, l, QcTInt, lp) in
    let r_res = qc_cx_expect(l_res.cx, r, QcTInt, rp) in
    QcInferRes { cx: r_res.cx, expr: QcTExpr { ty: QcTInt, kind: QcTKBin(op, l_res.expr, r_res.expr, path) } }
  else if op == QcOpAdd || op == QcOpSub || op == QcOpMul || op == QcOpDiv || qc_binop_is_comparison(op) && op != QcOpEq && op != QcOpNe then
    let l_res = qc_cx_infer(cx, l, lp) in
    let r_res = qc_cx_infer(l_res.cx, r, rp) in
    let l_unknown = match qc_subst_resolve(r_res.cx.sub, l_res.expr.ty) { QcTVar(_) => true, _ => false } in
    let r_unknown = match qc_subst_resolve(r_res.cx.sub, r_res.expr.ty) { QcTVar(_) => true, _ => false } in
    let is_comp = qc_binop_is_comparison(op) in
    let num_ord_res =
      if !is_comp then qc_cx_numeric(r_res.cx, lp, l_res.expr.ty)
      else if l_unknown && !r_unknown then
        let ord_res = qc_cx_ordered(r_res.cx, rp, r_res.expr.ty) in
        let un_res = qc_cx_unify_at(ord_res.cx, lp, ord_res.ty, l_res.expr.ty) in
        QcCxTypeRes { cx: un_res.cx, ty: ord_res.ty }
      else
        qc_cx_ordered(r_res.cx, lp, l_res.expr.ty) in
    let un_r = qc_cx_unify_at(num_ord_res.cx, rp, num_ord_res.ty, r_res.expr.ty) in
    let res_ty = if is_comp then QcTBool else num_ord_res.ty in
    QcInferRes { cx: un_r.cx, expr: QcTExpr { ty: res_ty, kind: QcTKBin(op, l_res.expr, r_res.expr, path) } }
  else if op == QcOpEq || op == QcOpNe then
    let l_res = qc_cx_infer(cx, l, lp) in
    let r_res = qc_cx_expect(l_res.cx, r, l_res.expr.ty, rp) in
    let next_def = push(r_res.cx.deferred, QcDefEq(path, l_res.expr.ty)) in
    let cx_def = QcCx { g: r_res.cx.g, def: r_res.cx.def, effects: r_res.cx.effects, tps: r_res.cx.tps, eps: r_res.cx.eps, frames: r_res.cx.frames, ret: r_res.cx.ret, diags: r_res.cx.diags, start: r_res.cx.start, sub: r_res.cx.sub, locals: r_res.cx.locals, scope: r_res.cx.scope, deferred: next_def, seq_lets: r_res.cx.seq_lets } in
    QcInferRes { cx: cx_def, expr: QcTExpr { ty: QcTBool, kind: QcTKBin(op, l_res.expr, r_res.expr, path) } }
  else if op == QcOpConcat then
    let l_res = qc_cx_infer(cx, l, lp) in
    let r_res = qc_cx_expect(l_res.cx, r, l_res.expr.ty, rp) in
    let next_def = push(r_res.cx.deferred, QcDefConcat(lp, l_res.expr.ty)) in
    let cx_def = QcCx { g: r_res.cx.g, def: r_res.cx.def, effects: r_res.cx.effects, tps: r_res.cx.tps, eps: r_res.cx.eps, frames: r_res.cx.frames, ret: r_res.cx.ret, diags: r_res.cx.diags, start: r_res.cx.start, sub: r_res.cx.sub, locals: r_res.cx.locals, scope: r_res.cx.scope, deferred: next_def, seq_lets: r_res.cx.seq_lets } in
    QcInferRes { cx: cx_def, expr: QcTExpr { ty: l_res.expr.ty, kind: QcTKBin(op, l_res.expr, r_res.expr, path) } }
  else
    qc_cx_poison(cx)

fn qc_cx_lambda(cx: QcCx, params: List[QcLambdaParam], body: QcExpr, path: Str, expected: Option[List[QcType]]) -> QcInferRes =
  let depth = len(cx.scope) in
  let bind_res = qc_cx_bind_lambda_params_loop(cx, params, path, expected, 0, AccEnd, AccEnd) in
  let cx1 = bind_res.cx in
  let ids = bind_res.ids in
  let ptys = bind_res.tys in
  let cx2 = QcCx {
    g: cx1.g,
    def: cx1.def,
    effects: cx1.effects,
    tps: cx1.tps,
    eps: cx1.eps,
    frames: push(cx1.frames, []),
    ret: None,
    diags: cx1.diags,
    start: cx1.start,
    sub: cx1.sub,
    locals: cx1.locals,
    scope: cx1.scope,
    deferred: cx1.deferred,
    seq_lets: cx1.seq_lets
  } in
  let body_res = qc_cx_infer(cx2, body, path ++ ".body") in
  let cur_cx = body_res.cx in
  let effs = match qc_list_pop(cur_cx.frames) {
    Some(rest) => if len(cur_cx.frames) > 0 then list_at(cur_cx.frames, len(cur_cx.frames) - 1) else [],
    None => []
  } in
  let rest_frames = match qc_list_pop(cur_cx.frames) { Some(fms) => fms, None => [] } in
  let scope_truncated = match qc_list_slice(cur_cx.scope, 0, depth) { Some(sc) => sc, None => [] } in
  let fn_ty = QcTFn(ptys, body_res.expr.ty, effs) in
  let wrap_res = qc_cx_wrap_type(QcCx {
    g: cur_cx.g,
    def: cur_cx.def,
    effects: cur_cx.effects,
    tps: cur_cx.tps,
    eps: cur_cx.eps,
    frames: rest_frames,
    ret: cx.ret,
    diags: cur_cx.diags,
    start: cur_cx.start,
    sub: cur_cx.sub,
    locals: cur_cx.locals,
    scope: scope_truncated,
    deferred: cur_cx.deferred,
    seq_lets: cur_cx.seq_lets
  }, fn_ty) in
  let lambda_kind = QcTKLambda(QcTLambda {
    params: ids,
    captures: [],
    body: body_res.expr
  }) in
  QcInferRes { cx: wrap_res.cx, expr: QcTExpr { ty: wrap_res.ty, kind: lambda_kind } }

type QcBindParamsRes = {
  cx: QcCx,
  ids: List[Int],
  ptys: List[QcType]
}

fn qc_cx_bind_lambda_params_loop(cx: QcCx, params: List[QcLambdaParam], path: Str, expected: Option[List[QcType]], idx: Int, acc_ids: Accum[Int], acc_ptys: Accum[QcType]) -> QcCxLambdaBindRes =
  if idx >= len(params) then QcCxLambdaBindRes { cx: cx, ids: acc_list(acc_ids), tys: acc_list(acc_ptys) }
  else
    let p = list_at(params, idx) in
    let pp = path ++ ".params[" ++ from_int(idx) ++ "]" in
    let is_dup = fold(match qc_list_slice(params, 0, idx) { Some(xs) => xs, None => [] }, false, fn(acc: Bool, prev: QcLambdaParam) => acc || prev.name == p.name) in
    let cx_dup = if is_dup then
      let d = qc_diag_duplicate_name(cx.def, pp, p.name) in
      QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }
    else cx in
    let param_res = match p.ty {
      Some(ann) =>
        let opt_t = qc_resolve_type(cx_dup.g, ann, cx_dup.tps, cx_dup.eps, cx_dup.def, pp, cx_dup.diags) in
        let next_cx = QcCx { g: cx_dup.g, def: cx_dup.def, effects: cx_dup.effects, tps: cx_dup.tps, eps: cx_dup.eps, frames: cx_dup.frames, ret: cx_dup.ret, diags: opt_t.diags, start: cx_dup.start, sub: cx_dup.sub, locals: cx_dup.locals, scope: cx_dup.scope, deferred: cx_dup.deferred, seq_lets: cx_dup.seq_lets } in
        QcCxTypeRes { cx: next_cx, ty: match opt_t.ty { Some(t) => t, None => QcTUnit } },
      None =>
        match expected {
          Some(ps) =>
            if idx < len(ps) then QcCxTypeRes { cx: cx_dup, ty: list_at(ps, idx) }
            else
              let f_res = qc_subst_fresh(cx_dup.sub) in
              let next_cx = QcCx { g: cx_dup.g, def: cx_dup.def, effects: cx_dup.effects, tps: cx_dup.tps, eps: cx_dup.eps, frames: cx_dup.frames, ret: cx_dup.ret, diags: cx_dup.diags, start: cx_dup.start, sub: f_res.subst, locals: cx_dup.locals, scope: cx_dup.scope, deferred: cx_dup.deferred, seq_lets: cx_dup.seq_lets } in
              QcCxTypeRes { cx: next_cx, ty: f_res.ty },
          None =>
            let f_res = qc_subst_fresh(cx_dup.sub) in
            let next_cx = QcCx { g: cx_dup.g, def: cx_dup.def, effects: cx_dup.effects, tps: cx_dup.tps, eps: cx_dup.eps, frames: cx_dup.frames, ret: cx_dup.ret, diags: cx_dup.diags, start: cx_dup.start, sub: f_res.subst, locals: cx_dup.locals, scope: cx_dup.scope, deferred: cx_dup.deferred, seq_lets: cx_dup.seq_lets } in
            QcCxTypeRes { cx: next_cx, ty: f_res.ty }
        }
    } in
    let bound_res = qc_cx_bind(param_res.cx, p.name, param_res.ty) in
    qc_cx_bind_lambda_params_loop(bound_res.cx, params, path, expected, idx + 1, AccPush(acc_ids, bound_res.id), AccPush(acc_ptys, param_res.ty))

fn qc_cx_call(cx: QcCx, name: Str, args: List[QcExpr], path: Str) -> QcInferRes =
  match qc_cx_lookup(cx, name) {
    Some(id) =>
      let callee_ty = if id < len(cx.locals) then list_at(cx.locals, id) else QcTUnit in
      let callee_expr = QcTExpr { ty: callee_ty, kind: QcTKLocal(id) } in
      match qc_subst_resolve(cx.sub, callee_ty) {
        QcTFn(params, ret, effs) =>
          let args_res = qc_cx_args(cx, name, args, params, path) in
          let cx_eff = qc_cx_effect_check(args_res.cx, path, name, effs) in
          QcInferRes { cx: cx_eff, expr: QcTExpr { ty: ret, kind: QcTKCallIndirect(callee_expr, args_res.exprs) } },
        _ =>
          let found_s = qc_print_type(qc_subst_finish(cx.sub, callee_ty)) in
          let d = qc_diag_hint(qc_diag_type_mismatch(cx.def, path, "a function", found_s), "`" ++ name ++ "` is a local value of type " ++ found_s) in
          let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
          let all_res = qc_cx_infer_all_loop(cx_err, args, path, 0, AccEnd) in
          qc_cx_poison(all_res.cx)
      },
    None =>
      match qc_g_find_fn(cx.g, name) {
        Some(fentry) =>
          if len(fentry.sig.tparams) > 0 || len(fentry.sig.eparams) > 0 then
            let inst = qc_cx_instantiate(cx, fentry.sig) in
            let args_res = qc_cx_args(inst.cx, name, args, inst.params, path) in
            # The arguments have bound the effect variable; the call needs its effects.
            let cx_eff = qc_cx_effect_check(args_res.cx, path, name, inst.effects) in
            let kind = if len(fentry.sig.tparams) == 0 then QcTKCall(fentry.idx, args_res.exprs) else QcTKCallG(fentry.idx, inst.targs, args_res.exprs) in
            QcInferRes { cx: cx_eff, expr: QcTExpr { ty: inst.ret, kind: kind } }
          else
            let args_res = qc_cx_args(cx, name, args, fentry.sig.params, path) in
            let cx_eff = qc_cx_effect_check(args_res.cx, path, name, fentry.sig.effects) in
            QcInferRes { cx: cx_eff, expr: QcTExpr { ty: fentry.sig.ret, kind: QcTKCall(fentry.idx, args_res.exprs) } },
        None =>
          match qc_cx_variant(cx, name) {
            Some(vlookup) =>
              let args_res = qc_cx_args(vlookup.cx, name, args, vlookup.fields, path) in
              QcInferRes { cx: args_res.cx, expr: QcTExpr { ty: vlookup.ty, kind: QcTKVariant(vlookup.tag, args_res.exprs) } },
            None =>
              match qc_cx_builtin(cx, name, args, path) {
                Some(res) => res,
                None =>
                  let d = qc_cx_unknown_name(cx, path, name) in
                  let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
                  let all_res = qc_cx_infer_all_loop(cx_err, args, path, 0, AccEnd) in
                  qc_cx_poison(all_res.cx)
              }
          }
      }
  }

fn qc_cx_builtin(cx: QcCx, name: Str, args: List[QcExpr], path: Str) -> Option[QcInferRes] =
  if name == "len" then Some(qc_cx_len(cx, args, path))
  else
    let a_res = qc_subst_fresh(cx.sub) in
    let b_res = qc_subst_fresh(a_res.subst) in
    let cx_ab = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: cx.diags, start: cx.start, sub: b_res.subst, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
    match qc_builtin_signature(name, a_res.ty, b_res.ty) {
      None => None,
      Some(bsig) =>
        if !cx.g.prelude && qc_builtin_needs_prelude(bsig.builtin) then
          let d = qc_diag_prelude_shadowed(cx.def, path, name) in
          let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
          let all_res = qc_cx_infer_all_loop(cx_err, args, path, 0, AccEnd) in
          Some(qc_cx_poison(all_res.cx))
        else
          let wrap_ret = qc_cx_wrap_type(cx_ab, bsig.ret) in
          let cur_cx = wrap_ret.cx in
          let ret_ty = wrap_ret.ty in
          if len(args) != len(bsig.params) then
            let d = qc_diag_arity(cur_cx.def, path, name, len(bsig.params), len(args)) in
            let cx_err = QcCx { g: cur_cx.g, def: cur_cx.def, effects: cur_cx.effects, tps: cur_cx.tps, eps: cur_cx.eps, frames: cur_cx.frames, ret: cur_cx.ret, diags: push(cur_cx.diags, d), start: cur_cx.start, sub: cur_cx.sub, locals: cur_cx.locals, scope: cur_cx.scope, deferred: cur_cx.deferred, seq_lets: cur_cx.seq_lets } in
            let all_res = qc_cx_infer_all_loop(cx_err, args, path, 0, AccEnd) in
            Some(qc_cx_poison(all_res.cx))
          else
            let args_res = qc_cx_builtin_args_loop(cur_cx, name, args, bsig.params, path, 0, AccEnd) in
            let cx_eff = match qc_builtin_effect(bsig.builtin) {
              Some(ef) => qc_cx_effect_check(args_res.cx, path, name, [ef]),
              None => args_res.cx
            } in
            let cx_sql = if bsig.builtin == QcBDbExec || bsig.builtin == QcBDbQuery then
              qc_cx_sql_literal(cx_eff, name, list_at(args, 0), path ++ ".args[0]")
            else cx_eff in
            Some(QcInferRes { cx: cx_sql, expr: QcTExpr { ty: ret_ty, kind: QcTKBuiltin(bsig.builtin, args_res.exprs, path) } })
    }

fn qc_cx_sql_literal(cx: QcCx, callee: Str, arg: QcExpr, path: Str) -> QcCx =
  match arg {
    QcEStr(sql) =>
      match qc_sql_check_statement(sql) {
        Ok(_) => cx,
        Err(reason) =>
          let d = qc_diag_sql_invalid(cx.def, path, reason) in
          QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }
      },
    _ =>
      let d = qc_diag_sql_not_literal(cx.def, path, callee) in
      QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }
  }

fn qc_cx_builtin_args_loop(cx: QcCx, callee: Str, args: List[QcExpr], params: List[QcType], path: Str, idx: Int, acc: Accum[QcTExpr]) -> QcCxExprsRes =
  if idx >= len(args) then QcCxExprsRes { cx: cx, exprs: acc_list(acc) }
  else
    let ap = path ++ ".args[" ++ from_int(idx) ++ "]" in
    let arg = list_at(args, idx) in
    let p = list_at(params, idx) in
    match p {
      QcTFn(fps, fr, _) =>
        let fn_arg_res = qc_cx_fn_arg(cx, callee, arg, fps, fr, ap) in
        qc_cx_builtin_args_loop(fn_arg_res.cx, callee, args, params, path, idx + 1, AccPush(acc, fn_arg_res.expr)),
      _ =>
        let exp_res = qc_cx_expect(cx, arg, p, ap) in
        qc_cx_builtin_args_loop(exp_res.cx, callee, args, params, path, idx + 1, AccPush(acc, exp_res.expr))
    }

fn qc_cx_fn_arg(cx: QcCx, callee: Str, arg: QcExpr, params: List[QcType], ret: QcType, path: Str) -> QcInferRes =
  let t_res = match arg {
    QcELambda(ps, body) if len(ps) == len(params) => qc_cx_lambda(cx, ps, body, path, Some(params)),
    _ => qc_cx_infer(cx, arg, path)
  } in
  let cur_cx = t_res.cx in
  let t = t_res.expr in
  let effects = match qc_subst_resolve(cur_cx.sub, t.ty) {
    QcTFn(_, _, effs) => effs,
    _ => []
  } in
  let want = QcTFn(params, ret, effects) in
  let un_res = qc_cx_unify_at(cur_cx, path, want, t.ty) in
  let cx_eff = if un_res.ok then qc_cx_effect_check(un_res.cx, path, callee, effects) else un_res.cx in
  QcInferRes { cx: cx_eff, expr: t }

fn qc_cx_len(cx: QcCx, args: List[QcExpr], path: Str) -> QcInferRes =
  if len(args) != 1 then
    let d = qc_diag_arity(cx.def, path, "len", 1, len(args)) in
    let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
    let all_res = qc_cx_infer_all_loop(cx_err, args, path, 0, AccEnd) in
    qc_cx_poison(all_res.cx)
  else
    let ap = path ++ ".args[0]" in
    let x_res = qc_cx_infer(cx, list_at(args, 0), ap) in
    let cur_cx = x_res.cx in
    let x = x_res.expr in
    match qc_subst_resolve(cur_cx.sub, x.ty) {
      QcTStr => QcInferRes { cx: cur_cx, expr: QcTExpr { ty: QcTInt, kind: QcTKBuiltin(QcBStrLen, [x], path) } },
      QcTList(_) => QcInferRes { cx: cur_cx, expr: QcTExpr { ty: QcTInt, kind: QcTKBuiltin(QcBListLen, [x], path) } },
      QcTVar(_) => QcInferRes { cx: cur_cx, expr: QcTExpr { ty: QcTInt, kind: QcTKBuiltin(QcBListLen, [x], path) } },
      other =>
        let found_s = qc_print_type(qc_subst_finish(cur_cx.sub, other)) in
        let d = qc_diag_type_mismatch(cur_cx.def, ap, "Str or List[_]", found_s) in
        let cx_err = QcCx { g: cur_cx.g, def: cur_cx.def, effects: cur_cx.effects, tps: cur_cx.tps, eps: cur_cx.eps, frames: cur_cx.frames, ret: cur_cx.ret, diags: push(cur_cx.diags, d), start: cur_cx.start, sub: cur_cx.sub, locals: cur_cx.locals, scope: cur_cx.scope, deferred: cur_cx.deferred, seq_lets: cur_cx.seq_lets } in
        qc_cx_poison(cx_err)
    }

fn qc_cx_record(cx: QcCx, name: Str, fields: List[QcFieldExpr], path: Str) -> QcInferRes =
  match qc_cx_fresh_decl(cx, name) {
    Some(decl_res) =>
      match decl_res.body {
        QcBodyRecord(decl) =>
          let f_res = qc_cx_record_fields_loop(decl_res.cx, name, fields, decl, path, 0, AccEnd) in
          let cx3 = qc_cx_check_missing_fields_loop(f_res.cx, name, decl, f_res.fields, path, 0) in
          QcInferRes { cx: cx3, expr: QcTExpr { ty: decl_res.ty, kind: QcTKRecord(f_res.fields) } },
        _ =>
          let d = qc_diag_hint(qc_diag_type_mismatch(cx.def, path, "a record type", name), "`" ++ name ++ "` is an enum; construct one of its variants instead") in
          let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
          let all_res = qc_cx_infer_record_fields_loop(cx_err, fields, path, 0, AccEnd) in
          qc_cx_poison(all_res.cx)
      },
    None =>
      let d = qc_diag_unknown_name(cx.def, path, name) in
      let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
      let all_res = qc_cx_infer_record_fields_loop(cx_err, fields, path, 0, AccEnd) in
      qc_cx_poison(all_res.cx)
  }

fn qc_cx_infer_record_fields_loop(cx: QcCx, fields: List[QcFieldExpr], path: Str, idx: Int, acc: Accum[QcTExpr]) -> QcCxExprsRes =
  if idx >= len(fields) then QcCxExprsRes { cx: cx, exprs: acc_list(acc) }
  else
    let f = list_at(fields, idx) in
    let res = qc_cx_infer(cx, f.expr, path ++ ".fields." ++ f.name) in
    qc_cx_infer_record_fields_loop(res.cx, fields, path, idx + 1, AccPush(acc, res.expr))

fn qc_cx_record_fields_loop(cx: QcCx, record_name: Str, fields: List[QcFieldExpr], decl: List[QcFieldType], path: Str, idx: Int, acc: Accum[QcTField]) -> QcCxFieldsRes =
  if idx >= len(fields) then QcCxFieldsRes { cx: cx, fields: acc_list(acc) }
  else
    let f = list_at(fields, idx) in
    let p = path ++ ".fields." ++ f.name in
    let cur_out = acc_list(acc) in
    match qc_list_find_idx_field_type(decl, f.name, 0) {
      Some(i) =>
        if fold(cur_out, false, fn(st: Bool, item: QcTField) => st || item.idx == i) then
          let d = qc_diag_duplicate_name(cx.def, p, f.name) in
          let cx_dup = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
          let res = qc_cx_infer(cx_dup, f.expr, p) in
          qc_cx_record_fields_loop(res.cx, record_name, fields, decl, path, idx + 1, acc)
        else
          let expected_ty = (list_at(decl, i)).ty in
          let exp_res = qc_cx_expect(cx, f.expr, expected_ty, p) in
          qc_cx_record_fields_loop(exp_res.cx, record_name, fields, decl, path, idx + 1, AccPush(acc, QcTField { idx: i, expr: exp_res.expr })),
      None =>
        let decl_names = map(decl, fn(ft: QcFieldType) => ft.name) in
        let d = qc_diag_hint(qc_diag_unknown_name(cx.def, p, f.name), "fields of `" ++ record_name ++ "`: " ++ join(decl_names, ", ")) in
        let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
        let res = qc_cx_infer(cx_err, f.expr, p) in
        qc_cx_record_fields_loop(res.cx, record_name, fields, decl, path, idx + 1, acc)
    }

fn qc_list_find_idx_field_type(decl: List[QcFieldType], name: Str, idx: Int) -> Option[Int] =
  if idx >= len(decl) then None
  else if (list_at(decl, idx)).name == name then Some(idx)
  else qc_list_find_idx_field_type(decl, name, idx + 1)

fn qc_cx_check_missing_fields_loop(cx: QcCx, record_name: Str, decl: List[QcFieldType], out: List[QcTField], path: Str, idx: Int) -> QcCx =
  if idx >= len(decl) then cx
  else
    let f = list_at(decl, idx) in
    if !fold(out, false, fn(st: Bool, item: QcTField) => st || item.idx == idx) then
      let d = qc_diag_missing_field(cx.def, path, record_name, f.name) in
      let next_cx = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
      qc_cx_check_missing_fields_loop(next_cx, record_name, decl, out, path, idx + 1)
    else
      qc_cx_check_missing_fields_loop(cx, record_name, decl, out, path, idx + 1)

fn qc_cx_field(cx: QcCx, target: QcExpr, field_name: Str, path: Str) -> QcInferRes =
  let t_res = qc_cx_infer(cx, target, path ++ ".target") in
  let cur_cx = t_res.cx in
  let t = t_res.expr in
  let ty = qc_subst_resolve(cur_cx.sub, t.ty) in
  match qc_tp_decl(cur_cx.g.tp, ty) {
    Some(QcBodyRecord(fs)) =>
      match qc_list_find_idx_field_type(fs, field_name, 0) {
        Some(i) =>
          QcInferRes { cx: cur_cx, expr: QcTExpr { ty: (list_at(fs, i)).ty, kind: QcTKField(t, i) } },
        None =>
          let names = map(fs, fn(ft: QcFieldType) => ft.name) in
          let d = qc_diag_hint(qc_diag_unknown_name(cur_cx.def, path, field_name), "fields of `" ++ qc_print_type(ty) ++ "`: " ++ join(names, ", ")) in
          let cx_err = QcCx { g: cur_cx.g, def: cur_cx.def, effects: cur_cx.effects, tps: cur_cx.tps, eps: cur_cx.eps, frames: cur_cx.frames, ret: cur_cx.ret, diags: push(cur_cx.diags, d), start: cur_cx.start, sub: cur_cx.sub, locals: cur_cx.locals, scope: cur_cx.scope, deferred: cur_cx.deferred, seq_lets: cur_cx.seq_lets } in
          qc_cx_poison(cx_err)
      },
    _ =>
      let is_var = match ty { QcTVar(_) => true, _ => false } in
      if !is_var || !qc_cx_has_errors(cur_cx) then
        let found_s = qc_print_type(qc_subst_finish(cur_cx.sub, ty)) in
        let d0 = qc_diag_type_mismatch(cur_cx.def, path, "a record", found_s) in
        let d = if is_var then qc_diag_hint(d0, "the type is not known yet here; annotate it, e.g. `let x: User = ... in x.field`") else d0 in
        let cx_err = QcCx { g: cur_cx.g, def: cur_cx.def, effects: cur_cx.effects, tps: cur_cx.tps, eps: cur_cx.eps, frames: cur_cx.frames, ret: cur_cx.ret, diags: push(cur_cx.diags, d), start: cur_cx.start, sub: cur_cx.sub, locals: cur_cx.locals, scope: cur_cx.scope, deferred: cur_cx.deferred, seq_lets: cur_cx.seq_lets } in
        qc_cx_poison(cx_err)
      else
        qc_cx_poison(cur_cx)
  }

fn qc_cx_match(cx: QcCx, s: QcExpr, arms: List[QcArm], path: Str) -> QcInferRes =
  let s_res = qc_cx_infer(cx, s, path ++ ".scrutinee") in
  let fresh_res = qc_subst_fresh(s_res.cx.sub) in
  let cx_fresh = QcCx { g: s_res.cx.g, def: s_res.cx.def, effects: s_res.cx.effects, tps: s_res.cx.tps, eps: s_res.cx.eps, frames: s_res.cx.frames, ret: s_res.cx.ret, diags: s_res.cx.diags, start: s_res.cx.start, sub: fresh_res.subst, locals: s_res.cx.locals, scope: s_res.cx.scope, deferred: s_res.cx.deferred, seq_lets: s_res.cx.seq_lets } in
  let s_expr = s_res.expr in
  let arms_res = qc_cx_match_arms_loop(cx_fresh, arms, s_expr.ty, fresh_res.ty, path, 0, AccEnd, AccEnd) in
  let next_deferred = push(arms_res.cx.deferred, QcDefExhaust(path, s_expr.ty, arms_res.rows)) in
  let cx_final = QcCx { g: arms_res.cx.g, def: arms_res.cx.def, effects: arms_res.cx.effects, tps: arms_res.cx.tps, eps: arms_res.cx.eps, frames: arms_res.cx.frames, ret: arms_res.cx.ret, diags: arms_res.cx.diags, start: arms_res.cx.start, sub: arms_res.cx.sub, locals: arms_res.cx.locals, scope: arms_res.cx.scope, deferred: next_deferred, seq_lets: arms_res.cx.seq_lets } in
  QcInferRes { cx: cx_final, expr: QcTExpr { ty: arms_res.ty, kind: QcTKMatch(s_expr, arms_res.arms) } }

fn qc_cx_match_arms_loop(cx: QcCx, arms: List[QcArm], s_ty: QcType, result_ty: QcType, path: Str, idx: Int, acc_tarms: Accum[QcTArm], acc_rows: Accum[QcTPat]) -> QcCxArmsRes =
  if idx >= len(arms) then QcCxArmsRes { cx: cx, arms: acc_list(acc_tarms), rows: acc_list(acc_rows), ty: result_ty }
  else
    let a = list_at(arms, idx) in
    let depth = len(cx.scope) in
    let ppath = path ++ ".arms[" ++ from_int(idx) ++ "].pattern" in
    let gpath = path ++ ".arms[" ++ from_int(idx) ++ "].guard" in
    let bpath = path ++ ".arms[" ++ from_int(idx) ++ "].body" in
    let pat_res = qc_cx_pattern(cx, a.pat, s_ty, ppath, []) in
    let guard_res = match a.guard {
      Some(g) =>
        let g_res = qc_cx_expect(pat_res.cx, g, QcTBool, gpath) in
        QcOptExprRes { cx: g_res.cx, expr: Some(g_res.expr) },
      None => QcOptExprRes { cx: pat_res.cx, expr: None }
    } in
    let b_res = qc_cx_branch(guard_res.cx, a.body, result_ty, bpath) in
    let cur_cx = b_res.cx in
    let scope_trunc = match qc_list_slice(cur_cx.scope, 0, depth) { Some(sc) => sc, None => [] } in
    let cx_arm_done = QcCx { g: cur_cx.g, def: cur_cx.def, effects: cur_cx.effects, tps: cur_cx.tps, eps: cur_cx.eps, frames: cur_cx.frames, ret: cur_cx.ret, diags: cur_cx.diags, start: cur_cx.start, sub: cur_cx.sub, locals: cur_cx.locals, scope: scope_trunc, deferred: cur_cx.deferred, seq_lets: cur_cx.seq_lets } in
    let next_rows = if guard_res.expr == None then AccPush(acc_rows, pat_res.pat) else acc_rows in
    let tarm = QcTArm { pat: pat_res.pat, guard: guard_res.expr, body: b_res.expr } in
    qc_cx_match_arms_loop(cx_arm_done, arms, s_ty, b_res.ty, path, idx + 1, AccPush(acc_tarms, tarm), next_rows)

fn qc_cx_pattern(cx: QcCx, p: QcPat, ty: QcType, path: Str, bound: List[Str]) -> QcCxPatRes =
  match p {
    QcPWild => QcCxPatRes { cx: cx, pat: QcTPWild, bound: bound },
    QcPBind(n) =>
      let cx_dup = if qc_contains_str_loop(bound, n, 0) then
        let d = qc_diag_duplicate_name(cx.def, path, n) in
        QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }
      else cx in
      let bind_res = qc_cx_bind(cx_dup, n, ty) in
      QcCxPatRes { cx: bind_res.cx, pat: QcTPBind(bind_res.id), bound: push(bound, n) },
    QcPInt(n) =>
      let un_res = qc_cx_unify_at(cx, path, ty, QcTInt) in
      QcCxPatRes { cx: un_res.cx, pat: QcTPInt(n), bound: bound },
    QcPStr(s) =>
      let un_res = qc_cx_unify_at(cx, path, ty, QcTStr) in
      QcCxPatRes { cx: un_res.cx, pat: QcTPStr(s), bound: bound },
    QcPBool(b) =>
      let un_res = qc_cx_unify_at(cx, path, ty, QcTBool) in
      QcCxPatRes { cx: un_res.cx, pat: QcTPBool(b), bound: bound },
    QcPUnit =>
      let un_res = qc_cx_unify_at(cx, path, ty, QcTUnit) in
      QcCxPatRes { cx: un_res.cx, pat: QcTPUnit, bound: bound },
    QcPVariant(name, ps) =>
      match qc_cx_variant(cx, name) {
        None =>
          let d = qc_diag_unknown_name(cx.def, path, name) in
          let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
          QcCxPatRes { cx: cx_err, pat: QcTPWild, bound: bound },
        Some(vlookup) =>
          let un_res = qc_cx_unify_at(vlookup.cx, path, ty, vlookup.ty) in
          if !un_res.ok then QcCxPatRes { cx: un_res.cx, pat: QcTPWild, bound: bound }
          else if len(ps) != len(vlookup.fields) then
            let d = qc_diag_arity(un_res.cx.def, path, name, len(vlookup.fields), len(ps)) in
            let cx_err = QcCx { g: un_res.cx.g, def: un_res.cx.def, effects: un_res.cx.effects, tps: un_res.cx.tps, eps: un_res.cx.eps, frames: un_res.cx.frames, ret: un_res.cx.ret, diags: push(un_res.cx.diags, d), start: un_res.cx.start, sub: un_res.cx.sub, locals: un_res.cx.locals, scope: un_res.cx.scope, deferred: un_res.cx.deferred, seq_lets: un_res.cx.seq_lets } in
            QcCxPatRes { cx: cx_err, pat: QcTPWild, bound: bound }
          else
            let sub_res = qc_cx_sub_patterns_loop(un_res.cx, ps, vlookup.fields, path, bound, 0, AccEnd) in
            QcCxPatRes { cx: sub_res.cx, pat: QcTPVariant(vlookup.tag, sub_res.pats), bound: sub_res.bound }
      },
    QcPRecord(name, fs) =>
      match qc_cx_fresh_decl(cx, name) {
        Some(decl_res) =>
          match decl_res.body {
            QcBodyRecord(decl) =>
              let un_res = qc_cx_unify_at(decl_res.cx, path, ty, decl_res.ty) in
              if !un_res.ok then QcCxPatRes { cx: un_res.cx, pat: QcTPWild, bound: bound }
              else
                let f_res = qc_cx_pat_record_fields_loop(un_res.cx, fs, decl, path, bound, 0, AccEnd, []) in
                QcCxPatRes { cx: f_res.cx, pat: QcTPRecord(f_res.fields), bound: f_res.bound },
            _ =>
              let d = qc_diag_unknown_name(cx.def, path, name) in
              let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
              QcCxPatRes { cx: cx_err, pat: QcTPWild, bound: bound }
          },
        None =>
          let d = qc_diag_unknown_name(cx.def, path, name) in
          let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
          QcCxPatRes { cx: cx_err, pat: QcTPWild, bound: bound }
      }
  }

fn qc_cx_sub_patterns_loop(cx: QcCx, ps: List[QcPat], fields: List[QcType], path: Str, bound: List[Str], idx: Int, acc: Accum[QcTPat]) -> QcCxSubPatsRes =
  if idx >= len(ps) || idx >= len(fields) then QcCxSubPatsRes { cx: cx, pats: acc_list(acc), bound: bound }
  else
    let ap = path ++ ".args[" ++ from_int(idx) ++ "]" in
    let p_res = qc_cx_pattern(cx, list_at(ps, idx), list_at(fields, idx), ap, bound) in
    qc_cx_sub_patterns_loop(p_res.cx, ps, fields, path, p_res.bound, idx + 1, AccPush(acc, p_res.pat))

fn qc_cx_pat_record_fields_loop(cx: QcCx, fs: List[QcFieldPat], decl: List[QcFieldType], path: Str, bound: List[Str], idx: Int, acc: Accum[QcTPField], seen: List[Str]) -> QcCxPatFieldsRes =
  if idx >= len(fs) then QcCxPatFieldsRes { cx: cx, fields: acc_list(acc), bound: bound }
  else
    let fp = list_at(fs, idx) in
    let fpath = path ++ ".fields." ++ fp.name in
    if qc_contains_str_loop(seen, fp.name, 0) then
      let d = qc_diag_duplicate_name(cx.def, fpath, fp.name) in
      let cx_dup = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
      qc_cx_pat_record_fields_loop(cx_dup, fs, decl, path, bound, idx + 1, acc, seen)
    else
      let next_seen = push(seen, fp.name) in
      match qc_list_find_idx_field_type(decl, fp.name, 0) {
        Some(i) =>
          let p_res = qc_cx_pattern(cx, fp.pat, (list_at(decl, i)).ty, fpath, bound) in
          let tp_field = QcTPField { idx: i, pat: p_res.pat } in
          qc_cx_pat_record_fields_loop(p_res.cx, fs, decl, path, p_res.bound, idx + 1, AccPush(acc, tp_field), next_seen),
        None =>
          let d = qc_diag_unknown_name(cx.def, fpath, fp.name) in
          let cx_err = QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, d), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets } in
          qc_cx_pat_record_fields_loop(cx_err, fs, decl, path, bound, idx + 1, acc, next_seen)
      }

fn qc_cx_infer(cx: QcCx, e: QcExpr, path: Str) -> QcInferRes =
  match e {
    QcEInt(n) => QcInferRes { cx: cx, expr: QcTExpr { ty: QcTInt, kind: QcTKInt(n) } },
    QcEFloat(x) => QcInferRes { cx: cx, expr: QcTExpr { ty: QcTFloat, kind: QcTKFloat(x) } },
    QcEBool(b) => QcInferRes { cx: cx, expr: QcTExpr { ty: QcTBool, kind: QcTKBool(b) } },
    QcEStr(s) => QcInferRes { cx: cx, expr: QcTExpr { ty: QcTStr, kind: QcTKStr(s) } },
    QcEUnit => QcInferRes { cx: cx, expr: QcTExpr { ty: QcTUnit, kind: QcTKUnit } },
    QcEVar(v) => qc_cx_var(cx, v, path),
    QcECall(name, args) => qc_cx_call(cx, name, args, path),
    QcEUn(QcUnNot, x) =>
      let res = qc_cx_expect(cx, x, QcTBool, path ++ ".operand") in
      QcInferRes { cx: res.cx, expr: QcTExpr { ty: QcTBool, kind: QcTKUn(QcUnNot, res.expr, path) } },
    QcEUn(QcUnNeg, x) =>
      let res = qc_cx_infer(cx, x, path ++ ".operand") in
      let num_res = qc_cx_numeric(res.cx, path ++ ".operand", res.expr.ty) in
      QcInferRes { cx: num_res.cx, expr: QcTExpr { ty: num_res.ty, kind: QcTKUn(QcUnNeg, res.expr, path) } },
    QcEBin(op, l, r) => qc_cx_binary(cx, op, l, r, path),
    QcEIf(c, t, f) =>
      let c_res = qc_cx_expect(cx, c, QcTBool, path ++ ".cond") in
      let t_res = qc_cx_infer(c_res.cx, t, path ++ ".then") in
      let f_res = qc_cx_branch(t_res.cx, f, t_res.expr.ty, path ++ ".else") in
      QcInferRes { cx: f_res.cx, expr: QcTExpr { ty: f_res.ty, kind: QcTKIf(c_res.expr, t_res.expr, f_res.expr) } },
    QcELet(name, ann, v, body) =>
      let ann_res = match ann {
        Some(t) =>
          let res_t = qc_resolve_type(cx.g, t, cx.tps, cx.eps, cx.def, path ++ ".type", cx.diags) in
          QcOptTypeRes { cx: QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: res_t.diags, start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }, ty: res_t.ty },
        None => QcOptTypeRes { cx: cx, ty: None }
      } in
      let v_res = match ann_res.ty {
        Some(want_ty) => qc_cx_expect(ann_res.cx, v, want_ty, path ++ ".value"),
        None => qc_cx_infer(ann_res.cx, v, path ++ ".value")
      } in
      let bind_res = qc_cx_bind(v_res.cx, name, v_res.expr.ty) in
      let body_res = qc_cx_infer(bind_res.cx, body, path ++ ".body") in
      let cx_unbound = qc_cx_unbind(body_res.cx) in
      QcInferRes { cx: cx_unbound, expr: QcTExpr { ty: body_res.expr.ty, kind: QcTKLet(bind_res.id, v_res.expr, body_res.expr) } },
    QcEList(items) =>
      let fresh_elem = qc_subst_fresh(cx.sub) in
      let elem = fresh_elem.ty in
      let fresh_wrap = qc_cx_wrap_type(QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: cx.diags, start: cx.start, sub: fresh_elem.subst, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }, QcTList(elem)) in
      let items_res = qc_cx_list_items_loop(fresh_wrap.cx, items, elem, path, 0, AccEnd) in
      let final_ty = if items_res.ty == elem then fresh_wrap.ty else (qc_cx_wrap_at(items_res.cx, path, QcTList(items_res.ty))).ty in
      QcInferRes { cx: items_res.cx, expr: QcTExpr { ty: final_ty, kind: QcTKList(items_res.items) } },
    QcESeq(items) =>
      if len(items) == 0 then QcInferRes { cx: cx, expr: QcTExpr { ty: QcTUnit, kind: QcTKUnit } }
      else
        let seq_res = qc_cx_seq_items_loop(cx, items, path, 0, AccEnd) in
        let last_ty = if len(seq_res.exprs) > 0 then (list_at(seq_res.exprs, len(seq_res.exprs) - 1)).ty else QcTUnit in
        # The sequence's `let` names end with it (Rust: `seq_lets.truncate`).
        let sc = seq_res.cx in
        let cx_out = QcCx { g: sc.g, def: sc.def, effects: sc.effects, tps: sc.tps, eps: sc.eps, frames: sc.frames, ret: sc.ret, diags: sc.diags, start: sc.start, sub: sc.sub, locals: sc.locals, scope: sc.scope, deferred: sc.deferred, seq_lets: cx.seq_lets } in
        QcInferRes { cx: cx_out, expr: QcTExpr { ty: last_ty, kind: QcTKSeq(seq_res.exprs) } },
    QcERecord(name, fields) => qc_cx_record(cx, name, fields, path),
    QcEField(target, field_name) => qc_cx_field(cx, target, field_name, path),
    QcEMatch(s, arms) => qc_cx_match(cx, s, arms, path),
    QcELambda(params, body) => qc_cx_lambda(cx, params, body, path, None)
  }

fn qc_cx_list_items_loop(cx: QcCx, items: List[QcExpr], acc_ty: QcType, path: Str, idx: Int, acc: Accum[QcTExpr]) -> QcCxListRes =
  if idx >= len(items) then QcCxListRes { cx: cx, items: acc_list(acc), ty: acc_ty }
  else
    let ip = path ++ ".items[" ++ from_int(idx) ++ "]" in
    let b_res = qc_cx_branch(cx, list_at(items, idx), acc_ty, ip) in
    qc_cx_list_items_loop(b_res.cx, items, b_res.ty, path, idx + 1, AccPush(acc, b_res.expr))

fn qc_cx_seq_items_loop(cx: QcCx, items: List[QcExpr], path: Str, idx: Int, acc: Accum[QcTExpr]) -> QcCxExprsRes =
  if idx >= len(items) then QcCxExprsRes { cx: cx, exprs: acc_list(acc) }
  else
    let ip = path ++ ".items[" ++ from_int(idx) ++ "]" in
    let res = qc_cx_infer(cx, list_at(items, idx), ip) in
    let cur_cx = res.cx in
    let t = res.expr in
    let next_cx =
      if idx + 1 < len(items) then
        match qc_subst_resolve(cur_cx.sub, t.ty) {
          QcTVar(_) =>
            let un_res = qc_cx_unify_at(cur_cx, ip, QcTUnit, t.ty) in
            un_res.cx,
          _ =>
            let fin_ty = qc_subst_finish(cur_cx.sub, t.ty) in
            if qc_contains_result(cur_cx.g, fin_ty, [], [], []) then
              let cx_m = qc_cx_mismatch(cur_cx, ip, QcTUnit, t.ty) in
              if len(cx_m.diags) > 0 then
                let d_last = list_at(cx_m.diags, len(cx_m.diags) - 1) in
                let d_hinted = qc_diag_hint(d_last, "a Result must be handled with `match` (or bound with `let`), also inside a List, Option, Map or record; only other values can be discarded in `{ a; b }`") in
                let diags_upd = qc_list_set(cx_m.diags, len(cx_m.diags) - 1, d_hinted) in
                QcCx { g: cx_m.g, def: cx_m.def, effects: cx_m.effects, tps: cx_m.tps, eps: cx_m.eps, frames: cx_m.frames, ret: cx_m.ret, diags: diags_upd, start: cx_m.start, sub: cx_m.sub, locals: cx_m.locals, scope: cx_m.scope, deferred: cx_m.deferred, seq_lets: cx_m.seq_lets }
              else cx_m
            else cur_cx
        }
      else cur_cx in
    # The `let` of a non-last item ends at its `;` (named by E0201 in later items).
    let lets_cx = match list_at(items, idx) {
      QcELet(name, _, _, _) =>
        if idx + 1 < len(items) then
          QcCx { g: next_cx.g, def: next_cx.def, effects: next_cx.effects, tps: next_cx.tps, eps: next_cx.eps, frames: next_cx.frames, ret: next_cx.ret, diags: next_cx.diags, start: next_cx.start, sub: next_cx.sub, locals: next_cx.locals, scope: next_cx.scope, deferred: next_cx.deferred, seq_lets: push(next_cx.seq_lets, name) }
        else next_cx,
      _ => next_cx
    } in
    qc_cx_seq_items_loop(lets_cx, items, path, idx + 1, AccPush(acc, t))

fn qc_contains_result(g: QcGlobals, t: QcType, params: List[Str], flags: List[Bool], seen: List[Str]) -> Bool =
  if len(seen) >= 256 then false
  else
    match t {
      QcTResult(_, _) => true,
      QcTList(x) => qc_contains_result(g, x, params, flags, seen),
      QcTOption(x) => qc_contains_result(g, x, params, flags, seen),
      QcTMap(a, b) => qc_contains_result(g, a, params, flags, seen) || qc_contains_result(g, b, params, flags, seen),
      QcTParam(p) =>
        match qc_list_find_idx_str(params, p) {
          Some(i) => if i < len(flags) then list_at(flags, i) else false,
          None => false
        },
      QcTNamed(n) => qc_contains_result_decl(g, n, [], params, flags, seen),
      QcTApp(n, args) => qc_contains_result_decl(g, n, args, params, flags, seen),
      _ => false
    }

fn qc_contains_result_decl(g: QcGlobals, n: Str, args: List[QcType], params: List[Str], flags: List[Bool], seen: List[Str]) -> Bool =
  let key = n ++ "[" ++ join(map(args, qc_print_type), ",") ++ "]" in
  if qc_contains_str_loop(seen, key, 0) then false
  else
    match qc_g_type_def(g, n) {
      None => false,
      Some(d) =>
        let arg_flags = map(args, fn(a: QcType) => qc_contains_result(g, a, params, flags, seen)) in
        let next_seen = push(seen, key) in
        match d.body {
          QcBodyRecord(fs) => fold(fs, false, fn(acc: Bool, f: QcFieldType) => acc || qc_contains_result(g, f.ty, d.params, arg_flags, next_seen)),
          QcBodyEnum(vs) => fold(vs, false, fn(acc: Bool, v: QcVariant) =>
            acc || fold(v.fields, false, fn(acc_f: Bool, f: QcType) => acc_f || qc_contains_result(g, f, d.params, arg_flags, next_seen))
          )
        }
    }

# Finish & Zonk pass
fn qc_cx_finish(cx: QcCx, exprs: List[QcTExpr]) -> QcCxFinishRes =
  if qc_cx_has_errors(cx) then QcCxFinishRes { res: None, diags: cx.diags }
  else
    let cx_def = qc_cx_run_deferred_loop(cx, cx.deferred, 0) in
    if qc_cx_has_errors(cx_def) then QcCxFinishRes { res: None, diags: cx_def.diags }
    else
      let zonk_res = qc_cx_zonk_list_loop(cx_def, exprs, 0, AccEnd) in
      if qc_cx_has_errors(zonk_res.cx) then QcCxFinishRes { res: None, diags: zonk_res.cx.diags }
      else
        let locals_fin = map(zonk_res.cx.locals, fn(t: QcType) => qc_subst_finish(zonk_res.cx.sub, t)) in
        QcCxFinishRes {
          res: Some(QcCxFinishOk { locals: locals_fin, exprs: zonk_res.exprs }),
          diags: zonk_res.cx.diags
        }

fn qc_cx_run_deferred_loop(cx: QcCx, defs: List[QcDeferred], idx: Int) -> QcCx =
  if idx >= len(defs) then cx
  else
    let d = list_at(defs, idx) in
    let next_cx = match d {
      QcDefEq(path, t) =>
        let fin_t = qc_subst_finish(cx.sub, t) in
        if qc_contains_fn(cx.g.tp, fin_t, []) then
          let diag = qc_diag_hint(qc_diag_type_mismatch(cx.def, path, "a comparable type", qc_print_type(fin_t)), "functions cannot be compared") in
          QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, diag), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }
        else cx,
      QcDefConcat(path, t) =>
        let res_t = qc_subst_resolve(cx.sub, t) in
        let ok = match res_t {
          QcTStr => true,
          QcTList(_) => true,
          QcTBytes => true,
          _ => false
        } in
        if !ok then
          let diag = qc_diag_type_mismatch(cx.def, path, "Str, Bytes or List[_]", qc_print_type(qc_subst_finish(cx.sub, res_t))) in
          QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, diag), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets }
        else cx,
      QcDefExhaust(path, t, rows) =>
        let fin_t = qc_subst_finish(cx.sub, t) in
        match qc_missing_pattern(cx.g.tp, fin_t, rows) {
          Some(w) =>
            let diag = qc_diag_non_exhaustive(cx.def, path, w) in
            QcCx { g: cx.g, def: cx.def, effects: cx.effects, tps: cx.tps, eps: cx.eps, frames: cx.frames, ret: cx.ret, diags: push(cx.diags, diag), start: cx.start, sub: cx.sub, locals: cx.locals, scope: cx.scope, deferred: cx.deferred, seq_lets: cx.seq_lets },
          None => cx
        }
    } in
    qc_cx_run_deferred_loop(next_cx, defs, idx + 1)

fn qc_cx_zonk_list_loop(cx: QcCx, exprs: List[QcTExpr], idx: Int, acc: Accum[QcTExpr]) -> QcCxExprsRes =
  if idx >= len(exprs) then QcCxExprsRes { cx: cx, exprs: acc_list(acc) }
  else
    let z_res = qc_cx_zonk(cx, list_at(exprs, idx)) in
    qc_cx_zonk_list_loop(z_res.cx, exprs, idx + 1, AccPush(acc, z_res.expr))

fn qc_cx_zonk(cx: QcCx, e: QcTExpr) -> QcInferRes =
  let fin_ty = qc_subst_finish(cx.sub, e.ty) in
  match e.kind {
    QcTKFnRefG(idx, targs) =>
      let fin_targs = map(targs, fn(t: QcType) => qc_subst_finish(cx.sub, t)) in
      QcInferRes { cx: cx, expr: QcTExpr { ty: fin_ty, kind: QcTKFnRefG(idx, fin_targs) } },
    QcTKCallG(idx, targs, xs) =>
      let fin_targs = map(targs, fn(t: QcType) => qc_subst_finish(cx.sub, t)) in
      let xs_res = qc_cx_zonk_list_loop(cx, xs, 0, AccEnd) in
      QcInferRes { cx: xs_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKCallG(idx, fin_targs, xs_res.exprs) } },
    QcTKLambda(l) =>
      let b_res = qc_cx_zonk(cx, l.body) in
      let init_bound = fold(l.params, map_new(), fn(m: Map[Int, Bool], p: Int) => map_put(m, p, true)) in
      let walk_res = qc_locals_of_walk(b_res.expr, QcLocalsOfAcc { used: AccEnd, bound: init_bound }) in
      let used = acc_list(walk_res.used) in
      let captures = filter(used, fn(id: Int) => !map_has(walk_res.bound, id)) in
      let final_lambda = QcTLambda { params: l.params, captures: qc_sort_dedup_ints(captures), body: b_res.expr } in
      QcInferRes { cx: b_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKLambda(final_lambda) } },
    QcTKUn(op, x, path) =>
      let x_res = qc_cx_zonk(cx, x) in
      QcInferRes { cx: x_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKUn(op, x_res.expr, path) } },
    QcTKField(x, i) =>
      let x_res = qc_cx_zonk(cx, x) in
      QcInferRes { cx: x_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKField(x_res.expr, i) } },
    QcTKBin(op, l, r, path) =>
      let l_res = qc_cx_zonk(cx, l) in
      let r_res = qc_cx_zonk(l_res.cx, r) in
      QcInferRes { cx: r_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKBin(op, l_res.expr, r_res.expr, path) } },
    QcTKLet(id, l, r) =>
      let l_res = qc_cx_zonk(cx, l) in
      let r_res = qc_cx_zonk(l_res.cx, r) in
      QcInferRes { cx: r_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKLet(id, l_res.expr, r_res.expr) } },
    QcTKIf(c, t, f) =>
      let c_res = qc_cx_zonk(cx, c) in
      let t_res = qc_cx_zonk(c_res.cx, t) in
      let f_res = qc_cx_zonk(t_res.cx, f) in
      QcInferRes { cx: f_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKIf(c_res.expr, t_res.expr, f_res.expr) } },
    QcTKCall(i, xs) =>
      let xs_res = qc_cx_zonk_list_loop(cx, xs, 0, AccEnd) in
      QcInferRes { cx: xs_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKCall(i, xs_res.exprs) } },
    QcTKList(xs) =>
      let xs_res = qc_cx_zonk_list_loop(cx, xs, 0, AccEnd) in
      QcInferRes { cx: xs_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKList(xs_res.exprs) } },
    QcTKVariant(tag, xs) =>
      let xs_res = qc_cx_zonk_list_loop(cx, xs, 0, AccEnd) in
      QcInferRes { cx: xs_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKVariant(tag, xs_res.exprs) } },
    QcTKSeq(xs) =>
      let xs_res = qc_cx_zonk_list_loop(cx, xs, 0, AccEnd) in
      QcInferRes { cx: xs_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKSeq(xs_res.exprs) } },
    QcTKCallIndirect(f, xs) =>
      let f_res = qc_cx_zonk(cx, f) in
      let xs_res = qc_cx_zonk_list_loop(f_res.cx, xs, 0, AccEnd) in
      QcInferRes { cx: xs_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKCallIndirect(f_res.expr, xs_res.exprs) } },
    QcTKRecord(fs) =>
      let fs_res = qc_cx_zonk_record_fields_loop(cx, fs, 0, AccEnd) in
      QcInferRes { cx: fs_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKRecord(fs_res.fields) } },
    QcTKBuiltin(b, xs, path) =>
      let xs_res = qc_cx_zonk_list_loop(cx, xs, 0, AccEnd) in
      let fin_res =
        if b == QcBStrLen || b == QcBListLen then
          let arg_ty = if len(xs_res.exprs) > 0 then (list_at(xs_res.exprs, 0)).ty else QcTUnit in
          match arg_ty {
            QcTStr => QcZonkBuiltinRes { cx: xs_res.cx, b: QcBStrLen },
            QcTList(_) => QcZonkBuiltinRes { cx: xs_res.cx, b: QcBListLen },
            other =>
              let d = qc_diag_type_mismatch(xs_res.cx.def, path ++ ".args[0]", "Str or List[_]", qc_print_type(other)) in
              let cx_err = QcCx { g: xs_res.cx.g, def: xs_res.cx.def, effects: xs_res.cx.effects, tps: xs_res.cx.tps, eps: xs_res.cx.eps, frames: xs_res.cx.frames, ret: xs_res.cx.ret, diags: push(xs_res.cx.diags, d), start: xs_res.cx.start, sub: xs_res.cx.sub, locals: xs_res.cx.locals, scope: xs_res.cx.scope, deferred: xs_res.cx.deferred, seq_lets: xs_res.cx.seq_lets } in
              QcZonkBuiltinRes { cx: cx_err, b: b }
          }
        else QcZonkBuiltinRes { cx: xs_res.cx, b: b } in
      QcInferRes { cx: fin_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKBuiltin(fin_res.b, xs_res.exprs, path) } },
    QcTKMatch(s, arms) =>
      let s_res = qc_cx_zonk(cx, s) in
      let arms_res = qc_cx_zonk_arms_loop(s_res.cx, arms, 0, AccEnd) in
      QcInferRes { cx: arms_res.cx, expr: QcTExpr { ty: fin_ty, kind: QcTKMatch(s_res.expr, arms_res.arms) } },
    _ => QcInferRes { cx: cx, expr: QcTExpr { ty: fin_ty, kind: e.kind } }
  }

fn qc_cx_zonk_record_fields_loop(cx: QcCx, fs: List[QcTField], idx: Int, acc: Accum[QcTField]) -> QcCxFieldsRes =
  if idx >= len(fs) then QcCxFieldsRes { cx: cx, fields: acc_list(acc) }
  else
    let f = list_at(fs, idx) in
    let z_res = qc_cx_zonk(cx, f.expr) in
    qc_cx_zonk_record_fields_loop(z_res.cx, fs, idx + 1, AccPush(acc, QcTField { idx: f.idx, expr: z_res.expr }))

fn qc_cx_zonk_arms_loop(cx: QcCx, arms: List[QcTArm], idx: Int, acc: Accum[QcTArm]) -> QcCxTArmsRes =
  if idx >= len(arms) then QcCxTArmsRes { cx: cx, arms: acc_list(acc) }
  else
    let a = list_at(arms, idx) in
    let guard_res = match a.guard {
      Some(g) =>
        let zg = qc_cx_zonk(cx, g) in
        QcOptExprRes { cx: zg.cx, expr: Some(zg.expr) },
      None => QcOptExprRes { cx: cx, expr: None }
    } in
    let body_res = qc_cx_zonk(guard_res.cx, a.body) in
    let next_arm = QcTArm { pat: a.pat, guard: guard_res.expr, body: body_res.expr } in
    qc_cx_zonk_arms_loop(body_res.cx, arms, idx + 1, AccPush(acc, next_arm))

# Locals used in expressions
type QcLocalsOfAcc = {
  used: Accum[Int],
  bound: Map[Int, Bool]
}

fn qc_pat_collect_bound(p: QcTPat, bound: Map[Int, Bool]) -> Map[Int, Bool] =
  match p {
    QcTPBind(id) => map_put(bound, id, true),
    QcTPVariant(_, ps) => fold(ps, bound, fn(b: Map[Int, Bool], sub_p: QcTPat) => qc_pat_collect_bound(sub_p, b)),
    QcTPRecord(fs) => fold(fs, bound, fn(b: Map[Int, Bool], f: QcTPField) => qc_pat_collect_bound(f.pat, b)),
    _ => bound
  }

fn qc_locals_of_walk(e: QcTExpr, st: QcLocalsOfAcc) -> QcLocalsOfAcc =
  match e.kind {
    QcTKLocal(id) => QcLocalsOfAcc { used: AccPush(st.used, id), bound: st.bound },
    QcTKLambda(l) =>
      let next_used = fold(l.captures, st.used, fn(acc: Accum[Int], id: Int) => AccPush(acc, id)) in
      QcLocalsOfAcc { used: next_used, bound: st.bound },
    QcTKLet(id, v, b) =>
      let st1 = QcLocalsOfAcc { used: st.used, bound: map_put(st.bound, id, true) } in
      let st2 = qc_locals_of_walk(v, st1) in
      qc_locals_of_walk(b, st2),
    QcTKMatch(s, arms) =>
      let st_s = qc_locals_of_walk(s, st) in
      fold(arms, st_s, fn(cur_st: QcLocalsOfAcc, a: QcTArm) =>
        let b_with_pat = qc_pat_collect_bound(a.pat, cur_st.bound) in
        let st_pat = QcLocalsOfAcc { used: cur_st.used, bound: b_with_pat } in
        let st_g = match a.guard {
          Some(g) => qc_locals_of_walk(g, st_pat),
          None => st_pat
        } in
        qc_locals_of_walk(a.body, st_g)
      ),
    _ => fold(qc_expr_children(e), st, fn(cur_st: QcLocalsOfAcc, c: QcTExpr) => qc_locals_of_walk(c, cur_st))
  }

fn qc_expr_children(e: QcTExpr) -> List[QcTExpr] =
  match e.kind {
    QcTKUn(_, x, _) => [x],
    QcTKField(x, _) => [x],
    QcTKBin(_, l, r, _) => [l, r],
    QcTKLet(_, l, r) => [l, r],
    QcTKIf(c, t, f) => [c, t, f],
    QcTKCall(_, xs) => xs,
    QcTKCallG(_, _, xs) => xs,
    QcTKList(xs) => xs,
    QcTKVariant(_, xs) => xs,
    QcTKSeq(xs) => xs,
    QcTKBuiltin(_, xs, _) => xs,
    QcTKCallIndirect(f, xs) => push(xs, f),
    QcTKRecord(fs) => map(fs, fn(f: QcTField) => f.expr),
    _ => []
  }

fn qc_sort_dedup_ints(xs: List[Int]) -> List[Int] =
  sort_int(fold(xs, [], fn(acc: List[Int], x: Int) =>
    if fold(acc, false, fn(st: Bool, item: Int) => st || item == x) then acc
    else push(acc, x)
  ))

# Type resolution pass
type QcResolveRes = {
  diags: List[QcDiag],
  ty: Option[QcType]
}

fn qc_resolve_type(g: QcGlobals, t: QcType, tps: List[Str], eps: List[Str], def_name: Str, path: Str, diags: List[QcDiag]) -> QcResolveRes =
  let start_len = len(diags) in
  let res = qc_resolve_inner(g, t, tps, eps, def_name, path, diags) in
  if len(res.diags) == start_len then QcResolveRes { diags: res.diags, ty: Some(res.ty) }
  else QcResolveRes { diags: res.diags, ty: None }

fn qc_resolve_inner(g: QcGlobals, t: QcType, tps: List[Str], eps: List[Str], def_name: Str, path: Str, diags: List[QcDiag]) -> QcDiagTypeRes =
  match t {
    QcTNamed(n) =>
      if qc_contains_str_loop(tps, n, 0) then QcDiagTypeRes { diags: diags, ty: QcTParam(n) }
      else
        match qc_g_type_def(g, n) {
          Some(d) if len(d.params) == 0 => QcDiagTypeRes { diags: diags, ty: t },
          Some(d) =>
            let d_err = qc_diag_hint(qc_diag_arity(def_name, path, n, len(d.params), 0), "write `" ++ n ++ "[" ++ join(qc_repeat_dots_loop(len(d.params), AccEnd), ", ") ++ "]`") in
            QcDiagTypeRes { diags: push(diags, d_err), ty: QcTUnit },
          None =>
            let d0 = qc_diag_unknown_name(def_name, path, n) in
            let d = if qc_g_find_variant(g, n) != None || n == "None" || n == "Some" || n == "Ok" || n == "Err" then
              qc_diag_hint(d0, "`" ++ n ++ "` is a variant, not a type")
            else match qc_foreign_name_hint(n) {
              Some(h) => qc_diag_hint(d0, h),
              None => d0
            } in
            QcDiagTypeRes { diags: push(diags, d), ty: QcTUnit }
        },
    QcTParam(n) =>
      if qc_contains_str_loop(tps, n, 0) then QcDiagTypeRes { diags: diags, ty: QcTParam(n) }
      else
        let d = qc_diag_unknown_name(def_name, path, n) in
        QcDiagTypeRes { diags: push(diags, d), ty: QcTUnit },
    QcTApp(n, args) =>
      let args_res = qc_resolve_list_loop(g, args, tps, eps, def_name, path, diags, 0, AccEnd) in
      match qc_g_type_def(g, n) {
        Some(d) if len(d.params) == len(args_res.tys) => QcDiagTypeRes { diags: args_res.diags, ty: QcTApp(n, args_res.tys) },
        Some(d) =>
          let d_err = qc_diag_arity(def_name, path, n, len(d.params), len(args_res.tys)) in
          QcDiagTypeRes { diags: push(args_res.diags, d_err), ty: QcTUnit },
        None =>
          let d0 = qc_diag_unknown_name(def_name, path, n) in
          let d = match qc_foreign_name_hint(n) {
            Some(h) => qc_diag_hint(d0, h),
            None => d0
          } in
          QcDiagTypeRes { diags: push(args_res.diags, d), ty: QcTUnit }
      },
    QcTList(x) =>
      let x_res = qc_resolve_inner(g, x, tps, eps, def_name, path, diags) in
      QcDiagTypeRes { diags: x_res.diags, ty: QcTList(x_res.ty) },
    QcTOption(x) =>
      let x_res = qc_resolve_inner(g, x, tps, eps, def_name, path, diags) in
      QcDiagTypeRes { diags: x_res.diags, ty: QcTOption(x_res.ty) },
    QcTResult(a, b) =>
      let a_res = qc_resolve_inner(g, a, tps, eps, def_name, path, diags) in
      let b_res = qc_resolve_inner(g, b, tps, eps, def_name, path, a_res.diags) in
      QcDiagTypeRes { diags: b_res.diags, ty: QcTResult(a_res.ty, b_res.ty) },
    QcTMap(k, v) =>
      let k_res = qc_resolve_inner(g, k, tps, eps, def_name, path, diags) in
      let diags_check = if qc_contains_fn(g.tp, k_res.ty, []) then
        let d = qc_diag_hint(qc_diag_type_mismatch(def_name, path, "a comparable key type", qc_print_type(k_res.ty)), "map keys cannot contain functions") in
        push(k_res.diags, d)
      else k_res.diags in
      let v_res = qc_resolve_inner(g, v, tps, eps, def_name, path, diags_check) in
      QcDiagTypeRes { diags: v_res.diags, ty: QcTMap(k_res.ty, v_res.ty) },
    QcTFn(ps, r, effs) =>
      let r_res = qc_resolve_inner(g, r, tps, eps, def_name, path, diags) in
      let ps_res = qc_resolve_list_loop(g, ps, tps, eps, def_name, path, r_res.diags, 0, AccEnd) in
      let diags_effs = fold(effs, ps_res.diags, fn(st: List[QcDiag], ef: Str) =>
        if !qc_is_known_effect(ef) && !qc_contains_str_loop(eps, ef, 0) then
          let d = qc_diag_hint(qc_diag_unknown_name(def_name, path, ef), "known effects: io, fs, time, rand, net, db, model, tensor; an effect parameter is declared in the function's brackets: `fn f[!" ++ ef ++ "](...)`") in
          push(st, d)
        else st
      ) in
      QcDiagTypeRes { diags: diags_effs, ty: QcTFn(ps_res.tys, r_res.ty, effs) },
    _ => QcDiagTypeRes { diags: diags, ty: t }
  }

fn qc_repeat_dots_loop(count: Int, acc: Accum[Str]) -> List[Str] =
  if count <= 0 then acc_list(acc)
  else qc_repeat_dots_loop(count - 1, AccPush(acc, "..."))

fn qc_resolve_list_loop(g: QcGlobals, xs: List[QcType], tps: List[Str], eps: List[Str], def_name: Str, path: Str, diags: List[QcDiag], idx: Int, acc: Accum[QcType]) -> QcDiagTypesRes =
  if idx >= len(xs) then QcDiagTypesRes { diags: diags, tys: acc_list(acc) }
  else
    let res = qc_resolve_inner(g, list_at(xs, idx), tps, eps, def_name, path, diags) in
    qc_resolve_list_loop(g, xs, tps, eps, def_name, path, res.diags, idx + 1, AccPush(acc, res.ty))

fn qc_is_known_effect(e: Str) -> Bool =
  e == "io" || e == "fs" || e == "time" || e == "rand" || e == "net" || e == "db" || e == "model" || e == "tensor"

# Checking functions and tests
fn qc_check_fn(f: QcFnDef, g: QcGlobals, diags: List[QcDiag]) -> QcCheckFnRes =
  let before = len(diags) in
  let diags_tp = qc_check_tparams(g, f.name, f.tparams, diags) in
  let params_res = qc_check_fn_params_loop(g, f, f.params, diags_tp, 0, AccEnd, []) in
  let ptypes = params_res.tys in
  let ret_res = qc_resolve_type(g, f.ret, f.tparams, f.eparams, f.name, "ret", params_res.diags) in
  let ret_ty = match ret_res.ty { Some(t) => t, None => QcTUnit } in
  let diags_ret = ret_res.diags in
  let diags_unused = qc_check_unused_tparams_loop(f.name, f.tparams, ptypes, ret_ty, diags_ret, 0) in
  let diags_ep = qc_check_eparams(f, ptypes, diags_unused) in
  let diags_effs = qc_check_fn_effects_loop(f.name, f.effects, f.eparams, diags_ep, 0) in
  let diags_main = if f.name == "main" then qc_check_main_sig(f, ret_ty, diags_effs) else diags_effs in
  let mut_cx0 = qc_cx_new(g, f.name, [], diags_main) in
  let mut_cx1 = QcCx { g: mut_cx0.g, def: mut_cx0.def, effects: [], tps: f.tparams, eps: f.eparams, frames: mut_cx0.frames, ret: Some(ret_ty), diags: mut_cx0.diags, start: before, sub: mut_cx0.sub, locals: mut_cx0.locals, scope: mut_cx0.scope, deferred: mut_cx0.deferred, seq_lets: mut_cx0.seq_lets } in
  let mut_cx2 = qc_cx_bind_fn_params_loop(mut_cx1, f.params, ptypes, 0) in
  let reqs_res = qc_cx_expect_list_loop(mut_cx2, f.reqs, QcTBool, "req", 0, AccEnd) in
  let mut_cx3 = reqs_res.cx in
  let req_exprs = reqs_res.exprs in
  let r_local_res = if len(f.enss) > 0 then
    let bind_r = qc_cx_bind(mut_cx3, "r", ret_ty) in
    QcResLocal { cx: bind_r.cx, id: Some(bind_r.id) }
  else QcResLocal { cx: mut_cx3, id: None } in
  let enss_res = qc_cx_expect_list_loop(r_local_res.cx, f.enss, QcTBool, "ens", 0, AccEnd) in
  let mut_cx5 = enss_res.cx in
  let ens_exprs = enss_res.exprs in
  let mut_cx6 = if r_local_res.id != None then qc_cx_unbind(mut_cx5) else mut_cx5 in
  let mut_cx7 = QcCx { g: mut_cx6.g, def: mut_cx6.def, effects: f.effects, tps: mut_cx6.tps, eps: mut_cx6.eps, frames: mut_cx6.frames, ret: mut_cx6.ret, diags: mut_cx6.diags, start: mut_cx6.start, sub: mut_cx6.sub, locals: mut_cx6.locals, scope: mut_cx6.scope, deferred: mut_cx6.deferred, seq_lets: mut_cx6.seq_lets } in
  let body_res = qc_cx_expect(mut_cx7, f.body, ret_ty, "body") in
  let all_exprs = req_exprs ++ ens_exprs ++ [body_res.expr] in
  let fin = qc_cx_finish(body_res.cx, all_exprs) in
  match fin.res {
    None => QcCheckFnRes { diags: fin.diags, tf: None },
    Some(ok) =>
      let req_fin = match qc_list_slice(ok.exprs, 0, len(f.reqs)) { Some(xs) => xs, None => [] } in
      let ens_fin = match qc_list_slice(ok.exprs, len(f.reqs), len(f.reqs) + len(f.enss)) { Some(xs) => xs, None => [] } in
      let body_fin = list_at(ok.exprs, len(ok.exprs) - 1) in
      let tfn = QcTFn {
        def: f,
        locals: ok.locals,
        reqs: req_fin,
        enss: ens_fin,
        result_local: r_local_res.id,
        body: body_fin,
        instance: None
      } in
      QcCheckFnRes { diags: fin.diags, tf: Some(tfn) }
  }

fn qc_check_main_sig(f: QcFnDef, ret_ty: QcType, diags: List[QcDiag]) -> List[QcDiag] =
  let entry_hint = "the entry point must be `fn main(args: List[Str]) -> Int` (any effects)" in
  let d1 = if len(f.tparams) > 0 then
    push(diags, qc_diag_hint(qc_diag_type_mismatch(f.name, "tparams", "no type parameters", "[" ++ join(f.tparams, ", ") ++ "]"), entry_hint))
  else diags in
  let d2 = if len(f.params) != 1 || (list_at(f.params, 0)).ty != QcTList(QcTStr) then
    let found = join(map(f.params, fn(p: QcFieldType) => qc_print_type(p.ty)), ", ") in
    push(d1, qc_diag_hint(qc_diag_type_mismatch(f.name, "params", "(List[Str])", "(" ++ found ++ ")"), entry_hint))
  else d1 in
  if f.ret != QcTInt then
    push(d2, qc_diag_hint(qc_diag_type_mismatch(f.name, "ret", "Int", qc_print_type(f.ret)), entry_hint))
  else d2

fn qc_check_fn_params_loop(g: QcGlobals, f: QcFnDef, params: List[QcFieldType], diags: List[QcDiag], idx: Int, acc: Accum[QcType], seen: List[Str]) -> QcDiagTypesRes =
  if idx >= len(params) then QcDiagTypesRes { diags: diags, tys: acc_list(acc) }
  else
    let p = list_at(params, idx) in
    let path = "params[" ++ from_int(idx) ++ "]" in
    let d1 = if qc_contains_str_loop(seen, p.name, 0) then
      push(diags, qc_diag_duplicate_name(f.name, path, p.name))
    else diags in
    let d2 = if p.name == "r" && len(f.enss) > 0 then
      push(d1, qc_diag_hint(qc_diag_duplicate_name(f.name, path, p.name), "inside `ens`, `r` is the result; rename the parameter"))
    else d1 in
    let res = qc_resolve_type(g, p.ty, f.tparams, f.eparams, f.name, path, d2) in
    let pty = match res.ty { Some(t) => t, None => QcTUnit } in
    qc_check_fn_params_loop(g, f, params, res.diags, idx + 1, AccPush(acc, pty), push(seen, p.name))

fn qc_check_unused_tparams_loop(def_name: Str, tparams: List[Str], ptypes: List[QcType], ret: QcType, diags: List[QcDiag], idx: Int) -> List[QcDiag] =
  if idx >= len(tparams) then diags
  else
    let tp = list_at(tparams, idx) in
    let p = QcTParam(tp) in
    let mentioned = fold(ptypes, qc_type_mentions(ret, p), fn(acc: Bool, t: QcType) => acc || qc_type_mentions(t, p)) in
    let next_diags = if !mentioned then
      push(diags, qc_diag_unused_type_param(def_name, "tparams[" ++ from_int(idx) ++ "]", tp))
    else diags in
    qc_check_unused_tparams_loop(def_name, tparams, ptypes, ret, next_diags, idx + 1)

fn qc_type_mentions(t: QcType, p: QcType) -> Bool =
  if t == p then true
  else
    match t {
      QcTList(x) => qc_type_mentions(x, p),
      QcTOption(x) => qc_type_mentions(x, p),
      QcTResult(a, b) => qc_type_mentions(a, p) || qc_type_mentions(b, p),
      QcTMap(a, b) => qc_type_mentions(a, p) || qc_type_mentions(b, p),
      QcTApp(_, args) => fold(args, false, fn(acc: Bool, a: QcType) => acc || qc_type_mentions(a, p)),
      QcTFn(ps, r, _) => fold(ps, qc_type_mentions(r, p), fn(acc: Bool, x: QcType) => acc || qc_type_mentions(x, p)),
      _ => false
    }

fn qc_check_fn_effects_loop(def_name: Str, effs: List[Str], eparams: List[Str], diags: List[QcDiag], idx: Int) -> List[QcDiag] =
  if idx >= len(effs) then diags
  else
    let ef = list_at(effs, idx) in
    let next_diags = if !qc_is_known_effect(ef) && !qc_contains_str_loop(eparams, ef, 0) then
      push(diags, qc_diag_hint(qc_diag_unknown_name(def_name, "effects[" ++ from_int(idx) ++ "]", ef), "known effects: io, fs, time, rand, net, db, model, tensor; an effect parameter is declared in the brackets: `fn " ++ def_name ++ "[!" ++ ef ++ "](...)`"))
    else diags in
    qc_check_fn_effects_loop(def_name, effs, eparams, next_diags, idx + 1)

# Effect parameters: at most one, not an effect's name, and determinable from a parameter.
fn qc_check_eparams(f: QcFnDef, ptypes: List[QcType], diags: List[QcDiag]) -> List[QcDiag] =
  let d1 = if len(f.eparams) > 1 then push(diags, qc_diag_effect_params(f.name, "eparams", f.eparams)) else diags in
  qc_check_eparams_loop(f, ptypes, d1, 0)

fn qc_check_eparams_loop(f: QcFnDef, ptypes: List[QcType], diags: List[QcDiag], idx: Int) -> List[QcDiag] =
  if idx >= len(f.eparams) then diags
  else
    let e = list_at(f.eparams, idx) in
    let path = "eparams[" ++ from_int(idx) ++ "]" in
    let next_diags = if qc_is_known_effect(e) then
      push(diags, qc_diag_hint(qc_diag_duplicate_name(f.name, path, e), "`" ++ e ++ "` is an effect; an effect parameter needs another name, e.g. `!eff`"))
    else if !fold(ptypes, false, fn(acc: Bool, t: QcType) => acc || qc_type_mentions_effect(t, e)) then
      push(diags, qc_diag_effect_param_unused(f.name, path, e))
    else diags in
    qc_check_eparams_loop(f, ptypes, next_diags, idx + 1)

fn qc_cx_bind_fn_params_loop(cx: QcCx, params: List[QcFieldType], ptypes: List[QcType], idx: Int) -> QcCx =
  if idx >= len(params) || idx >= len(ptypes) then cx
  else
    let bind_res = qc_cx_bind(cx, (list_at(params, idx)).name, list_at(ptypes, idx)) in
    qc_cx_bind_fn_params_loop(bind_res.cx, params, ptypes, idx + 1)

fn qc_cx_expect_list_loop(cx: QcCx, exprs: List[QcExpr], want: QcType, prefix: Str, idx: Int, acc: Accum[QcTExpr]) -> QcCxExprsRes =
  if idx >= len(exprs) then QcCxExprsRes { cx: cx, exprs: acc_list(acc) }
  else
    let ep = prefix ++ "[" ++ from_int(idx) ++ "]" in
    let res = qc_cx_expect(cx, list_at(exprs, idx), want, ep) in
    qc_cx_expect_list_loop(res.cx, exprs, want, prefix, idx + 1, AccPush(acc, res.expr))

# Irregular recursion check for types
fn qc_irregular_recursion(tp: QcTProgram, diags: List[QcDiag]) -> List[QcDiag] =
  let n = len(tp.types) in
  if n == 0 || fold(tp.types, true, fn(acc: Bool, d: QcTypeDef) => acc && len(d.params) == 0) then diags
  else
    let edges = map(tp.types, fn(d: QcTypeDef) =>
      let f_types = match d.body {
        QcBodyRecord(fs) => map(fs, fn(f: QcFieldType) => f.ty),
        QcBodyEnum(vs) => fold(vs, [], fn(acc: List[QcType], v: QcVariant) => acc ++ v.fields)
      } in
      let refs = fold(f_types, AccEnd, fn(st: Accum[QcFieldType], t: QcType) => qc_collect_type_refs(t, st)) in
      map(filter(acc_list(refs), fn(r: QcFieldType) => qc_tp_has_type(tp, r.name)), fn(r: QcFieldType) =>
        QcTypeEdge { target: qc_tp_type_idx(tp, r.name), ty: r.ty }
      )
    ) in
    let succ = map(edges, fn(es: List[QcTypeEdge]) => map(es, fn(e: QcTypeEdge) => e.target)) in
    let init_tarjan = QcTarjanState {
      n: n,
      edges: succ,
      indices: map_new(),
      lowlinks: map_new(),
      on_stack: map_new(),
      stack: [],
      next_idx: 0,
      sccs: AccEnd
    } in
    let tarjan_res = qc_tarjan_loop(init_tarjan, 0) in
    let comp_map = qc_build_comp_map_loop(acc_list(tarjan_res.sccs), 0, map_new()) in
    qc_check_irreg_loop(tp.types, edges, comp_map, diags, 0)

type QcTypeEdge = {
  target: Int,
  ty: QcType
}

fn qc_collect_type_refs(t: QcType, acc: Accum[QcFieldType]) -> Accum[QcFieldType] =
  match t {
    QcTNamed(n) => AccPush(acc, QcFieldType { name: n, ty: t }),
    QcTApp(n, args) =>
      let st1 = AccPush(acc, QcFieldType { name: n, ty: t }) in
      fold(args, st1, fn(st: Accum[QcFieldType], a: QcType) => qc_collect_type_refs(a, st)),
    QcTList(x) => qc_collect_type_refs(x, acc),
    QcTOption(x) => qc_collect_type_refs(x, acc),
    QcTResult(a, b) => qc_collect_type_refs(b, qc_collect_type_refs(a, acc)),
    QcTMap(a, b) => qc_collect_type_refs(b, qc_collect_type_refs(a, acc)),
    QcTFn(ps, r, _) =>
      let st1 = fold(ps, acc, fn(st: Accum[QcFieldType], p: QcType) => qc_collect_type_refs(p, st)) in
      qc_collect_type_refs(r, st1),
    _ => acc
  }

fn qc_tp_has_type(tp: QcTProgram, name: Str) -> Bool =
  qc_tp_type_def(tp, name) != None

fn qc_tp_type_idx_loop(types: List[QcTypeDef], name: Str, idx: Int) -> Int =
  if idx >= len(types) then 0
  else if (list_at(types, idx)).name == name then idx
  else qc_tp_type_idx_loop(types, name, idx + 1)

fn qc_tp_type_idx(tp: QcTProgram, name: Str) -> Int =
  qc_tp_type_idx_loop(tp.types, name, 0)

fn qc_check_irreg_loop(types: List[QcTypeDef], edges: List[List[QcTypeEdge]], comp_map: Map[Int, Int], diags: List[QcDiag], i: Int) -> List[QcDiag] =
  if i >= len(types) then diags
  else
    let d = list_at(types, i) in
    let es = list_at(edges, i) in
    let i_comp = map_get(comp_map, i) in
    let diags_i = qc_check_irreg_edges_loop(d.name, es, i_comp, comp_map, diags, 0) in
    qc_check_irreg_loop(types, edges, comp_map, diags_i, i + 1)

fn qc_check_irreg_edges_loop(def_name: Str, es: List[QcTypeEdge], i_comp: Option[Int], comp_map: Map[Int, Int], diags: List[QcDiag], idx: Int) -> List[QcDiag] =
  if idx >= len(es) then diags
  else
    let e = list_at(es, idx) in
    let j_comp = map_get(comp_map, e.target) in
    let same_group = (i_comp != None) && (i_comp == j_comp) in
    let next_diags = match e.ty {
      QcTApp(_, args) if same_group =>
        let all_plain = fold(args, true, fn(acc: Bool, a: QcType) =>
          acc && (match a { QcTParam(_) => true, _ => false })
        ) in
        if !all_plain then push(diags, qc_diag_irregular_recursion(def_name, "", qc_print_type(e.ty)))
        else diags,
      _ => diags
    } in
    qc_check_irreg_edges_loop(def_name, es, i_comp, comp_map, next_diags, idx + 1)

fn qc_check_tparams(g: QcGlobals, def_name: Str, tparams: List[Str], diags: List[QcDiag]) -> List[QcDiag] =
  qc_check_tparams_loop(g, def_name, tparams, diags, 0, [])

fn qc_check_tparams_loop(g: QcGlobals, def_name: Str, tparams: List[Str], diags: List[QcDiag], idx: Int, seen: List[Str]) -> List[QcDiag] =
  if idx >= len(tparams) then diags
  else
    let tp = list_at(tparams, idx) in
    let path = "tparams[" ++ from_int(idx) ++ "]" in
    let next_diags = if qc_contains_str_loop(seen, tp, 0) then
      push(diags, qc_diag_duplicate_name(def_name, path, tp))
    else if qc_is_builtin_type_name(tp) || qc_g_type_def(g, tp) != None then
      push(diags, qc_diag_hint(qc_diag_duplicate_name(def_name, path, tp), "`" ++ tp ++ "` is already a type; choose another type parameter name"))
    else diags in
    qc_check_tparams_loop(g, def_name, tparams, next_diags, idx + 1, push(seen, tp))

# Globals collection
fn qc_legacy_prelude_names(p: QcProgram, is_new: fn(Str) -> Bool) -> List[Str] =
  fold(p.defs, [], fn(acc: List[Str], d: QcDef) =>
    match d {
      QcDefType(t) if !is_new(t.name) =>
        let clash = qc_prelude_is_reserved(t.name) || (match t.body {
          QcBodyEnum(vs) => fold(vs, false, fn(st: Bool, v: QcVariant) => st || qc_prelude_is_reserved(v.name)),
          _ => false
        }) in
        if clash then push(acc, t.name) else acc,
      _ => acc
    }
  )

fn qc_build_globals(p: QcProgram, is_new: fn(Str) -> Bool) -> QcGlobalsDiagsRes =
  let legacy = len(qc_legacy_prelude_names(p, is_new)) > 0 in
  let p_types = if legacy then [] else qc_prelude_types() in
  let g0_acc = fold(p_types, QcGlobalsFoldAcc {
    g: QcGlobals {
      tp: QcTProgram { types: [], fns: [], tests: [], generics: [] },
      fns: [],
      variants: [],
      type_index: map_new(),
      fn_index: map_new(),
      variant_index: map_new(),
      prelude: !legacy
    },
    idx: 0
  }, fn(st: QcGlobalsFoldAcc, t: QcTypeDef) =>
    let cur_g = st.g in
    let cur_idx = st.idx in
    let next_vars = match t.body {
      QcBodyEnum(vs) => fold(vs, cur_g.variants, fn(v_acc: List[QcVariantEntry], v: QcVariant) =>
        let tag = len(v_acc) - len(cur_g.variants) in
        push(v_acc, QcVariantEntry { name: v.name, enum_name: t.name, tag: tag, fields: v.fields })
      ),
      _ => cur_g.variants
    } in
    let next_tp = QcTProgram { types: push(cur_g.tp.types, t), fns: [], tests: [], generics: [] } in
    let next_idx = map_put(cur_g.type_index, t.name, cur_idx) in
    QcGlobalsFoldAcc { g: QcGlobals { tp: next_tp, fns: cur_g.fns, variants: next_vars, type_index: next_idx, fn_index: cur_g.fn_index, variant_index: qc_index_variants(next_vars, len(cur_g.variants), cur_g.variant_index), prelude: cur_g.prelude }, idx: cur_idx + 1 }
  ) in
  let g0 = g0_acc.g in
  # User types
  let res1 = qc_collect_user_types_loop(p.defs, g0, [], legacy, is_new, 0) in
  # Resolve type bodies
  let res2 = qc_resolve_type_bodies_loop(res1.g, res1.diags, legacy, 0) in
  # Check irregular recursion
  let diags3 = qc_irregular_recursion(res2.g.tp, res2.diags) in
  # Collect functions and tests
  let res4 = qc_collect_fn_signatures_loop(p.defs, res2.g, diags3, 0, 0, 0, map_new()) in
  QcGlobalsDiagsRes { g: res4.g, diags: res4.diags }

fn qc_collect_user_types_loop(defs: List[QcDef], g: QcGlobals, diags: List[QcDiag], legacy: Bool, is_new: fn(Str) -> Bool, idx: Int) -> QcGlobalsDiagsRes =
  if idx >= len(defs) then QcGlobalsDiagsRes { g: g, diags: diags }
  else
    match list_at(defs, idx) {
      QcDefType(t) =>
        let reserved = qc_prelude_is_reserved(t.name) && (!legacy || is_new(t.name)) in
        if reserved then
          let d = qc_diag_reserved_name(t.name, "", t.name) in
          qc_collect_user_types_loop(defs, g, push(diags, d), legacy, is_new, idx + 1)
        else if qc_is_builtin_type_name(t.name) then
          let d = qc_diag_hint(qc_diag_duplicate_name(t.name, "", t.name), "`" ++ t.name ++ "` is a built-in type") in
          qc_collect_user_types_loop(defs, g, push(diags, d), legacy, is_new, idx + 1)
        else if qc_g_type_def(g, t.name) != None then
          let d = qc_diag_duplicate_name(t.name, "", t.name) in
          qc_collect_user_types_loop(defs, g, push(diags, d), legacy, is_new, idx + 1)
        else
          let body_res = match t.body {
            QcBodyRecord(fs) =>
              let r_fields = qc_check_record_fields_dup_loop(t.name, fs, diags, 0, []) in
              QcDiagVariantsRes { diags: r_fields.diags, vars: g.variants },
            QcBodyEnum(vs) =>
              qc_check_enum_variants_dup_loop(t.name, vs, g, diags, legacy, is_new, 0, g.variants)
          } in
          let type_k = len(g.tp.types) in
          let next_tp = QcTProgram { types: push(g.tp.types, t), fns: g.tp.fns, tests: g.tp.tests, generics: g.tp.generics } in
          let next_g = QcGlobals { tp: next_tp, fns: g.fns, variants: body_res.vars, type_index: map_put(g.type_index, t.name, type_k), fn_index: g.fn_index, variant_index: qc_index_variants(body_res.vars, len(g.variants), g.variant_index), prelude: g.prelude } in
          qc_collect_user_types_loop(defs, next_g, body_res.diags, legacy, is_new, idx + 1),
      _ => qc_collect_user_types_loop(defs, g, diags, legacy, is_new, idx + 1)
    }

fn qc_check_record_fields_dup_loop(type_name: Str, fs: List[QcFieldType], diags: List[QcDiag], idx: Int, seen: List[Str]) -> QcDiagStrsRes =
  if idx >= len(fs) then QcDiagStrsRes { diags: diags, strs: seen }
  else
    let f = list_at(fs, idx) in
    let path = "fields." ++ f.name in
    let next_diags = if qc_contains_str_loop(seen, f.name, 0) then
      push(diags, qc_diag_duplicate_name(type_name, path, f.name))
    else diags in
    qc_check_record_fields_dup_loop(type_name, fs, next_diags, idx + 1, push(seen, f.name))

fn qc_check_enum_variants_dup_loop(type_name: Str, vs: List[QcVariant], g: QcGlobals, diags: List[QcDiag], legacy: Bool, is_new: fn(Str) -> Bool, idx: Int, vars_acc: List[QcVariantEntry]) -> QcDiagVariantsRes =
  if idx >= len(vs) then QcDiagVariantsRes { diags: diags, vars: vars_acc }
  else
    let v = list_at(vs, idx) in
    let path = "variants[" ++ from_int(idx) ++ "]" in
    let reserved = qc_prelude_is_reserved(v.name) && (!legacy || is_new(type_name)) in
    if reserved then
      let d = qc_diag_reserved_name(type_name, path, v.name) in
      qc_check_enum_variants_dup_loop(type_name, vs, g, push(diags, d), legacy, is_new, idx + 1, vars_acc)
    else if v.name == "None" || v.name == "Some" || v.name == "Ok" || v.name == "Err" || qc_g_find_variant(g, v.name) != None then
      let d0 = qc_diag_duplicate_name(type_name, path, v.name) in
      let d = if v.name == "None" || v.name == "Some" || v.name == "Ok" || v.name == "Err" then
        qc_diag_hint(d0, "`" ++ v.name ++ "` belongs to the built-in Option/Result")
      else d0 in
      qc_check_enum_variants_dup_loop(type_name, vs, g, push(diags, d), legacy, is_new, idx + 1, vars_acc)
    else
      let ventry = QcVariantEntry { name: v.name, enum_name: type_name, tag: idx, fields: v.fields } in
      qc_check_enum_variants_dup_loop(type_name, vs, g, diags, legacy, is_new, idx + 1, push(vars_acc, ventry))

fn qc_resolve_type_bodies_loop(g: QcGlobals, diags: List[QcDiag], legacy: Bool, k: Int) -> QcGlobalsDiagsRes =
  if k >= len(g.tp.types) then QcGlobalsDiagsRes { g: g, diags: diags }
  else
    let t = list_at(g.tp.types, k) in
    # The prelude types come first (their own type parameters are not checked against user types).
    let prelude_count = if legacy then 0 else len(qc_prelude_types()) in
    let diags_tp = if k >= prelude_count then qc_check_tparams(g, t.name, t.params, diags) else diags in
    let body_res = match t.body {
      QcBodyRecord(fs) =>
        let r_fields = qc_resolve_record_fields_loop(g, fs, t.params, t.name, diags_tp, 0, AccEnd) in
        QcResolvedBodyRes { diags: r_fields.diags, body: QcBodyRecord(r_fields.fields) },
      QcBodyEnum(vs) =>
        let r_vars = qc_resolve_enum_variants_loop(g, vs, t.params, t.name, diags_tp, 0, AccEnd) in
        QcResolvedBodyRes { diags: r_vars.diags, body: QcBodyEnum(r_vars.vars) }
    } in
    let diags_body = body_res.diags in
    let next_body = body_res.body in
    let next_types = qc_list_set(g.tp.types, k, QcTypeDef { name: t.name, params: t.params, body: next_body }) in
    let next_vars = match next_body {
      QcBodyEnum(nvs) => qc_update_variants_fields_loop(g.variants, t.name, nvs, 0),
      _ => g.variants
    } in
    let next_g = QcGlobals { tp: QcTProgram { types: next_types, fns: g.tp.fns, tests: g.tp.tests, generics: g.tp.generics }, fns: g.fns, variants: next_vars, type_index: g.type_index, fn_index: g.fn_index, variant_index: g.variant_index, prelude: g.prelude } in
    qc_resolve_type_bodies_loop(next_g, diags_body, legacy, k + 1)

fn qc_update_variants_fields_loop(vars: List[QcVariantEntry], type_name: Str, vs: List[QcVariant], idx: Int) -> List[QcVariantEntry] =
  if idx >= len(vs) then vars
  else
    let v = list_at(vs, idx) in
    let updated_vars = map(vars, fn(ve: QcVariantEntry) =>
      if ve.enum_name == type_name && ve.tag == idx then
        QcVariantEntry { name: ve.name, enum_name: ve.enum_name, tag: ve.tag, fields: v.fields }
      else ve
    ) in
    qc_update_variants_fields_loop(updated_vars, type_name, vs, idx + 1)

fn qc_resolve_record_fields_loop(g: QcGlobals, fs: List[QcFieldType], tparams: List[Str], def_name: Str, diags: List[QcDiag], idx: Int, acc: Accum[QcFieldType]) -> QcDiagFieldsRes =
  if idx >= len(fs) then QcDiagFieldsRes { diags: diags, fields: acc_list(acc) }
  else
    let f = list_at(fs, idx) in
    let res = qc_resolve_type(g, f.ty, tparams, [], def_name, "fields." ++ f.name, diags) in
    let next_f = QcFieldType { name: f.name, ty: match res.ty { Some(t) => t, None => QcTUnit } } in
    qc_resolve_record_fields_loop(g, fs, tparams, def_name, res.diags, idx + 1, AccPush(acc, next_f))

fn qc_resolve_enum_variants_loop(g: QcGlobals, vs: List[QcVariant], tparams: List[Str], def_name: Str, diags: List[QcDiag], idx: Int, acc: Accum[QcVariant]) -> QcDiagVariantsRes2 =
  if idx >= len(vs) then QcDiagVariantsRes2 { diags: diags, vars: acc_list(acc) }
  else
    let v = list_at(vs, idx) in
    let path = "variants[" ++ from_int(idx) ++ "]" in
    let v_fields = qc_resolve_variant_fields_loop(g, v.fields, tparams, def_name, path, diags, 0, AccEnd) in
    let next_v = QcVariant { name: v.name, fields: v_fields.tys } in
    qc_resolve_enum_variants_loop(g, vs, tparams, def_name, v_fields.diags, idx + 1, AccPush(acc, next_v))

fn qc_resolve_variant_fields_loop(g: QcGlobals, fields: List[QcType], tparams: List[Str], def_name: Str, path: Str, diags: List[QcDiag], idx: Int, acc: Accum[QcType]) -> QcDiagTypesRes =
  if idx >= len(fields) then QcDiagTypesRes { diags: diags, tys: acc_list(acc) }
  else
    let res = qc_resolve_type(g, list_at(fields, idx), tparams, [], def_name, path ++ ".fields[" ++ from_int(idx) ++ "]", diags) in
    let ty = match res.ty { Some(t) => t, None => QcTUnit } in
    qc_resolve_variant_fields_loop(g, fields, tparams, def_name, path, res.diags, idx + 1, AccPush(acc, ty))

fn qc_collect_fn_signatures_loop(defs: List[QcDef], g: QcGlobals, diags: List[QcDiag], idx: Int, fn_idx: Int, gen_idx: Int, seen: Map[Str, Bool]) -> QcGlobalsDiagsRes =
  if idx >= len(defs) then QcGlobalsDiagsRes { g: g, diags: diags }
  else
    let d = list_at(defs, idx) in
    match d {
      QcDefType(_) => qc_collect_fn_signatures_loop(defs, g, diags, idx + 1, fn_idx, gen_idx, seen),
      QcDefFn(f) =>
        let d_seen = if map_has(seen, f.name) then
          push(diags, qc_diag_duplicate_name(f.name, "", f.name))
        else if qc_builtin_is_name(f.name) then
          push(diags, qc_diag_builtin_name(f.name))
        else if f.name == "memory" || f.name == "qal_alloc" then
          push(diags, qc_diag_hint(qc_diag_duplicate_name(f.name, "", f.name), "`" ++ f.name ++ "` is reserved by the runtime"))
        else if f.name == "r" then
          push(diags, qc_diag_hint(qc_diag_duplicate_name(f.name, "", f.name), "`r` names the result inside `ens`; choose another function name"))
        else diags in
        let is_gen = len(f.tparams) > 0 in
        let cur_slot = if is_gen then gen_idx else fn_idx in
        let ptypes = map(f.params, fn(p: QcFieldType) =>
          match (qc_resolve_type(g, p.ty, f.tparams, f.eparams, f.name, "", [])).ty { Some(t) => t, None => QcTUnit }
        ) in
        let ret_ty = match (qc_resolve_type(g, f.ret, f.tparams, f.eparams, f.name, "", [])).ty { Some(t) => t, None => QcTUnit } in
        let sig = QcSig { tparams: f.tparams, eparams: f.eparams, params: ptypes, ret: ret_ty, effects: f.effects } in
        let next_fns = push(g.fns, QcFnEntry { name: f.name, idx: cur_slot, sig: sig }) in
        let next_index = if map_has(g.fn_index, f.name) then g.fn_index else map_put(g.fn_index, f.name, len(g.fns)) in
        let next_g = QcGlobals { tp: g.tp, fns: next_fns, variants: g.variants, type_index: g.type_index, fn_index: next_index, variant_index: g.variant_index, prelude: g.prelude } in
        let next_fn_idx = if is_gen then fn_idx else fn_idx + 1 in
        let next_gen_idx = if is_gen then gen_idx + 1 else gen_idx in
        qc_collect_fn_signatures_loop(defs, next_g, d_seen, idx + 1, next_fn_idx, next_gen_idx, map_put(seen, f.name, true)),
      QcDefTest(t) =>
        let d_seen = if map_has(seen, t.name) then
          push(diags, qc_diag_duplicate_name(t.name, "", t.name))
        else if qc_builtin_is_name(t.name) then
          push(diags, qc_diag_builtin_name(t.name))
        else if t.name == "memory" || t.name == "qal_alloc" then
          push(diags, qc_diag_hint(qc_diag_duplicate_name(t.name, "", t.name), "`" ++ t.name ++ "` is reserved by the runtime"))
        else diags in
        qc_collect_fn_signatures_loop(defs, g, d_seen, idx + 1, fn_idx, gen_idx, map_put(seen, t.name, true))
    }

# Main checker entry point
fn qc_check_stored(p: QcProgram, is_new: fn(Str) -> Bool) -> Result[QcTProgram, List[QcDiag]] =
  let g_res = qc_build_globals(p, is_new) in
  let g = g_res.g in
  let diags0 = g_res.diags in
  if fold(diags0, false, fn(acc: Bool, d: QcDiag) => acc || d.kind == "irregular_recursion") then
    Err(diags0)
  else
    let check_res = qc_check_defs_loop(p.defs, g, diags0, 0, AccEnd, AccEnd, AccEnd) in
    let tp0 = QcTProgram {
      types: g.tp.types,
      fns: check_res.fns,
      tests: check_res.tests,
      generics: check_res.gens
    } in
    if len(check_res.diags) > 0 then Err(check_res.diags)
    else qc_check_finish(tp0)

# Polymorphic recursion, monomorphisation and validation of a program whose definitions checked.
fn qc_check_finish(tp0: QcTProgram) -> Result[QcTProgram, List[QcDiag]] =
  match qc_check_mono(tp0) {
    Err(ds) => Err(ds),
    Ok(tp) =>
      match qc_mono_validate(tp) {
        Some(d) => Err([d]),
        None => Ok(tp)
      }
  }

# Polymorphic recursion and monomorphisation; validation is left to the caller.
fn qc_check_mono(tp0: QcTProgram) -> Result[QcTProgram, List[QcDiag]] =
      let diags2 = match qc_mono_polymorphic_recursion(tp0) {
        Some(d) => [d],
        None => []
      } in
      if len(diags2) > 0 then Err(diags2)
      else
        let mono_res = qc_monomorphise(tp0) in
        let diags3 = match mono_res.diag {
          Some(d) => push(diags2, d),
          None => diags2
        } in
        if len(diags3) > 0 then Err(diags3)
        else
          Ok(mono_res.tp)

fn qc_check_defs_loop(defs: List[QcDef], g: QcGlobals, diags: List[QcDiag], idx: Int, acc_fns: Accum[QcTFn], acc_gens: Accum[QcTFn], acc_tests: Accum[QcTTest]) -> QcCheckDefsRes =
  if idx >= len(defs) then QcCheckDefsRes { diags: diags, fns: acc_list(acc_fns), gens: acc_list(acc_gens), tests: acc_list(acc_tests) }
  else
    let d = list_at(defs, idx) in
    match d {
      QcDefType(_) => qc_check_defs_loop(defs, g, diags, idx + 1, acc_fns, acc_gens, acc_tests),
      QcDefFn(f) =>
        let fn_check = qc_check_fn(f, g, diags) in
        match fn_check.tf {
          Some(tf) =>
            if len(f.tparams) == 0 then
              qc_check_defs_loop(defs, g, fn_check.diags, idx + 1, AccPush(acc_fns, tf), acc_gens, acc_tests)
            else
              qc_check_defs_loop(defs, g, fn_check.diags, idx + 1, acc_fns, AccPush(acc_gens, tf), acc_tests),
          None => qc_check_defs_loop(defs, g, fn_check.diags, idx + 1, acc_fns, acc_gens, acc_tests)
        },
      QcDefTest(t) =>
        # A test may ask a model: tests always run in replay mode (recorded answers, no network),
        # so the `model` effect keeps them deterministic. No other effect.
        let cx0 = qc_cx_new(g, t.name, ["model"], diags) in
        let body_res = qc_cx_expect(cx0, t.body, QcTBool, "body") in
        let fin = qc_cx_finish(body_res.cx, [body_res.expr]) in
        match fin.res {
          None => qc_check_defs_loop(defs, g, fin.diags, idx + 1, acc_fns, acc_gens, acc_tests),
          Some(ok) =>
            let ttest = QcTTest { name: t.name, locals: ok.locals, body: list_at(ok.exprs, 0) } in
            qc_check_defs_loop(defs, g, fin.diags, idx + 1, acc_fns, acc_gens, AccPush(acc_tests, ttest))
        }
    }

fn qc_check(p: QcProgram) -> Result[QcTProgram, List[QcDiag]] =
  qc_check_stored(p, fn(_: Str) => true)

# CHECK_DELTA (incremental define): a declared function counts only by its signature. Its
# parameters are renamed qc_p0, qc_p1, ... (so none shadows the body), its contracts are dropped
# and its body is `todo()`; the Rust reference builds the same (`FnDef::declared`).
fn qc_declared(f: QcFnDef) -> QcFnDef =
  QcFnDef { name: f.name, tparams: f.tparams, eparams: f.eparams, params: qc_declared_params_loop(f.params, 0, AccEnd), ret: f.ret, effects: f.effects, reqs: [], enss: [], body: QcECall("todo", []) }

fn qc_declared_params_loop(ps: List[QcFieldType], idx: Int, acc: Accum[QcFieldType]) -> List[QcFieldType] =
  if idx >= len(ps) then acc_list(acc)
  else qc_declared_params_loop(ps, idx + 1, AccPush(acc, QcFieldType { name: "qc_p" ++ from_int(idx), ty: list_at(ps, idx).ty }))

# The program with the functions in `declared` reduced to `qc_declared`.
fn qc_declare(p: QcProgram, declared: Map[Str, Bool]) -> QcProgram =
  QcProgram { defs: map(p.defs, fn(d: QcDef) => match d {
    QcDefFn(f) => if map_has(declared, f.name) then QcDefFn(qc_declared(f)) else d,
    _ => d
  }) }

test qc_declare_test =
  match qc_parse("fn f(todo: Int) -> Int\n  req todo > 0\n= todo + g(1)\nfn g(x: Int) -> Int = x\ntest t = f(1) == 2") {
    Ok(p) =>
      match qc_check(qc_declare(p, map_put(map_new(), "f", true))) {
        Ok(tp) => len(tp.fns) == 2 && len(list_at(tp.fns, 0).reqs) == 0,
        Err(_) => false
      },
    Err(_) => false
  }

# Split checking (phase 5 §4.3): a large program is checked in work items of definition ranges,
# each in its own execution, so the memory of one execution stays bounded. Only programs whose
# globals have no diagnostics are split; any diagnostic falls back to the single pass, which
# keeps diagnostics and their order identical.
fn qc_check_globals_ok(p: QcProgram, is_new: fn(Str) -> Bool) -> Bool =
  len(qc_build_globals(p, is_new).diags) == 0

fn qc_defs_range_loop(defs: List[QcDef], idx: Int, hi: Int, acc: Accum[QcDef]) -> List[QcDef] =
  if idx >= hi || idx >= len(defs) then acc_list(acc)
  else qc_defs_range_loop(defs, idx + 1, hi, AccPush(acc, list_at(defs, idx)))

# The typed functions, generics and tests of the definitions `lo..hi`; None on any diagnostic.
fn qc_check_range(p: QcProgram, lo: Int, hi: Int) -> Option[QcTProgram] =
  let g_res = qc_build_globals(p, fn(_: Str) => true) in
  if len(g_res.diags) > 0 then None
  else
    let r = qc_check_defs_loop(qc_defs_range_loop(p.defs, lo, hi, AccEnd), g_res.g, [], 0, AccEnd, AccEnd, AccEnd) in
    if len(r.diags) > 0 then None
    else Some(QcTProgram { types: if lo == 0 then g_res.g.tp.types else [], fns: r.fns, tests: r.tests, generics: r.gens })

# Joins the fragments of `qc_check_range` in item order and monomorphises; validation follows in
# work items (`qc_mono_validate_range`), so the whole equals `qc_check(p)`.
# The first fragment carries the type definitions, so the join neither parses nor rebuilds globals.
fn qc_check_join(frags: List[QcTProgram]) -> Result[QcTProgram, List[QcDiag]] =
  let types = if len(frags) == 0 then [] else list_at(frags, 0).types in
  let fns = fold(frags, AccEnd, fn(a: Accum[QcTFn], f: QcTProgram) => fold(f.fns, a, fn(b: Accum[QcTFn], x: QcTFn) => AccPush(b, x))) in
  let gens = fold(frags, AccEnd, fn(a: Accum[QcTFn], f: QcTProgram) => fold(f.generics, a, fn(b: Accum[QcTFn], x: QcTFn) => AccPush(b, x))) in
  let tests = fold(frags, AccEnd, fn(a: Accum[QcTTest], f: QcTProgram) => fold(f.tests, a, fn(b: Accum[QcTTest], x: QcTTest) => AccPush(b, x))) in
  qc_check_mono(QcTProgram { types: types, fns: acc_list(fns), tests: acc_list(tests), generics: acc_list(gens) })

test qc_check_test =
  match qc_parse("fn add(x: Int, y: Int) -> Int = x + y\ntest t = add(1, 2) == 3") {
    Ok(p) =>
      match qc_check(p) {
        Ok(tp) => len(tp.fns) == 1 && len(tp.tests) == 1,
        Err(_) => false
      },
    Err(_) => false
  }
# WebAssembly binary encoder, instruction builder (Asm), and module builder (Mb) (spec §7: qc_enc)

type QcValType =
  | QcVI32
  | QcVI64
  | QcVF64

type QcRepr =
  | QcRI32
  | QcRI64
  | QcRF64

fn qc_repr_of(t: QcType) -> QcRepr =
  match t {
    QcTInt => QcRI64,
    QcTFloat => QcRF64,
    _ => QcRI32
  }

fn qc_repr_val(r: QcRepr) -> QcValType =
  match r {
    QcRI32 => QcVI32,
    QcRI64 => QcVI64,
    QcRF64 => QcVF64
  }

fn qc_val_of(t: QcType) -> QcValType =
  qc_repr_val(qc_repr_of(t))

fn qc_type_val(t: QcType) -> QcValType =
  qc_val_of(t)

fn qc_valtype_byte(v: QcValType) -> Int =
  match v {
    QcVI32 => 127, # 0x7F
    QcVI64 => 126, # 0x7E
    QcVF64 => 124  # 0x7C
  }

fn qc_repr_str(r: QcRepr) -> Str =
  match r {
    QcRI32 => "I32",
    QcRI64 => "I64",
    QcRF64 => "F64"
  }

type QcBlockType =
  | QcBtEmpty
  | QcBtResult(QcValType)

fn qc_blocktype_byte(bt: QcBlockType) -> Int =
  match bt {
    QcBtEmpty => 64, # 0x40
    QcBtResult(v) => qc_valtype_byte(v)
  }

type QcIns =
  | QcIUnreachable
  | QcIBlock(QcBlockType)
  | QcILoop(QcBlockType)
  | QcIIf(QcBlockType)
  | QcIElse
  | QcIEnd
  | QcIBr(Int)
  | QcIBrIf(Int)
  | QcIReturn
  | QcICall(Int)
  | QcICallIndirect(Int)
  | QcIReturnCall(Int)
  | QcIReturnCallIndirect(Int)
  | QcIDrop
  | QcISelect
  | QcILocalGet(Int)
  | QcILocalSet(Int)
  | QcILocalTee(Int)
  | QcIGlobalGet(Int)
  | QcIGlobalSet(Int)
  | QcII32Load(Int)
  | QcII64Load(Int)
  | QcII32Load8U(Int)
  | QcII32Store(Int)
  | QcII64Store(Int)
  | QcII32Store8(Int)
  | QcII64Store8(Int)
  | QcIMemorySize
  | QcIMemoryGrow
  | QcIMemoryCopy
  | QcII32Const(Int)
  | QcII64Const(Int)
  | QcIF64Const(Float)
  | QcII32Eqz
  | QcII32Eq
  | QcII32Ne
  | QcII32LtS
  | QcII32LtU
  | QcII32GtS
  | QcII32GtU
  | QcII32LeS
  | QcII32LeU
  | QcII32GeS
  | QcII32GeU
  | QcII64Eqz
  | QcII64Eq
  | QcII64Ne
  | QcII64LtS
  | QcII64LtU
  | QcII64GtS
  | QcII64GtU
  | QcII64LeS
  | QcII64LeU
  | QcII64GeS
  | QcII64GeU
  | QcIF64Eq
  | QcIF64Ne
  | QcIF64Lt
  | QcIF64Gt
  | QcIF64Le
  | QcIF64Ge
  | QcII32Add
  | QcII32Sub
  | QcII32Mul
  | QcII32And
  | QcII32Or
  | QcII32Xor
  | QcII32Shl
  | QcII32ShrU
  | QcII64Add
  | QcII64Sub
  | QcII64Mul
  | QcII64DivS
  | QcII64DivU
  | QcII64RemS
  | QcII64And
  | QcII64Or
  | QcII64Xor
  | QcII64Shl
  | QcII64ShrS
  | QcII64ShrU
  | QcIF64Neg
  | QcIF64Add
  | QcIF64Sub
  | QcIF64Mul
  | QcIF64Div
  | QcII32WrapI64
  | QcII64ExtendI32S
  | QcII64ExtendI32U
  | QcII64TruncF64S
  | QcIF64ConvertI64S
  | QcII64ReinterpretF64
  | QcIF64ReinterpretI64

fn qc_to_slot(r: QcRepr) -> Option[QcIns] =
  match r {
    QcRI32 => Some(QcII64ExtendI32U),
    QcRI64 => None,
    QcRF64 => Some(QcII64ReinterpretF64)
  }

fn qc_from_slot(r: QcRepr) -> Option[QcIns] =
  match r {
    QcRI32 => Some(QcII32WrapI64),
    QcRI64 => None,
    QcRF64 => Some(QcIF64ReinterpretI64)
  }

fn qc_i32_sign_ext(x: Int) -> Int =
  let u = bit_and(x, 4294967295) in
  if u >= 2147483648 then u - 4294967296 else u

fn qc_sleb_acc(n: Int, acc: Accum[Int]) -> Accum[Int] =
  qc_tform_put_int_loop(n, acc)

fn qc_sleb_i32_acc(n: Int, acc: Accum[Int]) -> Accum[Int] =
  qc_tform_put_int_loop(qc_i32_sign_ext(n), acc)

fn qc_memarg_acc(align: Int, offset: Int, acc: Accum[Int]) -> Accum[Int] =
  qc_varint_acc(offset, qc_varint_acc(align, acc))

fn qc_ins_acc(ins: QcIns, acc: Accum[Int]) -> Accum[Int] =
  match ins {
    QcIUnreachable => AccPush(acc, 0),
    QcIBlock(bt) => AccPush(AccPush(acc, 2), qc_blocktype_byte(bt)),
    QcILoop(bt) => AccPush(AccPush(acc, 3), qc_blocktype_byte(bt)),
    QcIIf(bt) => AccPush(AccPush(acc, 4), qc_blocktype_byte(bt)),
    QcIElse => AccPush(acc, 5),
    QcIEnd => AccPush(acc, 11),
    QcIBr(l) => qc_varint_acc(l, AccPush(acc, 12)),
    QcIBrIf(l) => qc_varint_acc(l, AccPush(acc, 13)),
    QcIReturn => AccPush(acc, 15),
    QcICall(f) => qc_varint_acc(f, AccPush(acc, 16)),
    QcICallIndirect(ty) => AccPush(qc_varint_acc(ty, AccPush(acc, 17)), 0),
    QcIReturnCall(f) => qc_varint_acc(f, AccPush(acc, 18)),
    QcIReturnCallIndirect(ty) => AccPush(qc_varint_acc(ty, AccPush(acc, 19)), 0),
    QcIDrop => AccPush(acc, 26),
    QcISelect => AccPush(acc, 27),
    QcILocalGet(l) => qc_varint_acc(l, AccPush(acc, 32)),
    QcILocalSet(l) => qc_varint_acc(l, AccPush(acc, 33)),
    QcILocalTee(l) => qc_varint_acc(l, AccPush(acc, 34)),
    QcIGlobalGet(g) => qc_varint_acc(g, AccPush(acc, 35)),
    QcIGlobalSet(g) => qc_varint_acc(g, AccPush(acc, 36)),
    QcII32Load(off) => qc_memarg_acc(2, off, AccPush(acc, 40)),
    QcII64Load(off) => qc_memarg_acc(3, off, AccPush(acc, 41)),
    QcII32Load8U(off) => qc_memarg_acc(0, off, AccPush(acc, 45)),
    QcII32Store(off) => qc_memarg_acc(2, off, AccPush(acc, 54)),
    QcII64Store(off) => qc_memarg_acc(3, off, AccPush(acc, 55)),
    QcII32Store8(off) => qc_memarg_acc(0, off, AccPush(acc, 58)),
    QcII64Store8(off) => qc_memarg_acc(0, off, AccPush(acc, 60)),
    QcIMemorySize => AccPush(AccPush(acc, 63), 0),
    QcIMemoryGrow => AccPush(AccPush(acc, 64), 0),
    QcIMemoryCopy => AccPush(AccPush(AccPush(AccPush(acc, 252), 10), 0), 0),
    QcII32Const(x) => qc_sleb_i32_acc(x, AccPush(acc, 65)),
    QcII64Const(x) => qc_sleb_acc(x, AccPush(acc, 66)),
    QcIF64Const(x) => qc_float_acc(x, AccPush(acc, 68)),
    QcII32Eqz => AccPush(acc, 69),
    QcII32Eq => AccPush(acc, 70),
    QcII32Ne => AccPush(acc, 71),
    QcII32LtS => AccPush(acc, 72),
    QcII32LtU => AccPush(acc, 73),
    QcII32GtS => AccPush(acc, 74),
    QcII32GtU => AccPush(acc, 75),
    QcII32LeS => AccPush(acc, 76),
    QcII32LeU => AccPush(acc, 77),
    QcII32GeS => AccPush(acc, 78),
    QcII32GeU => AccPush(acc, 79),
    QcII64Eqz => AccPush(acc, 80),
    QcII64Eq => AccPush(acc, 81),
    QcII64Ne => AccPush(acc, 82),
    QcII64LtS => AccPush(acc, 83),
    QcII64LtU => AccPush(acc, 84),
    QcII64GtS => AccPush(acc, 85),
    QcII64GtU => AccPush(acc, 86),
    QcII64LeS => AccPush(acc, 87),
    QcII64LeU => AccPush(acc, 88),
    QcII64GeS => AccPush(acc, 89),
    QcII64GeU => AccPush(acc, 90),
    QcIF64Eq => AccPush(acc, 97),
    QcIF64Ne => AccPush(acc, 98),
    QcIF64Lt => AccPush(acc, 99),
    QcIF64Gt => AccPush(acc, 100),
    QcIF64Le => AccPush(acc, 101),
    QcIF64Ge => AccPush(acc, 102),
    QcII32Add => AccPush(acc, 106),
    QcII32Sub => AccPush(acc, 107),
    QcII32Mul => AccPush(acc, 108),
    QcII32And => AccPush(acc, 113),
    QcII32Or => AccPush(acc, 114),
    QcII32Xor => AccPush(acc, 115),
    QcII32Shl => AccPush(acc, 116),
    QcII32ShrU => AccPush(acc, 118),
    QcII64Add => AccPush(acc, 124),
    QcII64Sub => AccPush(acc, 125),
    QcII64Mul => AccPush(acc, 126),
    QcII64DivS => AccPush(acc, 127),
    QcII64DivU => AccPush(acc, 128),
    QcII64RemS => AccPush(acc, 129),
    QcII64And => AccPush(acc, 131),
    QcII64Or => AccPush(acc, 132),
    QcII64Xor => AccPush(acc, 133),
    QcII64Shl => AccPush(acc, 134),
    QcII64ShrS => AccPush(acc, 135),
    QcII64ShrU => AccPush(acc, 136),
    QcIF64Neg => AccPush(acc, 154),
    QcIF64Add => AccPush(acc, 160),
    QcIF64Sub => AccPush(acc, 161),
    QcIF64Mul => AccPush(acc, 162),
    QcIF64Div => AccPush(acc, 163),
    QcII32WrapI64 => AccPush(acc, 167),
    QcII64ExtendI32S => AccPush(acc, 172),
    QcII64ExtendI32U => AccPush(acc, 173),
    QcII64TruncF64S => AccPush(acc, 176),
    QcIF64ConvertI64S => AccPush(acc, 185),
    QcII64ReinterpretF64 => AccPush(acc, 189),
    QcIF64ReinterpretI64 => AccPush(acc, 191)
  }

type QcAsm = {
  n_params: Int,
  n_locals: Int,
  locals: Accum[QcValType],
  bytes: Accum[Int]
}

type QcAsmLocalRes = {
  a: QcAsm,
  l: Int
}

fn qc_asm_new(n_params: Int) -> QcAsm =
  QcAsm { n_params: n_params, n_locals: 0, locals: AccEnd, bytes: AccEnd }

fn qc_asm_local(a: QcAsm, v: QcValType) -> QcAsmLocalRes =
  let l = a.n_params + a.n_locals in
  let a2 = QcAsm {
    n_params: a.n_params,
    n_locals: a.n_locals + 1,
    locals: AccPush(a.locals, v),
    bytes: a.bytes
  } in
  QcAsmLocalRes { a: a2, l: l }

fn qc_asm_i(a: QcAsm, ins: QcIns) -> QcAsm =
  QcAsm {
    n_params: a.n_params,
    n_locals: a.n_locals,
    locals: a.locals,
    bytes: qc_ins_acc(ins, a.bytes)
  }

fn qc_asm_all(a: QcAsm, inss: List[QcIns]) -> QcAsm =
  let b2 = fold(inss, a.bytes, fn(acc: Accum[Int], ins: QcIns) => qc_ins_acc(ins, acc)) in
  QcAsm {
    n_params: a.n_params,
    n_locals: a.n_locals,
    locals: a.locals,
    bytes: b2
  }

fn qc_asm_opt(a: QcAsm, opt_ins: Option[QcIns]) -> QcAsm =
  match opt_ins {
    Some(ins) => qc_asm_i(a, ins),
    None => a
  }

fn qc_asm_finish(a: QcAsm) -> Bytes =
  let llist = acc_list(a.locals) in
  let h0 = qc_varint_acc(len(llist), AccEnd) in
  let h1 = fold(llist, h0, fn(acc: Accum[Int], v: QcValType) =>
    AccPush(AccPush(acc, 1), qc_valtype_byte(v))
  ) in
  let body_bytes = bytes_from(acc_list(AccPush(a.bytes, 11))) in
  let header_bytes = bytes_from(acc_list(h1)) in
  let total_len = bytes_len(header_bytes) + bytes_len(body_bytes) in
  let len_prefix = bytes_from(acc_list(qc_varint_acc(total_len, AccEnd))) in
  bytes_join([len_prefix, header_bytes, body_bytes])

# Runtime helper identifiers (matching qal-wasm/src/rt.rs)
type QcShift =
  | QcShiftShl
  | QcShiftShrS
  | QcShiftShrU

type QcRt =
  | QcRtAlloc
  | QcRtArith(QcBinOp)
  | QcRtMulDiv(Int)
  | QcRtVariant1
  | QcRtOptFromPtr
  | QcRtResultFrom
  | QcRtResultUnitFrom
  | QcRtStrNew
  | QcRtStrLen
  | QcRtStrConcat
  | QcRtBytesEq
  | QcRtStrEq
  | QcRtStrSub
  | QcRtCharToByte
  | QcRtStrSlice
  | QcRtStrFind
  | QcRtStrContains
  | QcRtStrStartsWith
  | QcRtStrSplit
  | QcRtStrJoin
  | QcRtStrTrim
  | QcRtStrToInt
  | QcRtIntToStr
  | QcRtStrChars
  | QcRtStrCmp
  | QcRtStrCase(Bool)
  | QcRtStrReplace
  | QcRtStrIndexOf
  | QcRtCharCode
  | QcRtFromCharCode
  | QcRtListNew
  | QcRtListGet
  | QcRtListPush
  | QcRtListConcat
  | QcRtListReverse
  | QcRtListRange
  | QcRtListSort(Bool)
  | QcRtSift(Bool)
  | QcRtFloatToInt
  | QcRtRandChecked
  | QcRtMap(QcRepr, QcRepr)
  | QcRtFilter(QcRepr)
  | QcRtFold(QcRepr, QcRepr)
  | QcRtMapNode
  | QcRtMapBal
  | QcRtMapFind(Int)
  | QcRtMapGet(Int)
  | QcRtMapPut(Int)
  | QcRtMapDel(Int)
  | QcRtMapDelMin
  | QcRtMapSize
  | QcRtMapFill
  | QcRtMapEntries
  | QcRtMapKeys
  | QcRtMapValues
  | QcRtBytesGet
  | QcRtBytesSlice
  | QcRtBytesFrom
  | QcRtBytesToList
  | QcRtShift(QcShift)
  | QcRtListAt
  | QcRtBytesAt
  | QcRtAccList
  | QcRtBytesJoin

fn qc_rt_key(rt: QcRt) -> Str =
  match rt {
    QcRtAlloc => "Alloc",
    QcRtArith(op) => "Arith:" ++ from_int(qc_binop_tag(op)),
    QcRtMulDiv(n) => "MulDiv:" ++ from_int(n),
    QcRtVariant1 => "Variant1",
    QcRtOptFromPtr => "OptFromPtr",
    QcRtResultFrom => "ResultFrom",
    QcRtResultUnitFrom => "ResultUnitFrom",
    QcRtStrNew => "StrNew",
    QcRtStrLen => "StrLen",
    QcRtStrConcat => "StrConcat",
    QcRtBytesEq => "BytesEq",
    QcRtStrEq => "StrEq",
    QcRtStrSub => "StrSub",
    QcRtCharToByte => "CharToByte",
    QcRtStrSlice => "StrSlice",
    QcRtStrFind => "StrFind",
    QcRtStrContains => "StrContains",
    QcRtStrStartsWith => "StrStartsWith",
    QcRtStrSplit => "StrSplit",
    QcRtStrJoin => "StrJoin",
    QcRtStrTrim => "StrTrim",
    QcRtStrToInt => "StrToInt",
    QcRtIntToStr => "IntToStr",
    QcRtStrChars => "StrChars",
    QcRtStrCmp => "StrCmp",
    QcRtStrCase(u) => if u then "StrCase:1" else "StrCase:0",
    QcRtStrReplace => "StrReplace",
    QcRtStrIndexOf => "StrIndexOf",
    QcRtCharCode => "CharCode",
    QcRtFromCharCode => "FromCharCode",
    QcRtListNew => "ListNew",
    QcRtListGet => "ListGet",
    QcRtListPush => "ListPush",
    QcRtListConcat => "ListConcat",
    QcRtListReverse => "ListReverse",
    QcRtListRange => "ListRange",
    QcRtListSort(s) => if s then "ListSort:1" else "ListSort:0",
    QcRtSift(s) => if s then "Sift:1" else "Sift:0",
    QcRtFloatToInt => "FloatToInt",
    QcRtRandChecked => "RandChecked",
    QcRtMap(a, b) => "Map:" ++ qc_repr_str(a) ++ ":" ++ qc_repr_str(b),
    QcRtFilter(e) => "Filter:" ++ qc_repr_str(e),
    QcRtFold(a, e) => "Fold:" ++ qc_repr_str(a) ++ ":" ++ qc_repr_str(e),
    QcRtMapNode => "MapNode",
    QcRtMapBal => "MapBal",
    QcRtMapFind(c) => "MapFind:" ++ from_int(c),
    QcRtMapGet(c) => "MapGet:" ++ from_int(c),
    QcRtMapPut(c) => "MapPut:" ++ from_int(c),
    QcRtMapDel(c) => "MapDel:" ++ from_int(c),
    QcRtMapDelMin => "MapDelMin",
    QcRtMapSize => "MapSize",
    QcRtMapFill => "MapFill",
    QcRtMapEntries => "MapEntries",
    QcRtMapKeys => "MapKeys",
    QcRtMapValues => "MapValues",
    QcRtBytesGet => "BytesGet",
    QcRtBytesSlice => "BytesSlice",
    QcRtBytesFrom => "BytesFrom",
    QcRtBytesToList => "BytesToList",
    QcRtShift(s) => match s { QcShiftShl => "Shift:0", QcShiftShrS => "Shift:1", QcShiftShrU => "Shift:2" },
    QcRtListAt => "ListAt",
    QcRtBytesAt => "BytesAt",
    QcRtAccList => "AccList",
    QcRtBytesJoin => "BytesJoin"
  }

type QcArg =
  | QcArgConst(Int)
  | QcArgLocal(Int)

fn qc_arg_push(a: QcAsm, arg: QcArg) -> QcAsm =
  match arg {
    QcArgConst(c) => qc_asm_i(a, QcII32Const(c)),
    QcArgLocal(l) => qc_asm_i(a, QcILocalGet(l))
  }

type QcFailVal = {
  local: Int,
  repr: QcRepr
}

type QcImport = {
  name: Str,
  ty: Int
}

type QcExport = {
  name: Str,
  idx: Int
}

type QcFuncSig = {
  params: List[QcValType],
  results: List[QcValType]
}

type QcMb = {
  p: QcTProgram,
  types_map: Map[Str, Int],
  types_acc: Accum[Bytes],
  n_types: Int,
  imports: List[QcImport],
  func_tys: Map[Int, Int],
  func_bodies: Map[Int, Bytes],
  n_funcs: Int,
  rt: Map[Str, Int],
  eqs: Map[Str, Int],
  cmps: Map[Str, Int],
  strs: Map[Str, Int],
  data_chunks: Accum[Bytes],
  data_len: Int,
  bug: Option[Str],
  table_acc: Accum[Int],
  table_len: Int,
  fn_values: Map[Int, Int],
  max_pages: Int
}

type QcMbIdx = {
  m: QcMb,
  idx: Int
}

type QcMbAsm = {
  m: QcMb,
  a: QcAsm
}

type QcWasmOut = {
  wasm: Bytes,
  table_len: Int
}

fn qc_host_signature(name: Str) -> Option[QcFuncSig] =
  if name == "fail" then Some(QcFuncSig { params: [QcVI32, QcVI32, QcVI32, QcVI32], results: [] })
  else if name == "float_to_str" then Some(QcFuncSig { params: [QcVF64], results: [QcVI32] })
  else if name == "str_to_float" then Some(QcFuncSig { params: [QcVI32], results: [QcVI32, QcVF64] })
  else if name == "utf8_valid" || name == "sha256" then Some(QcFuncSig { params: [QcVI32], results: [QcVI32] })
  else if name == "io.print" then Some(QcFuncSig { params: [QcVI32], results: [] })
  else if name == "net.http" then Some(QcFuncSig { params: [QcVI32], results: [QcVI32] })
  else if name == "db.exec" || name == "db.query" || name == "model.ask" then Some(QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] })
  else if name == "tensor.matmul" then Some(QcFuncSig { params: [QcVI32, QcVI32, QcVI64], results: [QcVI32] })
  else if name == "io.read_line" || name == "io.read_all" then Some(QcFuncSig { params: [], results: [QcVI32] })
  else if name == "fs.read_file" then Some(QcFuncSig { params: [QcVI32], results: [QcVI32, QcVI32] })
  else if name == "fs.write_file" then Some(QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32, QcVI32] })
  else if name == "time.now_ms" then Some(QcFuncSig { params: [], results: [QcVI64] })
  else if name == "rand.rand_int" then Some(QcFuncSig { params: [QcVI64, QcVI64], results: [QcVI64] })
  else None

fn qc_mb_bug(m: QcMb, msg: Str) -> QcMb =
  match m.bug {
    Some(_) => m,
    None =>
      QcMb {
        p: m.p, types_map: m.types_map, types_acc: m.types_acc, n_types: m.n_types,
        imports: m.imports, func_tys: m.func_tys, func_bodies: m.func_bodies, n_funcs: m.n_funcs,
        rt: m.rt, eqs: m.eqs, cmps: m.cmps, strs: m.strs,
        data_chunks: m.data_chunks, data_len: m.data_len,
        bug: Some(msg),
        table_acc: m.table_acc, table_len: m.table_len, fn_values: m.fn_values, max_pages: m.max_pages
      }
  }

fn qc_valtypes_key_loop(vs: List[QcValType], idx: Int, acc: Str) -> Str =
  if idx >= len(vs) then acc
  else
    let s = match list_at(vs, idx) { QcVI32 => "i", QcVI64 => "I", QcVF64 => "F" } in
    qc_valtypes_key_loop(vs, idx + 1, acc ++ s)

fn qc_sig_encode(params: List[QcValType], results: List[QcValType]) -> Bytes =
  let a0 = qc_varint_acc(len(params), AccPush(AccEnd, 96)) in # 0x60
  let a1 = fold(params, a0, fn(st: Accum[Int], v: QcValType) => AccPush(st, qc_valtype_byte(v))) in
  let a2 = qc_varint_acc(len(results), a1) in
  let a3 = fold(results, a2, fn(st: Accum[Int], v: QcValType) => AccPush(st, qc_valtype_byte(v))) in
  bytes_from(acc_list(a3))

fn qc_mb_ty(m: QcMb, params: List[QcValType], results: List[QcValType]) -> QcMbIdx =
  let key = qc_valtypes_key_loop(params, 0, "") ++ "->" ++ qc_valtypes_key_loop(results, 0, "") in
  match map_get(m.types_map, key) {
    Some(idx) => QcMbIdx { m: m, idx: idx },
    None =>
      let idx = m.n_types in
      let sig_bytes = qc_sig_encode(params, results) in
      let m2 = QcMb {
        p: m.p,
        types_map: map_put(m.types_map, key, idx),
        types_acc: AccPush(m.types_acc, sig_bytes),
        n_types: idx + 1,
        imports: m.imports, func_tys: m.func_tys, func_bodies: m.func_bodies, n_funcs: m.n_funcs,
        rt: m.rt, eqs: m.eqs, cmps: m.cmps, strs: m.strs,
        data_chunks: m.data_chunks, data_len: m.data_len, bug: m.bug,
        table_acc: m.table_acc, table_len: m.table_len, fn_values: m.fn_values, max_pages: m.max_pages
      } in
      QcMbIdx { m: m2, idx: idx }
  }

fn qc_max_tags_loop(types: List[QcTypeDef], idx: Int, cur: Int) -> Int =
  if idx >= len(types) then cur
  else
    let t = list_at(types, idx) in
    let n = match t.body {
      QcBodyEnum(vs) => len(vs),
      QcBodyRecord(_) => 0
    } in
    let next_cur = if n > cur then n else cur in
    qc_max_tags_loop(types, idx + 1, next_cur)

fn qc_u32_le_acc(w: Int, acc: Accum[Int]) -> Accum[Int] =
  let a0 = AccPush(acc, bit_and(w, 255)) in
  let a1 = AccPush(a0, bit_and(ushr(w, 8), 255)) in
  let a2 = AccPush(a1, bit_and(ushr(w, 16), 255)) in
  AccPush(a2, bit_and(ushr(w, 24), 255))

fn qc_init_tag_table_loop(tag: Int, max_tags: Int, acc: Accum[Int]) -> Accum[Int] =
  if tag >= max_tags then acc
  else
    let a1 = qc_u32_le_acc(tag, acc) in
    let a2 = AccPush(AccPush(AccPush(AccPush(a1, 0), 0), 0), 0) in
    qc_init_tag_table_loop(tag + 1, max_tags, a2)

fn qc_mb_add_imports_loop(m: QcMb, imports: List[Str], idx: Int) -> QcMb =
  if idx >= len(imports) then m
  else
    let name = list_at(imports, idx) in
    match qc_host_signature(name) {
      None => qc_mb_add_imports_loop(qc_mb_bug(m, "unknown host function `" ++ name ++ "`"), imports, idx + 1),
      Some(sig) =>
        let r = qc_mb_ty(m, sig.params, sig.results) in
        let m1 = r.m in
        let m2 = QcMb {
          p: m1.p, types_map: m1.types_map, types_acc: m1.types_acc, n_types: m1.n_types,
          imports: push(m1.imports, QcImport { name: name, ty: r.idx }),
          func_tys: m1.func_tys, func_bodies: m1.func_bodies, n_funcs: m1.n_funcs,
          rt: m1.rt, eqs: m1.eqs, cmps: m1.cmps, strs: m1.strs,
          data_chunks: m1.data_chunks, data_len: m1.data_len, bug: m1.bug,
          table_acc: m1.table_acc, table_len: m1.table_len, fn_values: m1.fn_values, max_pages: m1.max_pages
        } in
        qc_mb_add_imports_loop(m2, imports, idx + 1)
    }

fn qc_mb_new(p: QcTProgram, imports: List[Str], max_pages: Int) -> QcMb =
  let max_tags = qc_max_tags_loop(p.types, 0, 2) in
  let oom_zeros = AccPush(AccPush(AccPush(AccPush(AccPush(AccPush(AccPush(AccPush(AccEnd, 0), 0), 0), 0), 0), 0), 0), 0) in
  let init_bytes = bytes_from(acc_list(qc_init_tag_table_loop(0, max_tags, oom_zeros))) in
  let m0 = QcMb {
    p: p,
    types_map: map_new(),
    types_acc: AccEnd,
    n_types: 0,
    imports: [],
    func_tys: map_new(),
    func_bodies: map_new(),
    n_funcs: 0,
    rt: map_new(),
    eqs: map_new(),
    cmps: map_new(),
    strs: map_new(),
    data_chunks: AccPush(AccEnd, init_bytes),
    data_len: bytes_len(init_bytes),
    bug: None,
    table_acc: AccEnd,
    table_len: 0,
    fn_values: map_new(),
    max_pages: max_pages
  } in
  qc_mb_add_imports_loop(m0, imports, 0)

fn qc_find_import_loop(imports: List[QcImport], name: Str, idx: Int) -> Option[Int] =
  if idx >= len(imports) then None
  else
    let imp = list_at(imports, idx) in
    if imp.name == name then Some(idx)
    else qc_find_import_loop(imports, name, idx + 1)

fn qc_mb_import(m: QcMb, name: Str) -> QcMbIdx =
  match qc_find_import_loop(m.imports, name, 0) {
    Some(idx) => QcMbIdx { m: m, idx: idx },
    None => QcMbIdx { m: qc_mb_bug(m, "host import `" ++ name ++ "` not declared"), idx: 0 }
  }

fn qc_mb_declare(m: QcMb, params: List[QcValType], results: List[QcValType]) -> QcMbIdx =
  let tr = qc_mb_ty(m, params, results) in
  let m1 = tr.m in
  let f_slot = m1.n_funcs in
  let index = len(m1.imports) + f_slot in
  let m2 = QcMb {
    p: m1.p, types_map: m1.types_map, types_acc: m1.types_acc, n_types: m1.n_types,
    imports: m1.imports,
    func_tys: map_put(m1.func_tys, f_slot, tr.idx),
    func_bodies: m1.func_bodies,
    n_funcs: f_slot + 1,
    rt: m1.rt, eqs: m1.eqs, cmps: m1.cmps, strs: m1.strs,
    data_chunks: m1.data_chunks, data_len: m1.data_len, bug: m1.bug,
    table_acc: m1.table_acc, table_len: m1.table_len, fn_values: m1.fn_values, max_pages: m1.max_pages
  } in
  QcMbIdx { m: m2, idx: index }

fn qc_mb_define(m: QcMb, index: Int, f_bytes: Bytes) -> QcMb =
  let f_slot = index - len(m.imports) in
  if f_slot < 0 || f_slot >= m.n_funcs then
    qc_mb_bug(m, "function index " ++ from_int(index) ++ " is not declared")
  else
    QcMb {
      p: m.p, types_map: m.types_map, types_acc: m.types_acc, n_types: m.n_types,
      imports: m.imports, func_tys: m.func_tys,
      func_bodies: map_put(m.func_bodies, f_slot, f_bytes),
      n_funcs: m.n_funcs,
      rt: m.rt, eqs: m.eqs, cmps: m.cmps, strs: m.strs,
      data_chunks: m.data_chunks, data_len: m.data_len, bug: m.bug,
      table_acc: m.table_acc, table_len: m.table_len, fn_values: m.fn_values, max_pages: m.max_pages
    }

fn qc_zeros_acc(count: Int, acc: Accum[Int]) -> Accum[Int] =
  if count <= 0 then acc
  else qc_zeros_acc(count - 1, AccPush(acc, 0))

fn qc_mb_str_addr(m: QcMb, s: Str) -> QcMbIdx =
  match map_get(m.strs, s) {
    Some(addr) => QcMbIdx { m: m, idx: addr },
    None =>
      let rem = m.data_len % 8 in
      let pad = if rem == 0 then 0 else 8 - rem in
      let addr = m.data_len + pad in
      let sb = to_bytes(s) in
      let slen = bytes_len(sb) in
      let hdr = bytes_from(acc_list(qc_u32_le_acc(slen, qc_zeros_acc(pad, AccEnd)))) in
      let chunks2 = AccPush(AccPush(m.data_chunks, hdr), sb) in
      let m2 = QcMb {
        p: m.p, types_map: m.types_map, types_acc: m.types_acc, n_types: m.n_types,
        imports: m.imports, func_tys: m.func_tys, func_bodies: m.func_bodies, n_funcs: m.n_funcs,
        rt: m.rt, eqs: m.eqs, cmps: m.cmps,
        strs: map_put(m.strs, s, addr),
        data_chunks: chunks2,
        data_len: addr + 4 + slen,
        bug: m.bug,
        table_acc: m.table_acc, table_len: m.table_len, fn_values: m.fn_values, max_pages: m.max_pages
      } in
      QcMbIdx { m: m2, idx: addr }
  }

fn qc_mb_table_slot(m: QcMb, f: Int) -> QcMbIdx =
  let slot = m.table_len in
  let m2 = QcMb {
    p: m.p, types_map: m.types_map, types_acc: m.types_acc, n_types: m.n_types,
    imports: m.imports, func_tys: m.func_tys, func_bodies: m.func_bodies, n_funcs: m.n_funcs,
    rt: m.rt, eqs: m.eqs, cmps: m.cmps, strs: m.strs,
    data_chunks: m.data_chunks, data_len: m.data_len, bug: m.bug,
    table_acc: AccPush(m.table_acc, f),
    table_len: slot + 1,
    fn_values: m.fn_values, max_pages: m.max_pages
  } in
  QcMbIdx { m: m2, idx: slot }

fn qc_mb_static_block(m: QcMb, words: List[Int]) -> QcMbIdx =
  let rem = m.data_len % 8 in
  let pad = if rem == 0 then 0 else 8 - rem in
  let addr = m.data_len + pad in
  let a0 = qc_zeros_acc(pad, AccEnd) in
  let a1 = fold(words, a0, fn(st: Accum[Int], w: Int) => qc_u32_le_acc(w, st)) in
  let blk = bytes_from(acc_list(a1)) in
  let m2 = QcMb {
    p: m.p, types_map: m.types_map, types_acc: m.types_acc, n_types: m.n_types,
    imports: m.imports, func_tys: m.func_tys, func_bodies: m.func_bodies, n_funcs: m.n_funcs,
    rt: m.rt, eqs: m.eqs, cmps: m.cmps, strs: m.strs,
    data_chunks: AccPush(m.data_chunks, blk),
    data_len: addr + 4 * len(words),
    bug: m.bug,
    table_acc: m.table_acc, table_len: m.table_len, fn_values: m.fn_values, max_pages: m.max_pages
  } in
  QcMbIdx { m: m2, idx: addr }

fn qc_fn_wrapper_gets_loop(k: Int, count: Int, a: QcAsm) -> QcAsm =
  if k >= count then a
  else qc_fn_wrapper_gets_loop(k + 1, count, qc_asm_i(a, QcILocalGet(1 + k)))

fn qc_mb_fn_value(m: QcMb, f: Int, params: List[QcValType], ret: QcValType) -> QcMbIdx =
  match map_get(m.fn_values, f) {
    Some(addr) => QcMbIdx { m: m, idx: addr },
    None =>
      let wparams = [QcVI32] ++ params in
      let dr = qc_mb_declare(m, wparams, [ret]) in
      let w = dr.idx in
      let a0 = qc_asm_new(len(wparams)) in
      let a1 = qc_fn_wrapper_gets_loop(0, len(params), a0) in
      let a2 = qc_asm_i(a1, QcIReturnCall(f)) in
      let m2 = qc_mb_define(dr.m, w, qc_asm_finish(a2)) in
      let sr = qc_mb_table_slot(m2, w) in
      let br = qc_mb_static_block(sr.m, [sr.idx, 0]) in
      let m3 = br.m in
      let m4 = QcMb {
        p: m3.p, types_map: m3.types_map, types_acc: m3.types_acc, n_types: m3.n_types,
        imports: m3.imports, func_tys: m3.func_tys, func_bodies: m3.func_bodies, n_funcs: m3.n_funcs,
        rt: m3.rt, eqs: m3.eqs, cmps: m3.cmps, strs: m3.strs,
        data_chunks: m3.data_chunks, data_len: m3.data_len, bug: m3.bug,
        table_acc: m3.table_acc, table_len: m3.table_len,
        fn_values: map_put(m3.fn_values, f, br.idx),
        max_pages: m3.max_pages
      } in
      QcMbIdx { m: m4, idx: br.idx }
  }

fn qc_tag_addr(tag: Int) -> Int =
  8 + 8 * tag

fn qc_mb_rt(m: QcMb, key: QcRt) -> QcMbIdx =
  let kstr = qc_rt_key(key) in
  match map_get(m.rt, kstr) {
    Some(idx) => QcMbIdx { m: m, idx: idx },
    None =>
      let sig = qc_rt_signature(key) in
      let dr = qc_mb_declare(m, sig.params, sig.results) in
      let index = dr.idx in
      let m1 = dr.m in
      let m2 = QcMb {
        p: m1.p, types_map: m1.types_map, types_acc: m1.types_acc, n_types: m1.n_types,
        imports: m1.imports, func_tys: m1.func_tys, func_bodies: m1.func_bodies, n_funcs: m1.n_funcs,
        rt: map_put(m1.rt, kstr, index),
        eqs: m1.eqs, cmps: m1.cmps, strs: m1.strs,
        data_chunks: m1.data_chunks, data_len: m1.data_len, bug: m1.bug,
        table_acc: m1.table_acc, table_len: m1.table_len, fn_values: m1.fn_values, max_pages: m1.max_pages
      } in
      let br = qc_rt_body(key, m2, len(sig.params)) in
      let m3 = qc_mb_define(br.m, index, qc_asm_finish(br.a)) in
      QcMbIdx { m: m3, idx: index }
  }

fn qc_emit_fail_store_loop(a: QcAsm, ptr: Int, vals: List[QcFailVal], k: Int) -> QcAsm =
  if k >= len(vals) then a
  else
    let fv = list_at(vals, k) in
    let a1 = qc_asm_all(a, [QcILocalGet(ptr), QcILocalGet(fv.local)]) in
    let a2 = qc_asm_opt(a1, qc_to_slot(fv.repr)) in
    let a3 = qc_asm_i(a2, QcII64Store(8 * k)) in
    qc_emit_fail_store_loop(a3, ptr, vals, k + 1)

fn qc_mb_emit_fail(m: QcMb, a: QcAsm, kind: Int, func: QcArg, site: QcArg, vals: List[QcFailVal]) -> QcMbAsm =
  let lr = qc_asm_local(a, QcVI32) in
  let ptr = lr.l in
  let a0 = lr.a in
  let ma1 = if len(vals) == 0 then
    QcMbAsm { m: m, a: qc_asm_all(a0, [QcII32Const(0), QcILocalSet(ptr)]) }
  else
    let ar = qc_mb_rt(m, QcRtAlloc) in
    let a1 = qc_asm_all(a0, [QcII64Const(8 * len(vals)), QcICall(ar.idx), QcILocalSet(ptr)]) in
    let a2 = qc_emit_fail_store_loop(a1, ptr, vals, 0) in
    QcMbAsm { m: ar.m, a: a2 }
  in
  let a3 = qc_asm_i(ma1.a, QcII32Const(kind)) in
  let a4 = qc_arg_push(a3, func) in
  let a5 = qc_arg_push(a4, site) in
  let fr = qc_mb_import(ma1.m, "fail") in
  let a6 = qc_asm_all(a5, [QcILocalGet(ptr), QcICall(fr.idx), QcIUnreachable]) in
  QcMbAsm { m: fr.m, a: a6 }

# Structural equality and comparison generation (Mb::emit_eq, Mb::eq_fn, Mb::has_float, Mb::cmp_fn)
type QcFloatSeen = {
  res: Bool,
  seen: List[Str]
}

fn qc_has_float_fields_loop(p: QcTProgram, fs: List[QcFieldType], idx: Int, seen: List[Str]) -> QcFloatSeen =
  if idx >= len(fs) then QcFloatSeen { res: false, seen: seen }
  else
    let f = list_at(fs, idx) in
    let r = qc_has_float(p, f.ty, seen) in
    if r.res then r
    else qc_has_float_fields_loop(p, fs, idx + 1, r.seen)

fn qc_has_float_tys_loop(p: QcTProgram, tys: List[QcType], idx: Int, seen: List[Str]) -> QcFloatSeen =
  if idx >= len(tys) then QcFloatSeen { res: false, seen: seen }
  else
    let r = qc_has_float(p, list_at(tys, idx), seen) in
    if r.res then r
    else qc_has_float_tys_loop(p, tys, idx + 1, r.seen)

fn qc_has_float_variants_loop(p: QcTProgram, vs: List[QcVariant], idx: Int, seen: List[Str]) -> QcFloatSeen =
  if idx >= len(vs) then QcFloatSeen { res: false, seen: seen }
  else
    let v = list_at(vs, idx) in
    let r = qc_has_float_tys_loop(p, v.fields, 0, seen) in
    if r.res then r
    else qc_has_float_variants_loop(p, vs, idx + 1, r.seen)

fn qc_strs_contains(xs: List[Str], target: Str, idx: Int) -> Bool =
  if idx >= len(xs) then false
  else if list_at(xs, idx) == target then true
  else qc_strs_contains(xs, target, idx + 1)

fn qc_has_float(p: QcTProgram, t: QcType, seen: List[Str]) -> QcFloatSeen =
  if len(seen) >= 256 then QcFloatSeen { res: true, seen: seen }
  else
    match t {
      QcTFloat => QcFloatSeen { res: true, seen: seen },
      QcTList(x) => qc_has_float(p, x, seen),
      QcTOption(x) => qc_has_float(p, x, seen),
      QcTResult(a, b) =>
        let r1 = qc_has_float(p, a, seen) in
        if r1.res then r1 else qc_has_float(p, b, r1.seen),
      QcTMap(a, b) =>
        let r1 = qc_has_float(p, a, seen) in
        if r1.res then r1 else qc_has_float(p, b, r1.seen),
      QcTNamed(_) =>
        let key = qc_print_type(t) in
        if qc_strs_contains(seen, key, 0) then QcFloatSeen { res: false, seen: seen }
        else
          let seen2 = push(seen, key) in
          match qc_tp_decl(p, t) {
            Some(QcBodyRecord(fs)) => qc_has_float_fields_loop(p, fs, 0, seen2),
            Some(QcBodyEnum(vs)) => qc_has_float_variants_loop(p, vs, 0, seen2),
            None => QcFloatSeen { res: false, seen: seen2 }
          },
      QcTApp(_, _) =>
        let key = qc_print_type(t) in
        if qc_strs_contains(seen, key, 0) then QcFloatSeen { res: false, seen: seen }
        else
          let seen2 = push(seen, key) in
          match qc_tp_decl(p, t) {
            Some(QcBodyRecord(fs)) => qc_has_float_fields_loop(p, fs, 0, seen2),
            Some(QcBodyEnum(vs)) => qc_has_float_variants_loop(p, vs, 0, seen2),
            None => QcFloatSeen { res: false, seen: seen2 }
          },
      _ => QcFloatSeen { res: false, seen: seen }
    }

fn qc_mb_emit_eq(m: QcMb, a: QcAsm, t: QcType) -> QcMbAsm =
  match qc_repr_of(t) {
    QcRI64 => QcMbAsm { m: m, a: qc_asm_i(a, QcII64Eq) },
    QcRF64 => QcMbAsm { m: m, a: qc_asm_i(a, QcIF64Eq) },
    QcRI32 =>
      match t {
        QcTBool => QcMbAsm { m: m, a: qc_asm_i(a, QcII32Eq) },
        QcTUnit => QcMbAsm { m: m, a: qc_asm_i(a, QcII32Eq) },
        QcTFn(_, _, _) => QcMbAsm { m: m, a: qc_asm_i(a, QcII32Eq) },
        QcTBytes =>
          let r = qc_mb_rt(m, QcRtStrEq) in
          QcMbAsm { m: r.m, a: qc_asm_i(a, QcICall(r.idx)) },
        _ =>
          let r = qc_mb_eq_fn(m, t) in
          QcMbAsm { m: r.m, a: qc_asm_i(a, QcICall(r.idx)) }
      }
  }

fn qc_eq_field(m: QcMb, a: QcAsm, ft: QcType, offset: Int) -> QcMbAsm =
  let r = qc_repr_of(ft) in
  let a1 = qc_asm_opt(qc_asm_all(a, [QcILocalGet(0), QcII64Load(offset)]), qc_from_slot(r)) in
  let a2 = qc_asm_opt(qc_asm_all(a1, [QcILocalGet(1), QcII64Load(offset)]), qc_from_slot(r)) in
  let ma = qc_mb_emit_eq(m, a2, ft) in
  QcMbAsm { m: ma.m, a: qc_asm_all(ma.a, [QcII32Eqz, QcIIf(QcBtEmpty), QcII32Const(0), QcIReturn, QcIEnd]) }

fn qc_eq_record_fields_loop(m: QcMb, a: QcAsm, fs: List[QcFieldType], j: Int) -> QcMbAsm =
  if j >= len(fs) then QcMbAsm { m: m, a: a }
  else
    let f = list_at(fs, j) in
    let ma = qc_eq_field(m, a, f.ty, 8 * j) in
    qc_eq_record_fields_loop(ma.m, ma.a, fs, j + 1)

fn qc_eq_variant_fields_loop(m: QcMb, a: QcAsm, fs: List[QcType], j: Int) -> QcMbAsm =
  if j >= len(fs) then QcMbAsm { m: m, a: a }
  else
    let ft = list_at(fs, j) in
    let ma = qc_eq_field(m, a, ft, 8 + 8 * j) in
    qc_eq_variant_fields_loop(ma.m, ma.a, fs, j + 1)

fn qc_eq_variants_loop(m: QcMb, a: QcAsm, t: QcType, tag: Int, v: Int, count: Int) -> QcMbAsm =
  if v >= count then QcMbAsm { m: m, a: a }
  else
    let fields = qc_tp_variant_fields(m.p, t, v) in
    if len(fields) == 0 then
      qc_eq_variants_loop(m, a, t, tag, v + 1, count)
    else
      let a1 = qc_asm_all(a, [QcILocalGet(tag), QcII32Const(v), QcII32Eq, QcIIf(QcBtEmpty)]) in
      let ma = qc_eq_variant_fields_loop(m, a1, fields, 0) in
      let a2 = qc_asm_i(ma.a, QcIEnd) in
      qc_eq_variants_loop(ma.m, a2, t, tag, v + 1, count)

fn qc_mb_eq_fn(m: QcMb, t: QcType) -> QcMbIdx =
  match t {
    QcTStr => qc_mb_rt(m, QcRtStrEq),
    _ =>
      let tkey = qc_print_type(t) in
      match map_get(m.eqs, tkey) {
        Some(idx) => QcMbIdx { m: m, idx: idx },
        None =>
          let dr = qc_mb_declare(m, [QcVI32, QcVI32], [QcVI32]) in
          let index = dr.idx in
          let m1 = dr.m in
          let m2 = QcMb {
            p: m1.p, types_map: m1.types_map, types_acc: m1.types_acc, n_types: m1.n_types,
            imports: m1.imports, func_tys: m1.func_tys, func_bodies: m1.func_bodies, n_funcs: m1.n_funcs,
            rt: m1.rt,
            eqs: map_put(m1.eqs, tkey, index),
            cmps: m1.cmps, strs: m1.strs,
            data_chunks: m1.data_chunks, data_len: m1.data_len, bug: m1.bug,
            table_acc: m1.table_acc, table_len: m1.table_len, fn_values: m1.fn_values, max_pages: m1.max_pages
          } in
          let a0 = qc_asm_new(2) in
          let ma0 = match t {
            QcTMap(_, _) =>
              let er = qc_mb_rt(m2, QcRtMapEntries) in
              let a_ent = qc_asm_all(a0, [QcILocalGet(0), QcICall(er.idx), QcILocalSet(0), QcILocalGet(1), QcICall(er.idx), QcILocalSet(1)]) in
              QcMbAsm { m: er.m, a: a_ent },
            _ => QcMbAsm { m: m2, a: a0 }
          } in
          let hf = qc_has_float(ma0.m.p, t, []) in
          let a1 = if hf.res then ma0.a
          else qc_asm_all(ma0.a, [QcILocalGet(0), QcILocalGet(1), QcII32Eq, QcIIf(QcBtEmpty), QcII32Const(1), QcIReturn, QcIEnd]) in
          let ma_body = match t {
            QcTMap(kt, vt) =>
              let l1 = qc_asm_local(a1, QcVI32) in
              let l2 = qc_asm_local(l1.a, QcVI32) in
              let n = l1.l in
              let k = l2.l in
              let a2 = qc_asm_all(l2.a, [
                QcILocalGet(0), QcII32Load(0), QcILocalTee(n), QcILocalGet(1), QcII32Load(0), QcII32Ne,
                QcIIf(QcBtEmpty), QcII32Const(0), QcIReturn, QcIEnd,
                QcIBlock(QcBtEmpty), QcILoop(QcBtEmpty),
                QcILocalGet(k), QcILocalGet(n), QcII32GeU, QcIBrIf(1)
              ]) in
              let rk = qc_repr_of(kt) in
              let ak1 = qc_asm_opt(qc_asm_all(a2, [QcILocalGet(0), QcILocalGet(k), QcII32Const(4), QcII32Shl, QcII32Add, QcII64Load(8)]), qc_from_slot(rk)) in
              let ak2 = qc_asm_opt(qc_asm_all(ak1, [QcILocalGet(1), QcILocalGet(k), QcII32Const(4), QcII32Shl, QcII32Add, QcII64Load(8)]), qc_from_slot(rk)) in
              let mak = qc_mb_emit_eq(ma0.m, ak2, kt) in
              let ak3 = qc_asm_all(mak.a, [QcII32Eqz, QcIIf(QcBtEmpty), QcII32Const(0), QcIReturn, QcIEnd]) in
              let rv = qc_repr_of(vt) in
              let av1 = qc_asm_opt(qc_asm_all(ak3, [QcILocalGet(0), QcILocalGet(k), QcII32Const(4), QcII32Shl, QcII32Add, QcII64Load(16)]), qc_from_slot(rv)) in
              let av2 = qc_asm_opt(qc_asm_all(av1, [QcILocalGet(1), QcILocalGet(k), QcII32Const(4), QcII32Shl, QcII32Add, QcII64Load(16)]), qc_from_slot(rv)) in
              let mav = qc_mb_emit_eq(mak.m, av2, vt) in
              let av3 = qc_asm_all(mav.a, [
                QcII32Eqz, QcIIf(QcBtEmpty), QcII32Const(0), QcIReturn, QcIEnd,
                QcILocalGet(k), QcII32Const(1), QcII32Add, QcILocalSet(k), QcIBr(0), QcIEnd, QcIEnd
              ]) in
              QcMbAsm { m: mav.m, a: av3 },
            QcTList(elem) =>
              let l1 = qc_asm_local(a1, QcVI32) in
              let l2 = qc_asm_local(l1.a, QcVI32) in
              let n = l1.l in
              let k = l2.l in
              let re = qc_repr_of(elem) in
              let a2 = qc_asm_all(l2.a, [
                QcILocalGet(0), QcII32Load(0), QcILocalTee(n), QcILocalGet(1), QcII32Load(0), QcII32Ne,
                QcIIf(QcBtEmpty), QcII32Const(0), QcIReturn, QcIEnd,
                QcIBlock(QcBtEmpty), QcILoop(QcBtEmpty),
                QcILocalGet(k), QcILocalGet(n), QcII32GeU, QcIBrIf(1)
              ]) in
              let a3 = qc_asm_opt(qc_asm_all(a2, [QcILocalGet(0), QcILocalGet(k), QcII32Const(3), QcII32Shl, QcII32Add, QcII64Load(8)]), qc_from_slot(re)) in
              let a4 = qc_asm_opt(qc_asm_all(a3, [QcILocalGet(1), QcILocalGet(k), QcII32Const(3), QcII32Shl, QcII32Add, QcII64Load(8)]), qc_from_slot(re)) in
              let mae = qc_mb_emit_eq(ma0.m, a4, elem) in
              let a5 = qc_asm_all(mae.a, [
                QcII32Eqz, QcIIf(QcBtEmpty), QcII32Const(0), QcIReturn, QcIEnd,
                QcILocalGet(k), QcII32Const(1), QcII32Add, QcILocalSet(k), QcIBr(0), QcIEnd, QcIEnd
              ]) in
              QcMbAsm { m: mae.m, a: a5 },
            _ =>
              if qc_tp_is_record(ma0.m.p, t) then
                qc_eq_record_fields_loop(ma0.m, a1, qc_tp_record_fields(ma0.m.p, t), 0)
              else
                let lt = qc_asm_local(a1, QcVI32) in
                let tag = lt.l in
                let a2 = qc_asm_all(lt.a, [
                  QcILocalGet(0), QcII32Load(0), QcILocalTee(tag), QcILocalGet(1), QcII32Load(0), QcII32Ne,
                  QcIIf(QcBtEmpty), QcII32Const(0), QcIReturn, QcIEnd
                ]) in
                let vcount = len(qc_tp_variant_names(ma0.m.p, t)) in
                qc_eq_variants_loop(ma0.m, a2, t, tag, 0, vcount)
          } in
          let a_end = qc_asm_i(ma_body.a, QcII32Const(1)) in
          let m_final = qc_mb_define(ma_body.m, index, qc_asm_finish(a_end)) in
          QcMbIdx { m: m_final, idx: index }
      }
  }

fn qc_signed3(a: QcAsm, x: Int, y: Int) -> QcAsm =
  qc_asm_all(a, [QcILocalGet(x), QcILocalGet(y), QcII64GtS, QcILocalGet(x), QcILocalGet(y), QcII64LtS, QcII32Sub])

fn qc_cmp_field(m: QcMb, a: QcAsm, pa: Int, pb: Int, off: Int, ft: QcType, c: Int) -> QcMbAsm =
  let cr = qc_mb_cmp_fn(m, ft) in
  let a1 = qc_asm_all(a, [
    QcILocalGet(pa), QcII64Load(off), QcILocalGet(pb), QcII64Load(off), QcICall(cr.idx), QcILocalTee(c),
    QcIIf(QcBtEmpty), QcILocalGet(c), QcIReturn, QcIEnd
  ]) in
  QcMbAsm { m: cr.m, a: a1 }

fn qc_cmp_record_fields_loop(m: QcMb, a: QcAsm, pa: Int, pb: Int, c: Int, fs: List[QcFieldType], j: Int) -> QcMbAsm =
  if j >= len(fs) then QcMbAsm { m: m, a: a }
  else
    let f = list_at(fs, j) in
    let ma = qc_cmp_field(m, a, pa, pb, 8 * j, f.ty, c) in
    qc_cmp_record_fields_loop(ma.m, ma.a, pa, pb, c, fs, j + 1)

fn qc_cmp_variant_fields_loop(m: QcMb, a: QcAsm, pa: Int, pb: Int, c: Int, fs: List[QcType], j: Int) -> QcMbAsm =
  if j >= len(fs) then QcMbAsm { m: m, a: a }
  else
    let ft = list_at(fs, j) in
    let ma = qc_cmp_field(m, a, pa, pb, 8 + 8 * j, ft, c) in
    qc_cmp_variant_fields_loop(ma.m, ma.a, pa, pb, c, fs, j + 1)

fn qc_cmp_variants_loop(m: QcMb, a: QcAsm, t: QcType, pa: Int, pb: Int, ta: Int, c: Int, v: Int, count: Int) -> QcMbAsm =
  if v >= count then QcMbAsm { m: m, a: a }
  else
    let fields = qc_tp_variant_fields(m.p, t, v) in
    if len(fields) == 0 then
      qc_cmp_variants_loop(m, a, t, pa, pb, ta, c, v + 1, count)
    else
      let a1 = qc_asm_all(a, [QcILocalGet(ta), QcII64Const(v), QcII64Eq, QcIIf(QcBtEmpty)]) in
      let ma = qc_cmp_variant_fields_loop(m, a1, pa, pb, c, fields, 0) in
      let a2 = qc_asm_i(ma.a, QcIEnd) in
      qc_cmp_variants_loop(ma.m, a2, t, pa, pb, ta, c, v + 1, count)

fn qc_mb_cmp_seq(m: QcMb, a: QcAsm, c: Int, is_map: Bool, width: Int, kt: QcType, vt: Option[QcType]) -> QcMbAsm =
  let ma0 = if is_map then
    let er = qc_mb_rt(m, QcRtMapEntries) in
    let a_ent = qc_asm_all(a, [
      QcILocalGet(0), QcII32WrapI64, QcICall(er.idx), QcII64ExtendI32U, QcILocalSet(0),
      QcILocalGet(1), QcII32WrapI64, QcICall(er.idx), QcII64ExtendI32U, QcILocalSet(1)
    ]) in
    QcMbAsm { m: er.m, a: a_ent }
  else
    QcMbAsm { m: m, a: a }
  in
  let l_pa = qc_asm_local(ma0.a, QcVI32) in
  let l_pb = qc_asm_local(l_pa.a, QcVI32) in
  let l_n = qc_asm_local(l_pb.a, QcVI32) in
  let l_m = qc_asm_local(l_n.a, QcVI32) in
  let l_k = qc_asm_local(l_m.a, QcVI32) in
  let pa = l_pa.l in
  let pb = l_pb.l in
  let n = l_n.l in
  let m_loc = l_m.l in
  let k = l_k.l in
  let a1 = qc_asm_all(l_k.a, [
    QcILocalGet(0), QcII32WrapI64, QcILocalTee(pa), QcII32Load(0), QcILocalSet(n),
    QcILocalGet(1), QcII32WrapI64, QcILocalTee(pb), QcII32Load(0), QcILocalSet(m_loc),
    QcIBlock(QcBtEmpty), QcILoop(QcBtEmpty),
    QcILocalGet(k), QcILocalGet(n), QcII32GeU, QcILocalGet(k), QcILocalGet(m_loc), QcII32GeU, QcII32Or, QcIBrIf(1)
  ]) in
  let l_ea = qc_asm_local(a1, QcVI32) in
  let l_eb = qc_asm_local(l_ea.a, QcVI32) in
  let ea = l_ea.l in
  let eb = l_eb.l in
  let a2 = qc_asm_all(l_eb.a, [
    QcILocalGet(pa), QcILocalGet(k), QcII32Const(width), QcII32Mul, QcII32Add, QcILocalSet(ea),
    QcILocalGet(pb), QcILocalGet(k), QcII32Const(width), QcII32Mul, QcII32Add, QcILocalSet(eb)
  ]) in
  let ma1 = qc_cmp_field(ma0.m, a2, ea, eb, 8, kt, c) in
  let ma2 = match vt {
    Some(vty) => qc_cmp_field(ma1.m, ma1.a, ea, eb, 16, vty, c),
    None => ma1
  } in
  let a3 = qc_asm_all(ma2.a, [
    QcILocalGet(k), QcII32Const(1), QcII32Add, QcILocalSet(k), QcIBr(0), QcIEnd, QcIEnd,
    QcILocalGet(n), QcILocalGet(m_loc), QcII32GtU, QcILocalGet(n), QcILocalGet(m_loc), QcII32LtU, QcII32Sub
  ]) in
  QcMbAsm { m: ma2.m, a: a3 }

fn qc_mb_cmp_enum(m: QcMb, a: QcAsm, t: QcType, c: Int) -> QcMbAsm =
  let l_pa = qc_asm_local(a, QcVI32) in
  let l_pb = qc_asm_local(l_pa.a, QcVI32) in
  let l_ta = qc_asm_local(l_pb.a, QcVI64) in
  let l_tb = qc_asm_local(l_ta.a, QcVI64) in
  let pa = l_pa.l in
  let pb = l_pb.l in
  let ta = l_ta.l in
  let tb = l_tb.l in
  let a1 = qc_asm_all(l_tb.a, [
    QcILocalGet(0), QcII32WrapI64, QcILocalTee(pa), QcII32Load(0), QcII64ExtendI32U, QcILocalSet(ta),
    QcILocalGet(1), QcII32WrapI64, QcILocalTee(pb), QcII32Load(0), QcII64ExtendI32U, QcILocalSet(tb)
  ]) in
  let a2 = qc_signed3(a1, ta, tb) in
  let a3 = qc_asm_all(a2, [QcILocalTee(c), QcIIf(QcBtEmpty), QcILocalGet(c), QcIReturn, QcIEnd]) in
  let vcount = len(qc_tp_variant_names(m.p, t)) in
  let ma = qc_cmp_variants_loop(m, a3, t, pa, pb, ta, c, 0, vcount) in
  QcMbAsm { m: ma.m, a: qc_asm_i(ma.a, QcII32Const(0)) }

fn qc_mb_cmp_fn(m: QcMb, t: QcType) -> QcMbIdx =
  let tkey = qc_print_type(t) in
  match map_get(m.cmps, tkey) {
    Some(idx) => QcMbIdx { m: m, idx: idx },
    None =>
      let dr = qc_mb_declare(m, [QcVI64, QcVI64], [QcVI32]) in
      let index = dr.idx in
      let m1 = dr.m in
      let m2 = QcMb {
        p: m1.p, types_map: m1.types_map, types_acc: m1.types_acc, n_types: m1.n_types,
        imports: m1.imports, func_tys: m1.func_tys, func_bodies: m1.func_bodies, n_funcs: m1.n_funcs,
        rt: m1.rt, eqs: m1.eqs,
        cmps: map_put(m1.cmps, tkey, index),
        strs: m1.strs, data_chunks: m1.data_chunks, data_len: m1.data_len, bug: m1.bug,
        table_acc: m1.table_acc, table_len: m1.table_len, fn_values: m1.fn_values, max_pages: m1.max_pages
      } in
      let a0 = qc_asm_new(2) in
      let lc = qc_asm_local(a0, QcVI32) in
      let c = lc.l in
      let a1 = lc.a in
      let ma_body = match t {
        QcTFloat =>
          let a2 = qc_asm_all(a1, [
            QcILocalGet(0), QcILocalGet(0), QcII64Const(63), QcII64ShrS, QcII64Const(1), QcII64ShrU, QcII64Xor, QcILocalSet(0),
            QcILocalGet(1), QcILocalGet(1), QcII64Const(63), QcII64ShrS, QcII64Const(1), QcII64ShrU, QcII64Xor, QcILocalSet(1)
          ]) in
          QcMbAsm { m: m2, a: qc_signed3(a2, 0, 1) },
        QcTStr =>
          let a2 = qc_asm_all(a1, [QcILocalGet(0), QcII32WrapI64, QcILocalGet(1), QcII32WrapI64]) in
          let sr = qc_mb_rt(m2, QcRtStrCmp) in
          QcMbAsm { m: sr.m, a: qc_asm_i(a2, QcICall(sr.idx)) },
        QcTBytes =>
          let a2 = qc_asm_all(a1, [QcILocalGet(0), QcII32WrapI64, QcILocalGet(1), QcII32WrapI64]) in
          let sr = qc_mb_rt(m2, QcRtStrCmp) in
          QcMbAsm { m: sr.m, a: qc_asm_i(a2, QcICall(sr.idx)) },
        QcTList(x) =>
          qc_mb_cmp_seq(m2, a1, c, false, 8, x, None),
        QcTMap(kt, vt) =>
          qc_mb_cmp_seq(m2, a1, c, true, 16, kt, Some(vt)),
        _ =>
          if qc_tp_is_record(m2.p, t) then
            let l_pa = qc_asm_local(a1, QcVI32) in
            let l_pb = qc_asm_local(l_pa.a, QcVI32) in
            let pa = l_pa.l in
            let pb = l_pb.l in
            let a2 = qc_asm_all(l_pb.a, [
              QcILocalGet(0), QcII32WrapI64, QcILocalSet(pa),
              QcILocalGet(1), QcII32WrapI64, QcILocalSet(pb)
            ]) in
            let ma_rec = qc_cmp_record_fields_loop(m2, a2, pa, pb, c, qc_tp_record_fields(m2.p, t), 0) in
            QcMbAsm { m: ma_rec.m, a: qc_asm_i(ma_rec.a, QcII32Const(0)) }
          else
            match t {
              QcTOption(_) => qc_mb_cmp_enum(m2, a1, t, c),
              QcTResult(_, _) => qc_mb_cmp_enum(m2, a1, t, c),
              QcTNamed(_) => qc_mb_cmp_enum(m2, a1, t, c),
              QcTApp(_, _) => qc_mb_cmp_enum(m2, a1, t, c),
              _ => QcMbAsm { m: m2, a: qc_signed3(a1, 0, 1) }
            }
      } in
      let m_final = qc_mb_define(ma_body.m, index, qc_asm_finish(ma_body.a)) in
      QcMbIdx { m: m_final, idx: index }
  }

# WASM section assembly (Mb::finish)
fn qc_uleb_size(n: Int) -> Int =
  let rest = ushr(n, 7) in
  if rest == 0 then 1
  else 1 + qc_uleb_size(rest)

fn qc_encode_section(sec_id: Int, count: Int, body: Bytes) -> Bytes =
  let sec_len = qc_uleb_size(count) + bytes_len(body) in
  let hdr = bytes_from(acc_list(qc_varint_acc(count, qc_varint_acc(sec_len, AccPush(AccEnd, sec_id))))) in
  bytes_join([hdr, body])

fn qc_func_sec_loop(func_tys: Map[Int, Int], i: Int, n_funcs: Int, acc: Accum[Int]) -> Bytes =
  if i >= n_funcs then bytes_from(acc_list(acc))
  else
    let ty = match map_get(func_tys, i) { Some(t) => t, None => 0 } in
    qc_func_sec_loop(func_tys, i + 1, n_funcs, qc_varint_acc(ty, acc))

type QcCodeSecRes = {
  body: Bytes,
  missing: Bool
}

fn qc_code_sec_build_loop(func_bodies: Map[Int, Bytes], i: Int, n_funcs: Int, acc: Accum[Bytes], missing: Bool) -> QcCodeSecRes =
  if i >= n_funcs then QcCodeSecRes { body: bytes_join(acc_list(acc)), missing: missing }
  else
    match map_get(func_bodies, i) {
      Some(b) => qc_code_sec_build_loop(func_bodies, i + 1, n_funcs, AccPush(acc, b), missing),
      None =>
        let empty_fn = bytes_from([1, 0]) in
        qc_code_sec_build_loop(func_bodies, i + 1, n_funcs, AccPush(acc, empty_fn), true)
    }

fn qc_mb_finish(m: QcMb, exports: List[QcExport]) -> Result[QcWasmOut, Str] =
  let table = acc_list(m.table_acc) in
  let table_len = len(table) in
  let ar = qc_mb_rt(m, QcRtAlloc) in
  let alloc = ar.idx in
  let m1 = ar.m in
  # 1. TypeSection (id = 1)
  let types_body = bytes_join(acc_list(m1.types_acc)) in
  let sec_types = qc_encode_section(1, m1.n_types, types_body) in
  # 2. ImportSection (id = 2)
  let imp_acc = fold(m1.imports, AccEnd, fn(st: Accum[Int], imp: QcImport) =>
    let s1 = qc_str_acc("qal_host", st) in
    let s2 = qc_str_acc(imp.name, s1) in
    qc_varint_acc(imp.ty, AccPush(s2, 0))
  ) in
  let sec_imports = qc_encode_section(2, len(m1.imports), bytes_from(acc_list(imp_acc))) in
  # 3. FunctionSection (id = 3) & 9. CodeSection (id = 10)
  let func_body = qc_func_sec_loop(m1.func_tys, 0, m1.n_funcs, AccEnd) in
  let sec_functions = qc_encode_section(3, m1.n_funcs, func_body) in
  let code_res = qc_code_sec_build_loop(m1.func_bodies, 0, m1.n_funcs, AccEnd, false) in
  let m2 = if code_res.missing then qc_mb_bug(m1, "a declared function has no body") else m1 in
  let sec_codes = qc_encode_section(10, m2.n_funcs, code_res.body) in
  # 4. TableSection (id = 4)
  let tbl_acc = qc_varint_acc(table_len, qc_varint_acc(table_len, AccPush(AccPush(AccEnd, 112), 1))) in # 0x70 = funcref, 0x01 = has max
  let sec_tables = qc_encode_section(4, 1, bytes_from(acc_list(tbl_acc))) in
  # Pad static data to 8-byte alignment
  let rem = m2.data_len % 8 in
  let pad = if rem == 0 then 0 else 8 - rem in
  let data_chunks_final = if pad == 0 then m2.data_chunks else AccPush(m2.data_chunks, bytes_from(acc_list(qc_zeros_acc(pad, AccEnd)))) in
  let data_bytes = bytes_join(acc_list(data_chunks_final)) in
  let heap_start = bytes_len(data_bytes) in
  # 5. MemorySection (id = 5)
  let minimum = (heap_start / 65536) + 1 in
  if minimum > m2.max_pages then
    Err("the module's static data needs " ++ from_int(minimum) ++ " memory pages, more than its maximum of " ++ from_int(m2.max_pages))
  else
    let mem_acc = qc_varint_acc(m2.max_pages, qc_varint_acc(minimum, AccPush(AccEnd, 1))) in
    let sec_memories = qc_encode_section(5, 1, bytes_from(acc_list(mem_acc))) in
    # 6. GlobalSection (id = 6): I32 (0x7F), mutable (1), ConstExpr::i32_const(heap_start), End (0x0B)
    let glob_acc = AccPush(qc_sleb_i32_acc(heap_start, AccPush(AccPush(AccPush(AccEnd, 127), 1), 65)), 11) in
    let sec_globals = qc_encode_section(6, 1, bytes_from(acc_list(glob_acc))) in
    # 7. ExportSection (id = 7)
    let exp_acc0 = fold(exports, AccEnd, fn(st: Accum[Int], ex: QcExport) =>
      qc_varint_acc(ex.idx, AccPush(qc_str_acc(ex.name, st), 0))
    ) in
    let exp_acc1 = qc_varint_acc(0, AccPush(qc_str_acc("memory", exp_acc0), 2)) in
    let exp_acc2 = qc_varint_acc(alloc, AccPush(qc_str_acc("qal_alloc", exp_acc1), 0)) in
    let sec_exports = qc_encode_section(7, len(exports) + 2, bytes_from(acc_list(exp_acc2))) in
    # 8. ElementSection (id = 9)
    let sec_elements = if table_len == 0 then
      qc_encode_section(9, 0, bytes_from([]))
    else
      # active(Some(0), ConstExpr::i32_const(0), Functions(table)) -> [0x02, 0x00, 0x41, 0x00, 0x0B, 0x00, vec(table)]
      let el0 = qc_varint_acc(table_len, AccPush(AccPush(AccPush(AccPush(AccPush(AccPush(AccEnd, 2), 0), 65), 0), 11), 0)) in
      let el1 = fold(table, el0, fn(st: Accum[Int], f: Int) => qc_varint_acc(f, st)) in
      qc_encode_section(9, 1, bytes_from(acc_list(el1)))
    in
    # 10. DataSection (id = 11): active(0, ConstExpr::i32_const(0), data) -> [0x00, 0x41, 0x00, 0x0B, uleb(len), data]
    let d_hdr = bytes_from(acc_list(qc_varint_acc(heap_start, AccPush(AccPush(AccPush(AccPush(AccEnd, 0), 65), 0), 11)))) in
    let sec_data = qc_encode_section(11, 1, bytes_join([d_hdr, data_bytes])) in
    match m2.bug {
      Some(b) => Err("internal compiler error: " ++ b),
      None =>
        let header = bytes_from([0, 97, 115, 109, 1, 0, 0, 0]) in
        let wasm = bytes_join([
          header,
          sec_types,
          sec_imports,
          sec_functions,
          sec_tables,
          sec_memories,
          sec_globals,
          sec_exports,
          sec_elements,
          sec_codes,
          sec_data
        ]) in
        Ok(QcWasmOut { wasm: wasm, table_len: table_len })
    }
# Phase 5c: Runtime library helpers in WebAssembly (qc_rt.qal)

fn qc_rt_slot_addr(a: QcAsm, xs: Int, k: Int) -> QcAsm =
  qc_asm_all(a, [QcILocalGet(xs), QcILocalGet(k), QcII32Const(3), QcII32Shl, QcII32Add])

fn qc_rt_loop_until(a: QcAsm, k: Int, n: Int) -> QcAsm =
  qc_asm_all(a, [QcIBlock(QcBtEmpty), QcILoop(QcBtEmpty), QcILocalGet(k), QcILocalGet(n), QcII32GeU, QcIBrIf(1)])

fn qc_rt_loop_next(a: QcAsm, k: Int) -> QcAsm =
  qc_asm_all(a, [QcILocalGet(k), QcII32Const(1), QcII32Add, QcILocalSet(k), QcIBr(0), QcIEnd, QcIEnd])

fn qc_rt_incr(a: QcAsm, l: Int) -> QcAsm =
  qc_asm_all(a, [QcILocalGet(l), QcII32Const(1), QcII32Add, QcILocalSet(l)])

fn qc_rt_node_field(a: QcAsm, x: Int, off: Int) -> QcAsm =
  qc_asm_all(a, [QcILocalGet(x), QcIIf(QcBtResult(QcVI32)), QcILocalGet(x), QcII32Load(off), QcIElse, QcII32Const(0), QcIEnd])

fn qc_rt_signature(rt: QcRt) -> QcFuncSig =
  match rt {
    QcRtAlloc => QcFuncSig { params: [QcVI64], results: [QcVI32] },
    QcRtArith(_) => QcFuncSig { params: [QcVI64, QcVI64, QcVI32, QcVI32], results: [QcVI64] },
    QcRtMulDiv(n) => QcFuncSig { params: qc_rt_i64s(n + 1) ++ [QcVI32, QcVI32], results: [QcVI64] },
    QcRtVariant1 => QcFuncSig { params: [QcVI32, QcVI64], results: [QcVI32] },
    QcRtOptFromPtr => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtStrNew => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtStrTrim => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtStrToInt => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtStrChars => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtStrCase(_) => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtListNew => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtListReverse => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtListSort(_) => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtResultFrom => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtResultUnitFrom => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrConcat => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrEq => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrContains => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrStartsWith => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrJoin => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrCmp => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrIndexOf => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtListConcat => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrReplace => QcFuncSig { params: [QcVI32, QcVI32, QcVI32, QcVI32, QcVI32], results: [QcVI32] },
    QcRtCharCode => QcFuncSig { params: [QcVI32, QcVI32, QcVI32], results: [QcVI64] },
    QcRtFromCharCode => QcFuncSig { params: [QcVI64, QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrLen => QcFuncSig { params: [QcVI32], results: [QcVI64] },
    QcRtBytesEq => QcFuncSig { params: [QcVI32, QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrSub => QcFuncSig { params: [QcVI32, QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrFind => QcFuncSig { params: [QcVI32, QcVI32, QcVI32], results: [QcVI32] },
    QcRtCharToByte => QcFuncSig { params: [QcVI32, QcVI64], results: [QcVI32] },
    QcRtStrSlice => QcFuncSig { params: [QcVI32, QcVI64, QcVI64, QcVI32, QcVI32], results: [QcVI32] },
    QcRtStrSplit => QcFuncSig { params: [QcVI32, QcVI32, QcVI32, QcVI32], results: [QcVI32] },
    QcRtIntToStr => QcFuncSig { params: [QcVI64], results: [QcVI32] },
    QcRtListGet => QcFuncSig { params: [QcVI32, QcVI64], results: [QcVI32] },
    QcRtListPush => QcFuncSig { params: [QcVI32, QcVI64], results: [QcVI32] },
    QcRtListRange => QcFuncSig { params: [QcVI64, QcVI64], results: [QcVI32] },
    QcRtSift(_) => QcFuncSig { params: [QcVI32, QcVI32, QcVI32], results: [] },
    QcRtFloatToInt => QcFuncSig { params: [QcVF64], results: [QcVI32] },
    QcRtRandChecked => QcFuncSig { params: [QcVI64, QcVI64, QcVI32, QcVI32], results: [QcVI64] },
    QcRtMap(_, _) => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtFilter(_) => QcFuncSig { params: [QcVI32, QcVI32], results: [QcVI32] },
    QcRtFold(acc, _) => QcFuncSig { params: [QcVI32, qc_repr_val(acc), QcVI32], results: [qc_repr_val(acc)] },
    QcRtMapFind(_) => QcFuncSig { params: [QcVI32, QcVI64], results: [QcVI32] },
    QcRtMapGet(_) => QcFuncSig { params: [QcVI32, QcVI64], results: [QcVI32] },
    QcRtMapDel(_) => QcFuncSig { params: [QcVI32, QcVI64], results: [QcVI32] },
    QcRtBytesGet => QcFuncSig { params: [QcVI32, QcVI64], results: [QcVI32] },
    QcRtMapPut(_) => QcFuncSig { params: [QcVI32, QcVI64, QcVI64], results: [QcVI32] },
    QcRtMapNode => QcFuncSig { params: [QcVI32, QcVI64, QcVI64, QcVI32], results: [QcVI32] },
    QcRtMapBal => QcFuncSig { params: [QcVI32, QcVI64, QcVI64, QcVI32], results: [QcVI32] },
    QcRtMapDelMin => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtMapEntries => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtMapKeys => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtMapValues => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtBytesToList => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtMapSize => QcFuncSig { params: [QcVI32], results: [QcVI64] },
    QcRtMapFill => QcFuncSig { params: [QcVI32, QcVI32, QcVI32], results: [QcVI32] },
    QcRtBytesSlice => QcFuncSig { params: [QcVI32, QcVI64, QcVI64, QcVI32, QcVI32], results: [QcVI32] },
    QcRtBytesFrom => QcFuncSig { params: [QcVI32, QcVI32, QcVI32], results: [QcVI32] },
    QcRtShift(_) => QcFuncSig { params: [QcVI64, QcVI64, QcVI32, QcVI32], results: [QcVI64] },
    QcRtListAt => QcFuncSig { params: [QcVI32, QcVI64, QcVI32, QcVI32], results: [QcVI64] },
    QcRtBytesAt => QcFuncSig { params: [QcVI32, QcVI64, QcVI32, QcVI32], results: [QcVI64] },
    QcRtAccList => QcFuncSig { params: [QcVI32], results: [QcVI32] },
    QcRtBytesJoin => QcFuncSig { params: [QcVI32], results: [QcVI32] }
  }

fn qc_rt_alloc(m: QcMb, a0: QcAsm) -> QcMbAsm =
  let l_p = qc_asm_local(a0, QcVI32) in
  let l_end = qc_asm_local(l_p.a, QcVI64) in
  let l_have = qc_asm_local(l_end.a, QcVI64) in
  let p = l_p.l in
  let end = l_end.l in
  let have = l_have.l in
  let fr = qc_mb_import(m, "fail") in
  let a1 = qc_asm_all(l_have.a, [
    QcIGlobalGet(0), QcILocalTee(p), QcII64ExtendI32U, QcILocalGet(0), QcII64Add, QcII64Const(7), QcII64Add, QcII64Const(-8), QcII64And, QcILocalSet(end),
    QcIMemorySize, QcII64ExtendI32U, QcII64Const(16), QcII64Shl, QcILocalSet(have),
    QcILocalGet(end), QcILocalGet(have), QcII64GtU, QcIIf(QcBtEmpty),
    QcILocalGet(end), QcII64Const(4294967295), QcII64GtU, QcIIf(QcBtResult(QcVI32)), QcII32Const(-1), QcIElse,
    QcILocalGet(end), QcILocalGet(have), QcII64Sub, QcII64Const(65535), QcII64Add, QcII64Const(16), QcII64ShrU, QcII32WrapI64, QcIMemoryGrow, QcIEnd,
    QcII32Const(-1), QcII32Eq, QcIIf(QcBtEmpty),
    QcII32Const(0), QcILocalGet(0), QcII64Store(0),
    QcII32Const(7), QcII32Const(-1), QcII32Const(-1), QcII32Const(0), QcICall(fr.idx), QcIUnreachable,
    QcIEnd, QcIEnd,
    QcILocalGet(end), QcII32WrapI64, QcIGlobalSet(0), QcILocalGet(p)
  ]) in
  QcMbAsm { m: fr.m, a: a1 }

fn qc_rt_fail_if(m: QcMb, a: QcAsm, kind: Int, vals: List[QcFailVal]) -> QcMbAsm =
  let a1 = qc_asm_i(a, QcIIf(QcBtEmpty)) in
  let ma = qc_mb_emit_fail(m, a1, kind, QcArgLocal(2), QcArgLocal(3), vals) in
  QcMbAsm { m: ma.m, a: qc_asm_i(ma.a, QcIEnd) }

fn qc_rt_arith(m: QcMb, a0: QcAsm, op: QcBinOp) -> QcMbAsm =
  let lr = qc_asm_local(a0, QcVI64) in
  let r = lr.l in
  let a = lr.a in
  let vals = [QcFailVal { local: 0, repr: QcRI64 }, QcFailVal { local: 1, repr: QcRI64 }] in
  let i64_min = shl(1, 63) in
  match op {
    QcOpAdd =>
      let a1 = qc_asm_all(a, [
        QcILocalGet(0), QcILocalGet(1), QcII64Add, QcILocalSet(r),
        QcILocalGet(0), QcILocalGet(r), QcII64Xor, QcILocalGet(1), QcILocalGet(r), QcII64Xor,
        QcII64And, QcII64Const(0), QcII64LtS
      ]) in
      let ma = qc_rt_fail_if(m, a1, 3, vals) in
      QcMbAsm { m: ma.m, a: qc_asm_i(ma.a, QcILocalGet(r)) },
    QcOpSub =>
      let a1 = qc_asm_all(a, [
        QcILocalGet(0), QcILocalGet(1), QcII64Sub, QcILocalSet(r),
        QcILocalGet(0), QcILocalGet(1), QcII64Xor, QcILocalGet(0), QcILocalGet(r), QcII64Xor,
        QcII64And, QcII64Const(0), QcII64LtS
      ]) in
      let ma = qc_rt_fail_if(m, a1, 3, vals) in
      QcMbAsm { m: ma.m, a: qc_asm_i(ma.a, QcILocalGet(r)) },
    QcOpMul =>
      let a1 = qc_asm_all(a, [QcILocalGet(0), QcII64Const(-1), QcII64Eq, QcILocalGet(1), QcII64Const(i64_min), QcII64Eq, QcII32And]) in
      let ma1 = qc_rt_fail_if(m, a1, 3, vals) in
      let a2 = qc_asm_all(ma1.a, [
        QcILocalGet(0), QcILocalGet(1), QcII64Mul, QcILocalSet(r),
        QcILocalGet(0), QcII64Const(0), QcII64Ne, QcIIf(QcBtEmpty),
        QcILocalGet(r), QcILocalGet(0), QcII64DivS, QcILocalGet(1), QcII64Ne
      ]) in
      let ma2 = qc_rt_fail_if(ma1.m, a2, 3, vals) in
      QcMbAsm { m: ma2.m, a: qc_asm_all(ma2.a, [QcIEnd, QcILocalGet(r)]) },
    QcOpDiv =>
      let a1 = qc_asm_all(a, [QcILocalGet(1), QcII64Eqz]) in
      let ma1 = qc_rt_fail_if(m, a1, 4, vals) in
      let a2 = qc_asm_all(ma1.a, [QcILocalGet(0), QcII64Const(i64_min), QcII64Eq, QcILocalGet(1), QcII64Const(-1), QcII64Eq, QcII32And]) in
      let ma2 = qc_rt_fail_if(ma1.m, a2, 3, vals) in
      QcMbAsm { m: ma2.m, a: qc_asm_all(ma2.a, [QcILocalGet(0), QcILocalGet(1), QcII64DivS]) },
    QcOpRem =>
      let a1 = qc_asm_all(a, [QcILocalGet(1), QcII64Eqz]) in
      let ma1 = qc_rt_fail_if(m, a1, 4, vals) in
      QcMbAsm { m: ma1.m, a: qc_asm_all(ma1.a, [QcILocalGet(0), QcILocalGet(1), QcII64RemS]) },
    _ => QcMbAsm { m: qc_mb_bug(m, "not an arithmetic operator"), a: a }
  }

type QcMulDivL = {
  hi: Int,
  lo: Int,
  mg: Int,
  dv: Int,
  q: Int,
  neg: Int,
  ov: Int,
  z: Int,
  k: Int,
  h1: Int,
  l1: Int,
  h2: Int,
  l2: Int,
  s0: Int,
  s1: Int,
  s2: Int,
  mid: Int
}

fn qc_rt_i64s(n: Int) -> List[QcValType] =
  if n <= 0 then [] else [QcVI64] ++ qc_rt_i64s(n - 1)

fn qc_rt_abs_u64(a: QcAsm, x: Int) -> QcAsm =
  qc_asm_all(a, [QcII64Const(0), QcILocalGet(x), QcII64Sub, QcILocalGet(x), QcILocalGet(x), QcII64Const(0), QcII64LtS, QcISelect])

fn qc_rt_mul_wide(a: QcAsm, x: Int, y: Int, h: Int, l: Int, t: QcMulDivL) -> QcAsm =
  let mk = 4294967295 in
  qc_asm_all(a, [
    QcILocalGet(x), QcII64Const(mk), QcII64And, QcILocalGet(y), QcII64Const(mk), QcII64And, QcII64Mul, QcILocalSet(t.s0),
    QcILocalGet(x), QcII64Const(mk), QcII64And, QcILocalGet(y), QcII64Const(32), QcII64ShrU, QcII64Mul, QcILocalSet(t.s1),
    QcILocalGet(x), QcII64Const(32), QcII64ShrU, QcILocalGet(y), QcII64Const(mk), QcII64And, QcII64Mul, QcILocalSet(t.s2),
    QcILocalGet(t.s0), QcII64Const(32), QcII64ShrU, QcILocalGet(t.s1), QcII64Const(mk), QcII64And, QcII64Add, QcILocalGet(t.s2), QcII64Const(mk), QcII64And, QcII64Add, QcILocalSet(t.mid),
    QcILocalGet(t.s0), QcII64Const(mk), QcII64And, QcILocalGet(t.mid), QcII64Const(32), QcII64Shl, QcII64Or, QcILocalSet(l),
    QcILocalGet(x), QcII64Const(32), QcII64ShrU, QcILocalGet(y), QcII64Const(32), QcII64ShrU, QcII64Mul,
    QcILocalGet(t.s1), QcII64Const(32), QcII64ShrU, QcII64Add, QcILocalGet(t.s2), QcII64Const(32), QcII64ShrU, QcII64Add,
    QcILocalGet(t.mid), QcII64Const(32), QcII64ShrU, QcII64Add, QcILocalSet(h)
  ])

# One factor f of the product: (hi, lo) * |f| (see qc_rt_muldiv).
fn qc_rt_muldiv_factors(a: QcAsm, t: QcMulDivL, f: Int, n: Int) -> QcAsm =
  if f >= n then a
  else
    let a1 = qc_asm_i(qc_rt_abs_u64(a, f), QcILocalSet(t.mg)) in
    let a2 = qc_asm_all(a1, [
      QcILocalGet(t.neg), QcILocalGet(f), QcII64Const(0), QcII64LtS, QcII32Xor, QcILocalSet(t.neg),
      QcILocalGet(t.z), QcILocalGet(f), QcII64Eqz, QcII32Or, QcILocalSet(t.z)
    ]) in
    let a3 = qc_rt_mul_wide(qc_rt_mul_wide(a2, t.lo, t.mg, t.h1, t.l1, t), t.hi, t.mg, t.h2, t.l2, t) in
    let a4 = qc_asm_all(a3, [
      QcILocalGet(t.ov), QcILocalGet(t.h2), QcII64Const(0), QcII64Ne, QcII32Or, QcILocalSet(t.ov),
      QcILocalGet(t.l2), QcILocalGet(t.h1), QcII64Add, QcILocalSet(t.hi),
      QcILocalGet(t.ov), QcILocalGet(t.hi), QcILocalGet(t.l2), QcII64LtU, QcII32Or, QcILocalGet(t.hi), QcII64Const(0), QcII64LtS, QcII32Or, QcILocalSet(t.ov),
      QcILocalGet(t.l1), QcILocalSet(t.lo)
    ]) in
    qc_rt_muldiv_factors(a4, t, f + 1, n)

fn qc_rt_muldiv_fail_if(m: QcMb, a: QcAsm, kind: Int, d: Int) -> QcMbAsm =
  let a1 = qc_asm_i(a, QcIIf(QcBtEmpty)) in
  let vals = [QcFailVal { local: 0, repr: QcRI64 }, QcFailVal { local: d, repr: QcRI64 }] in
  let ma = qc_mb_emit_fail(m, a1, kind, QcArgLocal(d + 1), QcArgLocal(d + 2), vals) in
  QcMbAsm { m: ma.m, a: qc_asm_i(ma.a, QcIEnd) }

# Fused (f1 * ... * fn) / d, mirroring rt.rs `muldiv`. Params: f1..fn = 0..n, d = n, func = n + 1,
# site = n + 2. The product's magnitude is an unsigned 128-bit (hi, lo), its sign separate.
fn qc_rt_muldiv(m: QcMb, a0: QcAsm, n: Int) -> QcMbAsm =
  let d = n in
  let r_hi = qc_asm_local(a0, QcVI64) in
  let r_lo = qc_asm_local(r_hi.a, QcVI64) in
  let r_mg = qc_asm_local(r_lo.a, QcVI64) in
  let r_dv = qc_asm_local(r_mg.a, QcVI64) in
  let r_q = qc_asm_local(r_dv.a, QcVI64) in
  let r_neg = qc_asm_local(r_q.a, QcVI32) in
  let r_ov = qc_asm_local(r_neg.a, QcVI32) in
  let r_z = qc_asm_local(r_ov.a, QcVI32) in
  let r_k = qc_asm_local(r_z.a, QcVI32) in
  let r_h1 = qc_asm_local(r_k.a, QcVI64) in
  let r_l1 = qc_asm_local(r_h1.a, QcVI64) in
  let r_h2 = qc_asm_local(r_l1.a, QcVI64) in
  let r_l2 = qc_asm_local(r_h2.a, QcVI64) in
  let r_s0 = qc_asm_local(r_l2.a, QcVI64) in
  let r_s1 = qc_asm_local(r_s0.a, QcVI64) in
  let r_s2 = qc_asm_local(r_s1.a, QcVI64) in
  let r_mid = qc_asm_local(r_s2.a, QcVI64) in
  let t = QcMulDivL {
    hi: r_hi.l, lo: r_lo.l, mg: r_mg.l, dv: r_dv.l, q: r_q.l, neg: r_neg.l, ov: r_ov.l, z: r_z.l, k: r_k.l,
    h1: r_h1.l, l1: r_l1.l, h2: r_h2.l, l2: r_l2.l, s0: r_s0.l, s1: r_s1.l, s2: r_s2.l, mid: r_mid.l
  } in
  let a1 = qc_asm_i(qc_rt_abs_u64(r_mid.a, 0), QcILocalSet(t.lo)) in
  let a2 = qc_asm_all(a1, [QcILocalGet(0), QcII64Const(0), QcII64LtS, QcILocalSet(t.neg), QcILocalGet(0), QcII64Eqz, QcILocalSet(t.z)]) in
  let a3 = qc_rt_muldiv_factors(a2, t, 1, n) in
  let a4 = qc_asm_all(a3, [
    QcILocalGet(t.neg), QcILocalGet(d), QcII64Const(0), QcII64LtS, QcII32Xor, QcILocalSet(t.neg),
    QcILocalGet(t.ov), QcILocalGet(t.z), QcII32Eqz, QcII32And
  ]) in
  let ma1 = qc_rt_muldiv_fail_if(m, a4, 3, d) in
  let ma2 = qc_rt_muldiv_fail_if(ma1.m, qc_asm_all(ma1.a, [QcILocalGet(d), QcII64Eqz]), 4, d) in
  let a5 = qc_asm_i(qc_rt_abs_u64(ma2.a, d), QcILocalSet(t.dv)) in
  let ma3 = qc_rt_muldiv_fail_if(ma2.m, qc_asm_all(a5, [QcILocalGet(t.hi), QcILocalGet(t.dv), QcII64GeU]), 3, d) in
  let a6 = qc_asm_all(ma3.a, [
    QcILocalGet(t.hi), QcII64Eqz, QcIIf(QcBtEmpty), QcILocalGet(t.lo), QcILocalGet(t.dv), QcII64DivU, QcILocalSet(t.q), QcIElse,
    QcIBlock(QcBtEmpty), QcILoop(QcBtEmpty), QcILocalGet(t.k), QcII32Const(64), QcII32GeU, QcIBrIf(1),
    QcILocalGet(t.hi), QcII64Const(1), QcII64Shl, QcILocalGet(t.lo), QcII64Const(63), QcII64ShrU, QcII64Or, QcILocalSet(t.hi),
    QcILocalGet(t.lo), QcII64Const(1), QcII64Shl, QcILocalSet(t.lo), QcILocalGet(t.q), QcII64Const(1), QcII64Shl, QcILocalSet(t.q),
    QcILocalGet(t.hi), QcILocalGet(t.dv), QcII64GeU, QcIIf(QcBtEmpty),
    QcILocalGet(t.hi), QcILocalGet(t.dv), QcII64Sub, QcILocalSet(t.hi), QcILocalGet(t.q), QcII64Const(1), QcII64Or, QcILocalSet(t.q), QcIEnd
  ]) in
  let a7 = qc_asm_i(qc_rt_loop_next(a6, t.k), QcIEnd) in
  let a8 = qc_asm_all(a7, [QcILocalGet(t.q), QcII64Const(9223372036854775807), QcILocalGet(t.neg), QcII64ExtendI32U, QcII64Add, QcII64GtU]) in
  let ma4 = qc_rt_muldiv_fail_if(ma3.m, a8, 3, d) in
  QcMbAsm { m: ma4.m, a: qc_asm_all(ma4.a, [QcII64Const(0), QcILocalGet(t.q), QcII64Sub, QcILocalGet(t.q), QcILocalGet(t.neg), QcISelect]) }

fn qc_rt_split(m: QcMb, a0: QcAsm) -> QcMbAsm =
  let l1 = qc_asm_local(a0, QcVI32) in
  let l2 = qc_asm_local(l1.a, QcVI32) in
  let l3 = qc_asm_local(l2.a, QcVI32) in
  let l4 = qc_asm_local(l3.a, QcVI32) in
  let l5 = qc_asm_local(l4.a, QcVI32) in
  let l6 = qc_asm_local(l5.a, QcVI32) in
  let lsep = l1.l in
  let count = l2.l in
  let pos = l3.l in
  let f = l4.l in
  let xs = l5.l in
  let k = l6.l in
  let r_find = qc_mb_rt(m, QcRtStrFind) in
  let r_sub = qc_mb_rt(r_find.m, QcRtStrSub) in
  let find = r_find.idx in
  let sub = r_sub.idx in
  let a1 = qc_asm_all(l6.a, [QcILocalGet(1), QcII32Load(0), QcILocalTee(lsep), QcII32Eqz, QcIIf(QcBtEmpty)]) in
  let ma1 = qc_mb_emit_fail(r_sub.m, a1, 6, QcArgLocal(2), QcArgLocal(3), [QcFailVal { local: 1, repr: QcRI32 }]) in
  let a2 = qc_asm_all(ma1.a, [
    QcIEnd,
    QcII32Const(1), QcILocalSet(count),
    QcIBlock(QcBtEmpty), QcILoop(QcBtEmpty),
    QcILocalGet(0), QcILocalGet(1), QcILocalGet(pos), QcICall(find), QcILocalTee(f), QcII32Const(0), QcII32LtS, QcIBrIf(1)
  ]) in
  let a3 = qc_rt_incr(a2, count) in
  let a4 = qc_asm_all(a3, [QcILocalGet(f), QcILocalGet(lsep), QcII32Add, QcILocalSet(pos), QcIBr(0), QcIEnd, QcIEnd]) in
  let r_ln = qc_mb_rt(ma1.m, QcRtListNew) in
  let a5 = qc_asm_all(a4, [
    QcILocalGet(count), QcICall(r_ln.idx), QcILocalSet(xs), QcII32Const(0), QcILocalSet(pos),
    QcIBlock(QcBtEmpty), QcILoop(QcBtEmpty),
    QcILocalGet(0), QcILocalGet(1), QcILocalGet(pos), QcICall(find), QcILocalTee(f), QcII32Const(0), QcII32LtS, QcIBrIf(1)
  ]) in
  let a6 = qc_rt_slot_addr(a5, xs, k) in
  let a7 = qc_asm_all(a6, [QcILocalGet(0), QcILocalGet(pos), QcILocalGet(f), QcICall(sub), QcII64ExtendI32U, QcII64Store(8)]) in
  let a8 = qc_rt_incr(a7, k) in
  let a9 = qc_asm_all(a8, [QcILocalGet(f), QcILocalGet(lsep), QcII32Add, QcILocalSet(pos), QcIBr(0), QcIEnd, QcIEnd]) in
  let a10 = qc_rt_slot_addr(a9, xs, k) in
  let a11 = qc_asm_all(a10, [QcILocalGet(0), QcILocalGet(pos), QcILocalGet(0), QcII32Load(0), QcICall(sub), QcII64ExtendI32U, QcII64Store(8), QcILocalGet(xs)]) in
  QcMbAsm { m: r_ln.m, a: a11 }

fn qc_rt_join(m: QcMb, a0: QcAsm) -> QcMbAsm =
  let l1 = qc_asm_local(a0, QcVI32) in
  let l2 = qc_asm_local(l1.a, QcVI64) in
  let l3 = qc_asm_local(l2.a, QcVI32) in
  let l4 = qc_asm_local(l3.a, QcVI32) in
  let l5 = qc_asm_local(l4.a, QcVI32) in
  let l6 = qc_asm_local(l5.a, QcVI32) in
  let l7 = qc_asm_local(l6.a, QcVI32) in
  let n = l1.l in
  let total = l2.l in
  let k = l3.l in
  let p = l4.l in
  let at = l5.l in
  let e = l6.l in
  let lsep = l7.l in
  let r_sn = qc_mb_rt(m, QcRtStrNew) in
  let a1 = qc_asm_all(l7.a, [
    QcILocalGet(1), QcII32Load(0), QcILocalSet(lsep),
    QcILocalGet(0), QcII32Load(0), QcILocalTee(n), QcII32Eqz, QcIIf(QcBtEmpty), QcII32Const(0), QcICall(r_sn.idx), QcIReturn, QcIEnd,
    QcILocalGet(lsep), QcII64ExtendI32U, QcILocalGet(n), QcII32Const(1), QcII32Sub, QcII64ExtendI32U, QcII64Mul, QcILocalSet(total)
  ]) in
  let a2 = qc_rt_loop_until(a1, k, n) in
  let a3 = qc_rt_slot_addr(a2, 0, k) in
  let a4 = qc_asm_all(a3, [QcII64Load(8), QcII32WrapI64, QcII32Load(0), QcII64ExtendI32U, QcILocalGet(total), QcII64Add, QcILocalSet(total)]) in
  let a5 = qc_rt_loop_next(a4, k) in
  let r_al = qc_mb_rt(r_sn.m, QcRtAlloc) in
  let r_sn2 = qc_mb_rt(r_al.m, QcRtStrNew) in
  let a6 = qc_asm_all(a5, [
    QcILocalGet(total), QcII64Const(2147418112), QcII64GtU, QcIIf(QcBtEmpty), QcILocalGet(total), QcICall(r_al.idx), QcIDrop, QcIEnd,
    QcILocalGet(total), QcII32WrapI64, QcICall(r_sn2.idx), QcILocalTee(p), QcII32Const(4), QcII32Add, QcILocalSet(at), QcII32Const(0), QcILocalSet(k)
  ]) in
  let a7 = qc_rt_loop_until(a6, k, n) in
  let a8 = qc_asm_all(a7, [
    QcILocalGet(k), QcIIf(QcBtEmpty),
    QcILocalGet(at), QcILocalGet(1), QcII32Const(4), QcII32Add, QcILocalGet(lsep), QcIMemoryCopy, QcILocalGet(at), QcILocalGet(lsep), QcII32Add, QcILocalSet(at), QcIEnd
  ]) in
  let a9 = qc_rt_slot_addr(a8, 0, k) in
  let a10 = qc_asm_all(a9, [
    QcII64Load(8), QcII32WrapI64, QcILocalSet(e),
