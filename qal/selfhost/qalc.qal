fn qc_rt_body(rt: QcRt, m: QcMb, n_params: Int) -> QcMbAsm =
  let a0 = qc_asm_new(n_params) in
  match rt {
    QcRtAlloc => qc_rt_alloc(m, a0),
    QcRtArith(op) => qc_rt_arith(m, a0, op),
    QcRtVariant1 =>
