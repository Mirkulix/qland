      let r_dm = qc_mb_rt(r_del.m, QcRtMapDelMin) in
      let bal = r_bal.idx in
      let del = r_del.idx in
      let del_min = r_dm.idx in
      let l1 = qc_asm_local(a0, QcVI32) in
      let l2 = qc_asm_local(l1.a, QcVI32) in
      let c = l1.l in
      let mn = l2.l in
      let a1 = qc_asm_all(l2.a, [
        QcILocalGet(0), QcII32Eqz, QcIIf(QcBtEmpty), QcII32Const(0), QcIReturn, QcIEnd,
        QcILocalGet(1), QcILocalGet(0), QcII64Load(8), QcICall(cmp), QcILocalTee(c), QcII32Const(0), QcII32LtS, QcIIf(QcBtEmpty),
        QcILocalGet(0), QcII32Load(24), QcILocalGet(1), QcICall(del), QcILocalGet(0), QcII64Load(8), QcILocalGet(0), QcII64Load(16),
        QcILocalGet(0), QcII32Load(28), QcICall(bal), QcIReturn, QcIEnd,
        QcILocalGet(c), QcII32Const(0), QcII32GtS, QcIIf(QcBtEmpty),
        QcILocalGet(0), QcII32Load(24), QcILocalGet(0), QcII64Load(8), QcILocalGet(0), QcII64Load(16),
        QcILocalGet(0), QcII32Load(28), QcILocalGet(1), QcICall(del), QcICall(bal), QcIReturn, QcIEnd,
        QcILocalGet(0), QcII32Load(24), QcII32Eqz, QcIIf(QcBtEmpty), QcILocalGet(0), QcII32Load(28), QcIReturn, QcIEnd,
        QcILocalGet(0), QcII32Load(28), QcII32Eqz, QcIIf(QcBtEmpty), QcILocalGet(0), QcII32Load(24), QcIReturn, QcIEnd,
        QcILocalGet(0), QcII32Load(28), QcILocalSet(mn), QcIBlock(QcBtEmpty), QcILoop(QcBtEmpty),
        QcILocalGet(mn), QcII32Load(24), QcII32Eqz, QcIBrIf(1), QcILocalGet(mn), QcII32Load(24), QcILocalSet(mn), QcIBr(0), QcIEnd, QcIEnd,
