# Match exhaustiveness (usefulness algorithm after Maranget) for QAL self-hosting compiler (spec §7: qc_exhaust, matching qal-check/src/exhaust.rs)

type QcKey =
  | QcKeyTag(Int)
  | QcKeyBool(Bool)
  | QcKeyUnit
  | QcKeyRecord
  | QcKeyLit(Str)

type QcP =
  | QcExWild
  | QcExC(QcKey, List[QcP])

type QcCtor = {
  key: QcKey,
  name: Str,
  args: List[QcType],
  fields: List[Str]
}

type QcW =
  | QcWWild
  | QcWC(Str, List[QcW], List[Str], Bool)

fn qc_exhaust_show_fields_loop(fields: List[Str], args: List[QcW], idx: Int, acc: Accum[Str]) -> List[Str] =
  if idx >= len(fields) || idx >= len(args) then acc_list(acc)
  else
    let f = list_at(fields, idx) in
    let a = list_at(args, idx) in
    let part = f ++ ": " ++ qc_exhaust_show(a) in
    qc_exhaust_show_fields_loop(fields, args, idx + 1, AccPush(acc, part))

fn qc_exhaust_show(w: QcW) -> Str =
  match w {
    QcWWild => "_",
    QcWC(name, args, _, false) =>
      if len(args) == 0 then name
      else name ++ "(" ++ join(map(args, qc_exhaust_show), ", ") ++ ")",
    QcWC(name, args, fields, true) =>
      let parts = qc_exhaust_show_fields_loop(fields, args, 0, AccEnd) in
      name ++ " { " ++ join(parts, ", ") ++ " }"
  }

fn qc_exhaust_variants(tp: QcTProgram, ty: QcType) -> List[QcCtor] =
  let names = qc_tp_variant_names(tp, ty) in
  qc_exhaust_variants_loop(tp, ty, names, 0, AccEnd)

fn qc_exhaust_variants_loop(tp: QcTProgram, ty: QcType, names: List[Str], tag: Int, acc: Accum[QcCtor]) -> List[QcCtor] =
  if tag >= len(names) then acc_list(acc)
  else
    let name = list_at(names, tag) in
    let flds = qc_tp_variant_fields(tp, ty, tag) in
    let ctor = QcCtor { key: QcKeyTag(tag), name: name, args: flds, fields: [] } in
    qc_exhaust_variants_loop(tp, ty, names, tag + 1, AccPush(acc, ctor))

fn qc_exhaust_ctors(tp: QcTProgram, ty: QcType) -> Option[List[QcCtor]] =
  match ty {
    QcTBool => Some([
      QcCtor { key: QcKeyBool(false), name: "false", args: [], fields: [] },
      QcCtor { key: QcKeyBool(true), name: "true", args: [], fields: [] }
    ]),
    QcTUnit => Some([QcCtor { key: QcKeyUnit, name: "()", args: [], fields: [] }]),
    QcTOption(_) => Some(qc_exhaust_variants(tp, ty)),
    QcTResult(_, _) => Some(qc_exhaust_variants(tp, ty)),
    QcTNamed(n) =>
      match qc_tp_decl(tp, ty) {
        Some(QcBodyEnum(_)) => Some(qc_exhaust_variants(tp, ty)),
        Some(QcBodyRecord(fs)) =>
          Some([QcCtor {
            key: QcKeyRecord,
            name: n,
            args: map(fs, fn(f: QcFieldType) => f.ty),
            fields: map(fs, fn(f: QcFieldType) => f.name)
          }]),
        None => None
      },
    QcTApp(n, _) =>
      match qc_tp_decl(tp, ty) {
        Some(QcBodyEnum(_)) => Some(qc_exhaust_variants(tp, ty)),
        Some(QcBodyRecord(fs)) =>
          Some([QcCtor {
            key: QcKeyRecord,
            name: n,
            args: map(fs, fn(f: QcFieldType) => f.ty),
            fields: map(fs, fn(f: QcFieldType) => f.name)
          }]),
        None => None
      },
    _ => None
  }

fn qc_exhaust_find_field_pat_loop(fs: List[QcTPField], target_idx: Int, cur: Int) -> Option[QcTPat] =
  if cur >= len(fs) then None
  else
    let f = list_at(fs, cur) in
    if f.idx == target_idx then Some(f.pat)
    else qc_exhaust_find_field_pat_loop(fs, target_idx, cur + 1)

fn qc_exhaust_reduce_record_fields_loop(tp: QcTProgram, all_fields: List[QcFieldType], fs: List[QcTPField], i: Int, acc: Accum[QcP]) -> List[QcP] =
  if i >= len(all_fields) then acc_list(acc)
  else
    let fld = list_at(all_fields, i) in
    let p_reduced = match qc_exhaust_find_field_pat_loop(fs, i, 0) {
      Some(p) => qc_exhaust_reduce(tp, p, fld.ty),
      None => QcExWild
    } in
    qc_exhaust_reduce_record_fields_loop(tp, all_fields, fs, i + 1, AccPush(acc, p_reduced))

fn qc_exhaust_reduce_variant_sub_loop(tp: QcTProgram, ps: List[QcTPat], tys: List[QcType], idx: Int, acc: Accum[QcP]) -> List[QcP] =
  if idx >= len(ps) || idx >= len(tys) then acc_list(acc)
  else
    let sub_p = qc_exhaust_reduce(tp, list_at(ps, idx), list_at(tys, idx)) in
    qc_exhaust_reduce_variant_sub_loop(tp, ps, tys, idx + 1, AccPush(acc, sub_p))

fn qc_exhaust_reduce(tp: QcTProgram, p: QcTPat, ty: QcType) -> QcP =
  match p {
    QcTPWild => QcExWild,
    QcTPBind(_) => QcExWild,
    QcTPInt(n) => QcExC(QcKeyLit(from_int(n)), []),
    QcTPStr(s) => QcExC(QcKeyLit("\"" ++ s ++ "\""), []),
    QcTPBool(b) => QcExC(QcKeyBool(b), []),
    QcTPUnit => QcExC(QcKeyUnit, []),
    QcTPVariant(tag, ps) =>
      let tys = qc_tp_variant_fields(tp, ty, tag) in
      let sub = qc_exhaust_reduce_variant_sub_loop(tp, ps, tys, 0, AccEnd) in
      QcExC(QcKeyTag(tag), sub),
    QcTPRecord(fs) =>
      let all = qc_tp_record_fields(tp, ty) in
      let args = qc_exhaust_reduce_record_fields_loop(tp, all, fs, 0, AccEnd) in
      QcExC(QcKeyRecord, args)
  }

fn qc_exhaust_head(row: List[QcP]) -> Option[QcKey] =
  if len(row) == 0 then None
  else
    match list_at(row, 0) {
      QcExC(k, _) => Some(k),
      QcExWild => None
    }

fn qc_key_eq(k1: QcKey, k2: QcKey) -> Bool =
  match k1 {
    QcKeyTag(t1) => match k2 { QcKeyTag(t2) => t1 == t2, _ => false },
    QcKeyBool(b1) => match k2 { QcKeyBool(b2) => b1 == b2, _ => false },
    QcKeyUnit => match k2 { QcKeyUnit => true, _ => false },
    QcKeyRecord => match k2 { QcKeyRecord => true, _ => false },
    QcKeyLit(s1) => match k2 { QcKeyLit(s2) => s1 == s2, _ => false }
  }

fn qc_repeat_wild_loop(count: Int, acc: Accum[QcP]) -> List[QcP] =
  if count <= 0 then acc_list(acc)
  else qc_repeat_wild_loop(count - 1, AccPush(acc, QcExWild))

fn qc_exhaust_specialize_row(row: List[QcP], key: QcKey, arity: Int) -> Option[List[QcP]] =
  if len(row) == 0 then None
  else
    let head_p = list_at(row, 0) in
    let tail_p = match qc_list_slice(row, 1, len(row)) { Some(xs) => xs, None => [] } in
    match head_p {
      QcExC(k, args) =>
        if qc_key_eq(k, key) then Some(args ++ tail_p)
        else None,
      QcExWild =>
        let wilds = qc_repeat_wild_loop(arity, AccEnd) in
        Some(wilds ++ tail_p)
    }

fn qc_list_slice[T](xs: List[T], start_idx: Int, end_idx: Int) -> Option[List[T]] =
  if start_idx < 0 || end_idx < start_idx || end_idx > len(xs) then None
  else Some(qc_list_slice_loop(xs, start_idx, end_idx, start_idx, AccEnd))

fn qc_list_slice_loop[T](xs: List[T], start_idx: Int, end_idx: Int, cur: Int, acc: Accum[T]) -> List[T] =
  if cur >= end_idx then acc_list(acc)
  else qc_list_slice_loop(xs, start_idx, end_idx, cur + 1, AccPush(acc, list_at(xs, cur)))

fn qc_exhaust_specialize_loop(rows: List[List[QcP]], key: QcKey, arity: Int, idx: Int, acc: Accum[List[QcP]]) -> List[List[QcP]] =
  if idx >= len(rows) then acc_list(acc)
  else
    match qc_exhaust_specialize_row(list_at(rows, idx), key, arity) {
      Some(spec_row) => qc_exhaust_specialize_loop(rows, key, arity, idx + 1, AccPush(acc, spec_row)),
      None => qc_exhaust_specialize_loop(rows, key, arity, idx + 1, acc)
    }

fn qc_exhaust_specialize(rows: List[List[QcP]], key: QcKey, arity: Int) -> List[List[QcP]] =
  qc_exhaust_specialize_loop(rows, key, arity, 0, AccEnd)

fn qc_exhaust_heads_loop(rows: List[List[QcP]], idx: Int, acc: Accum[QcKey]) -> List[QcKey] =
  if idx >= len(rows) then acc_list(acc)
  else
    match qc_exhaust_head(list_at(rows, idx)) {
      Some(k) => qc_exhaust_heads_loop(rows, idx + 1, AccPush(acc, k)),
      None => qc_exhaust_heads_loop(rows, idx + 1, acc)
    }

fn qc_exhaust_heads_contain_loop(heads: List[QcKey], key: QcKey, idx: Int) -> Bool =
  if idx >= len(heads) then false
  else if qc_key_eq(list_at(heads, idx), key) then true
  else qc_exhaust_heads_contain_loop(heads, key, idx + 1)

fn qc_exhaust_all_ctors_covered_loop(all: List[QcCtor], heads: List[QcKey], idx: Int) -> Bool =
  if idx >= len(all) then true
  else
    let c = list_at(all, idx) in
    if !qc_exhaust_heads_contain_loop(heads, c.key, 0) then false
    else qc_exhaust_all_ctors_covered_loop(all, heads, idx + 1)

fn qc_exhaust_missing(tp: QcTProgram, rows: List[List[QcP]], tys: List[QcType]) -> Option[List[QcW]] =
  if len(tys) == 0 then
    if len(rows) == 0 then Some([])
    else None
  else
    let heads = qc_exhaust_heads_loop(rows, 0, AccEnd) in
    let ty0 = list_at(tys, 0) in
    let opt_all = qc_exhaust_ctors(tp, ty0) in
    let tail_tys = match qc_list_slice(tys, 1, len(tys)) { Some(xs) => xs, None => [] } in
    match opt_all {
      Some(all) if len(all) == 0 => None,
      Some(all) if qc_exhaust_all_ctors_covered_loop(all, heads, 0) =>
        qc_exhaust_missing_sub_loop(tp, rows, all, tail_tys, 0),
      _ =>
        let default_rows = qc_exhaust_default_rows_loop(rows, 0, AccEnd) in
        match qc_exhaust_missing(tp, default_rows, tail_tys) {
          None => None,
          Some(rest) =>
            let first = match opt_all {
              Some(all) =>
                match qc_exhaust_find_uncovered_ctor_loop(all, heads, 0) {
                  Some(c) =>
                    let wilds = qc_repeat_wild_w_loop(len(c.args), AccEnd) in
                    QcWC(c.name, wilds, c.fields, qc_key_eq(c.key, QcKeyRecord)),
                  None => QcWWild
                },
              None => QcWWild
            } in
            Some([first] ++ rest)
        }
    }

fn qc_repeat_wild_w_loop(count: Int, acc: Accum[QcW]) -> List[QcW] =
  if count <= 0 then acc_list(acc)
  else qc_repeat_wild_w_loop(count - 1, AccPush(acc, QcWWild))

fn qc_exhaust_find_uncovered_ctor_loop(all: List[QcCtor], heads: List[QcKey], idx: Int) -> Option[QcCtor] =
  if idx >= len(all) then None
  else
    let c = list_at(all, idx) in
    if !qc_exhaust_heads_contain_loop(heads, c.key, 0) then Some(c)
    else qc_exhaust_find_uncovered_ctor_loop(all, heads, idx + 1)

fn qc_exhaust_default_rows_loop(rows: List[List[QcP]], idx: Int, acc: Accum[List[QcP]]) -> List[List[QcP]] =
  if idx >= len(rows) then acc_list(acc)
  else
    let r = list_at(rows, idx) in
    match qc_exhaust_head(r) {
      None =>
        let tail_r = match qc_list_slice(r, 1, len(r)) { Some(xs) => xs, None => [] } in
        qc_exhaust_default_rows_loop(rows, idx + 1, AccPush(acc, tail_r)),
      Some(_) => qc_exhaust_default_rows_loop(rows, idx + 1, acc)
    }

fn qc_exhaust_missing_sub_loop(tp: QcTProgram, rows: List[List[QcP]], all: List[QcCtor], tail_tys: List[QcType], idx: Int) -> Option[List[QcW]] =
  if idx >= len(all) then None
  else
    let c = list_at(all, idx) in
    let sub = qc_exhaust_specialize(rows, c.key, len(c.args)) in
    let sub_tys = c.args ++ tail_tys in
    match qc_exhaust_missing(tp, sub, sub_tys) {
      Some(w) =>
        let w_args = match qc_list_slice(w, 0, len(c.args)) { Some(xs) => xs, None => [] } in
        let rest = match qc_list_slice(w, len(c.args), len(w)) { Some(xs) => xs, None => [] } in
        let first = QcWC(c.name, w_args, c.fields, qc_key_eq(c.key, QcKeyRecord)) in
        Some([first] ++ rest),
      None => qc_exhaust_missing_sub_loop(tp, rows, all, tail_tys, idx + 1)
    }

fn qc_missing_pattern(tp: QcTProgram, ty: QcType, rows: List[QcTPat]) -> Option[Str] =
  let p_rows = map(rows, fn(p: QcTPat) => [qc_exhaust_reduce(tp, p, ty)]) in
  match qc_exhaust_missing(tp, p_rows, [ty]) {
    Some(ws) =>
      if len(ws) > 0 then Some(qc_exhaust_show(list_at(ws, 0)))
      else None,
    None => None
  }

test qc_exhaust_test =
  let empty_tp = QcTProgram { types: [], fns: [], tests: [], generics: [] } in
  let rows = [QcTPBool(false)] in
  qc_missing_pattern(empty_tp, QcTBool, rows) == Some("true")
