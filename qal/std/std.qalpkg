fn std.db.col(rows: DbRows, name: Str) -> Option[Int]
= fold(range(0, len(rows.columns)), None, fn(acc: Option[Int], i: Int) => match acc { Some(_) => acc, None => if get(rows.columns, i) == Some(name) then Some(i) else None })

fn std.db.first(rows: DbRows) -> Option[List[SqlValue]]
= get(rows.rows, 0)

fn std.db.val(row: List[SqlValue], i: Int) -> Option[SqlValue]
= if i < 0 then None else get(row, i)

fn std.http.response(status: Int, ctype: Str, body: Str) -> HttpResponse
= HttpResponse { status: status, headers: [HttpHeader { name: "content-type", value: ctype }], body: body }

type std.json.Error = { pos: Int, message: Str }

type std.json.StrEnd = { text: Str, next: Int }

fn std.json.ch(cs: List[Str], i: Int) -> Str
= match get(cs, i) { Some(c) => c, None => "" }

fn std.json.dig(c: Str) -> Bool
= c != "" && c >= "0" && c <= "9"

fn std.json.hexd(n: Int) -> Str
= if n < 10 then from_char_code(48 + n) else from_char_code(87 + n)

fn std.json.hexv(c: Str) -> Int
= if c == "" then -1 else let k = char_code(c) in if k >= 48 && k <= 57 then k - 48 else if k >= 97 && k <= 102 then k - 87 else if k >= 65 && k <= 70 then k - 55 else -1

fn std.json.nest(n: Int, open: Str, close: Str) -> Str
= join(map(range(0, n), fn(i) => open), "") ++ join(map(range(0, n), fn(i) => close), "")

fn std.json.simple_esc(e: Str) -> Str
= if e == "\"" then "\"" else if e == "\\" then "\\" else if e == "/" then "/" else if e == "b" then from_char_code(8) else if e == "f" then from_char_code(12) else if e == "n" then "\n" else if e == "r" then "\r" else if e == "t" then "\t" else ""

type std.route.Route[A] = { method: Str, pattern: Str, tag: A }

fn std.route.big_path() -> Str
= "/big/" ++ join(map(range(0, 5000), fn(i) => "s" ++ from_int(i)), "/")

fn std.route.fits(m: Str, method: Str) -> Bool
= m == method || method == "HEAD" && m == "GET"

fn std.route.is_some_str(o: Option[Str]) -> Bool
= match o { Some(_) => true, None => false }

fn std.route.opt_str(o: Option[Str]) -> Str
= match o { Some(s) => s, None => "" }

fn std.route.seg(xs: List[Str], i: Int) -> Str
= match get(xs, i) { Some(s) => s, None => "" }

type std.str.Pair = { left: Str, right: Str }

fn std.str.char_at(xs: List[Str], i: Int) -> Str
= match get(xs, i) { Some(c) => c, None => "" }

fn std.str.ends_with(s: Str, suf: Str) -> Bool
= let ls = len(s) in let lf = len(suf) in if lf > ls then false else slice(s, ls - lf, ls) == suf

fn std.str.eq_ignore_case(a: Str, b: Str) -> Bool
= to_lower(a) == to_lower(b)

fn std.str.is_alpha(c: Str) -> Bool
= len(c) == 1 && (c >= "a" && c <= "z" || c >= "A" && c <= "Z")

fn std.str.is_digit(c: Str) -> Bool
= len(c) == 1 && c >= "0" && c <= "9"

fn std.str.is_space(c: Str) -> Bool
= c == " " || c == "\t" || c == "\n" || c == "\r"

fn std.str.repeat(s: Str, n: Int) -> Str
  req n >= 0
= join(map(range(0, n), fn(i) => s), "")

fn std.str.strip_cr(p: Str) -> Str
= let n = len(p) in if n > 0 && slice(p, n - 1, n) == "\r" then slice(p, 0, n - 1) else p

type std.url.Param = { name: Str, value: Str }

fn std.url.at(bs: List[Int], i: Int) -> Int
= match get(bs, i) { Some(v) => v, None => -1 }

fn std.url.hex_digit(d: Int) -> Str
= if d < 10 then from_char_code(48 + d) else from_char_code(55 + d)

fn std.url.hex_value(c: Int) -> Int
= if c >= 48 && c <= 57 then c - 48 else if c >= 97 && c <= 102 then c - 87 else if c >= 65 && c <= 70 then c - 55 else -1

fn std.url.unreserved(b: Int) -> Bool
= b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 45 || b == 46 || b == 95 || b == 126

fn std.db.bool(row: List[SqlValue], i: Int) -> Option[Bool]
= match std.db.val(row, i) { Some(SqlInt(0)) => Some(false), Some(SqlInt(1)) => Some(true), _ => None }

fn std.db.float(row: List[SqlValue], i: Int) -> Option[Float]
= match std.db.val(row, i) { Some(SqlFloat(x)) => Some(x), Some(SqlInt(n)) => Some(int_to_float(n)), _ => None }

fn std.db.int(row: List[SqlValue], i: Int) -> Option[Int]
= match std.db.val(row, i) { Some(SqlInt(n)) => Some(n), _ => None }

fn std.db.is_null(row: List[SqlValue], i: Int) -> Bool
= match std.db.val(row, i) { Some(SqlNull) => true, _ => false }

test std.db.test_col = std.db.col(DbRows { columns: ["id", "title"], rows: [] }, "title") == Some(1) && std.db.col(DbRows { columns: ["id"], rows: [] }, "ID") == None

test std.db.test_first = std.db.first(DbRows { columns: ["a"], rows: [[SqlInt(1)], [SqlInt(2)]] }) == Some([SqlInt(1)]) && std.db.first(DbRows { columns: ["a"], rows: [] }) == None

fn std.db.text(row: List[SqlValue], i: Int) -> Option[Str]
= match std.db.val(row, i) { Some(SqlText(s)) => Some(s), _ => None }

fn std.http.header(rq: HttpRequest, name: Str) -> Option[Str]
= match get(filter(rq.headers, fn(h) => std.str.eq_ignore_case(h.name, name)), 0) { Some(h) => Some(h.value), None => None }

test std.http.test_response_empty = std.http.response(204, "", "").headers == [HttpHeader { name: "content-type", value: "" }]

fn std.http.text(status: Int, body: Str) -> HttpResponse
= std.http.response(status, "text/plain; charset=utf-8", body)

fn std.http.with_header(resp: HttpResponse, name: Str, value: Str) -> HttpResponse
= HttpResponse { status: resp.status, headers: concat(filter(resp.headers, fn(h) => !std.str.eq_ignore_case(h.name, name)), [HttpHeader { name: to_lower(name), value: value }]), body: resp.body }

fn std.json.err_at(p: Int, m: Str) -> std.json.Error
= std.json.Error { pos: p, message: m }

fn std.json.esc_char(c: Str) -> Str
= if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else let k = char_code(c) in if k >= 32 then c else if k == 10 then "\\n" else if k == 13 then "\\r" else if k == 9 then "\\t" else if k == 8 then "\\b" else if k == 12 then "\\f" else "\\u00" ++ std.json.hexd(k / 16) ++ std.json.hexd(k % 16)

fn std.json.hex4(cs: List[Str], j: Int) -> Result[Int, Int]
= let a = std.json.hexv(std.json.ch(cs, j)) in let b = std.json.hexv(std.json.ch(cs, j + 1)) in let c = std.json.hexv(std.json.ch(cs, j + 2)) in let d = std.json.hexv(std.json.ch(cs, j + 3)) in if a < 0 then Err(j) else if b < 0 then Err(j + 1) else if c < 0 then Err(j + 2) else if d < 0 then Err(j + 3) else Ok(a * 4096 + b * 256 + c * 16 + d)

fn std.json.print_float(x: Float) -> Str
= let t = from_float(x) in if contains(t, "inf") || contains(t, "NaN") then "null" else if len(filter(chars(t), fn(c) => !(std.json.dig(c) || c == "-"))) == 0 then t ++ ".0" else t

fn std.json.scan_digits(cs: List[Str], j: Int) -> Int
= if std.json.dig(std.json.ch(cs, j)) then std.json.scan_digits(cs, j + 1) else j

fn std.json.skip_ws(cs: List[Str], i: Int) -> Int
= let c = std.json.ch(cs, i) in if c == " " || c == "\t" || c == "\n" || c == "\r" then std.json.skip_ws(cs, i + 1) else i

fn std.json.sub(cs: List[Str], a: Int, b: Int) -> Str
= join(map(range(a, b), fn(k) => std.json.ch(cs, k)), "")

type std.route.Result[A] = std.route.Matched(A, List[std.url.Param]) | std.route.NotFound | std.route.MethodNotAllowed(List[Str])

fn std.route.all_ok(ps: List[Str], ds: List[Str], i: Int, n: Int) -> Bool
= if i >= n then true else let p = std.route.seg(ps, i) in if starts_with(p, ":") || p == std.route.seg(ds, i) then std.route.all_ok(ps, ds, i + 1, n) else false

fn std.route.big_routes() -> List[std.route.Route[Int]]
= concat(map(range(0, 9000), fn(i) => std.route.Route { method: "GET", pattern: "/r" ++ from_int(i) ++ "/:id", tag: i }), [std.route.Route { method: "GET", pattern: "/big/*rest", tag: -1 }])

fn std.route.dedupe(xs: List[Str]) -> List[Str]
= map(filter(range(0, len(xs)), fn(i) => i == 0 || get(xs, i) != get(xs, i - 1)), fn(i) => std.route.seg(xs, i))

fn std.route.is_rest(ps: List[Str]) -> Bool
= let n = len(ps) in if n == 0 then false else starts_with(std.route.seg(ps, n - 1), "*")

fn std.str.end_ns(xs: List[Str], i: Int) -> Int
= if i <= 0 then 0 else match get(xs, i - 1) { Some(c) => if std.str.is_space(c) then std.str.end_ns(xs, i - 1) else i, None => 0 }

fn std.str.first_ns(xs: List[Str], i: Int, n: Int) -> Int
= if i >= n then n else match get(xs, i) { Some(c) => if std.str.is_space(c) then std.str.first_ns(xs, i + 1, n) else i, None => n }

fn std.str.lines(s: Str) -> List[Str]
= if s == "" then [] else let parts = split(s, "\n") in let n = len(parts) in let term = std.str.char_at(parts, n - 1) == "" in let cnt = if term then n - 1 else n in map(range(0, cnt), fn(i) => if i < n - 1 then std.str.strip_cr(std.str.char_at(parts, i)) else std.str.char_at(parts, i))

fn std.str.padding(width: Int, fill: Str, have: Int) -> Str
= let fc = chars(fill) in let k = len(fc) in if have >= width || k == 0 then "" else join(map(range(0, width - have), fn(i) => std.str.char_at(fc, i % k)), "")

fn std.str.split_once(s: Str, sep: Str) -> Option[std.str.Pair]
= match index_of(s, sep) { Some(i) => Some(std.str.Pair { left: slice(s, 0, i), right: slice(s, i + len(sep), len(s)) }), None => None }

test std.str.test_big_repeat = len(std.str.repeat("ab", 50000)) == 100000

test std.str.test_class_edge = !std.str.is_digit("") && !std.str.is_digit("12") && !std.str.is_digit("٣") && !std.str.is_alpha("ab") && !std.str.is_alpha("") && std.str.is_alpha("z") && !std.str.is_space(" ") && !std.str.is_space("  ") && !std.str.eq_ignore_case("É", "é")

test std.str.test_classes = std.str.is_digit("7") && !std.str.is_digit("x") && std.str.is_alpha("Q") && !std.str.is_alpha("é") && std.str.is_space("\t") && !std.str.is_space("")

test std.str.test_ends_edge = std.str.ends_with("", "") && std.str.ends_with("héllo", "llo") && !std.str.ends_with("a", "😀")

test std.str.test_ends_with = std.str.ends_with("abc", "bc") && std.str.ends_with("abc", "") && !std.str.ends_with("bc", "abc")

test std.str.test_eq_ignore_case = std.str.eq_ignore_case("Content-Type", "content-TYPE") && !std.str.eq_ignore_case("a", "b")

test std.str.test_repeat = std.str.repeat("ab", 3) == "ababab" && std.str.repeat("x", 0) == ""

fn std.url.bad_at(bs: List[Int], i: Int) -> Bool
= std.url.at(bs, i) == 37 && (std.url.hex_value(std.url.at(bs, i + 1)) < 0 || std.url.hex_value(std.url.at(bs, i + 2)) < 0)

fn std.url.consumed(bs: List[Int], i: Int) -> Bool
= std.url.at(bs, i - 1) == 37 || std.url.at(bs, i - 2) == 37

fn std.url.encode(s: Str) -> Str
= join(map(bytes_to_list(to_bytes(s)), fn(b) => if std.url.unreserved(b) then from_char_code(b) else "%" ++ std.url.hex_digit(b / 16) ++ std.url.hex_digit(b % 16)), "")

fn std.url.is_some(o: Option[std.url.Param]) -> Bool
= match o { Some(_) => true, None => false }

fn std.url.param(ps: List[std.url.Param], name: Str) -> Option[Str]
= match filter(ps, fn(p) => p.name == name) { xs => match get(xs, 0) { Some(p) => Some(p.value), None => None } }

test std.db.test_bool = std.db.bool([SqlInt(0), SqlInt(1), SqlInt(2)], 0) == Some(false) && std.db.bool([SqlInt(0), SqlInt(1), SqlInt(2)], 1) == Some(true) && std.db.bool([SqlInt(0), SqlInt(1), SqlInt(2)], 2) == None

test std.db.test_edges = std.db.int([SqlInt(5)], -1) == None && !std.db.is_null([SqlNull], -1) && std.db.bool([SqlText("1"), SqlFloat(1.0), SqlNull], 0) == None && std.db.bool([SqlText("1"), SqlFloat(1.0), SqlNull], 1) == None && std.db.bool([SqlNull], 0) == None && std.db.int([SqlFloat(1.0), SqlText("1")], 0) == None && std.db.int([SqlFloat(1.0), SqlText("1")], 1) == None && std.db.col(DbRows { columns: ["a", "a"], rows: [] }, "a") == Some(0)

test std.db.test_float = std.db.float([SqlFloat(1.5), SqlInt(2), SqlNull], 0) == Some(1.5) && std.db.float([SqlFloat(1.5), SqlInt(2), SqlNull], 1) == Some(2.0) && std.db.float([SqlFloat(1.5), SqlInt(2), SqlNull], 2) == None

test std.db.test_int_text = std.db.int([SqlInt(5), SqlText("a")], 0) == Some(5) && std.db.int([SqlInt(5), SqlText("a")], 1) == None && std.db.text([SqlInt(5), SqlText("a")], 1) == Some("a") && std.db.text([SqlInt(5)], 3) == None

test std.db.test_null = std.db.is_null([SqlNull, SqlInt(0)], 0) && !std.db.is_null([SqlNull, SqlInt(0)], 1) && !std.db.is_null([SqlNull], 5)

test std.http.test_header = std.http.header(HttpRequest { method: "GET", path: "/", query: "", headers: [HttpHeader { name: "X-Id", value: "1" }, HttpHeader { name: "x-id", value: "2" }], body: "" }, "x-ID") == Some("1")

test std.http.test_header_none = std.http.header(HttpRequest { method: "GET", path: "/", query: "", headers: [], body: "" }, "a") == None

test std.http.test_text = std.http.text(200, "hi") == HttpResponse { status: 200, headers: [HttpHeader { name: "content-type", value: "text/plain; charset=utf-8" }], body: "hi" }

test std.http.test_with_header = std.http.with_header(std.http.text(200, "x"), "X-A", "1").headers == [HttpHeader { name: "content-type", value: "text/plain; charset=utf-8" }, HttpHeader { name: "x-a", value: "1" }]

test std.http.test_with_header_replace = std.http.with_header(std.http.text(200, "x"), "Content-Type", "text/html").headers == [HttpHeader { name: "content-type", value: "text/html" }]

fn std.json.exp_end(cs: List[Str], j: Int) -> Result[Int, std.json.Error]
= let c = std.json.ch(cs, j) in if c == "e" || c == "E" then let s = std.json.ch(cs, j + 1) in let k = if s == "+" || s == "-" then j + 2 else j + 1 in if std.json.dig(std.json.ch(cs, k)) then Ok(std.json.scan_digits(cs, k)) else Err(std.json.err_at(k, "expected exponent digit")) else Ok(j)

fn std.json.frac_end(cs: List[Str], j: Int) -> Result[Int, std.json.Error]
= if std.json.ch(cs, j) == "." then if std.json.dig(std.json.ch(cs, j + 1)) then Ok(std.json.scan_digits(cs, j + 1)) else Err(std.json.err_at(j + 1, "expected digit after '.'")) else Ok(j)

fn std.json.print_str(s: Str) -> Str
= "\"" ++ join(map(chars(s), fn(c) => std.json.esc_char(c)), "") ++ "\""

fn std.route.matches(pattern: Str, ds: List[Str]) -> Bool
= let ps = split(pattern, "/") in let np = len(ps) in let nd = len(ds) in if std.route.is_rest(ps) then if nd >= np then std.route.all_ok(ps, ds, 0, np - 1) else false else if nd == np then std.route.all_ok(ps, ds, 0, np) else false

fn std.route.param(ps: List[std.url.Param], name: Str) -> Option[Str]
= std.url.param(ps, name)

fn std.route.params(pattern: Str, ds: List[Str]) -> List[std.url.Param]
= let ps = split(pattern, "/") in let np = len(ps) in let rest = std.route.is_rest(ps) in let one = fn(i: Int) => let p = std.route.seg(ps, i) in if rest && i == np - 1 then Some(std.url.Param { name: slice(p, 1, len(p)), value: join(map(range(np - 1, len(ds)), fn(j) => std.route.seg(ds, j)), "/") }) else if starts_with(p, ":") then Some(std.url.Param { name: slice(p, 1, len(p)), value: std.route.seg(ds, i) }) else None in map(filter(map(range(0, np), one), fn(o) => match o { Some(_) => true, None => false }), fn(o) => match o { Some(p) => p, None => std.url.Param { name: "", value: "" } })

fn std.str.pad_left(s: Str, width: Int, fill: Str) -> Str
= std.str.padding(width, fill, len(s)) ++ s

fn std.str.pad_right(s: Str, width: Int, fill: Str) -> Str
= s ++ std.str.padding(width, fill, len(s))

test std.str.test_lines = std.str.lines("a\r\nb\nc\n") == ["a", "b", "c"] && std.str.lines("") == []

test std.str.test_lines_bare_cr = std.str.lines("a\rb\n\n") == ["a\rb", ""]

test std.str.test_lines_edge = std.str.lines("\n") == [""] && std.str.lines("\n\n") == ["", ""] && std.str.lines("\r\n") == [""] && std.str.lines("a\r\r\nb") == ["a\r", "b"] && std.str.lines("a\rb") == ["a\rb"] && std.str.lines("a\r") == ["a\r"] && std.str.lines("a\n\nb") == ["a", "", "b"]

test std.str.test_split_edge = std.str.split_once("abc", "") == Some(std.str.Pair { left: "", right: "abc" }) && std.str.split_once("", "=") == None && std.str.split_once("a--b", "--") == Some(std.str.Pair { left: "a", right: "b" })

test std.str.test_split_once = std.str.split_once("a=b=c", "=") == Some(std.str.Pair { left: "a", right: "b=c" }) && std.str.split_once("abc", "=") == None

fn std.str.trim_end(s: Str) -> Str
= let xs = chars(s) in slice(s, 0, std.str.end_ns(xs, len(xs)))

fn std.str.trim_start(s: Str) -> Str
= let xs = chars(s) in slice(s, std.str.first_ns(xs, 0, len(xs)), len(xs))

fn std.url.decode_impl(s: Str, plus: Bool) -> Option[Str]
= let bs = bytes_to_list(to_bytes(s)) in let n = len(bs) in if len(filter(range(0, n), fn(i) => std.url.bad_at(bs, i))) > 0 then None else let keep = filter(range(0, n), fn(i) => !std.url.consumed(bs, i)) in let out = map(keep, fn(i) => let c = std.url.at(bs, i) in if c == 37 then std.url.hex_value(std.url.at(bs, i + 1)) * 16 + std.url.hex_value(std.url.at(bs, i + 2)) else if plus && c == 43 then 32 else c) in bytes_to_str(bytes_from(out))

test std.url.test_encode = std.url.encode("a b/é~") == "a%20b%2F%C3%A9~" && std.url.encode("AZaz09-._~") == "AZaz09-._~"

fn std.route.find[A](routes: List[std.route.Route[A]], i: Int, method: Str, ds: List[Str]) -> std.route.Result[A]
= match get(routes, i) { None => std.route.NotFound, Some(r) => if std.route.fits(r.method, method) && std.route.matches(r.pattern, ds) then std.route.Matched(r.tag, std.route.params(r.pattern, ds)) else std.route.find(routes, i + 1, method, ds) }

test std.route.test_param_lookup = std.route.param([std.url.Param { name: "id", value: "5" }], "id") == Some("5") && std.route.param([], "id") == None

test std.str.test_big = len(std.str.lines(std.str.repeat("ab\r\n", 30000))) == 30000 && len(std.str.trim_start(std.str.repeat(" ", 50000) ++ "x")) == 1 && len(std.str.trim_end("x" ++ std.str.repeat(" ", 50000))) == 1 && len(std.str.pad_left("", 100000, "ab")) == 100000

test std.str.test_pad = std.str.pad_left("7", 3, "0") == "007" && std.str.pad_right("ab", 5, "xy") == "abxyx" && std.str.pad_left("abc", 2, "0") == "abc"

test std.str.test_pad_edge = std.str.pad_left("7", 4, "ab") == "aba7" && std.str.pad_right("7", 4, "ab") == "7aba" && std.str.pad_left("é", 3, "·") == "··é" && std.str.pad_left("a", 5, "") == "a" && std.str.pad_left("a", -1, "x") == "a"

test std.str.test_trim_edge = std.str.trim_start("  \n") == "" && std.str.trim_end("  \n") == "" && std.str.trim_start(" a") == " a" && std.str.trim_end("a ") == "a " && std.str.trim_start("") == "" && trim("   x ") == std.str.trim_start(std.str.trim_end("   x "))

test std.str.test_trim_sides = std.str.trim_start(" \t a b \n") == "a b \n" && std.str.trim_end(" \t a b \n") == " \t a b"

fn std.url.decode(s: Str) -> Option[Str]
= std.url.decode_impl(s, false)

fn std.url.decode_form(s: Str) -> Option[Str]
= std.url.decode_impl(s, true)

fn std.route.route[A](routes: List[std.route.Route[A]], method: Str, path: Str) -> std.route.Result[A]
= let decoded = map(split(path, "/"), fn(s) => std.url.decode(s)) in if len(filter(decoded, fn(o) => !std.route.is_some_str(o))) > 0 then std.route.NotFound else let ds = map(decoded, fn(o) => std.route.opt_str(o)) in match std.route.find(routes, 0, method, ds) { std.route.NotFound => let ms = map(filter(routes, fn(r) => std.route.matches(r.pattern, ds)), fn(r) => r.method) in if len(ms) == 0 then std.route.NotFound else let ms2 = if len(filter(ms, fn(m) => m == "GET")) > 0 then concat(ms, ["HEAD"]) else ms in std.route.MethodNotAllowed(std.route.dedupe(sort_str(ms2))), other => other }

fn std.url.parse_piece(p: Str) -> Option[std.url.Param]
= let kv = match index_of(p, "=") { Some(i) => [slice(p, 0, i), slice(p, i + 1, len(p))], None => [p, ""] } in match std.url.decode_form(match get(kv, 0) { Some(a) => a, None => "" }) { Some(nm) => match std.url.decode_form(match get(kv, 1) { Some(a) => a, None => "" }) { Some(v) => Some(std.url.Param { name: nm, value: v }), None => None }, None => None }

test std.url.test_decode = std.url.decode("a%20b+c") == Some("a b+c") && std.url.decode("%c3%A9") == Some("é")

test std.url.test_decode_form = std.url.decode_form("a+b%2Bc") == Some("a b+c")

test std.url.test_decode_invalid = std.url.decode("%zz") == None && std.url.decode("%4") == None && std.url.decode("%C3") == None

test std.url.test_edges = std.url.decode("") == Some("") && std.url.decode("%") == None && std.url.decode("a%2") == None && std.url.decode("%G1") == None && std.url.decode("%FF") == None && std.url.decode("%C3%28") == None && std.url.decode("%C0%AF") == None && std.url.decode("%ED%A0%80") == None

test std.url.test_edges2 = std.url.decode("%2525") == Some("%25") && std.url.decode("%00") == Some("\0") && std.url.decode("%F0%9F%98%80") == Some("😀") && std.url.decode("é") == Some("é") && std.url.decode("%%41") == None

test std.url.test_edges3 = std.url.decode_form("a+%2B+b") == Some("a + b") && std.url.encode("+/?") == "%2B%2F%3F" && std.url.encode("") == ""

test std.url.test_roundtrip = std.url.decode(std.url.encode("x=1&y=😀 z")) == Some("x=1&y=😀 z")

test std.route.test_405 = std.route.route([std.route.Route { method: "POST", pattern: "/t", tag: 1 }, std.route.Route { method: "GET", pattern: "/t", tag: 2 }, std.route.Route { method: "GET", pattern: "/t", tag: 3 }], "PUT", "/t") == std.route.MethodNotAllowed(["GET", "HEAD", "POST"])

test std.route.test_big_405 = std.route.route(std.route.big_routes(), "POST", std.route.big_path()) == std.route.MethodNotAllowed(["GET", "HEAD"])

test std.route.test_big_get = match std.route.route(std.route.big_routes(), "GET", std.route.big_path()) { std.route.Matched(t, ps) => t == -1 && len(ps) == 1, _ => false }

test std.route.test_big_last = std.route.route(std.route.big_routes(), "GET", "/r8999/x") == std.route.Matched(8999, [std.url.Param { name: "id", value: "x" }])

test std.route.test_big_nf = std.route.route(std.route.big_routes(), "GET", "/zzz") == std.route.NotFound

test std.route.test_case = std.route.route([std.route.Route { method: "get", pattern: "/t", tag: 1 }], "GET", "/t") == std.route.MethodNotAllowed(["get"])

test std.route.test_empty_param = std.route.route([std.route.Route { method: "GET", pattern: "/todos/:id", tag: 1 }], "GET", "/todos/") == std.route.Matched(1, [std.url.Param { name: "id", value: "" }])

test std.route.test_first_wins = std.route.route([std.route.Route { method: "GET", pattern: "/a/:x", tag: "p" }, std.route.Route { method: "GET", pattern: "/a/b", tag: "lit" }], "GET", "/a/b") == std.route.Matched("p", [std.url.Param { name: "x", value: "b" }])

test std.route.test_head = std.route.route([std.route.Route { method: "GET", pattern: "/t", tag: 7 }], "HEAD", "/t") == std.route.Matched(7, [])

test std.route.test_head_405 = std.route.route([std.route.Route { method: "GET", pattern: "/t", tag: 1 }], "POST", "/t") == std.route.MethodNotAllowed(["GET", "HEAD"])

test std.route.test_literal = std.route.route([std.route.Route { method: "GET", pattern: "/todos", tag: 1 }], "GET", "/todos") == std.route.Matched(1, [])

test std.route.test_mix = std.route.route([std.route.Route { method: "GET", pattern: "/u/:id/p/*r", tag: 1 }], "GET", "/u/5/p/x/y") == std.route.Matched(1, [std.url.Param { name: "id", value: "5" }, std.url.Param { name: "r", value: "x/y" }])

test std.route.test_not_found = std.route.route([std.route.Route { method: "GET", pattern: "/todos", tag: 1 }], "GET", "/todos/") == std.route.NotFound

test std.route.test_param = std.route.route([std.route.Route { method: "GET", pattern: "/todos/:id", tag: "get" }], "GET", "/todos/a%20b") == std.route.Matched("get", [std.url.Param { name: "id", value: "a b" }])

test std.route.test_rest = std.route.route([std.route.Route { method: "GET", pattern: "/files/*rest", tag: 0 }], "GET", "/files/a/b.txt") == std.route.Matched(0, [std.url.Param { name: "rest", value: "a/b.txt" }])

test std.route.test_rest_empty = std.route.route([std.route.Route { method: "GET", pattern: "/files/*rest", tag: 1 }], "GET", "/files/") == std.route.Matched(1, [std.url.Param { name: "rest", value: "" }])

test std.route.test_rest_enc = std.route.route([std.route.Route { method: "GET", pattern: "/files/*rest", tag: 1 }], "GET", "/files/a%2Fb") == std.route.Matched(1, [std.url.Param { name: "rest", value: "a/b" }])

test std.route.test_rest_none = std.route.route([std.route.Route { method: "GET", pattern: "/files/*rest", tag: 1 }], "GET", "/files") == std.route.NotFound

test std.route.test_rest_notlast = std.route.route([std.route.Route { method: "GET", pattern: "/*x/b", tag: 1 }], "GET", "/*x/b") == std.route.Matched(1, [])

test std.route.test_undecodable = std.route.route([std.route.Route { method: "GET", pattern: "/t/:id", tag: 1 }], "GET", "/t/%zz") == std.route.NotFound

test std.route.test_utf8 = std.route.route([std.route.Route { method: "GET", pattern: "/café", tag: 1 }], "GET", "/caf%C3%A9") == std.route.Matched(1, [])

fn std.url.parse_query(q: Str) -> List[std.url.Param]
= map(filter(map(filter(split(q, "&"), fn(p) => p != ""), fn(p) => std.url.parse_piece(p)), fn(o) => std.url.is_some(o)), fn(o) => match o { Some(p) => p, None => std.url.Param { name: "", value: "" } })

fn std.http.query(rq: HttpRequest) -> List[std.url.Param]
= std.url.parse_query(rq.query)

test std.url.test_edges4 = std.url.parse_query("a%3Db=c&a=%26&k=v=w;x") == [std.url.Param { name: "a=b", value: "c" }, std.url.Param { name: "a", value: "&" }, std.url.Param { name: "k", value: "v=w;x" }] && std.url.parse_query("") == [] && std.url.parse_query("&&") == []

test std.url.test_param = std.url.param(std.url.parse_query("a=1&a=2"), "a") == Some("1") && std.url.param([], "a") == None

test std.url.test_parse_query = std.url.parse_query("a=1&b=hello+world&a=2") == [std.url.Param { name: "a", value: "1" }, std.url.Param { name: "b", value: "hello world" }, std.url.Param { name: "a", value: "2" }]

test std.url.test_parse_query_edges = std.url.parse_query("&x&=y&bad=%zz&") == [std.url.Param { name: "x", value: "" }, std.url.Param { name: "", value: "y" }]

test std.http.test_query = std.http.query(HttpRequest { method: "GET", path: "/", query: "a=1&b=x+y", headers: [], body: "" }) == [std.url.Param { name: "a", value: "1" }, std.url.Param { name: "b", value: "x y" }]

fn std.db.cell(v: SqlValue) -> std.json.Json
= match v { SqlNull => std.json.Null, SqlInt(n) => std.json.Int(n), SqlFloat(x) => std.json.Float(x), SqlText(s) => std.json.Str(s) }

fn std.db.field(cols: List[Str], row: List[SqlValue], i: Int) -> std.json.Field
= match get(cols, i) { Some(k) => match get(row, i) { Some(v) => std.json.Field { key: k, value: std.db.cell(v) }, None => std.json.Field { key: k, value: std.json.Null } }, None => std.json.Field { key: "", value: std.json.Null } }

fn std.db.obj(cols: List[Str], row: List[SqlValue]) -> std.json.Json
= let n = if len(cols) < len(row) then len(cols) else len(row) in std.json.Obj(map(range(0, n), fn(i: Int) => std.db.field(cols, row, i)))

test std.db.test_to_json = std.json.print(std.db.to_json(DbRows { columns: ["id", "t", "x"], rows: [[SqlInt(1), SqlText("a"), SqlNull], [SqlInt(2), SqlText("b"), SqlFloat(0.5)]] })) == "[{\"id\":1,\"t\":\"a\",\"x\":null},{\"id\":2,\"t\":\"b\",\"x\":0.5}]"

test std.db.test_to_json_empty = std.db.to_json(DbRows { columns: ["id"], rows: [] }) == std.json.Arr([])

test std.db.test_to_json_len = std.json.print(std.db.to_json(DbRows { columns: ["a", "b", "a"], rows: [[SqlInt(1)], [SqlInt(1), SqlInt(2), SqlInt(3), SqlInt(4)]] })) == "[{\"a\":1},{\"a\":1,\"b\":2,\"a\":3}]"

fn std.db.to_json(rows: DbRows) -> std.json.Json
= std.json.Arr(map(rows.rows, fn(r: List[SqlValue]) => std.db.obj(rows.columns, r)))

fn std.http.bad_request(message: Str) -> HttpResponse
= std.http.error(400, "bad_request", message)

test std.http.test_bad_request = std.http.bad_request("a\"b").body == "{\"error\":{\"code\":\"bad_request\",\"message\":\"a\\\"b\"}}"

fn std.http.error(status: Int, code: Str, message: Str) -> HttpResponse
= std.http.json(status, std.json.Obj([std.json.Field { key: "error", value: std.json.Obj([std.json.Field { key: "code", value: std.json.Str(code) }, std.json.Field { key: "message", value: std.json.Str(message) }]) }]))

fn std.http.method_not_allowed(allowed: List[Str]) -> HttpResponse
= std.http.with_header(std.http.error(405, "method_not_allowed", "method not allowed"), "allow", join(allowed, ", "))

fn std.http.not_found() -> HttpResponse
= std.http.error(404, "not_found", "not found")

test std.http.test_error = std.http.not_found().body == "{\"error\":{\"code\":\"not_found\",\"message\":\"not found\"}}" && std.http.not_found().status == 404

test std.http.test_method_not_allowed = std.http.method_not_allowed(["GET", "POST"]).headers == [HttpHeader { name: "content-type", value: "application/json" }, HttpHeader { name: "allow", value: "GET, POST" }]

test std.http.test_mna_empty = std.http.method_not_allowed([]).headers == [HttpHeader { name: "content-type", value: "application/json" }, HttpHeader { name: "allow", value: "" }]

fn std.http.json(status: Int, j: std.json.Json) -> HttpResponse
= std.http.response(status, "application/json", std.json.print(j))

fn std.http.json_body(rq: HttpRequest) -> Result[std.json.Json, HttpResponse]
= match std.http.header(rq, "content-type") { None => Err(std.http.error(415, "unsupported_media_type", "content-type must be application/json")), Some(v) => if starts_with(to_lower(v), "application/json") then match std.json.parse(rq.body) { Ok(j) => Ok(j), Err(e) => Err(std.http.error(400, "invalid_json", "invalid JSON at position " ++ from_int(e.pos) ++ ": " ++ e.message)) } else Err(std.http.error(415, "unsupported_media_type", "content-type must be application/json")) }

test std.http.test_json_body_400 = match std.http.json_body(HttpRequest { method: "POST", path: "/", query: "", headers: [HttpHeader { name: "content-type", value: "application/json" }], body: "[1,]" }) { Err(r) => r.status == 400 && contains(r.body, "invalid JSON at position 3: "), Ok(_) => false }

test std.http.test_json_body_415 = match std.http.json_body(HttpRequest { method: "POST", path: "/", query: "", headers: [], body: "[1]" }) { Err(r) => r.status == 415, Ok(_) => false }

test std.http.test_json_body_empty = match std.http.json_body(HttpRequest { method: "POST", path: "/", query: "", headers: [HttpHeader { name: "Content-Type", value: "Application/JSON" }], body: "" }) { Err(r) => r.status == 400 && contains(r.body, "invalid JSON at position 0: "), Ok(_) => false }

test std.http.test_json_body_wrongtype = std.http.json_body(HttpRequest { method: "POST", path: "/", query: "", headers: [HttpHeader { name: "content-type", value: "text/plain" }], body: "[1]" }) == Err(std.http.error(415, "unsupported_media_type", "content-type must be application/json"))

test std.http.test_json = std.http.json(201, std.json.obj([std.json.field("ok", std.json.bool(true))])) == HttpResponse { status: 201, headers: [HttpHeader { name: "content-type", value: "application/json" }], body: "{\"ok\":true}" }

test std.http.test_json_body_ok = std.http.json_body(HttpRequest { method: "POST", path: "/", query: "", headers: [HttpHeader { name: "content-type", value: "application/json; charset=utf-8" }], body: "[1]" }) == Ok(std.json.arr([std.json.int(1)]))

type std.json.Field = { key: Str, value: std.json.Json }

type std.json.Json = std.json.Null | std.json.Bool(Bool) | std.json.Int(Int) | std.json.Float(Float) | std.json.Str(Str) | std.json.Arr(List[std.json.Json]) | std.json.Obj(List[std.json.Field])

type std.json.Parsed = { value: std.json.Json, next: Int }

fn std.json.arr(xs: List[std.json.Json]) -> std.json.Json
= std.json.Arr(xs)

fn std.json.as_arr(j: std.json.Json) -> Option[List[std.json.Json]]
= match j { std.json.Arr(xs) => Some(xs), _ => None }

fn std.json.as_bool(j: std.json.Json) -> Option[Bool]
= match j { std.json.Bool(b) => Some(b), _ => None }

fn std.json.as_float(j: std.json.Json) -> Option[Float]
= match j { std.json.Float(x) => Some(x), std.json.Int(n) => Some(int_to_float(n)), _ => None }

fn std.json.as_int(j: std.json.Json) -> Option[Int]
= match j { std.json.Int(n) => Some(n), _ => None }

fn std.json.as_obj(j: std.json.Json) -> Option[List[std.json.Field]]
= match j { std.json.Obj(fs) => Some(fs), _ => None }

fn std.json.as_str(j: std.json.Json) -> Option[Str]
= match j { std.json.Str(s) => Some(s), _ => None }

fn std.json.at(j: std.json.Json, i: Int) -> Option[std.json.Json]
= match j { std.json.Arr(xs) => if i < 0 then None else get(xs, i), _ => None }

fn std.json.bool(b: Bool) -> std.json.Json
= std.json.Bool(b)

fn std.json.field(k: Str, v: std.json.Json) -> std.json.Field
= std.json.Field { key: k, value: v }

fn std.json.first_field(fs: List[std.json.Field], key: Str, i: Int) -> Option[std.json.Json]
= match get(fs, i) { None => None, Some(f) => if f.key == key then Some(f.value) else std.json.first_field(fs, key, i + 1) }

fn std.json.int(n: Int) -> std.json.Json
= std.json.Int(n)

fn std.json.obj(fs: List[std.json.Field]) -> std.json.Json
= std.json.Obj(fs)

fn std.json.print(j: std.json.Json) -> Str
= match j { std.json.Null => "null", std.json.Bool(b) => if b then "true" else "false", std.json.Int(n) => from_int(n), std.json.Float(x) => std.json.print_float(x), std.json.Str(s) => std.json.print_str(s), std.json.Arr(xs) => "[" ++ join(map(xs, fn(x) => std.json.print(x)), ",") ++ "]", std.json.Obj(fs) => "{" ++ join(map(fs, fn(f) => std.json.print_str(f.key) ++ ":" ++ std.json.print(f.value)), ",") ++ "}" }

fn std.json.str(s: Str) -> std.json.Json
= std.json.Str(s)

fn std.json.get(j: std.json.Json, key: Str) -> Option[std.json.Json]
= match j { std.json.Obj(fs) => std.json.first_field(fs, key, 0), _ => None }

fn std.json.lit_loop(cs: List[Str], i: Int, wc: List[Str], k: Int, v: std.json.Json) -> Result[std.json.Parsed, std.json.Error]
= if k >= len(wc) then Ok(std.json.Parsed { value: v, next: i + k }) else if std.json.ch(cs, i + k) == std.json.ch(wc, k) then std.json.lit_loop(cs, i, wc, k + 1, v) else Err(std.json.err_at(i + k, "invalid literal"))

fn std.json.num_value(text: Str, isint: Bool, i: Int, e: Int) -> Result[std.json.Parsed, std.json.Error]
= let asf = match to_float(text) { Some(x) => if contains(from_float(x), "inf") then Err(std.json.err_at(i, "number out of range")) else Ok(std.json.Parsed { value: std.json.Float(x), next: e }), None => Err(std.json.err_at(i, "invalid number")) } in if isint then match to_int(text) { Some(n) => Ok(std.json.Parsed { value: std.json.Int(n), next: e }), None => asf } else asf

test std.json.test_print = std.json.print(std.json.obj([std.json.field("a", std.json.arr([std.json.Float(2.0), std.json.bool(false)])), std.json.field("q\"", std.json.str("\u{1}/é"))])) == "{\"a\":[2.0,false],\"q\\\"\":\"\\u0001/é\"}"

test std.json.test_print_float = std.json.print(std.json.Float(1e20)) == "1e20" && std.json.print(std.json.Float(-0.0)) == "-0.0" && std.json.print(std.json.Float(0.1)) == "0.1" && std.json.print(std.json.Float(1e-7)) == "1e-7" && std.json.print(std.json.Float(3.0)) == "3.0" && std.json.print(std.json.Float(-3.0)) == "-3.0" && std.json.print(std.json.Int(-5)) == "-5" && std.json.print(std.json.Null) == "null" && std.json.print(std.json.arr([])) == "[]" && std.json.print(std.json.obj([])) == "{}"

test std.json.test_print_inf = (match to_float("1e999") { Some(x) => std.json.print(std.json.Float(x)) == "null", None => true }) && (match to_float("-inf") { Some(x) => std.json.print(std.json.Float(x)) == "null", None => true })

test std.json.test_print_nan = match to_float("NaN") { Some(x) => std.json.print(std.json.Float(x)) == "null", None => false }

test std.json.test_print_str = std.json.print(std.json.Str("\0\u{8}\t\n\u{b}\u{c}\r\u{1f}\u{7f}/ \\\"")) == "\"\\u0000\\b\\t\\n\\u000b\\f\\r\\u001f\u{7f}/ \\\\\\\"\""

fn std.json.parse_number(cs: List[Str], i: Int) -> Result[std.json.Parsed, std.json.Error]
= let j0 = if std.json.ch(cs, i) == "-" then i + 1 else i in let c0 = std.json.ch(cs, j0) in if !std.json.dig(c0) then Err(std.json.err_at(j0, "expected digit")) else let j1 = if c0 == "0" then j0 + 1 else std.json.scan_digits(cs, j0) in match std.json.frac_end(cs, j1) { Err(e) => Err(e), Ok(j2) => match std.json.exp_end(cs, j2) { Err(e) => Err(e), Ok(j3) => std.json.num_value(std.json.sub(cs, i, j3), j3 == j1, i, j3) } }

test std.json.test_access = let j = std.json.obj([std.json.field("n", std.json.int(3))]) in std.json.get(j, "n") == Some(std.json.Int(3)) && std.json.as_float(std.json.Int(3)) == Some(3.0) && std.json.as_int(std.json.Float(3.0)) == None && std.json.at(std.json.arr([j]), 1) == None

test std.json.test_accessors = let j = std.json.arr([std.json.int(1), std.json.str("s")]) in std.json.at(j, 1) == Some(std.json.Str("s")) && std.json.at(j, -1) == None && std.json.at(j, 2) == None && std.json.at(std.json.Null, 0) == None && std.json.get(j, "a") == None && std.json.as_str(std.json.str("s")) == Some("s") && std.json.as_str(std.json.int(1)) == None && std.json.as_bool(std.json.bool(true)) == Some(true) && std.json.as_arr(j) == Some([std.json.int(1), std.json.str("s")]) && std.json.as_obj(j) == None && std.json.as_obj(std.json.obj([])) == Some([]) && std.json.as_float(std.json.Float(1.5)) == Some(1.5) && std.json.as_float(std.json.str("")) == None && std.json.get(std.json.obj([std.json.field("k", std.json.int(1)), std.json.field("k", std.json.int(2))]), "k") == Some(std.json.Int(1)) && std.json.obj([]) == std.json.Obj([]) && std.json.field("k", std.json.Null) == std.json.Field { key: "k", value: std.json.Null }

fn std.json.arr_loop(cs: List[Str], j: Int, d: Int, m: Map[Int, std.json.Json], k: Int) -> Result[std.json.Parsed, std.json.Error]
= match std.json.parse_value(cs, j, d) { Err(e) => Err(e), Ok(p) => let m2 = map_put(m, k, p.value) in let q = std.json.skip_ws(cs, p.next) in let c = std.json.ch(cs, q) in if c == "," then std.json.arr_loop(cs, std.json.skip_ws(cs, q + 1), d, m2, k + 1) else if c == "]" then Ok(std.json.Parsed { value: std.json.Arr(map_values(m2)), next: q + 1 }) else Err(std.json.err_at(q, "expected ',' or ']'")) }

fn std.json.parse_arr(cs: List[Str], i: Int, depth: Int) -> Result[std.json.Parsed, std.json.Error]
= if depth >= 128 then Err(std.json.err_at(i, "nesting too deep")) else let j = std.json.skip_ws(cs, i + 1) in if std.json.ch(cs, j) == "]" then Ok(std.json.Parsed { value: std.json.Arr([]), next: j + 1 }) else std.json.arr_loop(cs, j, depth + 1, map_new(), 0)

fn std.json.epos(s: Str) -> Int
= match std.json.parse(s) { Err(e) => e.pos, Ok(_) => -1 }

test std.json.test_depth = std.json.epos(std.json.nest(128, "[", "]")) == -1 && std.json.epos(std.json.nest(129, "[", "]")) == 128 && std.json.epos(std.json.nest(1, "[", "]")) == -1 && std.json.epos(join(map(range(0, 64), fn(i) => "{\"a\":["), "") ++ "1" ++ join(map(range(0, 64), fn(i) => "]}"), "")) == -1 && std.json.epos(join(map(range(0, 65), fn(i) => "{\"a\":["), "") ++ "1" ++ join(map(range(0, 65), fn(i) => "]}"), "")) == 384

test std.json.test_pos_basic = std.json.epos("") == 0 && std.json.epos("   ") == 3 && std.json.epos("[1,]") == 3 && std.json.epos("[1 2]") == 3 && std.json.epos("{\"a\" 1}") == 5 && std.json.epos("{a:1}") == 1 && std.json.epos("nul") == 3 && std.json.epos("nulls") == 4 && std.json.epos("True") == 0

test std.json.test_pos_numbers = std.json.epos("01") == 1 && std.json.epos("-01") == 2 && std.json.epos("1.") == 2 && std.json.epos(".5") == 0 && std.json.epos("-") == 1 && std.json.epos("1e5.5") == 3 && std.json.epos("1 x") == 2 && std.json.epos("[1]x") == 3 && std.json.epos("+1") == 0 && std.json.epos("1e") == 2 && std.json.epos("1e+") == 3 && std.json.epos("1.e5") == 2 && std.json.epos("0x10") == 1 && std.json.epos("NaN") == 0 && std.json.epos("Infinity") == 0

test std.json.test_pos_strings = std.json.epos("\"abc") == 4 && std.json.epos("\"a\tb\"") == 2 && std.json.epos("\"é\\x\"") == 3 && std.json.epos("\"\\u12\"") == 5 && std.json.epos("\"a\\ud800\\u0041\"") == 2 && std.json.epos("\"\\udc00\"") == 1 && std.json.epos("[1e400]") == 1 && std.json.epos("\"\\ud800x\"") == 1 && std.json.epos("[\"\\ud800\"]") == 2

fn std.json.obj_loop(cs: List[Str], j: Int, d: Int, m: Map[Int, std.json.Field], seen: Map[Str, Bool], k: Int) -> Result[std.json.Parsed, std.json.Error]
= if std.json.ch(cs, j) != "\"" then Err(std.json.err_at(j, "expected string key")) else match std.json.str_loop(cs, j + 1, map_new(), 0) { Err(e) => Err(e), Ok(r) => if map_has(seen, r.text) then Err(std.json.err_at(j, "duplicate key")) else let q = std.json.skip_ws(cs, r.next) in if std.json.ch(cs, q) != ":" then Err(std.json.err_at(q, "expected ':'")) else match std.json.parse_value(cs, std.json.skip_ws(cs, q + 1), d) { Err(e) => Err(e), Ok(p) => let m2 = map_put(m, k, std.json.Field { key: r.text, value: p.value }) in let s2 = map_put(seen, r.text, true) in let q2 = std.json.skip_ws(cs, p.next) in let c = std.json.ch(cs, q2) in if c == "," then std.json.obj_loop(cs, std.json.skip_ws(cs, q2 + 1), d, m2, s2, k + 1) else if c == "}" then Ok(std.json.Parsed { value: std.json.Obj(map_values(m2)), next: q2 + 1 }) else Err(std.json.err_at(q2, "expected ',' or '}'")) } }

fn std.json.parse_obj(cs: List[Str], i: Int, depth: Int) -> Result[std.json.Parsed, std.json.Error]
= if depth >= 128 then Err(std.json.err_at(i, "nesting too deep")) else let j = std.json.skip_ws(cs, i + 1) in if std.json.ch(cs, j) == "}" then Ok(std.json.Parsed { value: std.json.Obj([]), next: j + 1 }) else std.json.obj_loop(cs, j, depth + 1, map_new(), map_new(), 0)

fn std.json.parse(s: Str) -> Result[std.json.Json, std.json.Error]
= let cs = chars(s) in match std.json.parse_value(cs, std.json.skip_ws(cs, 0), 0) { Err(e) => Err(e), Ok(p) => let j = std.json.skip_ws(cs, p.next) in if std.json.ch(cs, j) == "" then Ok(p.value) else Err(std.json.err_at(j, "unexpected trailing characters")) }

test std.json.test_big_array = match std.json.parse("[" ++ join(map(range(0, 20000), fn(i) => from_int(i)), ",") ++ "]") { Ok(j) => std.json.at(j, 19999) == Some(std.json.Int(19999)), Err(_) => false }

test std.json.test_big_obj = match std.json.parse("{" ++ join(map(range(0, 10000), fn(i) => "\"k" ++ from_int(i) ++ "\":" ++ from_int(i)), ",") ++ "}") { Ok(j) => std.json.get(j, "k9999") == Some(std.json.Int(9999)), Err(_) => false }

test std.json.test_big_string = match std.json.parse("\"" ++ join(map(range(0, 100000), fn(i) => "a"), "") ++ "\"") { Ok(std.json.Str(s)) => len(s) == 100000, _ => false }

test std.json.test_dup_scopes = std.json.epos("{\"a\":1,\"\\u0061\":2}") == 7 && std.json.parse("{\"a\":{\"a\":1}}") == Ok(std.json.obj([std.json.field("a", std.json.obj([std.json.field("a", std.json.int(1))]))]))

test std.json.test_overflow = std.json.epos("1e400") == 0 && std.json.epos("-1e400") == 0 && std.json.parse("1e-400") == Ok(std.json.Float(0.0)) && std.json.parse("-0") == Ok(std.json.Int(0)) && std.json.parse("-9223372036854775808") == Ok(std.json.Int(-9223372036854775807 - 1)) && std.json.parse("1.0") == Ok(std.json.Float(1.0)) && std.json.parse("1E2") == Ok(std.json.Float(100.0))

test std.json.test_parse_duplicate_key = match std.json.parse("{\"a\":1,\"a\":2}") { Err(e) => e.pos == 7, Ok(_) => false }

test std.json.test_parse_errors = match std.json.parse("[1,]") { Err(e) => e.pos == 3 && e.message != "", Ok(_) => false }

test std.json.test_parse_escapes = std.json.parse("\"\\u00e9\\n\\ud83d\\ude00\"") == Ok(std.json.Str("é\n😀"))

test std.json.test_parse_int_vs_float = std.json.parse("1e2") == Ok(std.json.Float(100.0)) && std.json.parse("9223372036854775807") == Ok(std.json.Int(9223372036854775807)) && std.json.parse("9223372036854775808") == Ok(std.json.Float(9.223372036854776e18))

test std.json.test_parse_lone_surrogate = match std.json.parse("\"\\ud800\"") { Err(e) => e.pos == 1, Ok(_) => false }

test std.json.test_parse_obj = std.json.parse("{\"b\":[1,null],\"a\":\"x\"}") == Ok(std.json.obj([std.json.field("b", std.json.arr([std.json.int(1), std.json.Null])), std.json.field("a", std.json.str("x"))]))

test std.json.test_parse_scalars = std.json.parse("null") == Ok(std.json.Null) && std.json.parse(" true ") == Ok(std.json.Bool(true)) && std.json.parse("-12") == Ok(std.json.Int(-12)) && std.json.parse("2.5") == Ok(std.json.Float(2.5))

test std.json.test_roundtrip = let j = std.json.arr([std.json.Float(0.1), std.json.str("\t\"\\"), std.json.obj([])]) in std.json.parse(std.json.print(j)) == Ok(j)

test std.json.test_roundtrip2 = let j = std.json.obj([std.json.field("a", std.json.Float(1e20)), std.json.field("b", std.json.arr([std.json.Float(-0.0), std.json.Float(2.0), std.json.int(-9223372036854775807 - 1), std.json.str("é😀\0\u{1f}\u{7f}"), std.json.Null, std.json.bool(true)])), std.json.field("", std.json.obj([std.json.field("x", std.json.Float(1e-7))]))]) in std.json.parse(std.json.print(j)) == Ok(j)

test std.json.test_strings = std.json.parse("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u0000\\u00E9\\uD83D\\uDE00\\u007f\"") == Ok(std.json.Str("\"\\/\u{8}\u{c}\n\r\t\0é😀\u{7f}")) && std.json.parse("\"😀é\"") == Ok(std.json.Str("😀é")) && std.json.epos("\"😀\\x\"") == 3 && std.json.parse("\"\"") == Ok(std.json.Str("")) && std.json.epos("\"\\ud83d\\u0041\"") == 1 && std.json.epos("\"\\ud83d\\ude0\"") == 12 && std.json.epos("\"\\ud83d") == 7

test std.json.test_ws = std.json.parse(" \t\n\r[ 1 , 2 ] \n") == Ok(std.json.arr([std.json.int(1), std.json.int(2)])) && std.json.epos(" 1") == 0 && std.json.epos("\u{c}1") == 0 && std.json.epos("1\u{b}") == 1 && std.json.epos("// c\n1") == 0 && std.json.epos("[1,/*x*/2]") == 3 && std.json.epos("'a'") == 0 && std.json.epos("{\"a\":1,}") == 7

fn std.json.parse_value(cs: List[Str], i: Int, depth: Int) -> Result[std.json.Parsed, std.json.Error]
= let c = std.json.ch(cs, i) in if c == "{" then std.json.parse_obj(cs, i, depth) else if c == "[" then std.json.parse_arr(cs, i, depth) else if c == "\"" then match std.json.str_loop(cs, i + 1, map_new(), 0) { Ok(r) => Ok(std.json.Parsed { value: std.json.Str(r.text), next: r.next }), Err(e) => Err(e) } else if c == "t" then std.json.lit_loop(cs, i, chars("true"), 0, std.json.Bool(true)) else if c == "f" then std.json.lit_loop(cs, i, chars("false"), 0, std.json.Bool(false)) else if c == "n" then std.json.lit_loop(cs, i, chars("null"), 0, std.json.Null) else if c == "-" || std.json.dig(c) then std.json.parse_number(cs, i) else Err(std.json.err_at(i, if c == "" then "unexpected end of input" else "unexpected character"))

fn std.json.str_esc(cs: List[Str], j: Int, m: Map[Int, Str], k: Int) -> Result[std.json.StrEnd, std.json.Error]
= let e = std.json.ch(cs, j + 1) in let s = std.json.simple_esc(e) in if s != "" then std.json.str_loop(cs, j + 2, map_put(m, k, s), k + 1) else if e == "u" then match std.json.hex4(cs, j + 2) { Err(p) => Err(std.json.err_at(p, "invalid \\u escape")), Ok(cp) => std.json.str_uni(cs, j, cp, m, k) } else Err(std.json.err_at(j + 1, if e == "" then "unterminated string" else "invalid escape"))

fn std.json.str_loop(cs: List[Str], j: Int, m: Map[Int, Str], k: Int) -> Result[std.json.StrEnd, std.json.Error]
= let c = std.json.ch(cs, j) in if c == "" then Err(std.json.err_at(j, "unterminated string")) else if c == "\"" then Ok(std.json.StrEnd { text: join(map_values(m), ""), next: j + 1 }) else if c == "\\" then std.json.str_esc(cs, j, m, k) else if char_code(c) < 32 then Err(std.json.err_at(j, "control character in string")) else std.json.str_loop(cs, j + 1, map_put(m, k, c), k + 1)

fn std.json.str_uni(cs: List[Str], j: Int, cp: Int, m: Map[Int, Str], k: Int) -> Result[std.json.StrEnd, std.json.Error]
= if cp >= 55296 && cp <= 56319 then let c6 = std.json.ch(cs, j + 6) in if c6 == "" then Err(std.json.err_at(j + 6, "unterminated string")) else if c6 != "\\" then Err(std.json.err_at(j, "unpaired high surrogate")) else let c7 = std.json.ch(cs, j + 7) in if c7 == "" then Err(std.json.err_at(j + 7, "unterminated string")) else if c7 != "u" then Err(std.json.err_at(j, "unpaired high surrogate")) else match std.json.hex4(cs, j + 8) { Err(p) => Err(std.json.err_at(p, "invalid \\u escape")), Ok(lo) => if lo >= 56320 && lo <= 57343 then std.json.str_loop(cs, j + 12, map_put(m, k, from_char_code(65536 + (cp - 55296) * 1024 + (lo - 56320))), k + 1) else Err(std.json.err_at(j, "unpaired high surrogate")) } else if cp >= 56320 && cp <= 57343 then Err(std.json.err_at(j, "lone low surrogate")) else std.json.str_loop(cs, j + 6, map_put(m, k, from_char_code(cp)), k + 1)
